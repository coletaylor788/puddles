{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end integration tests that drive the real OpenClaw pipeline (agent turns over the live gateway) and assert behavior with deterministic checks + an LLM judge.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:openclaw": "node ./bin/openclaw-test-env.mjs patches",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest --config vitest.e2e.config.ts",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
