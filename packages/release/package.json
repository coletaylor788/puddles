  },
  "bin": {
    "puddles-release": "bin/puddles-release.mjs",
    "puddles-ci": "bin/puddles-ci.mjs"
  },
  "packageManager": "pnpm@12.4.0",
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "^5.0.0",
    "vitest": "3.2.4",
    "yaml": "2.8.3"
  }
}
