{
  "name": "@puddles/release",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent single-host deployment, recovery, queue, and workspace lifecycle.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/build.mjs --check",
