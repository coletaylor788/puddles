+++ b/src/plugin-sdk/file-lock.stale-contention.test.ts
@@ -0,0 +1,221 @@
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { afterEach, describe, expect, it } from "vitest";
+
+const workerSource = `
+import fs from "node:fs/promises";
+import process from "node:process";
+import { pathToFileURL } from "node:url";
+
+const [modulePath, target, controlDir, eventsPath, id] = process.argv.slice(2);
+const { acquireFileLock } = await import(pathToFileURL(modulePath).href);
+const waitFor = async (file) => {
+  for (let attempt = 0; attempt < 500; attempt += 1) {
+    try {
+      await fs.access(file);
+      return;
+    } catch {}
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+  throw new Error("worker barrier timed out");
+};
+const lock = await acquireFileLock(target, {
+  managerKey: "stale-contention-" + id,
+  staleMs: 1,
+  retry: { retries: 500, factor: 1, minTimeout: 5, maxTimeout: 5 },
+  staleRecovery: "remove-if-unchanged",
+  allowReentrant: false,
+  payload: async () => ({
+    pid: process.pid,
+    createdAt: new Date().toISOString(),
+  }),
+  shouldReclaim: async ({ payload }) => payload?.pid === -1,
+  shouldRemoveStaleLock: async () => {
+    await fs.writeFile(controlDir + "/" + id + ".ready", "");
+    if (id === "a") {
+      await waitFor(controlDir + "/a.allow");
+    }
+    return true;
+  },
+});
+try {
+  await fs.appendFile(eventsPath, "enter " + id + "\\n");
+  await new Promise((resolve) => setTimeout(resolve, 100));
+  await fs.appendFile(eventsPath, "exit " + id + "\\n");
+} finally {
+  await lock.release();
+}
+`;
+
+describe("shared file-lock stale contention", () => {
+  const tempDirs: string[] = [];
+
+  afterEach(async () => {
+    await Promise.all(
+      tempDirs.splice(0).map((directory) =>
+        fs.rm(directory, { recursive: true, force: true }),
+      ),
+    );
+  });
+
+  it.skipIf(process.platform !== "darwin")(
+    "recovers after a killed reclaimer and shares persistent guards with sync callers",
+    async () => {
+      const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "openclaw-killed-lock-"));
+      tempDirs.push(tempDir);
+      const target = path.join(tempDir, "config.json");
+      const ready = path.join(tempDir, "ready");
+      const modulePath = path.join(process.cwd(), "node_modules/@openclaw/fs-safe/dist/file-lock.js");
+      await fs.writeFile(`${target}.lock`, JSON.stringify({ pid: -1 }));
+      // Existing production guards are persistent files, not stale directories.
+      await fs.writeFile(`${target}.lock.reclaim`, "");
+      const child = spawn(process.execPath, ["--input-type=module", "-e", `
+        import fs from "node:fs/promises";
+        const { acquireFileLock } = await import(${JSON.stringify(pathToFileURL(modulePath).href)});
+        await acquireFileLock(${JSON.stringify(target)}, {
+          payload: () => ({ pid: process.pid, createdAt: new Date().toISOString() }),
+          staleRecovery: "remove-if-unchanged", shouldReclaim: () => true,
+          shouldRemoveStaleLock: async () => {
+            await fs.writeFile(${JSON.stringify(ready)}, "");
+            await new Promise(() => setInterval(() => {}, 1000));
+            return true;
+          },
+        });
+      `], { stdio: ["ignore", "ignore", "pipe"] });
+      const exited = once(child, "exit");
+      try {
+        await waitFor(() => fs.access(ready));
+        child.kill("SIGKILL");
+        await exited;
+        const { acquireFileLock, acquireFileLockSync } = await import(pathToFileURL(modulePath).href);
+        const options = {
+          payload: () => ({ pid: process.pid, createdAt: new Date().toISOString() }),
+          staleRecovery: "remove-if-unchanged",
+          shouldReclaim: ({ payload }: { payload?: { pid?: number } }) => payload?.pid === -1,
+          shouldRemoveStaleLock: () => true,
+          retry: { retries: 1, minTimeout: 1, maxTimeout: 1 },
+        };
+        const first = await acquireFileLock(target, options);
+        try {
+          expect(() => acquireFileLockSync(target, options)).toThrow("file lock timeout");
+        } finally {
+          await first.release();
+        }
+        const second = acquireFileLockSync(target, options);
+        second.release();
+        expect((await fs.stat(`${target}.lock.reclaim`)).isFile()).toBe(true);
+      } finally {
+        if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+        await exited;
+      }
+    },
+    15_000,
+  );
+
+  it.skipIf(process.platform !== "darwin")(
+    "serializes two stale reclaimers without overlapping lock owners",
+    async () => {
+      const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "openclaw-stale-lock-"));
+      tempDirs.push(tempDir);
+      const target = path.join(tempDir, "openclaw.json");
+      const lockPath = `${target}.lock`;
+      const controlDir = path.join(tempDir, "control");
+      const eventsPath = path.join(tempDir, "events.log");
+      const workerPath = path.join(tempDir, "worker.mjs");
+      const modulePath = path.join(
+        process.cwd(),
+        "node_modules",
+        "@openclaw",
+        "fs-safe",
+        "dist",
+        "file-lock.js",
+      );
+      await fs.mkdir(controlDir);
+      await fs.writeFile(workerPath, workerSource);
+      await fs.writeFile(
+        lockPath,
+        JSON.stringify({
+          pid: -1,
+          createdAt: new Date(Date.now() - 60_000).toISOString(),
+        }),
+      );
+
+      const first = spawnWorker({
+        workerPath,
+        modulePath,
+        target,
+        controlDir,
+        eventsPath,
+        id: "a",
+      });
+      await waitFor(() => fs.access(path.join(controlDir, "a.ready")));
+
+      const second = spawnWorker({
+        workerPath,
+        modulePath,
+        target,
+        controlDir,
+        eventsPath,
+        id: "b",
+      });
+      await new Promise((resolve) => setTimeout(resolve, 150));
+      await expect(fs.access(path.join(controlDir, "b.ready"))).rejects.toThrow();
+
+      await fs.writeFile(path.join(controlDir, "a.allow"), "");
+      const [firstResult, secondResult] = await Promise.all([first, second]);
+      expect(firstResult).toEqual({ code: 0, stderr: "" });
+      expect(secondResult).toEqual({ code: 0, stderr: "" });
+
+      const events = (await fs.readFile(eventsPath, "utf8")).trim().split("\n");
+      let active = 0;
+      for (const event of events) {
+        active += event.startsWith("enter ") ? 1 : -1;
+        expect(active).toBeGreaterThanOrEqual(0);
+        expect(active).toBeLessThanOrEqual(1);
+      }
+      expect(active).toBe(0);
+    },
+    15_000,
+  );
+});
+
+function spawnWorker(params: {
+  workerPath: string;
+  modulePath: string;
+  target: string;
+  controlDir: string;
+  eventsPath: string;
+  id: string;
+}): Promise<{ code: number | null; stderr: string }> {
+  const child = spawn(process.execPath, [
+    params.workerPath,
+    params.modulePath,
+    params.target,
+    params.controlDir,
+    params.eventsPath,
+    params.id,
+  ]);
+  let stderr = "";
+  child.stderr.setEncoding("utf8");
+  child.stderr.on("data", (chunk) => {
+    stderr += chunk;
+  });
+  return new Promise((resolve) => {
+    child.on("close", (code) => resolve({ code, stderr }));
+  });
+}
+
+async function waitFor(check: () => Promise<void>): Promise<void> {
+  for (let attempt = 0; attempt < 500; attempt += 1) {
+    try {
+      await check();
+      return;
+    } catch {}
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+  throw new Error("test barrier timed out");
+}
