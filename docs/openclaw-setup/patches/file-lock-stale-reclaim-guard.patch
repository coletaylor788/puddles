+diff --git a/dist/reclaim-kernel-guard.js b/dist/reclaim-kernel-guard.js
+new file mode 100644
+index 00000000..05374776
+--- /dev/null
++++ b/dist/reclaim-kernel-guard.js
+@@ -0,0 +1,42 @@
++import fs from "node:fs";
++
++const key = Symbol.for("fsSafe.darwinReclaimGuards");
++const guards = globalThis[key] ??= new Map();
++const DARWIN_O_EXLOCK = 32;
++
++export function tryAcquireKernelReclaimGuard(path) {
++    if (guards.has(path)) return false;
++    let fd;
++    try {
++        fd = fs.openSync(path, fs.constants.O_CREAT | fs.constants.O_RDWR |
++            fs.constants.O_NONBLOCK | fs.constants.O_NOFOLLOW | DARWIN_O_EXLOCK, 0o600);
++        if (!fs.fstatSync(fd).isFile()) {
++            throw new Error("Reclaim guard must be a regular file");
++        }
++        guards.set(path, fd);
++        return true;
++    }
++    catch (error) {
++        if (fd !== undefined) fs.closeSync(fd);
++        if (error.code === "EAGAIN" || error.code === "EWOULDBLOCK") return false;
++        throw error;
++    }
++}
++
++export function releaseKernelReclaimGuard(path) {
++    const fd = guards.get(path);
++    if (fd === undefined) throw new Error("Reclaim guard is not held");
++    fs.closeSync(fd);
++    guards.delete(path);
++}
++
++export function kernelReclaimGuardExists(path) {
++    try {
++        if (!tryAcquireKernelReclaimGuard(path)) return true;
++    } catch (error) {
++        if (error.code === "ENOENT") return false;
++        throw error;
++    }
++    releaseKernelReclaimGuard(path);
++    return false;
++}
