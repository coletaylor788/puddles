+     }
++    if (process.platform === "darwin") {
++        if (!tryAcquireKernelReclaimGuard(pathname)) return;
++        reclaimGuards.add(pathname);
++        let released = false;
++        return { async release() {
++            if (released) return;
++            releaseKernelReclaimGuard(pathname);
++            reclaimGuards.delete(pathname);
++            released = true;
++        } };
++    }
+     try {
+         await fs.mkdir(pathname);
+     }
