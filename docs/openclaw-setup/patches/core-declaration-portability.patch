+  trajectoryRecorder: Awaited<ReturnType<typeof prepareEmbeddedAttemptTrajectory>>;
+  transcriptPolicy: PreparedSessionManager["transcriptPolicy"];
+  transport: Awaited<ReturnType<typeof prepareEmbeddedAttemptTransport>>;
+};
+
+type IsAssignable<Source, Target> = [Source] extends [Target] ? true : false;
+type AssertTrue<Check extends true> = Check;
+
+type QueryShape<T> =
+  T extends SelectQueryBuilder<infer Database, infer Tables, infer Output>
+    ? { database: Database; output: Output; tables: Tables }
+    : never;
+
+type CanonicalSessionValidationBaseRow = {
+  current_session_id: string;
+  entry_valid: number;
+  fork_source_session_key: string | null;
+  parent_session_key: string | null;
+  retained_window_id: string | null;
+  session_key: string;
+  spawned_by: string | null;
+};
+
+type CanonicalSessionValidationRow = CanonicalSessionValidationBaseRow & {
+  entry_json: string;
+} & Partial<
+    Omit<{ updated_at: number }, keyof (CanonicalSessionValidationBaseRow & { entry_json: string })>
+  > &
+  Partial<
+    Omit<
+      {
+        owner_actor_id: string | null;
+        owner_actor_type: string | null;
+        owner_assigned_at: number | null;
+        owner_assigned_by_id: string | null;
+        owner_assigned_by_type: string | null;
+      },
+      keyof (CanonicalSessionValidationBaseRow & { entry_json: string; updated_at: number })
+    >
+  >;
+
+it("keeps explicit portable annotations equal to the inferred public types", () => {
+  expectTypeOf<ReturnType<typeof createProcessPollDeliveryContract>>().toEqualTypeOf<{
+    tool: AgentToolWithMeta<typeof processSchema, unknown>;
