+import type { ExecToolDetails } from "../../agents/bash-tools.exec-types.js";
+import type { processTool } from "../../agents/bash-tools.process.js";
+import { execSchema, processSchema } from "../../agents/bash-tools.schemas.js";
+import type { createCacheTrace } from "../../agents/cache-trace.js";
+import type { prepareEmbeddedAttemptBundleTools } from "../../agents/embedded-agent-runner/run/attempt-bundle-tools.js";
+import type {
+  prepareEmbeddedAttemptAgentSession,
+  prepareEmbeddedAttemptSessionBoundary,
+  prepareEmbeddedAttemptSessionManager,
+} from "../../agents/embedded-agent-runner/run/attempt-session-prepare.js";
+import type { prepareEmbeddedAttemptSessionRuntime } from "../../agents/embedded-agent-runner/run/attempt-session-runtime-prepare.js";
+import type { createEmbeddedAttemptSessionSettleTracker } from "../../agents/embedded-agent-runner/run/attempt-session-settle.js";
+import type { installEmbeddedAttemptContextGuards } from "../../agents/embedded-agent-runner/run/attempt-setup.js";
+import type { prepareEmbeddedAttemptTransport } from "../../agents/embedded-agent-runner/run/attempt-stream-settle.js";
+import type { prepareEmbeddedAttemptTrajectory } from "../../agents/embedded-agent-runner/run/attempt-trajectory.js";
+import type {
+  EmbeddedRunAttemptParams,
+  EmbeddedRunAttemptResult,
+} from "../../agents/embedded-agent-runner/run/types.js";
+import type { getEmbeddedSessionPromptState } from "../../agents/embedded-agent-runner/session-prompt-state.js";
+import type { normalizeAgentRuntimeTools } from "../../agents/runtime-plan/tools.js";
+import type { AgentToolWithMeta, AnyAgentTool } from "../../agents/tools/common.js";
+import type { githubPublicationDatabase } from "../../gateway/github-publication-store.js";
+import type {
+  DB as OpenClawAgentKyselyDatabase,
+  SessionWindows,
+} from "../../state/openclaw-agent-db.generated.js";
+import type { DB as OpenClawStateKyselyDatabase } from "../../state/openclaw-state-db.generated.js";
+import type { PluginInstallRecordSchema } from "../plugin-install-record-map.js";
+import { StrictPluginInstallRecordSchema } from "../zod-schema.installs.js";
+import type { prepareTranscriptEventReadQuery } from "./session-accessor.sqlite-read.js";
+import type { getSessionKysely } from "./session-accessor.sqlite-scope.js";
+import type { canonicalSessionValidationQuery } from "./session-canonical-key.js";
+import type { getSessionMemberKysely } from "./session-sharing-store.kernel.js";
+
+type CanonicalSessionDatabase = Pick<
+  OpenClawAgentKyselyDatabase,
+  | "schema_meta"
+  | "session_key_contract"
+  | "session_nodes"
+  | "session_windows"
+  | "session_canonical_validation_pending"
+>;
+
+type SessionSqliteDatabase = Pick<
+  OpenClawAgentKyselyDatabase,
+  | "acp_parent_stream_events"
+  | "board_tabs"
+  | "board_widgets"
+  | "conversation_deliveries"
+  | "conversations"
+  | "heartbeat_outcomes"
+  | "session_conversations"
+  | "session_goal_operations"
+  | "session_members"
+  | "session_nodes"
+  | "session_participants"
+  | "session_pending_inputs"
+  | "session_input_completions"
+  | "session_progress_cards"
+  | "session_suggestions"
+  | "session_transcript_archives"
+  | "session_transcript_cold_archives"
+  | "session_transcript_active_events"
+  | "session_transcript_index_state"
+  | "session_windows"
+  | "transcript_rewrite_watermarks"
+  | "trajectory_runtime_events"
+  | "transcript_event_identities"
+  | "transcript_events"
+> & {
+  sqlite_schema: { name: string | null; type: string };
+};
+
+type SessionMemberDatabase = Pick<OpenClawAgentKyselyDatabase, "session_members">;
+
+type GitHubPublicationDatabase = Pick<
+  OpenClawStateKyselyDatabase,
+  | "github_publication_requests"
+  | "github_publication_session_lifecycles"
+  | "worker_session_placements"
+>;
+
+type PreparedEmbeddedAttemptBundleTools = {
+  bundleLspRuntime: Awaited<ReturnType<typeof createBundleLspToolRuntime>> | undefined;
+  bundleMcpRuntime: Awaited<ReturnType<typeof materializeBundleMcpToolsForRun>> | undefined;
+  clientTools: EmbeddedRunAttemptParams["clientTools"];
+  tools: ReturnType<typeof normalizeAgentRuntimeTools>;
+  uncompactedEffectiveTools: AnyAgentTool[];
+  refreshTools: () => void;
+};
+
+type PreparedSessionManager = Awaited<ReturnType<typeof prepareEmbeddedAttemptSessionManager>>;
+type PreparedEmbeddedAttemptSessionRuntime = {
+  agentSession: Awaited<ReturnType<typeof prepareEmbeddedAttemptAgentSession>>;
+  anthropicPayloadLogger: ReturnType<typeof createAnthropicPayloadLogger>;
+  boundary: Awaited<ReturnType<typeof prepareEmbeddedAttemptSessionBoundary>>;
+  cacheTrace: ReturnType<typeof createCacheTrace>;
+  contextGuards: ReturnType<typeof installEmbeddedAttemptContextGuards>;
+  isOpenAIResponsesApi: PreparedSessionManager["isOpenAIResponsesApi"];
+  preparedUserTurnMessage: PreparedSessionManager["preparedUserTurnMessage"];
+  sessionManager: PreparedSessionManager["sessionManager"];
+  sessionPromptState: ReturnType<typeof getEmbeddedSessionPromptState>;
+  settleTracker: ReturnType<typeof createEmbeddedAttemptSessionSettleTracker>;
+  state: {
+    currentTurnImageFailureCount: number;
+    prePromptMessageCount: number;
+    promptCache: EmbeddedRunAttemptResult["promptCache"];
+    systemPromptText: string;
+  };
+  toolResultPromptProjectionState: ReturnType<typeof getEmbeddedSessionPromptState>["toolResults"];
+  trajectoryRecorder: Awaited<ReturnType<typeof prepareEmbeddedAttemptTrajectory>>;
+  transcriptPolicy: PreparedSessionManager["transcriptPolicy"];
+  transport: Awaited<ReturnType<typeof prepareEmbeddedAttemptTransport>>;
+};
+
+type IsAssignable<Source, Target> = [Source] extends [Target] ? true : false;
+type AssertTrue<Check extends true> = Check;
+
+type QueryShape<T> =
+  T extends SelectQueryBuilder<infer Database, infer Tables, infer Output>
+    ? { database: Database; output: Output; tables: Tables }
+    : never;
+
+type CanonicalSessionValidationBaseRow = {
+  current_session_id: string;
+  entry_valid: number;
+  fork_source_session_key: string | null;
+  parent_session_key: string | null;
+  retained_window_id: string | null;
+  session_key: string;
+  spawned_by: string | null;
+};
+
+type CanonicalSessionValidationRow = CanonicalSessionValidationBaseRow & {
+  entry_json: string;
+} & Partial<
+    Omit<{ updated_at: number }, keyof (CanonicalSessionValidationBaseRow & { entry_json: string })>
+  > &
+  Partial<
+    Omit<
+      {
+        owner_actor_id: string | null;
+        owner_actor_type: string | null;
+        owner_assigned_at: number | null;
+        owner_assigned_by_id: string | null;
+        owner_assigned_by_type: string | null;
+      },
+      keyof (CanonicalSessionValidationBaseRow & { entry_json: string; updated_at: number })
+    >
+  >;
+
+it("keeps explicit portable annotations equal to the inferred public types", () => {
+  expectTypeOf<typeof execTool>().toEqualTypeOf<
+    AgentToolWithMeta<typeof execSchema, ExecToolDetails>
+  >();
+  expectTypeOf<typeof processTool>().toEqualTypeOf<
+    AgentToolWithMeta<typeof processSchema, unknown>
+  >();
+  expectTypeOf<ReturnType<typeof getSessionKysely>>().toEqualTypeOf<
+    Kysely<SessionSqliteDatabase>
+  >();
+  type TranscriptQuery = QueryShape<ReturnType<typeof prepareTranscriptEventReadQuery>>;
+  expectTypeOf<TranscriptQuery["database"]>().toEqualTypeOf<SessionSqliteDatabase>();
+  expectTypeOf<TranscriptQuery["tables"]>().toEqualTypeOf<"transcript_events">();
+  expectTypeOf<TranscriptQuery["output"]>().toEqualTypeOf<Partial<Omit<unknown, never>>>();
+
+  type CanonicalQuery = QueryShape<ReturnType<typeof canonicalSessionValidationQuery>>;
+  expectTypeOf<CanonicalQuery["database"]>().toEqualTypeOf<
+    CanonicalSessionDatabase & { retained_window: Nullable<SessionWindows> }
+  >();
+  expectTypeOf<CanonicalQuery["tables"]>().toEqualTypeOf<"session_nodes" | "retained_window">();
+  expectTypeOf<CanonicalQuery["output"]>().toEqualTypeOf<CanonicalSessionValidationRow>();
+  expectTypeOf<ReturnType<typeof getSessionMemberKysely>>().toEqualTypeOf<
+    Kysely<SessionMemberDatabase>
+  >();
+  expectTypeOf<ReturnType<typeof githubPublicationDatabase>>().toEqualTypeOf<
+    Kysely<GitHubPublicationDatabase>
+  >();
+  expectTypeOf<typeof PluginInstallRecordSchema>().toEqualTypeOf<
+    ReturnType<typeof StrictPluginInstallRecordSchema.passthrough>
+  >();
+  type InferredBundleTools = Awaited<ReturnType<typeof prepareEmbeddedAttemptBundleTools>>;
+  type BundleToolsMatchesAnnotation = AssertTrue<
+    IsAssignable<InferredBundleTools, PreparedEmbeddedAttemptBundleTools>
+  >;
+  type AnnotationMatchesBundleTools = AssertTrue<
+    IsAssignable<PreparedEmbeddedAttemptBundleTools, InferredBundleTools>
+  >;
+  expectTypeOf<BundleToolsMatchesAnnotation>().toEqualTypeOf<true>();
+  expectTypeOf<AnnotationMatchesBundleTools>().toEqualTypeOf<true>();
+
+  type InferredSessionRuntime = Awaited<ReturnType<typeof prepareEmbeddedAttemptSessionRuntime>>;
+  type SessionRuntimeMatchesAnnotation = AssertTrue<
+    IsAssignable<InferredSessionRuntime, PreparedEmbeddedAttemptSessionRuntime>
+  >;
+  type AnnotationMatchesSessionRuntime = AssertTrue<
+    IsAssignable<PreparedEmbeddedAttemptSessionRuntime, InferredSessionRuntime>
+  >;
+  expectTypeOf<SessionRuntimeMatchesAnnotation>().toEqualTypeOf<true>();
+  expectTypeOf<AnnotationMatchesSessionRuntime>().toEqualTypeOf<true>();
+});
