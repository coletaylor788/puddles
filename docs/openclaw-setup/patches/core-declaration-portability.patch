+  expectTypeOf<typeof processTool>().toEqualTypeOf<
+    AgentToolWithMeta<typeof processSchema, unknown>
+  >();
+  expectTypeOf<ReturnType<typeof getSessionKysely>>().toEqualTypeOf<
+    Kysely<SessionSqliteDatabase>
+  >();
+  type TranscriptQuery = QueryShape<ReturnType<typeof prepareTranscriptEventReadQuery>>;
+  expectTypeOf<TranscriptQuery["database"]>().toEqualTypeOf<SessionSqliteDatabase>();
+  expectTypeOf<TranscriptQuery["tables"]>().toEqualTypeOf<"transcript_events">();
+  expectTypeOf<TranscriptQuery["output"]>().toEqualTypeOf<Partial<Omit<unknown, never>>>();
+
+  type CanonicalQuery = QueryShape<ReturnType<typeof canonicalSessionValidationQuery>>;
+  expectTypeOf<CanonicalQuery["database"]>().toEqualTypeOf<
+    CanonicalSessionDatabase & { retained_window: Nullable<SessionWindows> }
+  >();
+  expectTypeOf<CanonicalQuery["tables"]>().toEqualTypeOf<"session_nodes" | "retained_window">();
+  expectTypeOf<CanonicalQuery["output"]>().toEqualTypeOf<CanonicalSessionValidationRow>();
+  expectTypeOf<ReturnType<typeof getSessionMemberKysely>>().toEqualTypeOf<
+    Kysely<SessionMemberDatabase>
+  >();
+  expectTypeOf<ReturnType<typeof githubPublicationDatabase>>().toEqualTypeOf<
+    Kysely<GitHubPublicationDatabase>
+  >();
+  expectTypeOf<typeof PluginInstallRecordSchema>().toEqualTypeOf<
+    ReturnType<typeof StrictPluginInstallRecordSchema.passthrough>
+  >();
+  type InferredBundleTools = Awaited<ReturnType<typeof prepareEmbeddedAttemptBundleTools>>;
+  type BundleToolsMatchesAnnotation = AssertTrue<
+    IsAssignable<InferredBundleTools, PreparedEmbeddedAttemptBundleTools>
+  >;
+  type AnnotationMatchesBundleTools = AssertTrue<
+    IsAssignable<PreparedEmbeddedAttemptBundleTools, InferredBundleTools>
+  >;
+  expectTypeOf<BundleToolsMatchesAnnotation>().toEqualTypeOf<true>();
+  expectTypeOf<AnnotationMatchesBundleTools>().toEqualTypeOf<true>();
+
+  type InferredClientTools = ReturnType<typeof prepareEmbeddedAttemptClientTools>;
+  type ClientToolsMatchesAnnotation = AssertTrue<
+    IsAssignable<InferredClientTools, PreparedEmbeddedAttemptClientTools>
+  >;
+  type AnnotationMatchesClientTools = AssertTrue<
+    IsAssignable<PreparedEmbeddedAttemptClientTools, InferredClientTools>
+  >;
+  expectTypeOf<ClientToolsMatchesAnnotation>().toEqualTypeOf<true>();
+  expectTypeOf<AnnotationMatchesClientTools>().toEqualTypeOf<true>();
+
+  type InferredAgentSession = Awaited<ReturnType<typeof prepareEmbeddedAttemptAgentSession>>;
+  type AgentSessionMatchesAnnotation = AssertTrue<
+    IsAssignable<InferredAgentSession, PreparedEmbeddedAttemptAgentSession>
+  >;
+  type AnnotationMatchesAgentSession = AssertTrue<
+    IsAssignable<PreparedEmbeddedAttemptAgentSession, InferredAgentSession>
+  >;
+  expectTypeOf<AgentSessionMatchesAnnotation>().toEqualTypeOf<true>();
+  expectTypeOf<AnnotationMatchesAgentSession>().toEqualTypeOf<true>();
+
+  type InferredSessionRuntime = Awaited<ReturnType<typeof prepareEmbeddedAttemptSessionRuntime>>;
+  type SessionRuntimeMatchesAnnotation = AssertTrue<
+    IsAssignable<InferredSessionRuntime, PreparedEmbeddedAttemptSessionRuntime>
+  >;
+  type AnnotationMatchesSessionRuntime = AssertTrue<
+    IsAssignable<PreparedEmbeddedAttemptSessionRuntime, InferredSessionRuntime>
+  >;
+  expectTypeOf<SessionRuntimeMatchesAnnotation>().toEqualTypeOf<true>();
+  expectTypeOf<AnnotationMatchesSessionRuntime>().toEqualTypeOf<true>();
+});
