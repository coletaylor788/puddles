+  refreshTools: (recordQuarantine: RuntimeToolSchemaQuarantineRecorder) => void;
+};
+
+type PreparedSessionManager = Awaited<ReturnType<typeof prepareEmbeddedAttemptSessionManager>>;
+type PreparedEmbeddedAttemptClientTools = {
+  allCustomTools: ToolDefinition[];
+  builtinToolNames: Set<string>;
+  clientToolCallSlots: EmbeddedAttemptClientToolCallSlot[];
