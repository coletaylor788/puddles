@@ -0,0 +1,208 @@
+import type { Kysely, Nullable, SelectQueryBuilder } from "kysely";
+import { expectTypeOf, it } from "vitest";
+import type { createBundleLspToolRuntime } from "../../agents/agent-bundle-lsp-runtime.js";
+import type { materializeBundleMcpToolsForRun } from "../../agents/agent-bundle-mcp-tools.js";
