+};
+type PreparedEmbeddedAttemptSessionRuntime = {
+  agentSession: PreparedEmbeddedAttemptAgentSession;
+  anthropicPayloadLogger: ReturnType<typeof createAnthropicPayloadLogger>;
+  boundary: Awaited<ReturnType<typeof prepareEmbeddedAttemptSessionBoundary>>;
+  cacheTrace: ReturnType<typeof createCacheTrace>;
+  contextGuards: ReturnType<typeof installEmbeddedAttemptContextGuards>;
+  isOpenAIResponsesApi: PreparedSessionManager["isOpenAIResponsesApi"];
+  preparedUserTurnMessage: PreparedSessionManager["preparedUserTurnMessage"];
+  sessionManager: PreparedSessionManager["sessionManager"];
+  prepareSystemPromptUpdate:
+    | ((
+        systemPrompt: string,
+        freshlyRendered?: boolean,
+      ) => Promise<ReturnType<typeof prepareSessionSystemPrompt>>)
+    | undefined;
+  sessionPromptState: ReturnType<typeof retainEmbeddedSessionPromptState>["state"];
+  settleTracker: ReturnType<typeof createEmbeddedAttemptSessionSettleTracker>;
+  state: {
+    currentTurnImageFailureCount: number;
+    prePromptMessageCount: number;
