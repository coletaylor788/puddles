diff --git a/src/config/sessions/session-declaration-portability.test.ts b/src/config/sessions/session-declaration-portability.test.ts
new file mode 100644
index 000000000..8d2909d53
--- /dev/null
+++ b/src/config/sessions/session-declaration-portability.test.ts
@@ -0,0 +1,131 @@
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import type { Kysely, Nullable, SelectQueryBuilder } from "kysely";
+import { expectTypeOf, it } from "vitest";
+import type { execTool } from "../../agents/bash-tools.exec-run.js";
+import type { ExecToolDetails } from "../../agents/bash-tools.exec-types.js";
+import type { processTool } from "../../agents/bash-tools.process.js";
+import { execSchema, processSchema } from "../../agents/bash-tools.schemas.js";
+import type { AgentToolWithMeta } from "../../agents/tools/common.js";
+import type {
+  DB as OpenClawAgentKyselyDatabase,
+  SessionWindows,
+} from "../../state/openclaw-agent-db.generated.js";
+import type { prepareTranscriptEventReadQuery } from "./session-accessor.sqlite-read.js";
+import type { getSessionKysely } from "./session-accessor.sqlite-scope.js";
+import type { canonicalSessionValidationQuery } from "./session-canonical-key.js";
+
+type CanonicalSessionDatabase = Pick<
+  OpenClawAgentKyselyDatabase,
+  | "schema_meta"
+  | "session_key_contract"
+  | "session_nodes"
+  | "session_windows"
+  | "session_canonical_validation_pending"
+>;
+
+type SessionSqliteDatabase = Pick<
+  OpenClawAgentKyselyDatabase,
+  | "acp_parent_stream_events"
+  | "board_tabs"
+  | "board_widgets"
+  | "conversation_deliveries"
+  | "conversations"
+  | "heartbeat_outcomes"
+  | "session_conversations"
+  | "session_goal_operations"
+  | "session_members"
+  | "session_nodes"
+  | "session_participants"
+  | "session_pending_inputs"
+  | "session_input_completions"
+  | "session_progress_cards"
+  | "session_suggestions"
+  | "session_transcript_archives"
+  | "session_transcript_cold_archives"
+  | "session_transcript_active_events"
+  | "session_transcript_index_state"
+  | "session_windows"
+  | "transcript_rewrite_watermarks"
+  | "trajectory_runtime_events"
+  | "transcript_event_identities"
+  | "transcript_events"
+> & {
+  sqlite_schema: { name: string | null; type: string };
+};
+
+type QueryShape<T> =
+  T extends SelectQueryBuilder<infer Database, infer Tables, infer Output>
+    ? { database: Database; output: Output; tables: Tables }
+    : never;
+
+const execFileAsync = promisify(execFile);
+
+type CanonicalSessionValidationBaseRow = {
+  current_session_id: string;
+  entry_valid: number;
+  fork_source_session_key: string | null;
+  parent_session_key: string | null;
+  retained_window_id: string | null;
+  session_key: string;
+  spawned_by: string | null;
+};
+
+type CanonicalSessionValidationRow = CanonicalSessionValidationBaseRow & {
+  entry_json: string;
+} & Partial<
+    Omit<{ updated_at: number }, keyof (CanonicalSessionValidationBaseRow & { entry_json: string })>
+  > &
+  Partial<
+    Omit<
+      {
+        owner_actor_id: string | null;
+        owner_actor_type: string | null;
+        owner_assigned_at: number | null;
+        owner_assigned_by_id: string | null;
+        owner_assigned_by_type: string | null;
+      },
+      keyof (CanonicalSessionValidationBaseRow & { entry_json: string; updated_at: number })
+    >
+  >;
+
+it("keeps explicit portable annotations equal to the inferred public types", () => {
+  expectTypeOf<typeof execTool>().toEqualTypeOf<
+    AgentToolWithMeta<typeof execSchema, ExecToolDetails>
+  >();
+  expectTypeOf<typeof processTool>().toEqualTypeOf<
+    AgentToolWithMeta<typeof processSchema, unknown>
+  >();
+  expectTypeOf<ReturnType<typeof getSessionKysely>>().toEqualTypeOf<
+    Kysely<SessionSqliteDatabase>
+  >();
+  type TranscriptQuery = QueryShape<ReturnType<typeof prepareTranscriptEventReadQuery>>;
+  expectTypeOf<TranscriptQuery["database"]>().toEqualTypeOf<SessionSqliteDatabase>();
+  expectTypeOf<TranscriptQuery["tables"]>().toEqualTypeOf<"transcript_events">();
+  expectTypeOf<TranscriptQuery["output"]>().toEqualTypeOf<Partial<Omit<unknown, never>>>();
+
+  type CanonicalQuery = QueryShape<ReturnType<typeof canonicalSessionValidationQuery>>;
+  expectTypeOf<CanonicalQuery["database"]>().toEqualTypeOf<
+    CanonicalSessionDatabase & { retained_window: Nullable<SessionWindows> }
+  >();
+  expectTypeOf<CanonicalQuery["tables"]>().toEqualTypeOf<"session_nodes" | "retained_window">();
+  expectTypeOf<CanonicalQuery["output"]>().toEqualTypeOf<CanonicalSessionValidationRow>();
+});
+
+it("typechecks the portable declaration exports with the maintained test compiler", async () => {
+  await execFileAsync(
+    process.execPath,
+    [
+      "scripts/run-tsgo.mjs",
+      "-p",
+      "test/tsconfig/tsconfig.core.test.agents-sessions.json",
+      "--incremental",
+    ],
+    {
+      cwd: process.cwd(),
+      env: process.env,
+      maxBuffer: 4 * 1024 * 1024,
+      timeout: 120_000,
+    },
+  );
+}, 130_000);
