+const identities = vi.hoisted(() => new Map<number, number>());
+vi.mock("../../shared/pid-alive.js", () => ({
+  getFileLockProcessStartTime: (pid: number) => identities.get(pid) ?? null,
+  isPidDefinitelyDead: (pid: number) => !identities.has(pid),
+}));
+
+describe("stopped local service ownership", () => {
+  const generation = "11111111-1111-1111-1111-111111111111";
+  const owner = { pid: 101, startTime: 10 };
+  const relay = { pid: 102, startTime: 20 };
+  const anchor = { pid: 103, startTime: 30 };
+  let stateDir: string;
+  let directory: string;
+  let file: string;
+
+  beforeEach(() => {
+    identities.clear();
+    stateDir = fs.mkdtempSync(path.join(os.tmpdir(), "service-ownership-"));
+    directory = path.join(stateDir, "runtime", "local-service-owners");
+    file = path.join(directory, `${generation}.json`);
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.useRealTimers();
+    fs.rmSync(stateDir, { recursive: true, force: true });
+  });
+
+  function record(includeAnchor = true) {
+    fs.mkdirSync(directory, { recursive: true });
+    fs.writeFileSync(
+      file,
+      JSON.stringify({
+        version: 1,
+        generation,
+        owner,
+        relay,
+        ...(includeAnchor ? { anchor } : {}),
+      }),
+    );
+  }
+  function probe(gone: () => boolean) {
+    return vi.spyOn(process, "kill").mockImplementation((_pid, signal) => {
+      if (signal === 0 && gone()) throw Object.assign(new Error("gone"), { code: "ESRCH" });
+      return true;
+    });
+  }
+
+  it("refuses a live owner before signalling any process", async () => {
+    record();
+    identities.set(owner.pid, owner.startTime);
+    const kill = probe(() => false);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("still running");
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it("never signals a reused anchor PID", async () => {
+    record();
+    identities.set(anchor.pid, anchor.startTime + 1);
+    const kill = probe(() => false);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("identity changed");
+    expect(kill.mock.calls).toEqual([[-anchor.pid, 0]]);
+  });
+
+  it("fails an incomplete published record without assuming no group exists", async () => {
+    record(false);
+    const kill = probe(() => true);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 1)).rejects.toThrow("deadline");
+    expect(fs.existsSync(file)).toBe(true);
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it("refuses corrupted records", async () => {
+    record();
+    fs.writeFileSync(file, JSON.stringify({ version: 1, generation, owner }));
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("Invalid");
+  });
