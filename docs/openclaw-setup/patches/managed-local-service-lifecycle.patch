@@ -0,0 +1,174 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  bindServiceChildAnchor,
+  joinStoppedLocalServiceGroups,
+  requireServiceProcessIdentity,
+  stopGatewayAndJoinLocalServices,
+  writeServiceChildOwnership,
+} from "./service-child-ownership.js";
+
+const identities = vi.hoisted(() => new Map<number, number>());
+vi.mock("../../shared/pid-alive.js", () => ({
+  getFileLockProcessStartTime: (pid: number) => identities.get(pid) ?? null,
+  isPidDefinitelyDead: (pid: number) => !identities.has(pid),
+}));
+
+describe("stopped local service ownership", () => {
+  const generation = "11111111-1111-1111-1111-111111111111";
+  const owner = { pid: 101, startTime: 10 };
+  const relay = { pid: 102, startTime: 20 };
+  const anchor = { pid: 103, startTime: 30 };
+  let stateDir: string;
+  let directory: string;
+  let file: string;
+
+  beforeEach(() => {
+    identities.clear();
+    stateDir = fs.mkdtempSync(path.join(os.tmpdir(), "service-ownership-"));
+    directory = path.join(stateDir, "runtime", "local-service-owners");
+    file = path.join(directory, `${generation}.json`);
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.useRealTimers();
+    fs.rmSync(stateDir, { recursive: true, force: true });
+  });
+
+  function record(includeAnchor = true) {
+    fs.mkdirSync(directory, { recursive: true });
+    fs.writeFileSync(
+      file,
+      JSON.stringify({
+        version: 1,
+        generation,
+        owner,
+        relay,
+        ...(includeAnchor ? { anchor } : {}),
+      }),
+    );
+  }
+  function probe(gone: () => boolean) {
+    return vi.spyOn(process, "kill").mockImplementation((_pid, signal) => {
+      if (signal === 0 && gone()) throw Object.assign(new Error("gone"), { code: "ESRCH" });
+      return true;
+    });
+  }
+
+  it("refuses a live owner before signalling any process", async () => {
+    record();
+    identities.set(owner.pid, owner.startTime);
+    const kill = probe(() => false);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("still running");
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it("never signals a reused anchor PID", async () => {
+    record();
+    identities.set(anchor.pid, anchor.startTime + 1);
+    const kill = probe(() => false);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("identity changed");
+    expect(kill.mock.calls).toEqual([[-anchor.pid, 0]]);
+  });
+
+  it("fails an incomplete published record without assuming no group exists", async () => {
+    record(false);
+    const kill = probe(() => true);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 1)).rejects.toThrow("deadline");
+    expect(fs.existsSync(file)).toBe(true);
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it("refuses corrupted records", async () => {
+    record();
+    fs.writeFileSync(file, JSON.stringify({ version: 1, generation, owner }));
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("Invalid");
+  });
+
+  it("retains evidence if the anchor died but its group survived", async () => {
+    record();
+    const kill = probe(() => false);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 1)).rejects.toThrow("deadline");
+    expect(kill.mock.calls.every(([, signal]) => signal === 0)).toBe(true);
+    expect(fs.existsSync(file)).toBe(true);
+  });
+
+  it("requires the relay to exit as well as its group", async () => {
+    record();
+    identities.set(relay.pid, relay.startTime);
+    probe(() => true);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 1)).rejects.toThrow("deadline");
+    expect(fs.existsSync(file)).toBe(true);
+    identities.delete(relay.pid);
+    await joinStoppedLocalServiceGroups(stateDir, 10);
+    expect(fs.existsSync(file)).toBe(false);
+  });
+
+  it("signals only a matching live anchor and joins group and relay exit", async () => {
+    record();
+    identities.set(anchor.pid, anchor.startTime);
+    const kill = probe(() => !identities.has(anchor.pid));
+    kill.mockImplementation((pid, signal) => {
+      if (signal === "SIGTERM" && pid === anchor.pid) identities.delete(anchor.pid);
+      if (signal === 0 && !identities.has(anchor.pid))
+        throw Object.assign(new Error("gone"), { code: "ESRCH" });
+      return true;
+    });
+    await joinStoppedLocalServiceGroups(stateDir, 200);
+    expect(kill.mock.calls.filter(([, signal]) => signal !== 0)).toEqual([[anchor.pid, "SIGTERM"]]);
+    expect(fs.existsSync(file)).toBe(false);
+  });
+
+  it("publishes the anchor before refusing startup after owner death", () => {
+    identities.set(relay.pid, relay.startTime);
+    identities.set(process.pid, 40);
+    const ownership = { directory, owner };
+    writeServiceChildOwnership(ownership, generation, relay.pid);
+    expect(() => bindServiceChildAnchor(ownership, generation)).toThrow("owner exited");
+    expect(JSON.parse(fs.readFileSync(file, "utf8")).anchor).toEqual({
+      pid: process.pid,
+      startTime: 40,
+    });
+    expect(fs.statSync(file).mode & 0o777).toBe(0o600);
+  });
+
+  it("does not overwrite an existing ownership generation", () => {
+    identities.set(relay.pid, relay.startTime);
+    writeServiceChildOwnership({ directory, owner }, generation, relay.pid);
+    expect(() => writeServiceChildOwnership({ directory, owner }, generation, relay.pid)).toThrow();
+  });
+
+  it("stops the same gateway generation gracefully before forcing it", async () => {
+    vi.useFakeTimers();
+    identities.set(owner.pid, owner.startTime);
+    const kill = probe(() => true);
+    kill.mockImplementation((_pid, signal) => {
+      if (signal === "SIGKILL") identities.delete(owner.pid);
+      return true;
+    });
+    const stopped = stopGatewayAndJoinLocalServices(stateDir, owner, 10_000);
+    await vi.advanceTimersByTimeAsync(5_100);
+    await stopped;
+    expect(kill.mock.calls).toEqual([
+      [owner.pid, "SIGTERM"],
+      [owner.pid, "SIGKILL"],
+    ]);
+  });
+
+  it("does not signal a reused gateway PID", async () => {
+    identities.set(owner.pid, owner.startTime + 1);
+    const kill = probe(() => true);
+    await expect(stopGatewayAndJoinLocalServices(stateDir, owner)).rejects.toThrow(
+      "identity changed",
+    );
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it("rejects invalid bounds and nonpositive process IDs", async () => {
+    expect(() => requireServiceProcessIdentity(0)).toThrow("Invalid");
+    await expect(joinStoppedLocalServiceGroups(stateDir, Infinity)).rejects.toThrow("Invalid");
+    await expect(stopGatewayAndJoinLocalServices(stateDir, null, NaN)).rejects.toThrow("Invalid");
+  });
+});
