+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  bindServiceChildAnchor,
+  joinStoppedLocalServiceGroups,
+  requireServiceProcessIdentity,
+  stopGatewayAndJoinLocalServices,
+  writeServiceChildOwnership,
+} from "./service-child-ownership.js";
+
+const identities = vi.hoisted(() => new Map<number, number>());
+vi.mock("../../shared/pid-alive.js", () => ({
+  getFileLockProcessStartTime: (pid: number) => identities.get(pid) ?? null,
+  isPidDefinitelyDead: (pid: number) => !identities.has(pid),
+}));
+
+describe("stopped local service ownership", () => {
+  const generation = "11111111-1111-1111-1111-111111111111";
+  const owner = { pid: 101, startTime: 10 };
+  const relay = { pid: 102, startTime: 20 };
+  const anchor = { pid: 103, startTime: 30 };
+  let stateDir: string;
+  let directory: string;
+  let file: string;
+
+  beforeEach(() => {
+    identities.clear();
+    stateDir = fs.mkdtempSync(path.join(os.tmpdir(), "service-ownership-"));
+    directory = path.join(stateDir, "runtime", "local-service-owners");
+    file = path.join(directory, `${generation}.json`);
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.useRealTimers();
+    fs.rmSync(stateDir, { recursive: true, force: true });
+  });
+
+  function record(includeAnchor = true) {
+    fs.mkdirSync(directory, { recursive: true });
+    fs.writeFileSync(
+      file,
+      JSON.stringify({
+        version: 1,
+        generation,
+        owner,
+        relay,
+        ...(includeAnchor ? { anchor } : {}),
+      }),
+    );
+  }
+  function probe(gone: () => boolean) {
+    return vi.spyOn(process, "kill").mockImplementation((_pid, signal) => {
+      if (signal === 0 && gone()) throw Object.assign(new Error("gone"), { code: "ESRCH" });
+      return true;
+    });
+  }
+
+  it("refuses a live owner before signalling any process", async () => {
+    record();
+    identities.set(owner.pid, owner.startTime);
+    const kill = probe(() => false);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("still running");
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it("never signals a reused anchor PID", async () => {
+    record();
+    identities.set(anchor.pid, anchor.startTime + 1);
+    const kill = probe(() => false);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("identity changed");
+    expect(kill.mock.calls).toEqual([[-anchor.pid, 0]]);
+  });
+
+  it("fails an incomplete published record without assuming no group exists", async () => {
+    record(false);
+    const kill = probe(() => true);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 1)).rejects.toThrow("deadline");
+    expect(fs.existsSync(file)).toBe(true);
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it("refuses corrupted records", async () => {
+    record();
+    fs.writeFileSync(file, JSON.stringify({ version: 1, generation, owner }));
+    await expect(joinStoppedLocalServiceGroups(stateDir, 10)).rejects.toThrow("Invalid");
+  });
+
+  it("retains evidence if the anchor died but its group survived", async () => {
+    record();
+    const kill = probe(() => false);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 1)).rejects.toThrow("deadline");
+    expect(kill.mock.calls.every(([, signal]) => signal === 0)).toBe(true);
+    expect(fs.existsSync(file)).toBe(true);
+  });
+
+  it("treats a denied group probe as present until extinction is confirmed", async () => {
+    record();
+    let probes = 0;
+    const kill = vi.spyOn(process, "kill").mockImplementation((_pid, signal) => {
+      if (signal === 0) {
+        const code = probes++ === 0 ? "EPERM" : "ESRCH";
+        throw Object.assign(new Error(code), { code });
+      }
+      return true;
+    });
+    await joinStoppedLocalServiceGroups(stateDir, 200);
+    expect(kill.mock.calls).toEqual([
+      [-anchor.pid, 0],
+      [-anchor.pid, 0],
+    ]);
+    expect(fs.existsSync(file)).toBe(false);
+  });
+
+  it("requires the relay to exit as well as its group", async () => {
+    record();
+    identities.set(relay.pid, relay.startTime);
+    probe(() => true);
+    await expect(joinStoppedLocalServiceGroups(stateDir, 1)).rejects.toThrow("deadline");
+    expect(fs.existsSync(file)).toBe(true);
+    identities.delete(relay.pid);
+    await joinStoppedLocalServiceGroups(stateDir, 10);
+    expect(fs.existsSync(file)).toBe(false);
+  });
+
+  it("signals only a matching live anchor and joins group and relay exit", async () => {
+    record();
+    identities.set(anchor.pid, anchor.startTime);
+    const kill = probe(() => !identities.has(anchor.pid));
+    kill.mockImplementation((pid, signal) => {
+      if (signal === "SIGTERM" && pid === anchor.pid) identities.delete(anchor.pid);
+      if (signal === 0 && !identities.has(anchor.pid))
+        throw Object.assign(new Error("gone"), { code: "ESRCH" });
+      return true;
+    });
+    await joinStoppedLocalServiceGroups(stateDir, 200);
+    expect(kill.mock.calls.filter(([, signal]) => signal !== 0)).toEqual([[anchor.pid, "SIGTERM"]]);
+    expect(fs.existsSync(file)).toBe(false);
+  });
+
+  it("publishes the anchor before refusing startup after owner death", () => {
+    identities.set(relay.pid, relay.startTime);
+    identities.set(process.pid, 40);
+    const ownership = { directory, owner };
+    writeServiceChildOwnership(ownership, generation, relay.pid);
+    expect(() => bindServiceChildAnchor(ownership, generation)).toThrow("owner exited");
+    expect(JSON.parse(fs.readFileSync(file, "utf8")).anchor).toEqual({
+      pid: process.pid,
+      startTime: 40,
+    });
+    expect(fs.statSync(file).mode & 0o777).toBe(0o600);
+  });
+
+  it("does not overwrite an existing ownership generation", () => {
+    identities.set(relay.pid, relay.startTime);
+    writeServiceChildOwnership({ directory, owner }, generation, relay.pid);
+    expect(() => writeServiceChildOwnership({ directory, owner }, generation, relay.pid)).toThrow();
+  });
+
+  it("stops the same gateway generation gracefully before forcing it", async () => {
+    vi.useFakeTimers();
+    identities.set(owner.pid, owner.startTime);
+    const kill = probe(() => true);
+    kill.mockImplementation((_pid, signal) => {
+      if (signal === "SIGKILL") identities.delete(owner.pid);
+      return true;
+    });
+    const stopped = stopGatewayAndJoinLocalServices(stateDir, owner, 10_000);
+    await vi.advanceTimersByTimeAsync(5_100);
+    await stopped;
+    expect(kill.mock.calls).toEqual([
+      [owner.pid, "SIGTERM"],
+      [owner.pid, "SIGKILL"],
+    ]);
+  });
+
+  it("does not signal a reused gateway PID", async () => {
+    identities.set(owner.pid, owner.startTime + 1);
+    const kill = probe(() => true);
+    await expect(stopGatewayAndJoinLocalServices(stateDir, owner)).rejects.toThrow(
+      "identity changed",
+    );
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it("rejects invalid bounds and nonpositive process IDs", async () => {
+    expect(() => requireServiceProcessIdentity(0)).toThrow("Invalid");
+    await expect(joinStoppedLocalServiceGroups(stateDir, Infinity)).rejects.toThrow("Invalid");
+    await expect(stopGatewayAndJoinLocalServices(stateDir, null, NaN)).rejects.toThrow("Invalid");
+  });
+});
diff --git a/src/process/supervisor/service-child-ownership.ts b/src/process/supervisor/service-child-ownership.ts
new file mode 100644
index 0000000000000000000000000000000000000000..96f5d4348025ab50152e6c845efc26c682c0ac05
--- /dev/null
+++ b/src/process/supervisor/service-child-ownership.ts
@@ -0,0 +1,237 @@
+import fs from "node:fs";
+import path from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { getFileLockProcessStartTime, isPidDefinitelyDead } from "../../shared/pid-alive.js";
+
+type ProcessIdentity = { pid: number; startTime: number };
+export type ServiceChildOwnership = {
+  directory: string;
+  owner: ProcessIdentity;
+};
+type OwnershipRecord = {
+  version: 1;
+  generation: string;
+  owner: ProcessIdentity;
+  relay: ProcessIdentity;
+  anchor?: ProcessIdentity;
+};
+
+export function requireServiceProcessIdentity(pid: number): ProcessIdentity {
+  if (!Number.isSafeInteger(pid) || pid <= 0) throw new Error("Invalid local service PID");
+  const startTime = getFileLockProcessStartTime(pid);
+  if (startTime === null) throw new Error("Cannot establish local service process identity");
+  return { pid, startTime };
+}
+
+export function isServiceProcessIdentityAlive(identity: ProcessIdentity): boolean {
+  const current = getFileLockProcessStartTime(identity.pid);
+  if (current === identity.startTime && !isPidDefinitelyDead(identity.pid)) return true;
+  if (isPidDefinitelyDead(identity.pid)) return false;
+  throw new Error("Local service process identity changed or is unavailable");
+}
+
+function recordPath(directory: string, generation: string): string {
+  if (!path.isAbsolute(directory) || !/^[a-f0-9-]{36}$/.test(generation)) {
+    throw new Error("Invalid local service ownership location");
+  }
+  return path.join(directory, `${generation}.json`);
+}
+
+export function writeServiceChildOwnership(
+  ownership: ServiceChildOwnership,
+  generation: string,
+  relayPid: number,
+): void {
+  fs.mkdirSync(ownership.directory, { recursive: true, mode: 0o700 });
+  const record: OwnershipRecord = {
+    version: 1,
+    generation,
+    owner: ownership.owner,
+    relay: requireServiceProcessIdentity(relayPid),
+  };
+  fs.writeFileSync(recordPath(ownership.directory, generation), JSON.stringify(record), {
+    flag: "wx",
+    mode: 0o600,
+    flush: true,
+  });
+}
+
+function readRecord(file: string): OwnershipRecord {
+  const value: unknown = JSON.parse(fs.readFileSync(file, "utf8"));
+  const identity = (item: unknown): item is ProcessIdentity =>
+    typeof item === "object" &&
+    item !== null &&
+    "pid" in item &&
+    Number.isInteger(item.pid) &&
+    Number(item.pid) > 0 &&
+    "startTime" in item &&
+    typeof item.startTime === "number" &&
+    Number.isFinite(item.startTime);
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    !("version" in value) ||
+    value.version !== 1 ||
+    !("generation" in value) ||
+    typeof value.generation !== "string" ||
+    path.basename(file) !== `${value.generation}.json` ||
+    !("owner" in value) ||
+    !identity(value.owner) ||
+    !("relay" in value) ||
+    !identity(value.relay) ||
+    ("anchor" in value && !identity(value.anchor))
+  ) {
+    throw new Error("Invalid local service ownership record");
+  }
+  return {
+    version: 1,
+    generation: value.generation,
+    owner: value.owner,
+    relay: value.relay,
+    ...("anchor" in value && identity(value.anchor) ? { anchor: value.anchor } : {}),
+  };
+}
+
+export function bindServiceChildAnchor(ownership: ServiceChildOwnership, generation: string): void {
+  const file = recordPath(ownership.directory, generation);
+  const record = readRecord(file);
+  if (
+    record.owner.pid !== ownership.owner.pid ||
+    record.owner.startTime !== ownership.owner.startTime ||
+    record.anchor
+  ) {
+    throw new Error("Local service ownership changed before anchor startup");
+  }
+  const next = `${file}.next`;
+  fs.writeFileSync(
+    next,
+    JSON.stringify({
+      ...record,
+      anchor: requireServiceProcessIdentity(process.pid),
+    }),
+    { flag: "wx", mode: 0o600, flush: true },
+  );
+  fs.renameSync(next, file);
+  // Publication precedes this check. Once the owner is dead a stopped-state
+  // reader either sees this anchor or knows it cannot launch a model.
+  if (!isServiceProcessIdentityAlive(record.owner)) {
+    throw new Error("Local service owner exited before startup");
+  }
+}
+
+export function removeServiceChildOwnership(
+  ownership: ServiceChildOwnership,
+  generation: string,
+): void {
+  fs.rmSync(recordPath(ownership.directory, generation), { force: true });
+}
+
+function groupGone(pid: number): boolean {
+  try {
+    process.kill(-pid, 0);
+    return false;
+  } catch (error) {
+    if (typeof error === "object" && error !== null && "code" in error) {
+      if (error.code === "ESRCH") {
+        return true;
+      }
+      if (error.code === "EPERM") {
+        return false;
+      }
+    }
+    throw error;
+  }
+}
+
+function signalIdentity(identity: ProcessIdentity, signal: NodeJS.Signals): void {
+  if (!isServiceProcessIdentityAlive(identity)) return;
+  try {
+    process.kill(identity.pid, signal);
+  } catch (error) {
+    if (typeof error === "object" && error !== null && "code" in error && error.code === "ESRCH")
+      return;
+    throw error;
+  }
+}
+
+/** Called only after the service manager disables launches and its gateway exits. */
+export async function joinStoppedLocalServiceGroups(
+  stateDir: string,
+  timeoutMs: number,
+): Promise<void> {
+  if (!path.isAbsolute(stateDir) || !Number.isFinite(timeoutMs) || timeoutMs <= 0) {
+    throw new Error("Invalid local service extinction bound or state directory");
+  }
+  const directory = path.join(stateDir, "runtime", "local-service-owners");
+  let names: string[];
+  try {
+    names = fs.readdirSync(directory).filter((name) => name.endsWith(".json"));
+  } catch (error) {
+    if (typeof error === "object" && error !== null && "code" in error && error.code === "ENOENT")
+      return;
+    throw error;
+  }
+  const deadline = Date.now() + timeoutMs;
+  for (const name of names) {
+    const file = path.join(directory, name);
+    let signalled = false;
+    for (;;) {
+      let record: OwnershipRecord;
+      try {
+        record = readRecord(file);
+      } catch (error) {
+        if (
+          typeof error === "object" &&
+          error !== null &&
+          "code" in error &&
+          error.code === "ENOENT"
+        )
+          break;
+        throw error;
+      }
+      if (isServiceProcessIdentityAlive(record.owner)) {
+        throw new Error("Local service gateway owner is still running");
+      }
+      if (record.anchor) {
+        if (groupGone(record.anchor.pid)) {
+          if (!isServiceProcessIdentityAlive(record.relay)) {
+            fs.rmSync(file);
+            break;
+          }
+        } else if (!signalled && isServiceProcessIdentityAlive(record.anchor)) {
+          // The live anchor, not a stale PGID, owns group cancellation.
+          signalIdentity(record.anchor, "SIGTERM");
+          signalled = true;
+        }
+      }
+
+      if (Date.now() >= deadline)
+        throw new Error("Local service group extinction deadline exceeded");
+      await delay(Math.min(50, Math.max(1, deadline - Date.now())));
+    }
+  }
+}
+
+export async function stopGatewayAndJoinLocalServices(
+  stateDir: string,
+  owner: ProcessIdentity | null,
+  timeoutMs = 30_000,
+): Promise<void> {
+  if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) throw new Error("Invalid gateway stop bound");
+  const deadline = Date.now() + timeoutMs;
+  const forceAt = Date.now() + 5_000;
+  let sentTerm = false;
+  let sentKill = false;
+  while (owner && isServiceProcessIdentityAlive(owner)) {
+    if (!sentTerm) {
+      signalIdentity(owner, "SIGTERM");
+      sentTerm = true;
+    } else if (!sentKill && Date.now() >= forceAt) {
+      signalIdentity(owner, "SIGKILL");
+      sentKill = true;
+    }
+    if (Date.now() >= deadline) throw new Error("Gateway process extinction deadline exceeded");
+    await delay(50);
+  }
+  await joinStoppedLocalServiceGroups(stateDir, Math.max(1, deadline - Date.now()));
+}
