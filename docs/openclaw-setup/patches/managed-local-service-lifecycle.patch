+import { build } from "tsdown";
+import { expect, it } from "vitest";
+import { collectWorkerDeployArtifactErrors } from "../../scripts/check-cli-bootstrap-imports.mts";
+import configs from "../../tsdown.config.ts";
+
+it("keeps the ownership-aware standalone anchor free of native runtime imports", async () => {
+  const config = configs.find(
+    (candidate) =>
+      typeof candidate.entry === "object" &&
+      !Array.isArray(candidate.entry) &&
+      candidate.entry?.["worker/service-child-group-anchor"],
+  );
+  expect(config).toBeDefined();
+  const root = mkdtempSync(join(tmpdir(), "openclaw-owned-anchor-bundle-"));
+  try {
+    // Compile only this fixture graph with its real packaging options. Nothing
+    // from this temporary output is a release or installation artifact.
+    const { bundles } = await build({
+      ...config,
+      config: false,
+      outDir: join(root, "dist"),
+      dts: false,
+      logLevel: "silent",
+    });
+    for (const bundle of bundles) await bundle[Symbol.asyncDispose]();
+    expect(
+      collectWorkerDeployArtifactErrors({
+        rootDir: root,
+        workerDeployEntrypoints: ["dist/worker/service-child-group-anchor.mjs"],
+      }),
+    ).toEqual([]);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
