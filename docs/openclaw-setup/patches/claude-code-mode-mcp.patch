new file mode 100644
index 0000000000000000000000000000000000000000..80fd37824e830c448330e2618bb05e4ac4c662f8
--- /dev/null
+++ b/src/agents/cli-runner/code-mode-skills.test.ts
@@ -0,0 +1,57 @@
+import { mkdtemp, mkdir, writeFile, rm, symlink } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, expect, it } from "vitest";
+import { readCodeModeSkill } from "../code-mode-skills.js";
+import { resolveMaterializedCliCodeModeSkills } from "./code-mode-skills.js";
+
+const roots: string[] = [];
+afterEach(async () => {
+  await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
+
+it("reads only the delivered skill behind a container-visible catalog location", async () => {
+  const rootDir = await mkdtemp(path.join(tmpdir(), "cli-contained-skills-"));
+  roots.push(rootDir);
+  const baseDir = path.join(rootDir, "manual");
+  const filePath = path.join(baseDir, "SKILL.md");
+  await mkdir(baseDir);
+  await writeFile(filePath, "Delivered instructions");
+  const skills = await resolveMaterializedCliCodeModeSkills({
+    rootDir,
+    skillsPrompt: [
+      "<available_skills>",
+      "  <skill>",
+      "    <name>manual</name>",
+      "    <location>/workspace/skills/manual/SKILL.md</location>",
+      "  </skill>",
+      "</available_skills>",
+    ].join("\n"),
+    candidates: [
+      {
+        name: "manual",
+        description: "Manual",
+        filePath,
+        baseDir,
+        source: "openclaw-workspace",
+        sourceInfo: {
+          path: filePath,
+          source: "openclaw-workspace",
+          scope: "project",
+          origin: "top-level",
+          baseDir,
+        },
+        disableModelInvocation: false,
+      },
+    ],
+  });
+  expect(skills).toHaveLength(1);
+  expect(skills[0]?.location).toBe("/workspace/skills/manual/SKILL.md");
+  await expect(readCodeModeSkill(skills[0]!)).resolves.toBe("Delivered instructions");
+  const outside = await mkdtemp(path.join(tmpdir(), "cli-outside-skills-"));
+  roots.push(outside);
+  await writeFile(path.join(outside, "private"), "Not a delivered instruction");
+  await rm(filePath);
+  await symlink(path.join(outside, "private"), filePath);
+  await expect(readCodeModeSkill(skills[0]!)).rejects.toThrow();
+});
diff --git a/src/agents/cli-runner/code-mode-skills.ts b/src/agents/cli-runner/code-mode-skills.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bce80868ac216f1dbf41c72f03560168fdcca93c
--- /dev/null
+++ b/src/agents/cli-runner/code-mode-skills.ts
@@ -0,0 +1,24 @@
+import path from "node:path";
+import { root as fsRoot } from "../../infra/fs-safe.js";
+import { resolveCodeModeSkills } from "../code-mode-skills.js";
+
+/** Native CLI preparation owns a delivered skill copy, without a live container bridge. */
+export async function resolveMaterializedCliCodeModeSkills(
+  params: Parameters<typeof resolveCodeModeSkills>[0] & { rootDir: string },
+) {
+  const skills = resolveCodeModeSkills(params);
+  if (!skills.length) return skills;
+  const root = await fsRoot(params.rootDir);
+  for (const skill of skills) {
+    // The source is the exact delivered file selected during preparation. The
+    // model-visible location can be a container path, never a host read request.
+    const relativePath = path.relative(params.rootDir, skill.source.filePath);
+    skill.reader = async ({ signal }) => {
+      signal?.throwIfAborted();
+      const result = await root.read(relativePath, { symlinks: "reject", hardlinks: "reject" });
+      signal?.throwIfAborted();
+      return result.buffer.toString("utf8");
+    };
+  }
+  return skills;
+}
