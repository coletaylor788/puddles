index 0000000000000000000000000000000000000000..6eb13f02afadf809062cbee4faa4cd3ffbdb11d7
--- /dev/null
+++ b/src/gateway/mcp-http.code-mode.test.ts
@@ -0,0 +1,150 @@
+import { afterEach, describe, expect, it } from "vitest";
+import {
+  fakeTool,
+  resetCodeModeTestState,
+  resultDetails,
+  testing,
+} from "../agents/code-mode.test-support.js";
+import { createInstalledSkillTools } from "../agents/tools/installed-skill-tools.js";
+import {
+  clearRuntimeConfigSnapshot,
+  setAppliedRuntimeConfigSnapshot,
+} from "../config/runtime-snapshot.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { createMcpCodeModeToolSurface } from "./mcp-http.code-mode.js";
+import { resolveMcpLoopbackScopedTools } from "./mcp-http.runtime.js";
+
+const surfaces: ReturnType<typeof createMcpCodeModeToolSurface>[] = [];
+afterEach(async () => {
+  for (const surface of surfaces.splice(0)) surface.cleanup();
+  clearRuntimeConfigSnapshot();
+  await resetCodeModeTestState();
+});
+
+function surface(policyEnabled: boolean, sessionKey = "agent:main:current") {
+  const config: OpenClawConfig = {
+    agents: {
+      entries: {
+        main: { tools: { codeMode: !policyEnabled } },
+        worker: { tools: { codeMode: policyEnabled } },
+      },
+    },
+    tools: { codeMode: { enabled: true, surface: "additive", executor: "quickjs" } },
+  };
+  const tools = [fakeTool("probe", "Synthetic probe")];
+  const value = createMcpCodeModeToolSurface({
+    config,
+    context: {
+      agentId: "main",
+      sessionKey,
+      sessionId: "current-session",
+      runId: "delegated-run",
+      runtimePolicyAgentId: "worker",
+      runtimePolicySessionKey: "agent:worker:policy",
+      toolsAllow: ["probe"],
+      senderIsOwner: false,
+    },
+    tools,
+    executeTool: async ({ toolName, toolCallId, input, signal, onUpdate }) => {
+      const tool = tools.find((candidate) => candidate.name === toolName);
+      if (!tool) {
+        throw new Error(`Unknown scoped tool: ${toolName}`);
+      }
+      return tool.execute(toolCallId, input, signal, onUpdate);
+    },
+  });
+  surfaces.push(value);
+  return value;
+}
+
+describe("MCP Code Mode delegated policy", () => {
+  it("keeps config-denied skill reads out of direct and scripted surfaces", async () => {
+    const skills = [
+      {
+        name: "manual",
+        description: "Synthetic manual",
+        location: "/fixture/SKILL.md",
+        source: { filePath: "/fixture/SKILL.md", readContent: "Authorized instructions" },
+      },
+    ];
+    const config: OpenClawConfig = {
+      plugins: { enabled: false },
+      tools: {
+        deny: ["skills_read"],
+        codeMode: { enabled: true, surface: "additive", executor: "quickjs" },
+      },
+    };
+    const context = {
+      agentId: "main",
+      sessionKey: "agent:main:skill-denied",
+      sessionId: "skill-denied-session",
+      runId: "skill-denied-run",
+      senderIsOwner: false,
+      toolsAllow: ["skills_search", "skills_read"],
+      codeMode: true,
+    };
+    await setAppliedRuntimeConfigSnapshot(config, config);
+    const scoped = await resolveMcpLoopbackScopedTools({
+      cfg: config,
+      context,
+      bundledTools: createInstalledSkillTools(skills),
+    });
+    expect(scoped.tools.map((tool) => tool.name)).toEqual(["skills_search"]);
+    const value = createMcpCodeModeToolSurface({
+      config,
+      context,
+      tools: scoped.tools,
+      skills,
+      executeTool: async ({ toolName, toolCallId, input, signal, onUpdate }) => {
+        const tool = scoped.tools.find((candidate) => candidate.name === toolName);
+        if (!tool) throw new Error(`Unknown scoped tool: ${toolName}`);
+        return tool.execute(toolCallId, input, signal, onUpdate);
+      },
+    });
+    surfaces.push(value);
+    expect(value.tools.map((tool) => tool.name)).not.toContain("skills_read");
+    const exec = value.tools.find((tool) => tool.name === "code_exec")!;
+    expect(
+      resultDetails(
+        await exec.execute("scripted-denied", {
+          code: 'return await skills.read("manual");',
+        }),
+      ).status,
+    ).toBe("failed");
+  });
+
+  it.each([true, false])(
+    "selects worker policy %s without replacing the current session",
+    (enabled) => {
+      const current = surface(enabled);
+      expect(current.enabled).toBe(enabled);
+      expect(current.tools.some((tool) => tool.name === "code_exec")).toBe(enabled);
+      expect(current.tools.some((tool) => tool.name === "probe")).toBe(true);
+    },
+  );
+
+  it("keeps parked execution bound to the current conversation and joins it on cleanup", async () => {
+    const current = surface(true);
+    const exec = current.tools.find((tool) => tool.name === "code_exec")!;
+    const wait = current.tools.find((tool) => tool.name === "code_wait")!;
+    const parked = resultDetails(
+      await exec.execute("park", {
+        code: 'await yield_control("pause"); return await probe({value:"retained"});',
+      }),
+    );
+    expect(parked.status).toBe("waiting");
+    const runId = parked.runId as string;
+    expect(testing.activeRuns.get(runId)?.ctx.sessionKey).toBe("agent:main:current");
+    const foreign = surface(true, "agent:main:other");
+    await expect(
+      foreign.tools.find((tool) => tool.name === "code_wait")!.execute("foreign", { runId }),
+    ).rejects.toThrow("different session");
+    const completed = resultDetails(await wait.execute("resume", { runId }));
+    expect(completed).toMatchObject({
+      status: "completed",
+      value: { name: "probe", input: { value: "retained" } },
+    });
+    current.cleanup();
+    expect(testing.activeRuns.has(runId)).toBe(false);
+  });
+});
