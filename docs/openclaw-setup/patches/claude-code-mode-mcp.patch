+      abortSignal: params.signal,
+      executeTool: params.executeTool,
+    },
+  });
+  return {
+    tools: surface.tools,
+    enabled: runtime.codeModeControlsEnabled,
+    cleanup: runtime.cleanup,
+  };
+}
