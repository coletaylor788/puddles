@@ -0,0 +1,57 @@
+import { mkdtemp, mkdir, writeFile, rm, symlink } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, expect, it } from "vitest";
+import { readCodeModeSkill } from "../code-mode-skills.js";
+import { resolveMaterializedCliCodeModeSkills } from "./code-mode-skills.js";
+
+const roots: string[] = [];
+afterEach(async () => {
+  await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
+
+it("reads only the delivered skill behind a container-visible catalog location", async () => {
+  const rootDir = await mkdtemp(path.join(tmpdir(), "cli-contained-skills-"));
+  roots.push(rootDir);
+  const baseDir = path.join(rootDir, "manual");
+  const filePath = path.join(baseDir, "SKILL.md");
+  await mkdir(baseDir);
+  await writeFile(filePath, "Delivered instructions");
+  const skills = await resolveMaterializedCliCodeModeSkills({
+    rootDir,
+    skillsPrompt: [
+      "<available_skills>",
+      "  <skill>",
+      "    <name>manual</name>",
+      "    <location>/workspace/skills/manual/SKILL.md</location>",
+      "  </skill>",
+      "</available_skills>",
+    ].join("\n"),
+    candidates: [
+      {
+        name: "manual",
+        description: "Manual",
+        filePath,
+        baseDir,
+        source: "openclaw-workspace",
+        sourceInfo: {
+          path: filePath,
+          source: "openclaw-workspace",
+          scope: "project",
+          origin: "top-level",
+          baseDir,
+        },
+        disableModelInvocation: false,
+      },
+    ],
+  });
+  expect(skills).toHaveLength(1);
+  expect(skills[0]?.location).toBe("/workspace/skills/manual/SKILL.md");
+  await expect(readCodeModeSkill(skills[0]!)).resolves.toBe("Delivered instructions");
+  const outside = await mkdtemp(path.join(tmpdir(), "cli-outside-skills-"));
+  roots.push(outside);
+  await writeFile(path.join(outside, "private"), "Not a delivered instruction");
+  await rm(filePath);
+  await symlink(path.join(outside, "private"), filePath);
+  await expect(readCodeModeSkill(skills[0]!)).rejects.toThrow();
+});
