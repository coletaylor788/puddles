@@ -0,0 +1,55 @@
+import { resolveCodeModeConfig } from "../agents/code-mode-runtime.js";
+import type { CodeModeSkill } from "../agents/code-mode-skills.js";
+import { createAgentHarnessToolSurfaceRuntimeCore } from "../agents/harness/tool-surface-bridge.js";
+import type { ToolSearchCatalogToolExecutor } from "../agents/tool-search-types.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { McpLoopbackRequestContext } from "./mcp-grant-store.js";
+import type { McpLoopbackTool } from "./mcp-http.schema.js";
+
+/** Project the same admitted tool catalog for CLI preparation and MCP execution. */
+export function createMcpCodeModeToolSurface(params: {
+  config: OpenClawConfig;
+  context: McpLoopbackRequestContext;
+  tools: McpLoopbackTool[];
+  executeTool: ToolSearchCatalogToolExecutor;
+  signal?: AbortSignal;
+  skills?: readonly CodeModeSkill[];
+}) {
+  const { context } = params;
+  const runtime = createAgentHarnessToolSurfaceRuntimeCore({
+    config: params.config,
+    agentId: context.runtimePolicyAgentId ?? context.agentId,
+    sessionId: context.sessionId,
+    sessionKey: context.sessionKey,
+    runId: context.runId,
+    modelProvider: context.modelProvider,
+    modelId: context.modelId,
+    modelToolsEnabled: params.tools.length > 0,
+    toolsAllow: context.toolsAllow,
+    codeModeOverride:
+      resolveCodeModeConfig(params.config, context.runtimePolicyAgentId ?? context.agentId)
+        .surface === "additive"
+        ? context.codeMode
+        : false,
+    disableToolSearch: true,
+    supportsDeferredToolCalls: false,
+    executeTool: params.executeTool,
+    abortSignal: params.signal,
+  });
+  // CLI preparation has already applied policy and prompt-hook restrictions.
+  const surface = runtime.compactTools(params.tools, {
+    localModelLeanApplied: true,
+    prepared: {
+      preserveToolNames: params.tools.map((tool) => tool.name),
+      toolExecutionAllow: context.toolsAllow,
+      codeModeSkills: params.skills,
+      abortSignal: params.signal,
+      executeTool: params.executeTool,
+    },
+  });
+  return {
+    tools: surface.tools,
+    enabled: runtime.codeModeControlsEnabled,
+    cleanup: runtime.cleanup,
+  };
+}
