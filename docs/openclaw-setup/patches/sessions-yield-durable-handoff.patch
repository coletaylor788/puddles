index 000000000..65603b17e
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-yield-gather.test.ts
@@ -0,0 +1,238 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { SubagentRegistryWriteError } from "./subagent-registry-persistence.js";
+import { recordYieldGatherHandoff } from "./subagent-registry-yield-gather.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+const mocks = vi.hoisted(() => ({
+  runs: new Map<string, SubagentRunRecord>(),
+  persist: vi.fn(),
+  context: { admission: {} },
+  captureContext: vi.fn(),
+}));
+vi.mock("./subagent-registry-memory.js", () => ({ subagentRuns: mocks.runs }));
+vi.mock("./subagent-registry-state.js", () => ({
+  persistSubagentRunsToDiskAsyncOrThrow: mocks.persist,
+}));
+vi.mock("../../../state/openclaw-state-worker-context.js", () => ({
+  captureOpenClawStateWorkerContext: mocks.captureContext,
+}));
+const handoff = {
+  requesterSessionKey: "agent:main:main",
+  requesterSessionId: "parent",
+  toolCallId: "yield-call",
+};
+function addRun(runId: string) {
+  const run = {
+    runId,
+    expectsCompletionMessage: true,
+    delivery: { status: "pending" },
+  } as SubagentRunRecord;
+  mocks.runs.set(runId, run);
+  return run;
+}
+describe("durable yield handoff worker commit", () => {
+  beforeEach(() => {
+    mocks.runs.clear();
+    mocks.persist.mockReset();
+    mocks.captureContext.mockReset().mockReturnValue(mocks.context);
+  });
+  it("commits the entire batch before publishing handoff ownership", async () => {
+    const runs = [addRun("first"), addRun("second")];
+    mocks.persist.mockImplementation(async (snapshot, runIds, options) => {
+      expect(runIds).toEqual(["first", "second"]);
+      for (const run of runs) {
+        expect(run.delivery?.yieldGatherHandoff).toBeUndefined();
+        expect(snapshot.get(run.runId).delivery.yieldGatherHandoff).toEqual(handoff);
+      }
+      options.assertCurrent();
+      options.onCommitted();
+    });
+    await recordYieldGatherHandoff(["first", "second"], handoff);
+    expect(runs.map((run) => run.delivery?.yieldGatherHandoff)).toEqual([handoff, handoff]);
+  });
+  it("leaves every live record retryable when the worker rejects the write", async () => {
+    const runs = [addRun("first"), addRun("second")];
+    mocks.persist.mockRejectedValue(new Error("disk full"));
+    await expect(recordYieldGatherHandoff(["first", "second"], handoff)).rejects.toThrow(
+      "disk full",
+    );
+    expect(runs.every((run) => run.delivery?.yieldGatherHandoff === undefined)).toBe(true);
+  });
+  it("rejects a changed completion before committing and preserves the new state", async () => {
+    const run = addRun("first");
+    mocks.persist.mockImplementation(async (_snapshot, _runIds, options) => {
+      run.delivery!.status = "discarded";
+      options.assertCurrent();
+    });
+    await expect(recordYieldGatherHandoff(["first"], handoff)).rejects.toThrow(
+      "completion changed",
+    );
+    expect(run.delivery).toEqual({ status: "discarded" });
+  });
+
+  it("recaptures cleanup-only conflicts and persists the fresh markers for the whole batch", async () => {
+    const runs = [addRun("first"), addRun("second")];
+    let attempt = 0;
+    let persisted: Map<string, SubagentRunRecord> | undefined;
+    mocks.persist.mockImplementation(async (snapshot, _runIds, options) => {
+      expect(options.context).toBe(mocks.context);
+      expect(runs.every((run) => run.delivery?.yieldGatherHandoff === undefined)).toBe(true);
+      if (attempt < runs.length) {
+        runs[attempt].browserCleanupDispatchedAt = 100 + attempt;
+        attempt += 1;
+        try {
+          options.assertCurrent();
+        } catch (error) {
+          throw new SubagentRegistryWriteError("not-committed", error);
+        }
+        throw new Error("Full-record CAS unexpectedly accepted cleanup progress");
+      }
+      options.assertCurrent();
+      persisted = structuredClone(snapshot);
+      options.onCommitted();
+    });
+    await recordYieldGatherHandoff(["first", "second"], handoff);
+    expect(mocks.persist).toHaveBeenCalledTimes(3);
+    expect(mocks.captureContext).toHaveBeenCalledTimes(1);
+    for (const [index, run] of runs.entries()) {
+      expect(persisted?.get(run.runId)?.browserCleanupDispatchedAt).toBe(100 + index);
+      expect(persisted?.get(run.runId)?.delivery?.yieldGatherHandoff).toEqual(handoff);
+      expect(run.delivery?.yieldGatherHandoff).toEqual(handoff);
+    }
+  });
+
+  it("publishes an acknowledged handoff once while retaining post-admission cleanup progress", async () => {
+    const run = addRun("first");
+    mocks.persist.mockImplementation(async (snapshot, _runIds, options) => {
+      options.assertCurrent();
+      const committed = structuredClone(snapshot);
+      run.browserCleanupDispatchedAt = 100;
+      options.onCommitted();
+      expect(snapshot).toEqual(committed);
+      expect(snapshot.get(run.runId).browserCleanupDispatchedAt).toBeUndefined();
+      expect(snapshot.get(run.runId).delivery.yieldGatherHandoff).toEqual(handoff);
+    });
+    await recordYieldGatherHandoff(["first"], handoff);
+    expect(mocks.persist).toHaveBeenCalledTimes(1);
+    expect(run.browserCleanupDispatchedAt).toBe(100);
+    expect(run.delivery?.yieldGatherHandoff).toEqual(handoff);
+  });
+
+  for (const [name, mutate] of [
+    [
+      "delivery",
+      (run: SubagentRunRecord) => {
+        run.delivery!.status = "discarded";
+      },
+    ],
+    [
+      "generation",
+      (run: SubagentRunRecord) => {
+        run.generation = 2;
+      },
+    ],
+    [
+      "requester",
+      (run: SubagentRunRecord) => {
+        run.requesterSessionKey = "agent:other:main";
+      },
+    ],
+    [
+      "entry replacement",
+      (run: SubagentRunRecord) => {
+        mocks.runs.set(run.runId, structuredClone(run));
+      },
+    ],
+    [
+      "entry removal",
+      (run: SubagentRunRecord) => {
+        mocks.runs.delete(run.runId);
+      },
+    ],
+  ] as const) {
+    it(`retains the complete batch guard when cleanup also changes ${name}`, async () => {
+      const runs = [addRun("first"), addRun("second")];
+      mocks.persist.mockImplementation(async (_snapshot, _runIds, options) => {
+        runs[0].browserCleanupDispatchedAt = 100;
+        mutate(runs[1]);
+        try {
+          options.assertCurrent();
+        } catch (error) {
+          throw new SubagentRegistryWriteError("not-committed", error);
+        }
+      });
+      await expect(recordYieldGatherHandoff(["first", "second"], handoff)).rejects.toThrow(
+        "Queued subagent registry persistence failed",
+      );
+      expect(mocks.persist).toHaveBeenCalledTimes(1);
+      expect(runs.every((run) => run.delivery?.yieldGatherHandoff === undefined)).toBe(true);
+    });
+
+    it(`refuses postcommit ${name} changes without partially publishing`, async () => {
+      const runs = [addRun("first"), addRun("second")];
+      mocks.persist.mockImplementation(async (_snapshot, _runIds, options) => {
+        options.assertCurrent();
+        runs[0].browserCleanupDispatchedAt = 100;
+        mutate(runs[1]);
+        try {
+          options.onCommitted();
+        } catch (error) {
+          throw new SubagentRegistryWriteError("committed", error);
+        }
+      });
+      await expect(recordYieldGatherHandoff(["first", "second"], handoff)).rejects.toThrow(
+        "Queued subagent registry persistence failed",
+      );
+      expect(mocks.persist).toHaveBeenCalledTimes(1);
+      expect(runs.every((run) => run.delivery?.yieldGatherHandoff === undefined)).toBe(true);
+    });
+  }
+
+  for (const outcome of ["unknown", "committed"] as const) {
+    it(`never retries a ${outcome} write even when cleanup is the only change`, async () => {
+      const run = addRun("first");
+      const error = new SubagentRegistryWriteError(outcome, new Error("lost response"));
+      mocks.persist.mockImplementation(async () => {
+        run.browserCleanupDispatchedAt = 100;
+        throw error;
+      });
+      await expect(recordYieldGatherHandoff(["first"], handoff)).rejects.toBe(error);
+      expect(mocks.persist).toHaveBeenCalledTimes(1);
+      expect(run.delivery?.yieldGatherHandoff).toBeUndefined();
+    });
+  }
+
+  for (const timestamp of [0, -1, 1.5, NaN, Infinity]) {
+    it(`refuses invalid cleanup progression ${timestamp}`, async () => {
+      const run = addRun("first");
+      const error = new SubagentRegistryWriteError("not-committed", new Error("CAS failed"));
+      mocks.persist.mockImplementation(async () => {
+        run.browserCleanupDispatchedAt = timestamp;
+        throw error;
+      });
+      await expect(recordYieldGatherHandoff(["first"], handoff)).rejects.toBe(error);
+      expect(mocks.persist).toHaveBeenCalledTimes(1);
+    });
+  }
+
+  it("bounds retries to one cleanup transition per row and preserves the final failure", async () => {
+    const run = addRun("first");
+    const error = new SubagentRegistryWriteError("not-committed", new Error("CAS failed"));
+    mocks.persist.mockImplementation(async () => {
+      run.browserCleanupDispatchedAt = (run.browserCleanupDispatchedAt ?? 99) + 1;
+      throw error;
+    });
+    await expect(recordYieldGatherHandoff(["first"], handoff)).rejects.toBe(error);
+    expect(mocks.persist).toHaveBeenCalledTimes(2);
+    expect(run.browserCleanupDispatchedAt).toBe(101);
+    expect(run.delivery?.yieldGatherHandoff).toBeUndefined();
+  });
+
+  it("does not retry a known rejected write without cleanup progress", async () => {
+    addRun("first");
+    const error = new SubagentRegistryWriteError("not-committed", new Error("disk full"));
+    mocks.persist.mockRejectedValue(error);
+    await expect(recordYieldGatherHandoff(["first"], handoff)).rejects.toBe(error);
+    expect(mocks.persist).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/src/agents/subagents/registry/subagent-registry-yield-gather.ts b/src/agents/subagents/registry/subagent-registry-yield-gather.ts
new file mode 100644
index 000000000..5eb5eba23
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-yield-gather.ts
@@ -0,0 +1,95 @@
+import { isDeepStrictEqual } from "node:util";
+import { captureOpenClawStateWorkerContext } from "../../../state/openclaw-state-worker-context.js";
+import { subagentRuns } from "./subagent-registry-memory.js";
+import { SubagentRegistryWriteError } from "./subagent-registry-persistence.js";
+import type { SubagentCompletionDeliveryState } from "./subagent-registry-read.types.js";
+import { persistSubagentRunsToDiskAsyncOrThrow } from "./subagent-registry-state.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+type YieldGatherHandoff = NonNullable<SubagentCompletionDeliveryState["yieldGatherHandoff"]>;
+
+function onlyBrowserCleanupAdvanced(entry: SubagentRunRecord, before: SubagentRunRecord): boolean {
+  const { browserCleanupDispatchedAt: currentCleanup, ...currentFields } = entry;
+  const { browserCleanupDispatchedAt: previousCleanup, ...previousFields } = before;
+  return (
+    previousCleanup === undefined &&
+    typeof currentCleanup === "number" &&
+    Number.isSafeInteger(currentCleanup) &&
+    currentCleanup > 0 &&
+    isDeepStrictEqual(currentFields, previousFields)
+  );
+}
+
+/** Publishes gather ownership only after the registry worker commits the whole batch. */
+export async function recordYieldGatherHandoff(
+  runIds: readonly string[],
+  handoff: YieldGatherHandoff,
+): Promise<void> {
+  if (runIds.length === 0) return;
+  const context = captureOpenClawStateWorkerContext();
+  let records = runIds.map((runId) => {
+    const entry = subagentRuns.get(runId);
+    if (!entry?.delivery || entry.expectsCompletionMessage !== true) {
+      throw new Error(`Cannot persist sessions_yield handoff for run ${runId}`);
+    }
+    return { entry, before: structuredClone(entry) };
+  });
+  // Each row can acquire its cleanup marker once. Keep retries bounded by that
+  // monotonic transition, with the original database admission throughout.
+  let retriesRemaining = new Set(runIds).size;
+  while (true) {
+    const snapshot = new Map(
+      records.map(({ entry, before }) => {
+        const captured = structuredClone(before);
+        captured.delivery!.yieldGatherHandoff = structuredClone(handoff);
+        return [entry.runId, captured];
+      }),
+    );
+    const assertCurrent = (allowCleanupProgress = false) => {
+      for (const { entry, before } of records) {
+        if (
+          subagentRuns.get(entry.runId) !== entry ||
+          (!isDeepStrictEqual(entry, before) &&
+            !(allowCleanupProgress && onlyBrowserCleanupAdvanced(entry, before)))
+        ) {
+          throw new Error(
+            `sessions_yield completion changed before handoff for run ${entry.runId}`,
+          );
+        }
+      }
+    };
+    try {
+      await persistSubagentRunsToDiskAsyncOrThrow(snapshot, runIds, {
+        context,
+        assertCurrent,
+        onCommitted: () => {
+          // The write already committed. Publish only its handoff, retaining a
+          // cleanup marker acquired since admission without rewriting the row.
+          assertCurrent(true);
+          for (const { entry } of records) {
+            entry.delivery!.yieldGatherHandoff = structuredClone(handoff);
+          }
+        },
+      });
+      return;
+    } catch (error) {
+      if (
+        !(error instanceof SubagentRegistryWriteError) ||
+        error.outcome !== "not-committed" ||
+        retriesRemaining === 0 ||
+        !records.some(({ entry, before }) => onlyBrowserCleanupAdvanced(entry, before))
+      ) {
+        throw error;
+      }
+      // A cleanup-only conflict can be recaptured. Any replacement, delivery,
+      // generation, or other change retains the original full-record refusal.
+      try {
+        assertCurrent(true);
+      } catch {
+        throw error;
+      }
+      retriesRemaining -= 1;
+      records = records.map(({ entry }) => ({ entry, before: structuredClone(entry) }));
+    }
+  }
+}
