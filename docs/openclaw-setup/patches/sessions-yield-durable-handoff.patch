diff --git a/src/agents/subagents/registry/subagent-registry-yield-gather.ts b/src/agents/subagents/registry/subagent-registry-yield-gather.ts
new file mode 100644
index 00000000000..f73917442ed
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-yield-gather.ts
@@ -0,0 +1,31 @@
+import { subagentRuns } from "./subagent-registry-memory.js";
+import { persistSubagentRunsToDiskOrThrow } from "./subagent-registry-state.js";
+import type { SubagentCompletionDeliveryState } from "./subagent-registry.types.js";
+
+type YieldGatherHandoff = NonNullable<SubagentCompletionDeliveryState["yieldGatherHandoff"]>;
+
+/** Persists gather ownership before sessions_yield can commit its visible tool result. */
+export function recordYieldGatherHandoff(runIds: readonly string[], handoff: YieldGatherHandoff) {
+  const records = runIds.map((runId) => {
+    const entry = subagentRuns.get(runId);
+    if (!entry?.delivery || entry.expectsCompletionMessage !== true) {
+      throw new Error(`Cannot persist sessions_yield handoff for run ${runId}`);
+    }
+    return { entry, delivery: entry.delivery };
+  });
+  const previous = records.map(({ delivery }) => structuredClone(delivery));
+  for (const { delivery } of records) {
+    delivery.yieldGatherHandoff = structuredClone(handoff);
+  }
+  try {
+    persistSubagentRunsToDiskOrThrow(
+      subagentRuns,
+      records.map(({ entry }) => entry.runId),
+    );
+  } catch (error) {
+    records.forEach(({ entry }, index) => {
+      entry.delivery = previous[index];
+    });
+    throw error;
+  }
+}
