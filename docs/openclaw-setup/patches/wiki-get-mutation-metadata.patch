@@ -2,13 +2,111 @@ import fs from "node:fs/promises";
 import path from "node:path";
 import { describe, expect, it } from "vitest";
 import { lintMemoryWikiVault } from "./lint.js";
-import { parseWikiMarkdown } from "./markdown.js";
+import { parseWikiMarkdown, renderWikiMarkdown } from "./markdown.js";
 import { createMemoryWikiTestHarness } from "./test-helpers.js";
-import { createWikiApplyTool, createWikiLintTool } from "./tool.js";
+import { createWikiApplyTool, createWikiGetTool, createWikiLintTool } from "./tool.js";
 
 describe("memory-wiki tools", () => {
   const harness = createMemoryWikiTestHarness();
 
+  it("exposes complete metadata in model-visible text for a preserving synthesis update", async () => {
+    const { rootDir, config } = await harness.createVault({
+      initialize: true,
+      config: { search: { backend: "local", corpus: "wiki" } },
+    });
+    const metadata = {
+      sourceIds: ["source.legacy", "source.bridge"],
+      claims: [
+        {
+          id: "claim.alpha",
+          text: "Alpha fact",
+          status: "supported",
+          confidence: 0.9,
+          updatedAt: "2026-01-01T00:00:00.000Z",
+          evidence: [
+            {
+              kind: "note",
+              sourceId: "source.legacy",
+              path: "memory/alpha.md",
+              lines: "2-4",
+              weight: 1,
+              confidence: 0.8,
+              privacyTier: "private",
+              note: "Original evidence",
+              updatedAt: "2026-01-01T00:00:00.000Z",
+            },
+          ],
+        },
+        { id: "claim.beta", text: "Another fact", evidence: [{ sourceId: "source.bridge" }] },
+      ],
+      contradictions: ["Unresolved conflict"],
+      questions: ["Unanswered question"],
+      confidence: 0.7,
+      status: "review",
+    };
+    const pagePath = path.join(rootDir, "syntheses", "alpha.md");
+    await fs.writeFile(
+      pagePath,
+      renderWikiMarkdown({
+        frontmatter: { pageType: "synthesis", id: "synthesis.alpha", title: "Alpha", ...metadata },
+        body: "# Alpha\n\nOriginal summary.\n",
+      }),
+    );
+    const get = createWikiGetTool(config);
+    const result = await get.execute("read-metadata", {
+      lookup: "synthesis.alpha",
+      includeMetadata: true,
+      lineCount: 1,
+    });
+    const text = result.content.find((part) => part.type === "text")?.text ?? "";
+    const snapshot = JSON.parse(text);
+    expect(snapshot.metadata).toEqual(metadata);
+    expect(snapshot.truncated).toBe(true);
+    expect(snapshot.content.split("\n")).toHaveLength(1);
+    // Body-only callers keep their existing model-visible format.
+    const plain = await get.execute("read-body", { lookup: "synthesis.alpha", lineCount: 1 });
+    expect(plain.content.find((part) => part.type === "text")?.text).toBe(snapshot.content);
+    await createWikiApplyTool(config).execute("update-summary", {
+      op: "create_synthesis",
+      title: "Alpha",
+      body: "Updated summary.",
+      ...snapshot.metadata,
+    });
+    const updated = parseWikiMarkdown(await fs.readFile(pagePath, "utf8"));
+    expect(updated.frontmatter).toMatchObject(metadata);
+    expect(updated.frontmatter.id).toBe("synthesis.alpha");
+    expect(updated.body).toContain("Updated summary.");
+  });
+
+  it("does not expose metadata from an unreadable bridge source", async () => {
+    const { rootDir, config } = await harness.createVault({
+      initialize: true,
+      config: { vault: { scope: "global" }, search: { backend: "local", corpus: "wiki" } },
+    });
+    await fs.writeFile(
+      path.join(rootDir, "sources", "foreign.md"),
+      renderWikiMarkdown({
+        frontmatter: {
+          pageType: "source",
+          id: "source.foreign",
+          title: "Foreign",
+          sourceType: "memory-bridge",
+          bridgeAgentIds: ["other"],
+          sourceIds: ["private-evidence"],
+          claims: [{ text: "Private claim" }],
+        },
+        body: "Private body.",
+      }),
+    );
+    const result = await createWikiGetTool(config, undefined, {
+      agentId: "main",
+      sandboxed: true,
+    }).execute("denied", { lookup: "sources/foreign.md", includeMetadata: true });
+    expect(result.details).toEqual({ found: false });
+    expect(JSON.stringify(result)).not.toContain("private-evidence");
+    expect(JSON.stringify(result)).not.toContain("Private claim");
+  });
+
   it("rejects non-object wiki_apply arguments without throwing a TypeError", async () => {
     const { config } = await harness.createVault({ initialize: true });
     const tool = createWikiApplyTool(config);
