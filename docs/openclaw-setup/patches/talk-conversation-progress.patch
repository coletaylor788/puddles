+import { describe, expect, it, vi } from "vitest";
+import { buildOpenAIQuicksilverInstructions } from "./realtime-quicksilver-instructions.js";
+import { buildOpenAIQuicksilverSession } from "./realtime-quicksilver-wire.js";
+import {
+  createDelegationHarness,
+  FakeSocket,
+  parseSent,
+  type ConsultRunner,
+} from "./realtime-quicksilver.test-helpers.js";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+describe("Live conversation during backend work", () => {
+  it("supplies direct conversation and truthful delegation guidance with the operator profile", () => {
+    const instructions = buildOpenAIQuicksilverSession({
+      model: "gpt-live-1",
+      hostControlsInput: true,
+      instructions: buildOpenAIQuicksilverInstructions("gpt-live-1", "Speak warmly."),
+    }).instructions;
+    expect(instructions).toContain("Answer directly from the current conversation");
+    expect(instructions).toContain("lightweight brainstorming");
+    expect(instructions).toContain(
+      "Delegate requests needing unavailable or current facts, tools, actions, or careful reasoning",
+    );
+    expect(instructions).toContain("Do not invent results, progress, or completion");
+    expect(instructions).toContain("session.thinking.append is silent context");
+    expect(instructions).not.toContain("Delegate each user request once and wait");
+    expect(instructions).toContain("Speak warmly.");
+    expect(instructions).toContain(
+      "Ordinary conversational follow-ups, clarification, and brainstorming from available context do not require host control",
+    );
+    expect(instructions).not.toContain("before answering each new request");
+  });
+
+  it.each(["accepted", "rejected"] as const)(
+    "routes context after %s steering",
+    async (outcome) => {
+      const work = deferred<{ text: string }>();
+      const steering = deferred<{ text: string }>();
+      const runAgentConsult = vi.fn<ConsultRunner>(async () => work.promise);
+      const steer = vi.fn(async () => {
+        await steering.promise;
+        if (outcome === "rejected")
+          throw Object.assign(new Error("unsupported"), { code: "TALK_STEERING_UNSUPPORTED" });
+        return { text: "" };
+      });
+      const h = createDelegationHarness({
+        model: "gpt-live-1",
+        runAgentConsult,
+        steerAgentConsult: steer,
+      });
+      const request = (id: string, text: string, offset: number) => {
+        h.controller.handleFrame(
+          Buffer.from(
+            JSON.stringify({
+              type: "session.input_transcript.delta",
+              delta: text,
+              start_ms: offset,
+              end_ms: offset + 100,
+            }),
+          ),
+          false,
+        );
+        h.controller.handleFrame(
+          Buffer.from(
+            JSON.stringify({
+              type: "session.delegation.created",
+              offset_ms: offset + 100,
+              delegation: { id, type: "delegation", target: "client" },
+            }),
+          ),
+          false,
+        );
+      };
+      request("original", "Research this", 0);
+      await vi.waitFor(() => expect(runAgentConsult).toHaveBeenCalledOnce());
+      const progress = runAgentConsult.mock.calls[0]![0].onProgress!;
+      request("followup", "Focus on alternatives", 200);
+      await vi.waitFor(() => expect(steer).toHaveBeenCalledOnce());
+      progress("Ambiguous during steering");
+      expect(parseSent(h.socket).filter((e) => e.type === "session.thinking.append")).toEqual([]);
+      steering.resolve({ text: "" });
+      await new Promise((resolve) => setTimeout(resolve, 0));
+      progress("Updated research context");
+      expect(parseSent(h.socket)).toContainEqual({
+        type: "session.thinking.append",
+        delegation_id: outcome === "accepted" ? "followup" : "original",
+        content: "Updated research context",
+      });
+      work.resolve({ text: "done" });
+      h.controller.stop(new Error("test complete"));
+      await work.promise;
+    },
+  );
+
+  it.each(["complete", "yield", "cancel", "detach", "socket-replaced"] as const)(
+    "keeps progress silent and fences it after %s",
+    async (ending) => {
+      const work = deferred<{ text: string; yielded?: true }>();
+      const runAgentConsult = vi.fn<ConsultRunner>(async () => work.promise);
+      let currentSocket!: FakeSocket;
+      const h = createDelegationHarness({
+        model: "gpt-live-1",
+        runAgentConsult,
+        getSocket: () => currentSocket,
+      });
+      currentSocket = h.socket;
+      h.controller.handleFrame(
+        Buffer.from(
+          JSON.stringify({
+            type: "session.input_transcript.delta",
+            delta: "Research this",
+            start_ms: 0,
+            end_ms: 200,
+          }),
+        ),
+        false,
+      );
+      h.controller.handleFrame(
+        Buffer.from(
+          JSON.stringify({
+            type: "session.delegation.created",
+            offset_ms: 200,
+            delegation: { id: "research", type: "delegation", target: "client" },
+          }),
+        ),
+        false,
+      );
+      await vi.waitFor(() => expect(runAgentConsult).toHaveBeenCalledOnce());
+      const progress = runAgentConsult.mock.calls[0]![0].onProgress!;
+      progress("Public research is underway. Existing notes identify two options.");
+      expect(parseSent(h.socket)).toEqual([
+        {
+          type: "session.thinking.append",
+          delegation_id: "research",
+          content: "Public research is underway. Existing notes identify two options.",
+        },
+      ]);
+      h.controller.handleEvent({
+        kind: "transcript-done",
+        role: "user",
+        text: "Let's discuss those options",
+      });
+      expect(runAgentConsult).toHaveBeenCalledOnce();
+      if (ending === "cancel") h.sessionController.abort();
+      if (ending === "detach") h.controller.detach();
+      if (ending === "socket-replaced") {
+        currentSocket = new FakeSocket("manual");
+        currentSocket.readyState = 1;
+      }
+      if (ending === "complete" || ending === "yield") {
+        work.resolve({ text: "Useful result", ...(ending === "yield" ? { yielded: true } : {}) });
+        await vi.waitFor(() =>
+          expect(parseSent(h.socket)).toContainEqual({
+            type: "session.commentary.append",
+            delegation_id: "research",
+            content: "Useful result",
+          }),
+        );
+      }
+      const count = h.socket.sent.length;
+      progress("Late progress must not reach any call");
+      expect(h.socket.sent).toHaveLength(count);
+      if (ending === "socket-replaced") expect(currentSocket!.sent).toHaveLength(0);
+      work.resolve({ text: "done" });
+      h.controller.stop(new Error("test complete"));
+      await work.promise;
+    },
+  );
+});
