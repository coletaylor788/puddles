+            delegation_id: "research",
+            content: "Research complete.",
+          }),
+        );
+      } finally {
+        backend.resolve();
+        h.controller.stop(new Error("test complete"));
+        clientVoiceSessionTesting.reset();
+      }
+    });
+  });
+});
