index 0000000000..0a7de0e373
--- /dev/null
+++ b/src/agents/yield-descendant-gather.ts
@@ -0,0 +1,117 @@
+import type { OpenClawConfig } from "../config/config.js";
+import { readDescendantSubagentFallbackReply } from "../cron/isolated-agent/subagent-followup.js";
+import { waitForAgentRunsToDrain } from "./run-wait.js";
+import { resolveSubagentController } from "./subagent-control.js";
+import { listDescendantRunsForRequester } from "./subagent-registry-read.js";
+import { resolveRequesterStoreKey } from "./subagent-requester-store-key.js";
+import {
+  clearYieldGathering,
+  markYieldGathered,
+  markYieldGathering,
+} from "./tools/yield-gather-state.js";
+
+export type YieldDescendantGatherResult = {
+  /** True when the caller had active descendant subagents that we waited on. */
+  active: boolean;
+  /** Combined subagent replies (joined) when any usable content was read. */
+  results?: string;
+};
+
+/**
+ * Block the yielding turn in-place until the caller's descendant subagents drain,
+ * then read their combined replies. Keeping the turn ACTIVE (rather than ending it
+ * and re-waking) is the deterministic single-writer path: the orchestrator never
+ * goes inactive, so there is no announce/steer race and no fresh-session rotation.
+ *
+ * While waiting, the requester's announce delivery is SUPPRESSED (yield-gather
+ * flag) so a descendant completion can't steer/deliver its raw text — this turn
+ * owns the single synthesis. The flag is keyed by the descendants' own
+ * requesterSessionKey passed through `resolveRequesterStoreKey`, i.e. the exact
+ * key the announce path canonicalizes, so suppression cannot miss on key drift.
+ */
+export async function gatherYieldDescendants(params: {
+  cfg: OpenClawConfig;
+  agentSessionKey?: string;
+  timeoutMs?: number;
+}): Promise<YieldDescendantGatherResult> {
+  const suppressionKeys = new Set<string>();
+  // Bulletproof: a throw anywhere inside MUST NOT break sessions_yield (that
+  // would strand the orchestrator mid-turn, spamming "tool broken" and leaking
+  // interim text). Any failure degrades to a normal yield (active: false) and
+  // always clears the suppression flag.
+  try {
+    let requesterKey: string | undefined;
+    try {
+      requesterKey = resolveSubagentController({
+        cfg: params.cfg,
+        agentSessionKey: params.agentSessionKey,
+      }).controllerSessionKey;
+    } catch {
+      requesterKey = params.agentSessionKey;
+    }
+    if (!requesterKey) {
+      return { active: false };
+    }
+
+    const activeRuns = listDescendantRunsForRequester(requesterKey).filter(
+      (entry) => typeof entry.endedAt !== "number",
+    );
+    if (activeRuns.length === 0) {
+      return { active: false };
+    }
+
+    // Mark every key the announce path might canonicalize to, so suppression is
+    // exact regardless of which session-key spelling a descendant recorded.
+    suppressionKeys.add(resolveRequesterStoreKey(params.cfg, requesterKey));
+    for (const entry of activeRuns) {
+      const canonical = resolveRequesterStoreKey(params.cfg, entry.requesterSessionKey);
+      if (canonical) {
+        suppressionKeys.add(canonical);
+      }
+    }
+
+    const runStartedFloor =
+      Math.min(...activeRuns.map((entry) => entry.createdAt ?? Date.now())) - 1;
+
+    for (const key of suppressionKeys) {
+      markYieldGathering(key);
+    }
+    const deadlineAtMs = Date.now() + Math.max(1_000, params.timeoutMs ?? 300_000);
+    await waitForAgentRunsToDrain({
+      deadlineAtMs,
+      initialPendingRunIds: activeRuns.map((entry) => entry.runId),
+      getPendingRunIds: () =>
+        listDescendantRunsForRequester(requesterKey!)
+          .filter((entry) => typeof entry.endedAt !== "number")
+          .map((entry) => entry.runId),
+    });
+    // Mark every descendant we waited on as gathered. Its result is now part of
+    // this turn's synthesis, so its completion announce — which can fire seconds
+    // AFTER this gather clears the requester flag — must stay suppressed, else it
+    // delivers the raw subagent text as a late leak.
+    for (const entry of listDescendantRunsForRequester(requesterKey)) {
+      if (entry.childSessionKey && (entry.endedAt ?? 0) >= runStartedFloor) {
+        markYieldGathered(entry.childSessionKey);
+      }
+    }
+    let results: string | undefined;
+    try {
+      results = await readDescendantSubagentFallbackReply({
+        sessionKey: requesterKey,
+        runStartedAt: runStartedFloor,
+      });
+    } catch {
+      results = undefined;
+    }
+    return { active: true, results: results?.trim() || undefined };
+  } catch {
+    // Descendants were active but something downstream failed: keep the turn
+    // active (active: true) with no results rather than ending it, so main can
+    // recover via its own tools instead of going inactive and leaking.
+    return { active: suppressionKeys.size > 0, results: undefined };
+  } finally {
+    for (const key of suppressionKeys) {
+      clearYieldGathering(key);
+    }
+  }
+}
