+import { readDescendantSubagentFallbackReply } from "../cron/isolated-agent/subagent-followup.js";
+import { waitForAgentRunsToDrain } from "./run-wait.js";
+import { listDescendantRunsForRequester } from "./subagents/registry/subagent-registry-read.js";
+import {
+  clearYieldGathering,
+  markYieldGathered,
+  markYieldGathering,
+} from "./tools/yield-gather-state.js";
+
+export type YieldDescendantGatherResult = {
+  active: boolean;
+  timedOut?: boolean;
+  results?: string;
+  gatheredRunIds?: string[];
+};
+
+export async function gatherYieldDescendants(params: {
+  agentSessionKey?: string;
+  requesterAgentId?: string;
+  requesterSessionId?: string;
+  requesterTurnRunId?: string;
+  toolCallId: string;
+  timeoutMs?: number;
+}): Promise<YieldDescendantGatherResult> {
+  const requesterKey = params.agentSessionKey?.trim();
+  if (!requesterKey) return { active: false };
+  if (!params.requesterSessionId || !params.toolCallId) {
+    throw new Error("Blocking gather requires a requester session and tool call identity");
+  }
+  const scopedRuns = () => {
+    const all = listDescendantRunsForRequester(requesterKey);
+    const allowed = new Set<string>([requesterKey]);
+    const selected: typeof all = [];
+    for (let changed = true; changed;) {
+      changed = false;
+      for (const entry of all) {
+        if (
+          !entry.childSessionKey ||
+          entry.collect ||
+          entry.expectsCompletionMessage !== true ||
+          !allowed.has(entry.requesterSessionKey) ||
+          selected.includes(entry)
+        )
+          continue;
+        if (
+          entry.requesterSessionKey === requesterKey &&
+          ((params.requesterAgentId && entry.requesterAgentId !== params.requesterAgentId) ||
+            (params.requesterTurnRunId && entry.requesterTurnRunId !== params.requesterTurnRunId))
+        )
+          continue;
+        selected.push(entry);
+        allowed.add(entry.childSessionKey);
+        changed = true;
+      }
+    }
+    return selected;
+  };
+  const activeRuns = scopedRuns().filter((entry) => typeof entry.execution.endedAt !== "number");
+  if (!activeRuns.length) return { active: false };
+  const suppressionKeys = new Set<string>();
+  const markSuppressed = () => {
+    for (const entry of scopedRuns()) {
+      const key = entry.runId;
+      suppressionKeys.add(key);
+      markYieldGathering(key);
+    }
+  };
+  try {
+    markSuppressed();
+    const runStartedAt = Math.min(...activeRuns.map((entry) => entry.createdAt)) - 1;
+    const drained = await waitForAgentRunsToDrain({
+      deadlineAtMs: Date.now() + Math.max(1_000, params.timeoutMs ?? 300_000),
+      initialPendingRunIds: activeRuns.map((entry) => entry.runId),
+      getPendingRunIds: () => {
+        markSuppressed();
+        return scopedRuns()
+          .filter((entry) => typeof entry.execution.endedAt !== "number")
+          .map((entry) => entry.runId);
+      },
+    });
+    const completed = scopedRuns().filter(
+      (entry) =>
+        typeof entry.execution.endedAt === "number" && entry.execution.endedAt >= runStartedAt,
+    );
+    const results = await readDescendantSubagentFallbackReply({
+      sessionKey: requesterKey,
+      runStartedAt,
+      runIds: new Set(completed.map((entry) => entry.runId)),
+    });
+    const gatheredRunIds = completed.map((entry) => entry.runId);
+    for (const runId of gatheredRunIds) {
+      markYieldGathered(runId, {
+        requesterSessionKey: requesterKey,
+        requesterSessionId: params.requesterSessionId,
+        requesterAgentId: params.requesterAgentId,
+        toolCallId: params.toolCallId,
+      });
+    }
+    return {
+      active: true,
+      timedOut: drained.timedOut,
+      results: results?.trim() || undefined,
+      gatheredRunIds,
+    };
+  } finally {
+    for (const key of suppressionKeys) clearYieldGathering(key);
+  }
+}
