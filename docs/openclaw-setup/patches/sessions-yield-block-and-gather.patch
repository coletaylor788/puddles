@@ -0,0 +1,103 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { gatherYieldDescendants } from "../yield-descendant-gather.js";
+import { isYieldGathered, isYieldGathering } from "./yield-gather-state.js";
+
+const mocks = vi.hoisted(() => ({ list: vi.fn(), wait: vi.fn(), read: vi.fn() }));
+vi.mock("../subagents/registry/subagent-registry-read.js", () => ({
+  listDescendantRunsForRequester: mocks.list,
+}));
+vi.mock("../run-wait.js", () => ({ waitForAgentRunsToDrain: mocks.wait }));
+vi.mock("../../cron/isolated-agent/subagent-followup.js", () => ({
+  readDescendantSubagentFallbackReply: mocks.read,
+}));
+let sequence = 0;
+function run(overrides: Record<string, unknown> = {}) {
+  const id = `gather-regression-${++sequence}`;
+  return {
+    runId: id,
+    childSessionKey: `agent:worker:subagent:${id}`,
+    requesterSessionKey: "agent:main:main",
+    requesterAgentId: "main",
+    requesterTurnRunId: "current-turn",
+    createdAt: 100,
+    execution: { endedAt: undefined as number | undefined },
+    ...overrides,
+  };
+}
+const params = {
+  agentSessionKey: "agent:main:main",
+  requesterAgentId: "main",
+  requesterTurnRunId: "current-turn",
+};
+
+describe("blocking gather on current registry records", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.read.mockResolvedValue("frozen child result");
+  });
+
+  it("drains owned announced children and excludes other turns, agents and collectors", async () => {
+    const owned = run();
+    const nested = run({ requesterSessionKey: owned.childSessionKey, requesterAgentId: "worker" });
+    const excluded = [
+      run({ requesterTurnRunId: "old-turn" }),
+      run({ requesterAgentId: "different-agent" }),
+      run({ collect: true }),
+    ];
+    mocks.list.mockReturnValue([nested, owned, ...excluded]);
+    mocks.wait.mockImplementation(async ({ initialPendingRunIds, getPendingRunIds }) => {
+      expect(new Set(initialPendingRunIds)).toEqual(new Set([owned.runId, nested.runId]));
+      expect(isYieldGathering(owned.runId)).toBe(true);
+      expect(isYieldGathering(excluded[0]!.runId)).toBe(false);
+      owned.execution.endedAt = nested.execution.endedAt = 200;
+      expect(getPendingRunIds()).toEqual([]);
+      return { timedOut: false };
+    });
+    expect(await gatherYieldDescendants(params)).toEqual({
+      active: true,
+      timedOut: false,
+      results: "frozen child result",
+    });
+    expect(mocks.read).toHaveBeenCalledWith({
+      sessionKey: params.agentSessionKey,
+      runStartedAt: 99,
+      runIds: new Set([owned.runId, nested.runId]),
+    });
+    expect(isYieldGathered(owned.runId)).toBe(true);
+    expect(isYieldGathered(owned.childSessionKey)).toBe(false);
+    expect(isYieldGathering(owned.runId)).toBe(false);
+  });
+
+  it("leaves collector-only work on its explicit wait path", async () => {
+    mocks.list.mockReturnValue([run({ collect: true })]);
+    expect(await gatherYieldDescendants(params)).toEqual({ active: false });
+    expect(mocks.wait).not.toHaveBeenCalled();
+  });
+
+  it("reports a deadline without marking still-running children gathered", async () => {
+    const owned = run();
+    mocks.list.mockReturnValue([owned]);
+    mocks.wait.mockResolvedValue({ timedOut: true });
+    mocks.read.mockResolvedValue(undefined);
+    expect(await gatherYieldDescendants(params)).toEqual({
+      active: true,
+      timedOut: true,
+      results: undefined,
+    });
+    expect(isYieldGathered(owned.runId)).toBe(false);
+    expect(isYieldGathering(owned.runId)).toBe(false);
+  });
+
+  it("surfaces result-read failure and releases active suppression", async () => {
+    const owned = run();
+    mocks.list.mockReturnValue([owned]);
+    mocks.wait.mockImplementation(async () => {
+      owned.execution.endedAt = 200;
+      return { timedOut: false };
+    });
+    mocks.read.mockRejectedValue(new Error("result storage unavailable"));
+    await expect(gatherYieldDescendants(params)).rejects.toThrow("result storage unavailable");
+    expect(isYieldGathering(owned.runId)).toBe(false);
+    expect(isYieldGathered(owned.runId)).toBe(false);
+  });
+});
