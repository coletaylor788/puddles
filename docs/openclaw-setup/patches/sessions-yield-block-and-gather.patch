+import { describe, expect, it } from "vitest";
+import { clearYieldGathering, isYieldGathering, markYieldGathering } from "./yield-gather-state.js";
+
+describe("yield-gather-state", () => {
+  it("marks, reports, and clears a session key", () => {
+    const key = "agent:main:imessage:direct:+test-1";
+    expect(isYieldGathering(key)).toBe(false);
+    markYieldGathering(key);
+    expect(isYieldGathering(key)).toBe(true);
+    clearYieldGathering(key);
+    expect(isYieldGathering(key)).toBe(false);
+  });
+
+  it("tracks keys independently", () => {
+    const a = "agent:main:imessage:direct:+test-a";
+    const b = "agent:main:imessage:direct:+test-b";
+    markYieldGathering(a);
+    expect(isYieldGathering(a)).toBe(true);
+    expect(isYieldGathering(b)).toBe(false);
+    clearYieldGathering(a);
+  });
+
+  it("ignores empty/whitespace keys", () => {
+    markYieldGathering("   ");
+    expect(isYieldGathering("   ")).toBe(false);
+    expect(isYieldGathering("")).toBe(false);
+  });
+
+  it("shares state across module callers via globalThis", () => {
+    // A second resolution of the store (as happens across separate chunks) must
+    // observe the same Set — this is what lets the announce path see the yield
+    // tool's flag even when bundled into a different chunk.
+    const key = "agent:main:imessage:direct:+test-global";
+    markYieldGathering(key);
+    const store = (globalThis as unknown as { __ocYieldGather?: { keys: Set<string> } })
+      .__ocYieldGather;
+    expect(store?.keys.has(key)).toBe(true);
+    clearYieldGathering(key);
+  });
+});
diff --git a/src/agents/tools/yield-gather-state.ts b/src/agents/tools/yield-gather-state.ts
new file mode 100644
index 0000000000..4422086dba
--- /dev/null
+++ b/src/agents/tools/yield-gather-state.ts
@@ -0,0 +1,72 @@
+/**
+ * Cross-module state coordinating block-at-yield gather with announce delivery.
+ * Backed by `globalThis` so it's a true singleton even across bundled chunks.
+ *
+ * - `keys`: requester session keys whose `sessions_yield` is CURRENTLY blocking
+ *   in-turn to gather descendants. While set, the announce path suppresses
+ *   delivery for that requester (the yielding turn owns the single synthesis).
+ * - `done`: child (subagent) session keys whose results have ALREADY been
+ *   gathered by a completed yield. Their announces must stay suppressed even
+ *   after the gather returns — a subagent completion announce can fire several
+ *   seconds after the gather delivered its content via main's synthesis, and
+ *   without this it would deliver the raw subagent text as a late leak.
+ */
+type YieldGatherStore = { keys: Set<string>; done: Set<string> };
+
+const DONE_CAP = 500;
+
+function store(): YieldGatherStore {
+  const g = globalThis as unknown as { __ocYieldGather?: YieldGatherStore };
+  if (!g.__ocYieldGather) {
+    g.__ocYieldGather = { keys: new Set<string>(), done: new Set<string>() };
+  } else if (!g.__ocYieldGather.done) {
+    g.__ocYieldGather.done = new Set<string>();
+  }
+  return g.__ocYieldGather;
+}
+
+export function markYieldGathering(sessionKey: string): void {
+  const key = sessionKey?.trim();
+  if (key) {
+    store().keys.add(key);
+  }
+}
+
+export function clearYieldGathering(sessionKey: string): void {
+  const key = sessionKey?.trim();
+  if (key) {
+    store().keys.delete(key);
+  }
+}
+
+export function isYieldGathering(sessionKey: string): boolean {
+  const key = sessionKey?.trim();
+  return key ? store().keys.has(key) : false;
+}
+
+/** Record a child session key whose result a yield gather has delivered. */
+export function markYieldGathered(childSessionKey: string): void {
+  const key = childSessionKey?.trim();
+  if (!key) {
+    return;
+  }
+  const done = store().done;
+  done.add(key);
+  // Bound growth over a long-lived session (child keys are unique UUIDs).
+  if (done.size > DONE_CAP) {
+    const excess = done.size - DONE_CAP;
+    let i = 0;
+    for (const k of done) {
+      if (i++ >= excess) {
+        break;
+      }
+      done.delete(k);
+    }
+  }
+}
+
+/** True once a yield gather has already delivered this subagent's result. */
+export function isYieldGathered(childSessionKey: string): boolean {
+  const key = childSessionKey?.trim();
+  return key ? store().done.has(key) : false;
+}
