index 00000000000..f03cec045c0
--- /dev/null
+++ b/src/agents/tools/yield-gather-state.ts
@@ -0,0 +1,67 @@
+/**
+ * Cross-module state coordinating block-at-yield gather with announce delivery.
+ * Backed by `globalThis` so it's a true singleton even across bundled chunks.
+ *
+ * Both sets use exact execution IDs, not reusable child or requester sessions.
+ * `keys` prevents active gathers from leaking raw results. `done` suppresses
+ * delayed announcements for results already returned to the parent.
+ */
+type YieldGatherStore = { keys: Set<string>; done: Set<string> };
+
+const DONE_CAP = 500;
+
+function store(): YieldGatherStore {
+  const g = globalThis as typeof globalThis & { __ocYieldGather?: YieldGatherStore };
+  if (!g.__ocYieldGather) {
+    g.__ocYieldGather = { keys: new Set<string>(), done: new Set<string>() };
+  } else if (!g.__ocYieldGather.done) {
+    g.__ocYieldGather.done = new Set<string>();
+  }
+  return g.__ocYieldGather;
+}
+
+export function markYieldGathering(sessionKey: string): void {
+  const key = sessionKey?.trim();
+  if (key) {
+    store().keys.add(key);
+  }
+}
+
+export function clearYieldGathering(sessionKey: string): void {
+  const key = sessionKey?.trim();
+  if (key) {
+    store().keys.delete(key);
+  }
+}
+
+export function isYieldGathering(sessionKey: string): boolean {
+  const key = sessionKey?.trim();
+  return key ? store().keys.has(key) : false;
+}
+
+/** Record an execution whose result a yield gather has returned. */
+export function markYieldGathered(childSessionKey: string): void {
+  const key = childSessionKey?.trim();
+  if (!key) {
+    return;
+  }
+  const done = store().done;
+  done.add(key);
+  // Bound growth over a long-lived process.
+  if (done.size > DONE_CAP) {
+    const excess = done.size - DONE_CAP;
+    let i = 0;
+    for (const k of done) {
+      if (i++ >= excess) {
+        break;
+      }
+      done.delete(k);
+    }
+  }
+}
+
+/** True once a yield gather has already delivered this subagent's result. */
+export function isYieldGathered(childSessionKey: string): boolean {
+  const key = childSessionKey?.trim();
+  return key ? store().done.has(key) : false;
+}
