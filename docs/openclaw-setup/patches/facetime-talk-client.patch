diff --git a/extensions/facetime/scripts/pinned-helper.mjs b/extensions/facetime/scripts/pinned-helper.mjs
new file mode 100644
index 0000000..ab43cc9
--- /dev/null
+++ b/extensions/facetime/scripts/pinned-helper.mjs
@@ -0,0 +1,80 @@
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { readFileSync, realpathSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+// The runtime artifact selects these exact bytes. This opt-in receipt is only
+// for a source-built call helper; the vendor capture path stays unchanged.
+export function resolvePinnedHelper(
+  root,
+  verifySignature = (path) => {
+    execFileSync("/usr/bin/codesign", ["--verify", "--strict", path], {
+      stdio: "pipe",
+      timeout: 10_000,
+    });
+  },
+) {
+  const manifest = JSON.parse(readFileSync(resolve(root, "native-helper.json"), "utf8"));
+  const validSelection =
+    (manifest.schemaVersion === 1 && manifest.developmentOnly === true) ||
+    (manifest.schemaVersion === 2 &&
+      manifest.kind === "source-built" &&
+      manifest.configuration === "release" &&
+      manifest.signing === "ad-hoc" &&
+      Array.isArray(manifest.patches) &&
+      manifest.patches.length > 0 &&
+      manifest.patches.every(
+        (patch) =>
+          patch &&
+          /^[a-z0-9-]+\.patch$/.test(patch.name ?? "") &&
+          /^[a-f0-9]{64}$/.test(patch.sha256 ?? ""),
+      ));
+  if (
+    !validSelection ||
+    !/^[a-f0-9]{64}$/.test(manifest.helperSha256 ?? "") ||
+    !/^[a-f0-9]{64}$/.test(manifest.buildId ?? "") ||
+    !/^[a-f0-9]{40}$/.test(manifest.revision ?? "") ||
+    !/^[a-f0-9]{40}$/.test(manifest.tree ?? "")
+  ) {
+    throw new Error("Invalid pinned FaceTime helper receipt");
+  }
+  const dylib = resolve(root, "native", "FaceTimeHelper.dylib");
+  if (realpathSync(dylib) !== dylib)
+    throw new Error("Pinned helper must be a regular artifact path");
+  const bytes = readFileSync(dylib);
+  if (
+    createHash("sha256").update(bytes).digest("hex") !== manifest.helperSha256 ||
+    !bytes.includes(Buffer.from(manifest.buildId))
+  ) {
+    throw new Error("Pinned FaceTime helper identity mismatch");
+  }
+  verifySignature(dylib);
+  return { buildId: manifest.buildId, dylib, sha256: manifest.helperSha256 };
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try {
+    const result = resolvePinnedHelper(resolve(dirname(fileURLToPath(import.meta.url)), ".."));
+    if (process.argv[2] === "--verify-copy" && process.argv.length === 4) {
+      const bytes = readFileSync(process.argv[3]);
+      if (createHash("sha256").update(bytes).digest("hex") !== result.sha256) {
+        throw new Error("Copied FaceTime helper identity mismatch");
+      }
+      execFileSync("/usr/bin/codesign", ["--verify", "--strict", process.argv[3]], {
+        stdio: "pipe",
+        timeout: 10_000,
+      });
+    } else {
+      if (process.argv.length !== 3 || !["--json", "--path"].includes(process.argv[2])) {
+        throw new Error("Use --json, --path, or --verify-copy PATH");
+      }
+      process.stdout.write(
+        (process.argv[2] === "--path" ? result.dylib : JSON.stringify(result)) + "\n",
+      );
+    }
+  } catch (error) {
+    console.error(error.message);
+    process.exitCode = 1;
+  }
+}
