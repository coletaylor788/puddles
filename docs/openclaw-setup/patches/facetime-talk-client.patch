+  ).toEqual([]);
+}
+
+afterEach(async () => {
+  for (const { root, child, done } of fixtures.splice(0)) {
+    child.kill("SIGTERM");
+    await done;
+    await rm(root, { recursive: true, force: true });
+  }
+});
 
