+  const connect = (startupWork = (async () => {
+    client = await connectFaceTimeTalkGateway({
+      config: params.fullConfig,
+      signal: startup.signal,
+      onEvent,
+      onClose: (error) => {
+        if (!suspended && !stopped) reportFailure(error);
+      },
+    });
+    if (suspended || stopped || params.signal?.aborted) {
+      await client.stopAndWait();
+      return;
+    }
+    const created = asRecord(
+      await client.request("talk.session.create", {
+        mode: "realtime",
+        transport: "gateway-relay",
+        brain: "agent-consult",
+        sessionKey,
+      }),
+    );
+    if (typeof created.relaySessionId !== "string")
+      throw new Error("Talk did not create an audio relay");
+    relaySessionId = created.relaySessionId;
+    const audio = asRecord(created.audio);
+    if (
+      audio.inputEncoding !== "pcm16" ||
+      audio.outputEncoding !== "pcm16" ||
+      audio.inputSampleRateHz !== 24_000 ||
+      audio.outputSampleRateHz !== 24_000
+    ) {
+      throw new Error("Talk relay audio format is incompatible with FaceTime");
+    }
+    if (suspended || stopped) {
+      await client.request("talk.session.close", {
+        sessionId: relaySessionId,
+        disposition: "detach",
+      });
+      await client.stopAndWait();
+      return;
+    }
+    const pending = earlyEvents.splice(0);
+    pendingBytes = 0;
+    for (const event of pending) onEvent(event);
+    await raceWithTimeout(
+      () => ready.promise,
+      REALTIME_READY_TIMEOUT_MS,
+      () => {
+        throw new Error("FaceTime Talk provider readiness timed out");
+      },
+    );
+  })());
+  void connect.catch(reportFailure);
+  try {
+    await pump.suppressionReady();
+  } catch (error) {
+    await fail(error instanceof Error ? error : new Error(String(error)));
+    throw error;
+  }
+  return {
+    recentTalkEvents,
+    processOutputSuppressed: pump.processOutputSuppressed,
+    realtimeActive: () => providerReady && !suspended && !stopped,
+    async readyForAudio() {
+      await connect;
+      await pump.routeReady();
+      if (suspended || stopped) throw new Error("FaceTime Talk media is unavailable");
+    },
+    activate() {
+      if (suspended || stopped || activated) return;
+      activated = true;
+      pendingBytes = 0;
+      for (const event of earlyEvents.splice(0)) consume(event);
+    },
+    suspendMedia,
+    close,
+  };
+}
