@@ -0,0 +1,164 @@
+import type { RealtimeVoiceCarrierSessionParams } from "openclaw/plugin-sdk/realtime-voice";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  mocks,
+  resetTalkDriverMocks,
+  sharedTalkParams,
+  startTalkDriver,
+} from "./talk-driver.test-support.js";
+
+describe("FaceTime shared Talk mode", () => {
+  beforeEach(resetTalkDriverMocks);
+
+  it("uses the host session without the standalone provider, prompts, or consult controller", async () => {
+    let request!: RealtimeVoiceCarrierSessionParams;
+    const createSession = vi.fn(async (params: RealtimeVoiceCarrierSessionParams) => {
+      request = params;
+      return mocks.bridge;
+    });
+    mocks.bridge.connect.mockImplementation(async () => request.onReady?.());
+    const assertCurrent = vi.fn();
+    const driver = await startTalkDriver(
+      sharedTalkParams({
+        runtime: { realtimeVoice: { createSession } },
+        assertOwnerCurrent: assertCurrent,
+      }),
+    );
+    await driver.readyForAudio();
+    expect(createSession).toHaveBeenCalledOnce();
+    expect(request).toMatchObject({
+      callId: "call-1",
+      sessionKey: "agent:main:main",
+      owner: { handle: "caller@example.com", assertCurrent },
+    });
+    expect(request).not.toHaveProperty("providerConfig");
+    expect(request).not.toHaveProperty("tools");
+    expect(request).not.toHaveProperty("instructions");
+    expect(mocks.resolveProvider).not.toHaveBeenCalled();
+    expect(mocks.resolveAgentContext).not.toHaveBeenCalled();
+    expect(mocks.createSession).not.toHaveBeenCalled();
+    expect(mocks.consult).not.toHaveBeenCalled();
+    driver.activate();
+    const audio = Buffer.from([1, 2]);
+    mocks.pumpParams?.onInputAudio(audio);
+    expect(mocks.bridge.sendAudio).toHaveBeenCalledWith(audio);
+    await driver.close();
+    expect(mocks.bridge.close).toHaveBeenCalledOnce();
+    // The host owns detach semantics; no standalone cancellation is dispatched.
+    expect(mocks.consult).not.toHaveBeenCalled();
+    request.audioSink.sendAudio(audio);
+    expect(mocks.pump.writeOutputAudio).not.toHaveBeenCalled();
+  });
+
+  it("fails before capture when the host or live owner capability is unavailable", async () => {
+    await expect(startTalkDriver(sharedTalkParams({}))).rejects.toThrow(
+      "host session support and current caller authority",
+    );
+    expect(mocks.pumpParams).toBeUndefined();
+  });
+
+  it("suspends native media while shared Talk persistence is still closing", async () => {
+    let request!: RealtimeVoiceCarrierSessionParams;
+    const createSession = vi.fn(async (params: RealtimeVoiceCarrierSessionParams) => {
+      request = params;
+      return mocks.bridge;
+    });
+    mocks.bridge.connect.mockImplementation(async () => request.onReady?.());
+    let finishClose!: () => void;
+    mocks.bridge.close.mockReturnValue(
+      new Promise<void>((resolve) => {
+        finishClose = resolve;
+      }),
+    );
+    const driver = await startTalkDriver(
+      sharedTalkParams({
+        runtime: { realtimeVoice: { createSession } },
+        assertOwnerCurrent: vi.fn(),
+      }),
+    );
+    await driver.readyForAudio();
+    driver.activate();
+    const closing = driver.suspendMedia("hangup");
+    let finalClose: Promise<void> | undefined;
+    try {
+      await vi.waitFor(() => expect(mocks.pump.suspendMedia).toHaveBeenCalledOnce());
+      expect(mocks.bridge.close).toHaveBeenCalledOnce();
+      mocks.pumpParams?.onInputAudio(Buffer.from([1, 2]));
+      request.audioSink.sendAudio(Buffer.from([1, 2]));
+      expect(mocks.bridge.sendAudio).not.toHaveBeenCalled();
+      expect(mocks.pump.writeOutputAudio).not.toHaveBeenCalled();
+      // Process-tap suppression remains owned until physical hangup is safe.
+      expect(mocks.pump.stop).not.toHaveBeenCalled();
+      // The carrier now confirms closure. Persistence still has not completed.
+      finalClose = driver.close("carrier-closed");
+      await vi.waitFor(() => expect(mocks.pump.stop).toHaveBeenCalledOnce());
+    } finally {
+      finishClose();
+      await closing;
+      await (finalClose ?? driver.close());
+    }
+  });
+
+  it("bounds shared cleanup after releasing capture on confirmed carrier closure", async () => {
+    let request!: RealtimeVoiceCarrierSessionParams;
+    const createSession = vi.fn(async (params: RealtimeVoiceCarrierSessionParams) => {
+      request = params;
+      return mocks.bridge;
+    });
+    mocks.bridge.connect.mockImplementation(async () => request.onReady?.());
+    let release!: () => void;
+    mocks.bridge.close.mockReturnValue(
+      new Promise<void>((resolve) => {
+        release = resolve;
+      }),
+    );
+    const warn = vi.fn();
+    const driver = await startTalkDriver(
+      sharedTalkParams({
+        runtime: { realtimeVoice: { createSession } },
+        assertOwnerCurrent: vi.fn(),
+        logger: { ...console, warn },
+      }),
+    );
+    await driver.readyForAudio();
+    vi.useFakeTimers();
+    try {
+      const closing = driver.close("carrier-closed");
+      await vi.advanceTimersByTimeAsync(0);
+      expect(mocks.pump.stop).toHaveBeenCalledOnce();
+      await vi.advanceTimersByTimeAsync(20_000);
+      await closing;
+      expect(warn).toHaveBeenCalledWith(expect.stringContaining("cleanup still pending"));
+    } finally {
+      release();
+      vi.useRealTimers();
+      await driver.close();
+    }
+  });
+
+  it("closes a host session that finishes creation after carrier cancellation", async () => {
+    let finish!: (value: typeof mocks.bridge) => void;
+    const creating = new Promise<typeof mocks.bridge>((resolve) => {
+      finish = resolve;
+    });
+    const createSession = vi.fn(() => creating);
+    const controller = new AbortController();
+    const driver = await startTalkDriver(
+      sharedTalkParams({
+        runtime: { realtimeVoice: { createSession } },
+        assertOwnerCurrent: vi.fn(),
+        signal: controller.signal,
+      }),
+    );
+    const ready = driver.readyForAudio();
+    const rejected = expect(ready).rejects.toThrow("aborted");
+    controller.abort();
+    await rejected;
+    finish(mocks.bridge);
+    await vi.waitFor(() =>
+      expect(mocks.bridge.close).toHaveBeenCalledWith({ disposition: "detach" }),
+    );
+    expect(mocks.bridge.connect).not.toHaveBeenCalled();
+    await driver.close();
+  });
+});
