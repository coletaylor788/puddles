--- /dev/null
+++ b/src/gateway/talk/carrier-provider.ts
@@ -0,0 +1,46 @@
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { resolveInternalRealtimeVoiceGatewayRelayLaunchError } from "../../talk/provider-internal.js";
+import { resolveConfiguredRealtimeVoiceProviderAsync } from "../../talk/provider-resolver.js";
+import { buildRealtimeVoiceLaunchOptions, buildTalkRealtimeConfig } from "./session-config.js";
+
+/** Read-only carrier validation, shared by readiness checks and call creation. */
+export async function resolveTalkCarrierProvider(config: OpenClawConfig, agentId: string) {
+  const defaults = await buildTalkRealtimeConfig(config);
+  if (
+    (defaults.mode && defaults.mode !== "realtime") ||
+    (defaults.brain && defaults.brain !== "agent-consult")
+  ) {
+    throw new Error(
+      "Realtime voice carriers require the native realtime agent-consult Talk configuration.",
+    );
+  }
+  const launchOptions = buildRealtimeVoiceLaunchOptions({ requested: {}, defaults });
+  const resolution = await resolveConfiguredRealtimeVoiceProviderAsync({
+    cfg: config,
+    agentId,
+    configuredProviderId: defaults.provider,
+    providerConfigs: defaults.providers,
+    ...(launchOptions.model ? { providerConfigOverrides: { model: launchOptions.model } } : {}),
+    defaultModel: defaults.model,
+    surface: "gateway-relay",
+    autoRespondToAudio: defaults.consultRouting !== "force-agent-consult",
+  });
+  const forceAgentConsultOnFinalTranscript = defaults.consultRouting === "force-agent-consult";
+  const { model: _model, ...overrides } = launchOptions;
+  const providerConfig =
+    Object.keys(overrides).length > 0
+      ? { ...resolution.providerConfig, ...overrides }
+      : resolution.providerConfig;
+  const error = resolveInternalRealtimeVoiceGatewayRelayLaunchError({
+    provider: resolution.provider,
+    cfg: config,
+    providerConfig,
+    model: launchOptions.model,
+    autoRespondToAudio: !forceAgentConsultOnFinalTranscript,
+  });
+  if (error || forceAgentConsultOnFinalTranscript) {
+    throw new Error(error ?? "Forced transcript consultation is not supported by this carrier.");
+  }
+  const launch = { providerConfig };
+  return { defaults, resolution, launch };
+}
