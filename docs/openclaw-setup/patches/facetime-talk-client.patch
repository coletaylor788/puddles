+++ b/src/talk/carrier-call-control.ts
@@ -0,0 +1,37 @@
+/** Deliberate current-call commands, separate from agent task cancellation. */
+export function createRealtimeVoiceCarrierCallControl(params: {
+  assertCurrent: () => void;
+  requestHangup?: () => void | Promise<void>;
+  onError: (error: Error) => void;
+}) {
+  let requested = false;
+  return {
+    get hangupRequested() {
+      return requested;
+    },
+    handleInput(text: string): boolean {
+      if (
+        !params.requestHangup ||
+        !/^(?:please\s+)?(?:hang\s+up|(?:end|disconnect)\s+(?:this|the)\s+call)(?:\s+please)?[.!]?$/i.test(
+          text.trim(),
+        )
+      ) {
+        return false;
+      }
+      if (requested) {
+        return true;
+      }
+      params.assertCurrent();
+      requested = true;
+      // Claim synchronously before any reentrant transcript or delegation callback.
+      try {
+        void Promise.resolve(params.requestHangup()).catch((error: unknown) => {
+          params.onError(error instanceof Error ? error : new Error(String(error)));
+        });
+      } catch (error) {
+        params.onError(error instanceof Error ? error : new Error(String(error)));
+      }
+      return true;
+    },
+  };
+}
