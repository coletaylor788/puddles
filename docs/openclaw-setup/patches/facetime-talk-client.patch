@@ -0,0 +1,63 @@
+import { describe, expect, it, vi } from "vitest";
+import { createRealtimeVoiceCarrierCallControl } from "./carrier-call-control.js";
+
+describe("carrier call control", () => {
+  it.each(["Hang up.", "please end this call", "disconnect the call please!", "hang up please"])(
+    "requests deliberate hangup once for %s",
+    (text) => {
+      const requestHangup = vi.fn();
+      const assertCurrent = vi.fn();
+      const control = createRealtimeVoiceCarrierCallControl({
+        requestHangup,
+        assertCurrent,
+        onError: vi.fn(),
+      });
+      expect(control.handleInput(text)).toBe(true);
+      expect(control.handleInput(text)).toBe(true);
+      expect(control.hangupRequested).toBe(true);
+      expect(assertCurrent).toHaveBeenCalledOnce();
+      expect(requestHangup).toHaveBeenCalledOnce();
+    },
+  );
+  it.each([
+    "don't hang up",
+    'Say "hang up"',
+    "can you explain hang up",
+    "hang up when the task is done",
+    "cancel that task",
+    "end the task",
+    "hang up?",
+    "",
+  ])("does not interpret %s as a call command", (text) => {
+    const requestHangup = vi.fn();
+    const control = createRealtimeVoiceCarrierCallControl({
+      requestHangup,
+      assertCurrent: vi.fn(),
+      onError: vi.fn(),
+    });
+    expect(control.handleInput(text)).toBe(false);
+    expect(requestHangup).not.toHaveBeenCalled();
+  });
+  it("rechecks authority and reports native failure without automatic retries", async () => {
+    const onError = vi.fn();
+    const error = new Error("carrier closure pending");
+    const requestHangup = vi.fn(async () => {
+      throw error;
+    });
+    const assertCurrent = vi.fn(() => {
+      throw new Error("owner retired");
+    });
+    const control = createRealtimeVoiceCarrierCallControl({
+      requestHangup,
+      assertCurrent,
+      onError,
+    });
+    expect(() => control.handleInput("hang up")).toThrow("owner retired");
+    expect(requestHangup).not.toHaveBeenCalled();
+    assertCurrent.mockImplementation(() => {});
+    expect(control.handleInput("hang up")).toBe(true);
+    await vi.waitFor(() => expect(onError).toHaveBeenCalledWith(error));
+    expect(control.handleInput("hang up")).toBe(true);
+    expect(requestHangup).toHaveBeenCalledOnce();
+  });
+});
