@@ -0,0 +1,234 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import type { RealtimeVoiceProviderPlugin } from "../../plugins/types.js";
+import type { InternalRealtimeVoiceProviderApi } from "../../talk/provider-internal.js";
+import { resolveTalkCarrierProvider } from "./carrier-provider.js";
+
+const registry = vi.hoisted(() => ({ providers: [] as RealtimeVoiceProviderPlugin[] }));
+// Only discovery is synthetic. Configuration, async selection and launch validation are native.
+vi.mock("../../talk/provider-registry.js", () => ({
+  listRealtimeVoiceProviders: () => registry.providers,
+  getRealtimeVoiceProvider: (id?: string) =>
+    registry.providers.find((provider) => provider.id === id),
+}));
+
+function recordingProvider() {
+  const legacy = vi.fn(() => {
+    throw new Error("synchronous provider hooks must not run");
+  });
+  const resolveConfigAsync = vi.fn<NonNullable<RealtimeVoiceProviderPlugin["resolveConfigAsync"]>>(
+    async ({ rawConfig }) => ({
+      ...rawConfig,
+      model: `resolved:${rawConfig.model ?? "provider-default"}`,
+    }),
+  );
+  const isConfiguredAsync = vi.fn<NonNullable<RealtimeVoiceProviderPlugin["isConfiguredAsync"]>>(
+    async () => true,
+  );
+  const validateGatewayRelayLaunch = vi.fn<
+    NonNullable<InternalRealtimeVoiceProviderApi["validateGatewayRelayLaunch"]>
+  >(() => undefined);
+  const createBridge = vi.fn<RealtimeVoiceProviderPlugin["createBridge"]>(() => {
+    throw new Error("read-only resolution must not start a provider");
+  });
+  const provider: RealtimeVoiceProviderPlugin = {
+    id: "recording",
+    label: "Recording provider",
+    models: ["catalog-default"],
+    defaultModel: "provider-default",
+    resolveConfig: legacy,
+    isConfigured: legacy,
+    resolveConfigAsync,
+    isConfiguredAsync,
+    createBridge,
+  };
+  const internal: InternalRealtimeVoiceProviderApi = {
+    isBrowserSessionConfigured: legacy,
+    validateGatewayRelayLaunch,
+  };
+  Object.defineProperty(provider, Symbol.for("openclaw.internal.realtime-voice-provider.v1"), {
+    value: internal,
+  });
+  registry.providers = [provider];
+  return {
+    provider,
+    legacy,
+    resolveConfigAsync,
+    isConfiguredAsync,
+    validateGatewayRelayLaunch,
+    createBridge,
+  };
+}
+
+function configured(
+  realtime: NonNullable<OpenClawConfig["talk"]>["realtime"] = {},
+): OpenClawConfig {
+  return {
+    talk: {
+      realtime: {
+        provider: "recording",
+        mode: "realtime",
+        brain: "agent-consult",
+        providers: { recording: { model: "provider-model", voice: "provider-voice" } },
+        ...realtime,
+      },
+    },
+  };
+}
+
+beforeEach(() => {
+  registry.providers = [];
+});
+
+describe("Talk carrier native provider selection", () => {
+  it("inherits provider configuration and awaits the provider's async normalization", async () => {
+    const f = recordingProvider();
+    const config = configured();
+    const result = await resolveTalkCarrierProvider(config, "main");
+    expect(result.resolution.provider).toBe(f.provider);
+    expect(result.launch.providerConfig).toEqual({
+      model: "resolved:provider-model",
+      voice: "provider-voice",
+    });
+    expect(f.resolveConfigAsync).toHaveBeenCalledWith(
+      expect.objectContaining({
+        cfg: config,
+        agentId: "main",
+        surface: "gateway-relay",
+        autoRespondToAudio: true,
+        rawConfig: { model: "provider-model", voice: "provider-voice" },
+      }),
+    );
+    expect(f.isConfiguredAsync).toHaveBeenCalledWith(
+      expect.objectContaining({
+        cfg: config,
+        agentId: "main",
+        providerConfig: result.launch.providerConfig,
+      }),
+    );
+    expect(f.legacy).not.toHaveBeenCalled();
+    expect(f.createBridge).not.toHaveBeenCalled();
+  });
+
+  it("applies Talk model and voice controls without overwriting the provider-normalized model", async () => {
+    const f = recordingProvider();
+    const config = configured({
+      model: "talk-model",
+      speakerVoice: "talk-voice",
+      reasoningEffort: "high",
+      vadThreshold: 0.6,
+      silenceDurationMs: 350,
+      prefixPaddingMs: 180,
+    });
+    const result = await resolveTalkCarrierProvider(config, "voice-agent");
+    expect(result.defaults).toMatchObject({ model: "talk-model", voice: "talk-voice" });
+    expect(result.launch.providerConfig).toEqual({
+      model: "resolved:talk-model",
+      voice: "talk-voice",
+      reasoningEffort: "high",
+      vadThreshold: 0.6,
+      silenceDurationMs: 350,
+      prefixPaddingMs: 180,
+    });
+    expect(f.validateGatewayRelayLaunch).toHaveBeenCalledExactlyOnceWith({
+      cfg: config,
+      providerConfig: result.launch.providerConfig,
+      model: "talk-model",
+      autoRespondToAudio: true,
+    });
+    expect(f.legacy).not.toHaveBeenCalled();
+    expect(f.createBridge).not.toHaveBeenCalled();
+  });
+
+  it("awaits native voice-model default discovery before selecting the carrier provider", async () => {
+    const f = recordingProvider();
+    let release!: () => void;
+    const held = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const normalResolve = f.resolveConfigAsync.getMockImplementation()!;
+    f.resolveConfigAsync.mockImplementationOnce(async (context) => {
+      await held;
+      return normalResolve(context);
+    });
+    const config: OpenClawConfig = {
+      agents: { defaults: { voiceModel: { primary: "recording/catalog-default" } } },
+      talk: {
+        realtime: { mode: "realtime", brain: "agent-consult", speakerVoice: "catalog-voice" },
+      },
+    };
