+    const release = deferred();
+    releaseHeldWrites.push(release.resolve);
+    sessionTurnMocks.appendExpectedSessionTranscriptTurn.mockImplementationOnce(async (...args) => {
+      entered.resolve();
+      await release.promise;
+      return sessionTurnMocks.actualAppendSessionTranscriptTurn!(...args);
+    });
+    let closed = false;
+    const closing = session.close().then(() => {
+      closed = true;
+    });
+    try {
+      await awaitGateBeforeSettlement(
+        entered.promise,
+        closing,
+        "close settled before its transcript append gate",
+      );
+      expect(closed).toBe(false);
+      expect(mocks.logicalClose).not.toHaveBeenCalled();
+      expect(JSON.stringify(persistedTranscript())).not.toContain("final spoken words");
+    } finally {
+      release.resolve();
+    }
+    await closing;
+    expect(JSON.stringify(persistedTranscript())).toContain("final spoken words");
+    expect(clientVoiceSessionTesting.readRecord("main", session.voiceSessionId)).toMatchObject({
+      status: "closed",
+      transcriptFailureKeys: [],
+    });
+    expect(mocks.flush).toHaveBeenCalled();
+  });
+
+  it("rejects a replaced voice database without recapturing a replacement owner", async () => {
+    const f = fixture();
+    const voicePath = resolveOpenClawAgentSqlitePath({ agentId: "main" });
+    const selectedPath = voicePath;
+    const session = await createTalkCarrierSession(f.params, {
+      context: f.context,
+      pluginId: "test-carrier",
+    });
+    sessions.push(session);
+    await session.connect();
+    const source = mocks.captureWriter.mock.calls[0]?.[0]?.physicalSource;
+    expect(source).toBeDefined();
+    mocks.captureWriter.mockClear();
+    const originalPath = `${selectedPath}.carrier-original`;
+    const database = new DatabaseSync(selectedPath);
+    database.exec("PRAGMA wal_checkpoint(TRUNCATE)");
+    const originalTranscriptCount = database
+      .prepare("SELECT COUNT(*) AS count FROM transcript_events")
+      .get();
+    database.close();
+    renameSync(selectedPath, originalPath);
+    copyFileSync(originalPath, selectedPath);
+    try {
+      const failure = await session.close().then(
+        () => undefined,
+        (error: unknown) => error,
+      );
+      expect(failure).toBeInstanceOf(Error);
+      expect(f.media.close).toHaveBeenCalledOnce();
+      const replacement = new DatabaseSync(selectedPath, { readOnly: true });
+      try {
+        expect(
+          replacement.prepare("SELECT COUNT(*) AS count FROM transcript_events").get(),
+        ).toEqual(originalTranscriptCount);
+      } finally {
+        replacement.close();
+      }
+      for (const [capture] of mocks.captureWriter.mock.calls) {
+        expect(capture.physicalSource?.identity).toEqual(source!.identity);
+        expect(capture.physicalSource?.options.path).toBe(source!.options.path);
+      }
+      expect(mocks.logicalCreate).toHaveBeenCalledOnce();
+    } finally {
+      if (existsSync(originalPath)) {
+        unlinkSync(selectedPath);
+        renameSync(originalPath, selectedPath);
+      }
+    }
+  });
+
+  it("fences an admitted transcript append against replacement of its separate conversation store", async () => {
+    const f = fixture();
+    mocks.targetStorePath = resolveOpenClawAgentSqlitePath({
+      agentId: "main",
+      env: {
+        ...process.env,
+        OPENCLAW_STATE_DIR: join(process.env.OPENCLAW_STATE_DIR!, "conversation"),
+      },
+    });
+    await replaceSessionEntry(
+      { agentId: "main", sessionKey: "agent:main:main", storePath: mocks.targetStorePath },
+      { sessionId: "session-agent-main-main", updatedAt: Date.now() },
+    );
+    const session = await createTalkCarrierSession(f.params, {
+      context: f.context,
+      pluginId: "test-carrier",
+    });
+    sessions.push(session);
+    await session.connect();
+    const admitted = deferred();
+    const release = deferred();
+    releaseHeldWrites.push(release.resolve);
+    mocks.captureWriter.mockImplementationOnce((params) => {
+      const writer = mocks.actualWriter!.captureClientVoiceSessionWriter(params);
+      const mutate = writer.mutate;
+      vi.spyOn(writer, "mutate").mockImplementation(async (...args) => {
+        // Native custom-store append captures its entry source before reserving this write.
+        if (args[0].kind === "reserve") {
+          admitted.resolve();
+          await release.promise;
+        }
+        return Reflect.apply(mutate, writer, args);
+      });
+      return writer;
+    });
+    // This case owns a single transcript. Provider teardown must not enqueue another.
+    f.media.close.mockImplementation(() => {});
+    f.request().onTranscript?.("assistant", "do not write through the replaced source", true);
+    await vi.waitFor(() => expect(mocks.append).toHaveBeenCalledOnce());
+    const append = mocks.append.mock.results.at(-1);
+    expect(append?.type).toBe("return");
+    const appendOperation = Promise.resolve(append?.value);
+    const appendResult = appendOperation.then(
+      () => undefined,
+      (error: unknown) => error,
+    );
+    await awaitGateBeforeSettlement(
+      admitted.promise,
+      appendOperation,
+      "append settled before its captured-source gate",
+    );
+    const selectedPath = mocks.targetStorePath;
+    const originalPath = `${selectedPath}.carrier-original`;
+    const database = new DatabaseSync(selectedPath);
+    database.exec("PRAGMA wal_checkpoint(TRUNCATE)");
+    const originalTranscriptCount = database
+      .prepare("SELECT COUNT(*) AS count FROM transcript_events")
+      .get();
+    database.close();
+    renameSync(selectedPath, originalPath);
+    copyFileSync(originalPath, selectedPath);
+    try {
+      release.resolve();
+      expect(await appendResult).toBeInstanceOf(Error);
+      expect(mocks.append).toHaveBeenCalledOnce();
+      const replacement = new DatabaseSync(selectedPath, { readOnly: true });
+      try {
+        expect(
+          replacement.prepare("SELECT COUNT(*) AS count FROM transcript_events").get(),
+        ).toEqual(originalTranscriptCount);
+      } finally {
+        replacement.close();
+      }
+      expect(mocks.logicalCreate).toHaveBeenCalledOnce();
+    } finally {
+      release.resolve();
+      if (existsSync(originalPath)) {
+        unlinkSync(selectedPath);
+        renameSync(originalPath, selectedPath);
+      }
+      const failure = await session.close().then(
+        () => undefined,
+        (error: unknown) => error,
+      );
+      expect(failure).toBeInstanceOf(Error);
+      expect(String(failure)).toContain(
+        "voice transcript persistence must be retried before close",
+      );
+      await expect(session.close()).rejects.toBe(failure);
+    }
+    expect(f.media.close).toHaveBeenCalledExactlyOnceWith({ disposition: "detach" });
+    expect(mocks.append).toHaveBeenCalledOnce();
+    expect(clientVoiceSessionTesting.readRecord("main", session.voiceSessionId)).toMatchObject({
+      status: "open",
+    });
+  });
+
+  it("tears down the provider after native settlement admission refusal without replaying close", async () => {
+    const f = fixture();
+    const session = await createTalkCarrierSession(f.params, {
+      context: f.context,
+      pluginId: "test-carrier",
+    });
+    sessions.push(session);
+    await session.connect();
+    const persistence = prepareClientVoiceSessionClose();
+    persistence.beginClose();
+    const failure = await session.close().then(
+      () => undefined,
+      (error: unknown) => error,
+    );
+    expect(failure).toBeInstanceOf(Error);
+    expect(String(failure)).toContain("admission is closed");
+    expect(f.media.close).toHaveBeenCalledExactlyOnceWith({ disposition: "detach" });
+    expect(mocks.logicalClose).not.toHaveBeenCalled();
+    await expect(session.close()).rejects.toBe(failure);
+    expect(f.media.close).toHaveBeenCalledOnce();
+    expect(clientVoiceSessionTesting.readRecord("main", session.voiceSessionId)).toMatchObject({
+      status: "open",
+    });
+    await persistence.drain();
+  });
+
+  it("surfaces an unknown creation outcome without claiming a clean close or replaying creation", async () => {
+    const f = fixture();
+    const session = await createTalkCarrierSession(f.params, {
+      context: f.context,
+      pluginId: "test-carrier",
+    });
+    sessions.push(session);
+    const unknown = new SqliteWorkerError(
+      "synthetic lost create acknowledgement",
+      "outcome-unknown",
+    );
+    mocks.captureWriter.mockImplementationOnce((params) => {
+      const writer = mocks.actualWriter!.captureClientVoiceSessionWriter(params);
+      vi.spyOn(writer, "mutate").mockRejectedValueOnce(unknown);
+      return writer;
+    });
+    const failure = await session.connect().then(
+      () => undefined,
+      (error: unknown) => error,
+    );
+    expect(failure).toBeInstanceOf(Error);
+    expect(f.media.connect).not.toHaveBeenCalled();
+    expect(f.media.close).toHaveBeenCalledOnce();
+    expect(mocks.logicalCreate).toHaveBeenCalledOnce();
+    expect(mocks.logicalClose).not.toHaveBeenCalled();
+    await expect(session.close()).rejects.toBeDefined();
+    expect(clientVoiceSessionTesting.readRecord("main", session.voiceSessionId)).toBeUndefined();
+  });
+});
diff --git a/src/gateway/talk/carrier-session.ts b/src/gateway/talk/carrier-session.ts
new file mode 100644
index 0000000..8e264ce
--- /dev/null
+++ b/src/gateway/talk/carrier-session.ts
@@ -0,0 +1,437 @@
+import { randomUUID } from "node:crypto";
+import { releaseSessionSourceAuthorities } from "../../config/sessions/session-source-authority.js";
+import { assertSecretOwnerAvailable } from "../../secrets/runtime-degraded-state.js";
+import { REALTIME_VOICE_AGENT_CONSULT_TOOL } from "../../talk/agent-consult-tool.js";
+import { REALTIME_VOICE_AGENT_CONTROL_TOOL } from "../../talk/agent-run-control-shared.js";
+import { createRealtimeVoiceCarrierCallControl } from "../../talk/carrier-call-control.js";
+import type {
+  RealtimeVoiceCarrierSession,
+  RealtimeVoiceCarrierSessionParams,
+} from "../../talk/carrier-session.types.js";
+import { withClientVoiceSessionSettlement } from "../../talk/client-voice-session-lifecycle.js";
+import {
+  captureClientVoiceSessionSource,
+  type ClientVoiceSessionSource,
+} from "../../talk/client-voice-session-source.js";
+import {
+  captureClientVoiceSessionWriter,
+  ensureClientVoiceAgentSessionEntry,
+  type ClientVoiceSessionWriter,
+} from "../../talk/client-voice-session-write.js";
+import {
+  appendClientVoiceTranscript,
+  closeClientVoiceSession,
+  createOrResumeClientVoiceSession,
+  flushClientVoiceSessionWrites,
+} from "../../talk/client-voice-session.js";
+import {
+  createRealtimeVoiceBridgeSession,
+  type RealtimeVoiceBridgeSession,
+} from "../../talk/session-runtime.js";
+import type { GatewayRequestContext } from "../server-methods/types.js";
+import { resolveTalkCarrierProvider } from "./carrier-provider.js";
+import { createTalkClientAgentConsultRunner } from "./client-agent-consult.js";
+import { createTalkClientGatewayControlOwner } from "./client-gateway-control.js";
+import {
+  buildRealtimeInstructions,
+  resolveTalkRealtimeProviderInstructions,
+} from "./session-config.js";
+import { readTalkRealtimeInitialItems } from "./session-history.js";
+import { cleanupTalkConnection } from "./session-registry.js";
+import { assertTalkSessionStorageTarget, prepareTalkSessionTarget } from "./session-target.js";
+
+/** Media carriers reuse the native Talk owners, configuration, history, and admission policy. */
+export async function createTalkCarrierSession(
+  params: RealtimeVoiceCarrierSessionParams,
+  host: { context: GatewayRequestContext; pluginId: string },
+): Promise<RealtimeVoiceCarrierSession> {
+  if (!params.callId.trim() || !params.owner.handle.trim()) {
+    throw new Error("Realtime voice requires a call identity and authenticated owner handle.");
+  }
+  const config = host.context.getRuntimeConfig();
+  const target = await prepareTalkSessionTarget(config, params.sessionKey);
+  const assertCurrent = () => {
+    if (callControl?.hangupRequested) {
+      throw new Error("Realtime voice call is ending");
+    }
+    params.signal.throwIfAborted();
+    params.owner.assertCurrent();
+    assertTalkSessionStorageTarget(host.context.getRuntimeConfig(), target);
+  };
+  const callControl: ReturnType<typeof createRealtimeVoiceCarrierCallControl> =
+    createRealtimeVoiceCarrierCallControl({
+      assertCurrent,
+      requestHangup: params.onHangupRequested,
+      onError: (error) => {
+        host.context.logGateway.warn(`talk carrier hangup failed: ${String(error)}`);
+        params.onError?.(error);
+      },
+    });
+  assertCurrent();
+  assertSecretOwnerAvailable("capability", "talk:realtime");
+  const { defaults, resolution, launch } = await resolveTalkCarrierProvider(config, target.agentId);
+  const providerInstructions = await resolveTalkRealtimeProviderInstructions({
+    config,
+    agentId: target.agentId,
+    configuredInstructions: defaults.instructions,
+    sessionKey: target.canonicalKey,
+    warn: (message) => host.context.logGateway.warn(`talk realtime context: ${message}`),
+  });
+  assertCurrent();
+  const initialItems = await readTalkRealtimeInitialItems(target, assertCurrent);
+  assertCurrent();
+  const voiceSessionId = randomUUID();
+  // This is a real carrier capability owner, not a fabricated WebSocket/client identity.
+  // Native run ownership currently calls its opaque media owner field `connId`.
+  const ownerId = `carrier:${host.pluginId}:${randomUUID()}`;
+  const sessionTarget = {
+    agentId: target.agentId,
+    sessionKey: target.canonicalKey,
+    storePath: target.storePath,
+  };
+  let logicalSessionCreated = false;
+  let voiceSessionSource: ClientVoiceSessionSource | undefined;
+  let voiceCreation: Promise<void> | undefined;
+  let closing = false;
+  let closingWriter: ClientVoiceSessionWriter | undefined;
+  let closingFailure: { error: unknown } | undefined;
+  const awaitVoiceCreation = async () => {
+    try {
+      await voiceCreation;
+    } catch (error) {
+      if (!logicalSessionCreated) {
+        throw error;
+      }
+    }
+  };
+  const requireVoiceSource = () => {
+    if (!voiceSessionSource) {
+      throw new Error("Carrier voice session is not ready for persistence");
+    }
+    return voiceSessionSource;
+  };
+  const withVoiceWriter = async <T>(
+    operation: (writer: ClientVoiceSessionWriter) => Promise<T>,
+  ): Promise<T> => {
+    const source = requireVoiceSource();
+    return withClientVoiceSessionSettlement(
+      async () => {
+        await awaitVoiceCreation();
+        if (closingFailure) {
+          throw closingFailure.error;
+        }
+        const writer =
+          closingWriter ??
+          captureClientVoiceSessionWriter({
+            agentId: target.agentId,
+            physicalSource: requireVoiceSource(),
+          });
+        const retained = closing;
+        if (retained) {
+          closingWriter = writer;
+        }
+        const errors: unknown[] = [];
+        try {
+          return await operation(writer);
+        } catch (error) {
+          errors.push(error);
+          throw error;
+        } finally {
+          if (!retained) {
+            await releaseSessionSourceAuthorities([writer], errors);
+          }
+        }
+      },
+      undefined,
+      source.settlementContext,
+    );
+  };
+  const consult = createTalkClientAgentConsultRunner({
+    config,
+    context: host.context,
+    sessionTarget: target,
+    ownerConnId: ownerId,
+    authority: { senderIsOwner: true },
+    getVoiceSessionId: () => voiceSessionId,
+    getVoiceSessionSource: () => (logicalSessionCreated ? voiceSessionSource : undefined),
+    initialItems,
+  });
+  const controlSource = resolution.capabilities?.handlesAgentConsult ? "delegation" : "transcript";
+  const owner = createTalkClientGatewayControlOwner({
+    voiceSessionId,
+    providerId: resolution.provider.id,
+    supportsToolCalls: resolution.capabilities?.supportsToolCalls,
+    controlSource,
+    sessionTarget: target,
+    connId: ownerId,
+    transport: "gateway-relay",
+    // Carrier media has no browser event recipient. It receives provider events below.
+    onTalkEvent: () => {},
+    context: host.context,
+    assertConnectionOpen: assertCurrent,
+    runToolAgentConsult: consult.runArgs,
+    runAgentConsult: consult.runOwnedArgs,
+    getToolAuthorityOverlay: (source) => consult.getToolAuthorityOverlay(undefined, source),
+    appendTranscript: ({ entryId, role, text }) =>
+      withVoiceWriter((writer) =>
+        appendClientVoiceTranscript(
+          {
+            agentId: target.agentId,
+            sessionKey: target.canonicalKey,
+            sessionTarget,
+            voiceSessionId,
+            entryId,
+            role,
+            text,
+            config,
+          },
+          writer,
+        ),
+      ),
+    flushTranscript: async () => {
+      const voiceTarget = { agentId: target.agentId, voiceSessionId };
+      if (!voiceSessionSource) {
+        return flushClientVoiceSessionWrites(voiceTarget, null);
+      }
+      try {
+        return await withVoiceWriter((writer) =>
+          flushClientVoiceSessionWrites(voiceTarget, writer),
+        );
+      } catch (error) {
+        if (!closing) {
+          throw error;
+        }
+        closingFailure ??= { error };
+        await flushClientVoiceSessionWrites(voiceTarget, null);
+      }
+    },
+    closeLogicalSession: async () => {
+      await awaitVoiceCreation();
+      if (closingFailure) {
+        throw closingFailure.error;
+      }
+      if (logicalSessionCreated) {
+        await withVoiceWriter((writer) =>
+          closeClientVoiceSession(
+            {
+              agentId: target.agentId,
+              sessionKey: target.canonicalKey,
+              voiceSessionId,
+              config,
+            },
+            writer,
+          ),
+        );
+      }
+    },
+    withCloseSettlement: (run) => {
+      closing = true;
+      const settleClose = async (admissionFailure?: { error: unknown }) => {
+        closingFailure = admissionFailure;
+        const errors: unknown[] = [];
+        try {
+          await run();
+          if (closingFailure) {
+            throw closingFailure.error;
+          }
+        } catch (error) {
+          const failure =
+            closingFailure && error !== closingFailure.error
+              ? new AggregateError([closingFailure.error, error], "Voice session close failed", {
+                  cause: error,
+                })
+              : error;
+          errors.push(failure);
+          throw failure;
+        } finally {
+          const writer = closingWriter;
+          closingWriter = undefined;
+          closingFailure = undefined;
+          await releaseSessionSourceAuthorities(writer ? [writer] : [], errors);
+        }
+      };
+      return withClientVoiceSessionSettlement(
+        settleClose,
+        (error) => settleClose({ error }),
+        voiceSessionSource?.settlementContext,
+      );
+    },
+  });
+  let requestedDisposition: "abort" | "detach" = "detach";
+  let bridge: RealtimeVoiceBridgeSession;
+  try {
+    bridge = createRealtimeVoiceBridgeSession({
+      cfg: config,
+      agentId: target.agentId,
+      provider: resolution.provider,
+      providerConfig: launch.providerConfig,
+      capabilities: resolution.capabilities,
+      audioFormat: params.audioFormat,
+      audioSink: params.audioSink,
+      initialItems,
+      instructions:
+        controlSource === "delegation"
+          ? providerInstructions
+          : buildRealtimeInstructions(providerInstructions),
+      tools:
+        controlSource === "delegation"
+          ? []
+          : [REALTIME_VOICE_AGENT_CONSULT_TOOL, REALTIME_VOICE_AGENT_CONTROL_TOOL],
+      runAgentConsult: owner.runAgentConsult,
+      handleDelegationInput: (text, respond) => {
+        if (callControl.handleInput(text) || callControl.hangupRequested) {
+          return "control";
+        }
+        assertCurrent();
+        return owner.control.handleDelegationInput?.(text, respond) ?? "consult";
+      },
+      triggerGreetingOnReady: false,
+      onReady: () => {
+        owner.control.onReady?.();
+        params.onReady?.();
+      },
+      onTranscript: (role, text, done) => {
+        owner.control.onTranscript?.(role, text, done);
+        params.onTranscript?.(role, text, done);
+        if (role === "user" && done) {
+          callControl.handleInput(text);
+        }
+      },
+      onEvent: (event) => {
+        owner.control.onEvent?.(event);
+        params.onEvent?.(event);
+      },
+      onResponseDone: (outcome) => {
+        owner.control.onResponseDone?.(outcome);
+        params.onResponseDone?.(outcome);
+      },
+      onToolCall: (event) => owner.control.onToolCall?.(event),
+      onError: (error) => {
+        owner.control.onError?.(error);
+        params.onError?.(error);
+      },
+      onClose: (reason) => {
+        owner.control.onClose?.(reason);
+        try {
+          params.onClose?.(reason);
+        } finally {
+          void Promise.resolve()
+            .then(() => close())
+            .catch((error: unknown) =>
+              host.context.logGateway.warn(`talk carrier cleanup failed: ${String(error)}`),
+            );
+        }
+      },
+    });
+  } catch (error) {
+    await owner.close();
+    cleanupTalkConnection(ownerId, host.context.logGateway);
+    throw error;
+  }
+  owner.control.bindControl({
+    sendUserMessage: (text) => bridge.sendUserMessage(text),
+    submitToolResult: (callId, result, options) => bridge.submitToolResult(callId, result, options),
+  });
+  let connectPromise: Promise<void> | undefined;
+  let closePromise: Promise<void> | undefined;
+  const close: RealtimeVoiceCarrierSession["close"] = (options) => {
+    if (!closePromise) {
+      requestedDisposition = options?.disposition ?? "detach";
+      params.signal.removeEventListener("abort", onAbort);
+      closePromise = owner
+        .close()
+        .finally(() => cleanupTalkConnection(ownerId, host.context.logGateway));
+    }
+    return closePromise;
+  };
+  const onAbort = () => {
+    void Promise.resolve(close()).catch((error: unknown) =>
+      host.context.logGateway.warn(`talk carrier cleanup failed: ${String(error)}`),
+    );
+  };
+  params.signal.addEventListener("abort", onAbort, { once: true });
+  try {
+    await owner.adoptProvider(async () => {
+      await bridge.close({ disposition: requestedDisposition });
+    });
+    assertCurrent();
+  } catch (error) {
+    await close();
+    throw error;
+  }
+  return {
+    ...bridge,
+    sessionKey: target.canonicalKey,
+    voiceSessionId,
+    providerId: resolution.provider.id,
+    close,
+    connect: () => {
+      connectPromise ??= (async () => {
+        try {
+          assertCurrent();
+          owner.assertOpen();
+          await ensureClientVoiceAgentSessionEntry({
+            ...sessionTarget,
+            creation: { actor: { type: "human", source: "channel", id: params.owner.handle } },
+            assertCurrent: () => {
+              assertCurrent();
+              owner.assertOpen();
+            },
+          });
+          assertCurrent();
+          owner.assertOpen();
+          const source = captureClientVoiceSessionSource(target.agentId);
+          voiceSessionSource = source;
+          voiceCreation = withClientVoiceSessionSettlement(
+            async () => {
+              const writer = captureClientVoiceSessionWriter({
+                agentId: target.agentId,
+                physicalSource: source,
+              });
+              const errors: unknown[] = [];
+              try {
+                await createOrResumeClientVoiceSession(
+                  {
+                    agentId: target.agentId,
+                    sessionKey: target.canonicalKey,
+                    provider: resolution.provider.id,
+                    origin: "client",
+                    transcriptCapable: true,
+                    voiceSessionId,
+                    requester: assertCurrent,
+                    source: { storePath: target.storePath, assertCurrent },
+                    assertCurrent: () => {
+                      assertCurrent();
+                      owner.assertOpen();
+                    },
+                  },
+                  writer,
+                );
+                logicalSessionCreated = true;
+                voiceSessionSource = writer.source;
+              } catch (error) {
+                errors.push(error);
+                throw error;
+              } finally {
+                await releaseSessionSourceAuthorities([writer], errors);
+              }
+            },
+            undefined,
+            source.settlementContext,
+          );
+          await voiceCreation;
+          assertCurrent();
+          owner.assertOpen();
+          owner.activate();
+          await bridge.connect();
+          assertCurrent();
+          owner.assertOpen();
+        } catch (error) {
+          await close();
+          throw error;
+        }
+      })();
+      return connectPromise;
+    },
+  };
+}
diff --git a/src/gateway/talk/client-gateway-control.ts b/src/gateway/talk/client-gateway-control.ts
