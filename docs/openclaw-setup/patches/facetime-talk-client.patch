@@ -97,3 +97,19 @@
 The separately released Objective-C and Swift native sources, their adapted
 third-party notices, and their signing pipeline live in
 `openclaw/openclaw-facetime`.
+
+## Stable audio consent
+
+Runtime setup stages the vendor-signed capture helper at a stable physical path
+in `~/Library/Application Support/OpenClaw/FaceTime/audio`. A small native
+launcher makes that helper its own macOS audio-permission identity, independent
+of Node and Homebrew's versioned installation paths. The helper is not re-signed.
+Setup builds the launcher with the already-required Xcode tools only when its
+source or the installed helper changes. Subsequent starts reuse the staged files.
+
+The launcher replaces its own process, preserving the capture PID, standard
+streams, and shutdown controls. It accepts only capture, `--check`, and
+`--default-devices`; unsupported macOS responsibility APIs fail explicitly.
+Normal macOS consent is still required. A successful process-tap startup is not
+proof of consent or audible audio. Node upgrade and native-helper upgrade
+persistence require separate acceptance checks.
diff --git a/extensions/facetime/scripts/capture-launcher.c b/extensions/facetime/scripts/capture-launcher.c
new file mode 100644
--- /dev/null
+++ b/extensions/facetime/scripts/capture-launcher.c
@@ -0,0 +1,53 @@
+// Keep macOS audio consent on the signed native helper across Node upgrades.
+// Process replacement preserves the PID, PCM pipes and stdin safety protocol.
+#include <dlfcn.h>
+#include <limits.h>
+#include <mach-o/dyld.h>
+#include <spawn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char **environ;
+typedef int (*disclaim_fn)(posix_spawnattr_t *, int);
+
+int main(int argc, char **argv) {
+  if (argc > 2 || (argc == 2 && strcmp(argv[1], "--check") != 0 &&
+                   strcmp(argv[1], "--default-devices") != 0)) {
+    fputs("Usage: capture-launcher [--check|--default-devices]\n", stderr);
+    return 64;
+  }
+  char executable[PATH_MAX], target[PATH_MAX];
+  uint32_t size = sizeof executable;
+  if (_NSGetExecutablePath(executable, &size) != 0 || !realpath(executable, target)) {
+    fputs("capture-launcher: cannot resolve installation\n", stderr);
+    return 78;
+  }
+  char *slash = strrchr(target, '/');
+  if (!slash) return 78;
+  *slash = '\0';
+  const char suffix[] = "/facetime-audio-capture";
+  if (strlen(target) + sizeof suffix > sizeof target) return 78;
+  strcat(target, suffix);
+
+  // macOS SPI also used by the Apple PIM launcher. Never fall back to Node's identity.
+  disclaim_fn disclaim = (disclaim_fn)dlsym(RTLD_DEFAULT, "responsibility_spawnattrs_setdisclaim");
+  if (!disclaim) {
+    fputs("capture-launcher: macOS audio responsibility API unavailable; rerun FaceTime setup\n", stderr);
+    return 78;
+  }
+  posix_spawnattr_t attr;
+  int error = posix_spawnattr_init(&attr);
+  if (error) return 78;
+  error = disclaim(&attr, 1);
+  if (!error) error = posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETEXEC);
+  if (!error) {
+    char *args[] = {target, argc == 2 ? argv[1] : NULL, NULL};
+    error = posix_spawn(NULL, target, NULL, &attr, args, environ);
+  }
+  posix_spawnattr_destroy(&attr);
+  fprintf(stderr, "capture-launcher: cannot start signed audio helper: %s\n", strerror(error));
+  return 78;
+}
