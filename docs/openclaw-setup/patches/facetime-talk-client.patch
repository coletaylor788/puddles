+    await vi.waitFor(() => expect(remove).toHaveBeenCalledWith("abort", expect.any(Function)));
+    expect(mocks.logicalClose).toHaveBeenCalledOnce();
+    expect(mocks.append).toHaveBeenCalledWith(
+      expect.objectContaining({ text: "provider final transcript" }),
+    );
+  });
+
+  it("rechecks carrier authority after awaited preparation and at the persistent commit", async () => {
+    const f = fixture();
+    mocks.instructions.mockImplementationOnce(async () => {
+      f.call.abort();
+      return "native instructions";
+    });
+    await expect(
+      createTalkCarrierSession(f.params, { context: f.context, pluginId: "test-carrier" }),
+    ).rejects.toThrow();
+    expect(mocks.logicalCreate).not.toHaveBeenCalled();
+    expect(f.media.connect).not.toHaveBeenCalled();
+
+    const next = fixture();
+    const session = await createTalkCarrierSession(next.params, {
+      context: next.context,
+      pluginId: "test-carrier",
+    });
+    sessions.push(session);
+    mocks.ensure.mockImplementationOnce(async (params?: { assertCommitAllowed?: () => void }) => {
+      next.assertCurrent.mockImplementation(() => {
+        throw new Error("owner removed");
+      });
+      params?.assertCommitAllowed?.();
+      return "session-id";
+    });
+    await expect(session.connect()).rejects.toThrow("owner removed");
+    expect(mocks.logicalCreate).not.toHaveBeenCalled();
+    expect(next.media.connect).not.toHaveBeenCalled();
+    expect(next.media.close).toHaveBeenCalled();
+  });
