@@ -0,0 +1,389 @@
+import type { OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { resolveGatewayPort } from "openclaw/plugin-sdk/gateway-config-runtime";
+import {
+  GatewayClient,
+  resolveGatewayAuth,
+  startGatewayClientWhenEventLoopReady,
+} from "openclaw/plugin-sdk/gateway-runtime";
+import type { RuntimeLogger } from "openclaw/plugin-sdk/plugin-runtime";
+import type { TalkEvent } from "openclaw/plugin-sdk/realtime-voice";
+import { buildAgentMainSessionKey } from "openclaw/plugin-sdk/routing";
+import { asRecord } from "openclaw/plugin-sdk/string-coerce-runtime";
+import { raceWithTimeout } from "openclaw/plugin-sdk/time-runtime";
+import { startFaceTimeAudioPump } from "./audio-pump.js";
+import { isAuthorizedFaceTimeHandle } from "./call-events.js";
+import type { FaceTimeConfig } from "./config.js";
+import { agentIdFromSessionKey, REALTIME_READY_TIMEOUT_MS } from "./talk-driver-config.js";
+
+const scopes = ["operator.talk", "operator.read", "operator.write", "operator.admin"];
+const MAX_PENDING_AUDIO_BYTES = 2 * 1024 * 1024;
+
+/** A normal authenticated client. The Gateway owns admission and granted scopes. */
+export async function connectFaceTimeTalkGateway(params: {
+  config: OpenClawConfig;
+  signal?: AbortSignal;
+  onEvent?: (payload: Record<string, unknown>) => void;
+  onClose?: (error: Error) => void;
+}) {
+  const auth = resolveGatewayAuth({
+    authConfig: params.config.gateway?.auth,
+    tailscaleMode: params.config.gateway?.tailscale?.mode,
+  });
+  const connected = createDeferred<void>();
+  void connected.promise.catch(() => {});
+  const start = new AbortController();
+  const abort = () => {
+    start.abort();
+    connected.reject(new Error("FaceTime Talk connection cancelled"));
+  };
+  const client = new GatewayClient({
+    url: `${params.config.gateway?.tls?.enabled ? "wss" : "ws"}://127.0.0.1:${resolveGatewayPort(params.config)}`,
+    token: auth.token,
+    password: auth.password,
+    clientName: "cli",
+    clientDisplayName: "FaceTime",
+    role: "operator",
+    scopes,
+    requestTimeoutMs: REALTIME_READY_TIMEOUT_MS,
+    onHelloOk(hello) {
+      if (!scopes.every((scope) => hello.auth.scopes.includes(scope))) {
+        connected.reject(new Error("FaceTime Talk requires an authorized owner connection"));
+        return;
+      }
+      connected.resolve();
+    },
+    onConnectError(error) {
+      connected.reject(error);
+    },
+    onEvent(event) {
+      if (event.event === "talk.event") params.onEvent?.(asRecord(event.payload));
+    },
+    onClose(_code, reason) {
+      const error = new Error(`FaceTime Talk connection closed: ${reason}`);
+      connected.reject(error);
+      params.onClose?.(error);
+    },
+  });
+  params.signal?.addEventListener("abort", abort, { once: true });
+  try {
+    params.signal?.throwIfAborted();
+    await raceWithTimeout(
+      async () => {
+        void startGatewayClientWhenEventLoopReady(client, {
+          timeoutMs: REALTIME_READY_TIMEOUT_MS,
+          signal: start.signal,
+        }).then((result) => {
+          if (!result.ready) connected.reject(new Error("FaceTime Gateway was not ready"));
+        }, connected.reject);
+        await connected.promise;
+      },
+      REALTIME_READY_TIMEOUT_MS,
+      () => {
+        throw new Error("FaceTime Talk connection timed out");
+      },
+    );
+    return client;
+  } catch (error) {
+    await client.stopAndWait();
+    throw error;
+  } finally {
+    start.abort();
+    params.signal?.removeEventListener("abort", abort);
+  }
+}
+
+export async function checkFaceTimeTalkProvider(config: OpenClawConfig, sessionKey: string) {
+  const client = await connectFaceTimeTalkGateway({ config });
+  try {
+    const catalog = asRecord(await client.request("talk.catalog", { sessionKey }));
+    const realtime = asRecord(catalog.realtime);
+    if (realtime.ready !== true) throw new Error("Native Talk realtime provider is not ready");
+    return String(realtime.activeProvider ?? "configured Talk provider");
+  } finally {
+    await client.stopAndWait();
+  }
+}
+
+export async function startNativeFaceTimeTalkDriver(params: {
+  config: FaceTimeConfig;
+  fullConfig: OpenClawConfig;
+  logger: RuntimeLogger;
+  callUUID: string;
+  senderId: string;
+  captureBinary: string;
+  signal?: AbortSignal;
+  onFailure?: (error: Error) => boolean | Promise<boolean>;
+}) {
+  params.signal?.throwIfAborted();
+  if (
+    !isAuthorizedFaceTimeHandle({
+      handle: params.senderId,
+      ownerHandles: params.config.ownerHandles,
+    })
+  ) {
+    throw new Error("FaceTime caller is not authorized");
+  }
+  const agentId = agentIdFromSessionKey(params.config.realtime.sessionKey, params.fullConfig);
+  const sessionKey = params.config.realtime.sessionKey.startsWith("agent:")
+    ? params.config.realtime.sessionKey
+    : buildAgentMainSessionKey({
+        agentId,
+        mainKey:
+          params.config.realtime.sessionKey === "main"
+            ? params.fullConfig.session?.mainKey
+            : params.config.realtime.sessionKey,
+      });
+  const ready = createDeferred<void>();
+  void ready.promise.catch(() => {});
+  const recentTalkEvents: TalkEvent[] = [];
+  let client: GatewayClient | undefined;
+  let relaySessionId: string | undefined;
+  let suspended = false;
+  let activated = false;
+  let providerReady = false;
+  let stopped = false;
+  let timestamp = 0;
+  let pendingBytes = 0;
+  const earlyEvents: Record<string, unknown>[] = [];
+  const marks: string[] = [];
+  let failure: Promise<boolean> | undefined;
+  let detach: Promise<void> | undefined;
+  let suspension: Promise<void> | undefined;
+  let closure: Promise<void> | undefined;
+  const startup = new AbortController();
+  let startupWork: Promise<void> = Promise.resolve();
+
+  const detachSession = () => {
+    if (!client) return Promise.resolve();
+    return (detach ??= (async () => {
+      if (relaySessionId && client) {
+        try {
+          await client.request("talk.session.close", {
+            sessionId: relaySessionId,
+            disposition: "detach",
+          });
+        } finally {
+          await client.stopAndWait();
+        }
+      } else {
+        await client?.stopAndWait();
+      }
+    })());
+  };
+  const suspendMedia = async (_reason = "suspended") => {
+    if (suspension) return suspension;
+    suspended = true;
+    activated = false;
+    startup.abort();
+    ready.reject(new Error("FaceTime Talk media suspended"));
+    earlyEvents.length = 0;
+    marks.length = 0;
+    void detachSession().catch((error: unknown) =>
+      params.logger.warn(`[facetime] Talk detach failed: ${String(error)}`),
+    );
+    suspension = pump.suspendMedia();
+    return suspension;
+  };
+  const close = async (reason = "closed") => {
+    if (closure) return closure;
+    stopped = true;
+    closure = (async () => {
+      params.signal?.removeEventListener("abort", onAbort);
+      const results = await Promise.allSettled([
+        suspendMedia(reason),
+        pump.stop(),
+        startupWork.catch(() => {}),
+      ]);
+      results.push(...(await Promise.allSettled([detachSession()])));
+      const errors = results.flatMap((result) =>
+        result.status === "rejected" ? [result.reason] : [],
+      );
+      if (errors.length) throw new AggregateError(errors, "FaceTime Talk cleanup failed");
+    })();
+    return closure;
+  };
+  const fail = (error: Error) =>
+    (failure ??= (async () => {
+      ready.reject(error);
+      let reported = error;
+      try {
+        await suspendMedia("failed");
+      } catch (suspensionError) {
+        reported = new AggregateError(
+          [error, suspensionError],
+          "FaceTime Talk failed to suspend media",
+        );
+      }
+      const safeToClose = (await params.onFailure?.(reported)) !== false;
+      if (safeToClose) await close("failed");
+      return safeToClose;
+    })());
+  const reportFailure = (error: unknown) => {
+    void fail(error instanceof Error ? error : new Error(String(error))).catch((cause: unknown) => {
+      params.logger.warn(`[facetime] Talk media cleanup failed: ${String(cause)}`);
+    });
+  };
+  const request = (method: string, body: Record<string, unknown>) => {
+    if (suspended || stopped || !client || !relaySessionId) return;
+    void client.request(method, { sessionId: relaySessionId, ...body }).catch(reportFailure);
+  };
+  const acknowledgePlayback = () => {
+    if (pump.queuedAudioFrames() > 0) return;
+    for (const markName of marks.splice(0)) request("talk.session.acknowledgeMark", { markName });
+  };
+  const pump = startFaceTimeAudioPump({
+    captureBinary: params.captureBinary,
+    logger: params.logger,
+    onInputAudio(audio) {
+      if (!activated || suspended || stopped) return;
+      timestamp += audio.byteLength / 48;
+      request("talk.session.appendAudio", {
+        audioBase64: audio.toString("base64"),
+        timestamp: Math.floor(timestamp),
+      });
+    },
+    onPlaybackDrained: acknowledgePlayback,
+    onSuppressionLost: reportFailure,
+    onError: (error) => fail(error),
+  });
+  const consume = (event: Record<string, unknown>) => {
+    if (suspended || stopped || event.relaySessionId !== relaySessionId) return;
+    if (event.talkEvent && typeof event.talkEvent === "object") {
+      recentTalkEvents.push(event.talkEvent as TalkEvent);
+      if (recentTalkEvents.length > 40) recentTalkEvents.shift();
+    }
+    switch (event.type) {
+      case "ready":
+        providerReady = true;
+        ready.resolve();
+        break;
+      case "audio":
+        if (typeof event.audioBase64 === "string") {
+          pump.writeOutputAudio(
+            Buffer.from(event.audioBase64, "base64"),
+            typeof event.itemId === "string" ? { itemId: event.itemId } : undefined,
+          );
+        }
+        break;
+      case "audioDone":
+        pump.finishOutputAudio();
+        break;
+      case "mark":
+        if (typeof event.markName === "string") {
+          marks.push(event.markName);
+          acknowledgePlayback();
+        }
+        break;
+      case "clear":
+        marks.length = 0;
+        pump.clearOutputAudio();
+        break;
+      case "error":
+        reportFailure(new Error(String(event.message ?? "Talk failed")));
+        break;
+      case "close":
+        reportFailure(new Error(`Talk closed: ${String(event.reason)}`));
+        break;
+    }
+  };
+  const onEvent = (event: Record<string, unknown>) => {
+    if (suspended || stopped) return;
+    // Events can precede the create response. Once bound, accept only this relay.
+    if (relaySessionId && event.relaySessionId !== relaySessionId) return;
+    if (
+      !relaySessionId ||
