+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import type { RealtimeVoiceBridgeCreateRequest } from "../../talk/provider-types.js";
+import type { GatewayRequestContext } from "../server-methods/types.js";
+import { createTalkCarrierSession } from "./carrier-session.js";
+import { controlBridge, sessionTarget } from "./client-gateway-control.test-support.js";
+
+const mocks = vi.hoisted(() => ({
+  resolve: vi.fn(),
+  ensure: vi.fn(async () => "session-id"),
+  append: vi.fn(async () => {}),
+  flush: vi.fn(async () => {}),
+  logicalClose: vi.fn(async () => {}),
+  logicalCreate: vi.fn(),
+  createRunner: vi.fn(),
+  assertTarget: vi.fn(),
+  readHistory: vi.fn(async () => [{ role: "user" as const, text: "remember our plan" }]),
+  instructions: vi.fn(async () => "native instructions"),
+  config: vi.fn(),
+}));
+vi.mock("../../secrets/runtime-degraded-state.js", () => ({ assertSecretOwnerAvailable: vi.fn() }));
+vi.mock("../../talk/provider-resolver.js", () => ({
+  resolveConfiguredRealtimeVoiceProvider: mocks.resolve,
+}));
+vi.mock("../../talk/client-voice-session.js", () => ({
+  appendClientVoiceTranscript: mocks.append,
+  closeClientVoiceSession: mocks.logicalClose,
+  createOrResumeClientVoiceSession: mocks.logicalCreate,
+  ensureClientVoiceAgentSessionEntry: mocks.ensure,
+  flushClientVoiceSessionWrites: mocks.flush,
+}));
+vi.mock("./client-agent-consult.js", () => ({
+  createTalkClientAgentConsultRunner: mocks.createRunner,
+}));
+vi.mock("./session-target.js", () => ({
+  prepareTalkSessionTarget: () => ({
+    agentId: "main",
+    sessionKey: "main",
+    canonicalKey: "agent:main:main",
+    storePath: "/tmp/sessions",
+  }),
+  assertTalkSessionStorageTarget: mocks.assertTarget,
+}));
+vi.mock("./session-history.js", () => ({ readTalkRealtimeInitialItems: mocks.readHistory }));
+vi.mock("./session-config.js", () => ({
+  buildTalkRealtimeConfig: mocks.config,
+  buildRealtimeVoiceLaunchOptions: ({ defaults }: { defaults: unknown }) => defaults,
+  resolveTalkRealtimeGatewayRelayLaunch: ({ providerConfig }: { providerConfig: unknown }) => ({
+    providerConfig,
+  }),
+  resolveTalkRealtimeProviderInstructions: mocks.instructions,
+  buildRealtimeInstructions: (instructions: string) => instructions,
+}));
+
+function fixture() {
+  const config: OpenClawConfig = { talk: { consultThinkingLevel: "high" } };
+  const call = new AbortController();
+  const assertCurrent = vi.fn();
+  let request: RealtimeVoiceBridgeCreateRequest | undefined;
+  const media = controlBridge();
+  media.connect.mockImplementation(async () => {
+    request?.onReady?.();
+  });
+  media.close.mockImplementation(() => {
+    request?.onTranscript?.("assistant", "final spoken words", true);
+  });
+  mocks.resolve.mockReturnValue({
+    provider: {
+      id: "test-provider",
+      createBridge: (params: RealtimeVoiceBridgeCreateRequest) => {
+        request = params;
+        return media;
+      },
+    },
+    providerConfig: { model: "inherited-model", voice: "inherited-voice" },
+    capabilities: { handlesAgentConsult: true },
+  });
+  const run = Object.assign(
+    vi.fn(async () => ({ text: "done" })),
+    {
+      adoptCompletionClaims: vi.fn(),
+      claimAppend: vi.fn(() => true),
+      claimFailureAppend: vi.fn(() => true),
+      revokeRequesterFinal: vi.fn(),
+      steer: vi.fn(async () => ({ text: "steered" })),
+    },
+  );
+  mocks.createRunner.mockReturnValue({
+    runArgs: run,
+    runOwnedArgs: run,
+    getToolAuthorityOverlay: vi.fn(),
+  });
+  const context = {
+    getRuntimeConfig: () => config,
+    chatAbortControllers: new Map(),
+    logGateway: { warn: vi.fn() },
+    broadcastToConnIds: vi.fn(),
+  } as unknown as GatewayRequestContext;
+  const params = {
+    callId: "real-carrier-call",
+    sessionKey: "main",
+    owner: { handle: "owner@example.test", assertCurrent },
+    signal: call.signal,
+    audioSink: { sendAudio: vi.fn() },
+  };
+  return { context, params, call, media, run, request: () => request!, config, assertCurrent };
+}
+const sessions: Awaited<ReturnType<typeof createTalkCarrierSession>>[] = [];
+afterEach(async () => {
+  await Promise.allSettled(sessions.splice(0).map((session) => session.close()));
+});
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.config.mockReturnValue({ provider: "test-provider", model: "inherited-model" });
+  mocks.ensure.mockImplementation(async () => "session-id");
+  mocks.instructions.mockResolvedValue("native instructions");
+});
+
+describe("host-owned Talk carrier", () => {
+  it("inherits native configuration, canonical history, and full runner ownership", async () => {
+    const f = fixture();
+    const session = await createTalkCarrierSession(f.params, {
+      context: f.context,
+      pluginId: "test-carrier",
+    });
+    sessions.push(session);
+    expect(session.sessionKey).toBe(sessionTarget.canonicalKey);
+    expect(mocks.resolve).toHaveBeenCalledWith(
+      expect.objectContaining({ cfg: f.config, surface: "gateway-relay" }),
+    );
+    expect(f.request()).toMatchObject({
+      instructions: "native instructions",
+      initialItems: [{ role: "user", text: "remember our plan" }],
+      tools: [],
+    });
+    expect(mocks.createRunner).toHaveBeenCalledWith(
+      expect.objectContaining({
+        config: f.config,
+        authority: { senderIsOwner: true },
+        initialItems: [{ role: "user", text: "remember our plan" }],
+      }),
+    );
+    await session.connect();
+    const runner = f.request().runAgentConsult!;
+    expect(runner.steer).toBeTypeOf("function");
+    runner.adoptCompletionClaims?.();
+    await expect(runner({ prompt: "real task" })).resolves.toEqual({ text: "done" });
+    expect(f.run).toHaveBeenCalled();
+    expect(f.context.broadcastToConnIds).not.toHaveBeenCalled();
+  });
+
+  it("hangup detaches accepted work and flushes the provider's final transcript", async () => {
+    const f = fixture();
+    let complete!: (result: { text: string }) => void;
+    let admitted!: () => void;
+    const admission = new Promise<void>((resolve) => {
+      admitted = resolve;
+    });
+    let acceptedSignal: AbortSignal | undefined;
+    f.run.mockImplementation(async (_args?: unknown, signal?: AbortSignal) => {
+      acceptedSignal = signal;
+      admitted();
+      return await new Promise<{ text: string }>((resolve) => {
+        complete = resolve;
+      });
+    });
+    const session = await createTalkCarrierSession(f.params, {
+      context: f.context,
+      pluginId: "test-carrier",
+    });
+    sessions.push(session);
+    await session.connect();
+    const runner = f.request().runAgentConsult!;
+    const result = runner({ prompt: "continue after hangup" });
+    await admission;
+    await session.close();
+    expect(f.media.close).toHaveBeenCalledWith({ disposition: "detach" });
+    expect(acceptedSignal?.aborted).toBe(false);
+    expect(mocks.append).toHaveBeenCalledWith(
+      expect.objectContaining({ sessionKey: "agent:main:main", text: "final spoken words" }),
+    );
+    expect(mocks.flush).toHaveBeenCalled();
+    await expect(runner({ prompt: "late request" })).rejects.toThrow("closed");
+    complete({ text: "finished in chat" });
+    await expect(result).resolves.toEqual({ text: "finished in chat" });
+  });
+
+  it("handles spoken hangup once without consulting or cancelling accepted work", async () => {
+    const f = fixture();
+    const requestHangup = vi.fn();
+    const session = await createTalkCarrierSession(
+      { ...f.params, onHangupRequested: requestHangup },
+      { context: f.context, pluginId: "test-carrier" },
+    );
+    sessions.push(session);
+    await session.connect();
+    expect(await f.request().handleDelegationInput?.("please hang up", vi.fn())).toBe("control");
+    f.request().onTranscript?.("user", "please hang up", true);
+    expect(requestHangup).toHaveBeenCalledOnce();
+    expect(f.run).not.toHaveBeenCalled();
+    expect(f.media.close).not.toHaveBeenCalled();
+    await expect(f.request().runAgentConsult!({ prompt: "new work" })).rejects.toThrow("ending");
+    await session.close();
+    expect(f.media.close).toHaveBeenCalledWith({ disposition: "detach" });
+  });
+
+  it("releases carrier listeners on provider termination even when its callback throws", async () => {
+    const f = fixture();
+    const remove = vi.spyOn(f.call.signal, "removeEventListener");
+    const session = await createTalkCarrierSession(
+      {
+        ...f.params,
+        onClose: () => {
+          throw new Error("carrier callback failed");
+        },
+      },
+      { context: f.context, pluginId: "test-carrier" },
+    );
+    sessions.push(session);
+    await session.connect();
+    f.request().onTranscript?.("assistant", "provider final transcript", true);
+    expect(() => f.request().onClose?.("completed")).toThrow("carrier callback failed");
+    await vi.waitFor(() => expect(remove).toHaveBeenCalledWith("abort", expect.any(Function)));
+    expect(mocks.logicalClose).toHaveBeenCalledOnce();
+    expect(mocks.append).toHaveBeenCalledWith(
+      expect.objectContaining({ text: "provider final transcript" }),
+    );
+  });
+
+  it("rechecks carrier authority after awaited preparation and at the persistent commit", async () => {
+    const f = fixture();
+    mocks.instructions.mockImplementationOnce(async () => {
+      f.call.abort();
+      return "native instructions";
+    });
+    await expect(
+      createTalkCarrierSession(f.params, { context: f.context, pluginId: "test-carrier" }),
+    ).rejects.toThrow();
+    expect(mocks.logicalCreate).not.toHaveBeenCalled();
+    expect(f.media.connect).not.toHaveBeenCalled();
+
+    const next = fixture();
+    const session = await createTalkCarrierSession(next.params, {
+      context: next.context,
+      pluginId: "test-carrier",
+    });
+    sessions.push(session);
+    mocks.ensure.mockImplementationOnce(async (params?: { assertCommitAllowed?: () => void }) => {
+      next.assertCurrent.mockImplementation(() => {
+        throw new Error("owner removed");
+      });
+      params?.assertCommitAllowed?.();
+      return "session-id";
+    });
+    await expect(session.connect()).rejects.toThrow("owner removed");
+    expect(mocks.logicalCreate).not.toHaveBeenCalled();
+    expect(next.media.connect).not.toHaveBeenCalled();
+    expect(next.media.close).toHaveBeenCalled();
+  });
+});
