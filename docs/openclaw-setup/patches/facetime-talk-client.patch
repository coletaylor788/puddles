+import type { RealtimeVoiceAudioFormat, RealtimeVoiceBridgeCallbacks } from "./provider-types.js";
+import type { RealtimeVoiceAudioSink, RealtimeVoiceBridgeSession } from "./session-runtime.js";
+
+/** Host-owned Talk conversation with a trusted carrier providing only media and owner admission. */
+export type RealtimeVoiceCarrierSessionParams = {
+  callId: string;
+  sessionKey?: string;
+  owner: {
