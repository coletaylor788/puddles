+  child.stderr!.on("data", (data) => {
+    output += data.toString();
+  });
+  const done = new Promise<{ code: number | null; elapsed: number; output: string }>(
+    (complete, reject) => {
+      child.once("error", reject);
+      // close waits for inherited output pipes too, unlike exit.
+      child.once("close", (code) =>
+        complete({ code, elapsed: performance.now() - started, output }),
+      );
+    },
+  );
+  fixtures.push({ root, child, done });
+  return { root, container, child, done };
+}
