diff --git a/extensions/facetime/tests/capture-launcher.test.ts b/extensions/facetime/tests/capture-launcher.test.ts
new file mode 100644
index 0000000..fabe197
--- /dev/null
+++ b/extensions/facetime/tests/capture-launcher.test.ts
@@ -0,0 +1,236 @@
+import { spawn, spawnSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { once } from "node:events";
+import { cp, mkdtemp, mkdir, readFile, rm, stat, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+
+describe.skipIf(process.platform !== "darwin")("FaceTime capture identity launcher", () => {
+  let root: string;
+  let launcher: string;
+  beforeAll(async () => {
+    root = await mkdtemp(join(tmpdir(), "facetime-capture-launcher-"));
+    launcher = join(root, "capture-launcher");
+    const source = resolve(import.meta.dirname, "../scripts/capture-launcher.c");
+    const helperSource = join(root, "helper.c");
+    await writeFile(
+      helperSource,
+      `#include <stdio.h>
+#include <unistd.h>
+int main(int argc, char **argv) {
+  printf("pid=%d;mode=%s\\n", getpid(), argc == 2 ? argv[1] : "capture");
+  fflush(stdout);
+  char data[256]; ssize_t count;
+  while ((count = read(0, data, sizeof data)) > 0) write(1, data, count);
+  return 0;
+}`,
+    );
+    for (const [input, output] of [
+      [source, launcher],
+      [helperSource, join(root, "facetime-audio-capture")],
+    ]) {
+      const result = spawnSync(
+        "/usr/bin/xcrun",
+        ["clang", "-Wall", "-Wextra", "-Werror", input!, "-o", output!],
+        { encoding: "utf8" },
+      );
+      expect(result.status, result.stderr).toBe(0);
+    }
+    const absentSource = join(root, "absent-api.c");
+    await writeFile(
+      absentSource,
+      (await readFile(source, "utf8")).replace(
+        '"responsibility_spawnattrs_setdisclaim"',
+        '"facetime_nonexistent_responsibility_api"',
+      ),
+    );
+    const result = spawnSync(
+      "/usr/bin/xcrun",
+      ["clang", absentSource, "-o", join(root, "absent-api")],
+      { encoding: "utf8" },
+    );
+    expect(result.status, result.stderr).toBe(0);
+  });
+  afterAll(async () => {
+    if (root) {
+      await rm(root, { recursive: true, force: true });
+    }
+  });
+
+  it.each([[], ["--check"], ["--default-devices"]])(
+    "preserves PID, mode, PCM bytes, and EOF for %j",
+    async (...args) => {
+      const child = spawn(launcher, args, { stdio: ["pipe", "pipe", "pipe"] });
+      const done = once(child, "close");
+      const chunks: Buffer[] = [];
+      child.stdout.on("data", (data) => chunks.push(data));
+      const payload = Buffer.from([4, 0, 0, 0, 4, 0, 0, 0, 0, 255]);
+      child.stdin.end(payload);
+      expect(await done).toEqual([0, null]);
+      const output = Buffer.concat(chunks);
+      const header = Buffer.from(`pid=${child.pid};mode=${args[0] ?? "capture"}\n`);
+      expect(output.subarray(0, header.length)).toEqual(header);
+      expect(output.subarray(header.length)).toEqual(payload);
+    },
+  );
+
+  it.each(["SIGTERM", "SIGKILL"] as const)(
+    "terminates the actual capture PID with %s",
+    async (signal) => {
+      const child = spawn(launcher, [], { stdio: ["pipe", "pipe", "pipe"] });
+      const done = once(child, "close");
+      try {
+        const [header] = await once(child.stdout, "data");
+        expect(header.toString()).toContain(`pid=${child.pid};`);
+        child.kill(signal);
+        expect(await done).toEqual([null, signal]);
+        expect(() => process.kill(child.pid!, 0)).toThrow();
+      } finally {
+        child.kill("SIGKILL");
+      }
+    },
+  );
+
+  it("rejects extra modes and unavailable responsibility APIs without starting capture", () => {
+    for (const args of [["/bin/sh"], ["--process", "anything"], ["--check", "extra"]]) {
+      const result = spawnSync(launcher, args, { encoding: "utf8" });
+      expect(result.status).toBe(64);
+      expect(result.stdout).toBe("");
+    }
+    const result = spawnSync(join(root, "absent-api"), [], { encoding: "utf8" });
+    expect(result.status).toBe(78);
+    expect(result.stdout).toBe("");
+    expect(result.stderr).toContain("responsibility API unavailable");
+  });
+
+  it("does not search PATH or run another command if its fixed helper is missing", async () => {
+    const empty = join(root, "empty");
+    await mkdir(empty);
+    const copy = join(empty, "capture-launcher");
+    await writeFile(copy, await readFile(launcher), { mode: 0o700 });
+    const result = spawnSync(copy, [], { encoding: "utf8" });
+    expect(result.status).toBe(78);
+    expect(result.stdout).toBe("");
+  });
+
+  it("stages unchanged helper bytes at a stable path, reuses them, and preserves them on build failure", async () => {
+    const fixture = join(root, "stage-test");
+    const scripts = join(fixture, "scripts");
+    const native = join(fixture, "brew/opt/openclaw-facetime/libexec");
+    const audio = join(fixture, "Library/Application Support/OpenClaw/FaceTime/audio");
+    await mkdir(scripts, { recursive: true });
+    await mkdir(native, { recursive: true });
+    await writeFile(join(native, "facetime-audio-capture"), "signed native bytes v1");
+    await writeFile(join(scripts, "capture-launcher.c"), "launcher source v1");
+    await writeFile(join(scripts, "verify-native-helper.sh"), "#!/bin/sh\nexit 0\n", {
+      mode: 0o700,
+    });
+    const codeSign = join(fixture, "codesign");
+    await writeFile(codeSign, "#!/bin/sh\nexit 0\n", { mode: 0o700 });
+    const compiler = join(fixture, "xcrun");
+    await writeFile(
+      compiler,
+      `#!/bin/bash
+set -eu
+test "\${FAIL_COMPILE:-0}" != 1 || exit 1
+echo compile >> "$HOME/compiles"
+sleep "\${COMPILE_DELAY:-0}"
+cp "$TEST_COMPILED_LAUNCHER" "\${!#}"
+cat "\${@: -3:1}" >> "\${!#}"
+`,
+      { mode: 0o700 },
+    );
+    const move = join(fixture, "move");
+    await writeFile(
+      move,
+      `#!/bin/bash
+if [[ "\${FAIL_COMMIT:-0}" == 1 && "$2" == */.stage.*/capture-launcher && "$2" != */previous/* ]]; then exit 1; fi
+exec /bin/mv "$@"
+`,
+      { mode: 0o700 },
+    );
+    const original = await readFile(
+      resolve(import.meta.dirname, "../scripts/stage-capture.sh"),
+      "utf8",
+    );
+    const script = join(scripts, "stage-capture.sh");
+    await writeFile(
+      script,
+      original
+        .replaceAll("/opt/homebrew", `${fixture}/brew`)
+        .replaceAll("/usr/local", `${fixture}/unused`)
+        .replaceAll("/usr/bin/codesign", codeSign)
+        .replaceAll("/usr/bin/xcrun", compiler)
+        .replaceAll('/bin/mv -f "${stage}/', `${move} -f "\${stage}/`),
+    );
+    const run = (fail = false, failCommit = false) =>
+      spawnSync("/bin/bash", [script, native], {
+        encoding: "utf8",
+        env: {
+          ...process.env,
+          HOME: fixture,
+          TEST_COMPILED_LAUNCHER: launcher,
+          FAIL_COMPILE: fail ? "1" : "0",
+          FAIL_COMMIT: failCommit ? "1" : "0",
+        },
+      });
+    const first = run();
+    expect(first.status, first.stderr).toBe(0);
+    expect(first.stdout.trim()).toBe(join(audio, "capture-launcher"));
+    expect(await readFile(join(audio, "facetime-audio-capture"), "utf8")).toBe(
+      "signed native bytes v1",
+    );
+    const inode = (await stat(join(audio, "facetime-audio-capture"))).ino;
+    expect(run().status).toBe(0);
+    expect((await stat(join(audio, "facetime-audio-capture"))).ino).toBe(inode);
+    expect(await readFile(join(fixture, "compiles"), "utf8")).toBe("compile\n");
+    await writeFile(join(native, "facetime-audio-capture"), "signed native bytes v2");
+    expect(run(true).status).not.toBe(0);
+    expect(await readFile(join(audio, "facetime-audio-capture"), "utf8")).toBe(
+      "signed native bytes v1",
+    );
+    expect(run(false, true).status).not.toBe(0);
+    expect(await readFile(join(audio, "facetime-audio-capture"), "utf8")).toBe(
+      "signed native bytes v1",
+    );
+    expect(run().status).toBe(0);
+    expect(await readFile(join(audio, "facetime-audio-capture"), "utf8")).toBe(
+      "signed native bytes v2",
+    );
+    // Distinct source generations share one stable install and must serialize commits.
+    const otherScripts = join(fixture, "other-scripts");
+    await cp(scripts, otherScripts, { recursive: true });
+    await writeFile(join(otherScripts, "capture-launcher.c"), "launcher source v2");
+    await writeFile(join(scripts, "capture-launcher.c"), "launcher source v3");
+    const runs = [script, join(otherScripts, "stage-capture.sh")].map((entry) => {
+      const child = spawn("/bin/bash", [entry, native], {
+        env: {
+          ...process.env,
+          HOME: fixture,
+          TEST_COMPILED_LAUNCHER: launcher,
+          COMPILE_DELAY: "0.3",
+        },
+        stdio: "ignore",
+      });
+      return once(child, "close");
+    });
+    expect(await Promise.all(runs)).toEqual([
+      [0, null],
+      [0, null],
+    ]);
+    const digest = (bytes: Buffer | string) => createHash("sha256").update(bytes).digest("hex");
+    const installed = await readFile(join(audio, "capture-launcher"));
+    const receipt = (await readFile(join(audio, "installed.sha256"), "utf8")).trim().split(":");
+    expect(receipt[0]).toBe(digest(await readFile(join(audio, "facetime-audio-capture"))));
+    expect(receipt[2]).toBe(digest(installed));
+    const installedSource = installed.subarray((await readFile(launcher)).length).toString();
+    expect(["launcher source v2", "launcher source v3"]).toContain(installedSource);
+    expect(receipt[1]).toBe(digest(installedSource));
+    // Either generation may win; its next setup must observe a consistent receipt.
+    expect(run().status).toBe(0);
+    const finalInode = (await stat(join(audio, "capture-launcher"))).ino;
+    expect(run().status).toBe(0);
+    expect((await stat(join(audio, "capture-launcher"))).ino).toBe(finalInode);
+  });
+});
