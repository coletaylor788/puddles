+import { createHash } from "node:crypto";
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync, symlinkSync, realpathSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+const { resolvePinnedHelper } = await import(
+  new URL("../scripts/pinned-helper.mjs", import.meta.url).href
+);
+const roots: string[] = [];
+afterEach(() => roots.splice(0).forEach((root) => rmSync(root, { recursive: true, force: true })));
+function fixture() {
+  const root = realpathSync(mkdtempSync(join(tmpdir(), "facetime-pinned-")));
+  roots.push(root);
+  mkdirSync(join(root, "native"));
+  const buildId = "b".repeat(64);
+  const bytes = Buffer.from(`synthetic native image ${buildId}`);
+  const manifest = {
+    schemaVersion: 1,
+    developmentOnly: true,
+    buildId,
+    helperSha256: createHash("sha256").update(bytes).digest("hex"),
+    revision: "a".repeat(40),
+    tree: "c".repeat(40),
+  };
+  const dylib = join(root, "native", "FaceTimeHelper.dylib");
+  writeFileSync(dylib, bytes);
+  const save = () => writeFileSync(join(root, "native-helper.json"), JSON.stringify(manifest));
+  save();
+  return { root, manifest, dylib, save };
+}
+describe("pinned source-built call helper", () => {
+  it("requires the selected bytes and a successful signature check", () => {
+    const f = fixture();
+    const verify = vi.fn();
+    expect(resolvePinnedHelper(f.root, verify)).toMatchObject({
+      dylib: f.dylib,
+      buildId: f.manifest.buildId,
+    });
+    expect(verify).toHaveBeenCalledWith(f.dylib);
+    expect(() =>
+      resolvePinnedHelper(f.root, () => {
+        throw Error("signature invalid");
+      }),
+    ).toThrow("signature invalid");
+  });
+  it("accepts release provenance while still requiring signature integrity", () => {
+    const f = fixture();
+    const receipt = {
+      ...f.manifest,
+      schemaVersion: 2,
+      kind: "source-built",
+      configuration: "release",
+      signing: "ad-hoc",
+      patches: [{ name: "call-lifecycle.patch", sha256: "e".repeat(64) }],
+    };
+    const save = () => writeFileSync(join(f.root, "native-helper.json"), JSON.stringify(receipt));
+    save();
+    const verify = vi.fn();
+    expect(resolvePinnedHelper(f.root, verify).buildId).toBe(f.manifest.buildId);
+    expect(verify).toHaveBeenCalledWith(f.dylib);
+    expect(() =>
+      resolvePinnedHelper(f.root, () => {
+        throw Error("bad signature");
+      }),
+    ).toThrow("bad signature");
+    receipt.patches[0]!.sha256 = "invalid";
+    save();
+    expect(() => resolvePinnedHelper(f.root, verify)).toThrow("Invalid pinned");
+    receipt.patches[0]!.sha256 = "e".repeat(64);
+    receipt.configuration = "debug";
+    save();
+    expect(() => resolvePinnedHelper(f.root, verify)).toThrow("Invalid pinned");
+  });
+  it("rejects changed helper bytes before signature verification", () => {
+    const f = fixture();
+    const verify = vi.fn();
+    writeFileSync(f.dylib, "replacement");
+    expect(() => resolvePinnedHelper(f.root, verify)).toThrow("identity mismatch");
+    expect(verify).not.toHaveBeenCalled();
+  });
+  it("rejects a build ID that is not embedded in the selected binary", () => {
+    const f = fixture();
+    f.manifest.buildId = "d".repeat(64);
+    f.save();
+    expect(() => resolvePinnedHelper(f.root, vi.fn())).toThrow("identity mismatch");
+  });
+  it("rejects missing or malformed provenance without falling back", () => {
+    const f = fixture();
+    f.manifest.developmentOnly = false;
+    f.save();
+    expect(() => resolvePinnedHelper(f.root, vi.fn())).toThrow("Invalid pinned");
+    rmSync(join(f.root, "native-helper.json"));
+    expect(() => resolvePinnedHelper(f.root, vi.fn())).toThrow();
+  });
+  it("rejects a linked helper outside the selected runtime", () => {
+    const f = fixture();
+    const other = fixture();
+    rmSync(f.dylib);
+    symlinkSync(other.dylib, f.dylib);
+    expect(() => resolvePinnedHelper(f.root, vi.fn())).toThrow("regular artifact path");
+  });
+});
