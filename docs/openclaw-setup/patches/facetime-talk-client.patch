+    expect(f.media.close).not.toHaveBeenCalled();
+    await expect(f.request().runAgentConsult!({ prompt: "new work" })).rejects.toThrow("ending");
+    await session.close();
+    expect(f.media.close).toHaveBeenCalledWith({ disposition: "detach" });
+  });
+
+  it("releases carrier listeners on provider termination even when its callback throws", async () => {
+    const f = fixture();
+    const remove = vi.spyOn(f.call.signal, "removeEventListener");
