+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { resolveConfiguredRealtimeVoiceProvider } from "../../talk/provider-resolver.js";
+import {
+  buildRealtimeVoiceLaunchOptions,
+  buildTalkRealtimeConfig,
+  resolveTalkRealtimeGatewayRelayLaunch,
+} from "./session-config.js";
+
+/** Read-only carrier validation, shared by readiness checks and call creation. */
+export function resolveTalkCarrierProvider(config: OpenClawConfig, agentId: string) {
+  const defaults = buildTalkRealtimeConfig(config);
+  if (
+    (defaults.mode && defaults.mode !== "realtime") ||
+    (defaults.brain && defaults.brain !== "agent-consult")
+  ) {
+    throw new Error(
+      "Realtime voice carriers require the native realtime agent-consult Talk configuration.",
+    );
+  }
+  const launchOptions = buildRealtimeVoiceLaunchOptions({ requested: {}, defaults });
+  const resolution = resolveConfiguredRealtimeVoiceProvider({
+    cfg: config,
+    agentId,
+    configuredProviderId: defaults.provider,
+    providerConfigs: defaults.providers,
+    ...(launchOptions.model ? { providerConfigOverrides: { model: launchOptions.model } } : {}),
+    defaultModel: defaults.model,
+    surface: "gateway-relay",
+  });
+  const launch = resolveTalkRealtimeGatewayRelayLaunch({
+    provider: resolution.provider,
+    providerConfig: resolution.providerConfig,
+    cfg: config,
+    launchOptions,
+    consultRouting: defaults.consultRouting,
+  });
+  if (launch.error || launch.forceAgentConsultOnFinalTranscript) {
+    throw new Error(
+      launch.error ?? "Forced transcript consultation is not supported by this carrier.",
+    );
+  }
+  return { defaults, resolution, launch };
+}
