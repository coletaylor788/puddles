@@ -0,0 +1,215 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+const h = vi.hoisted(() => ({
+  options: undefined as any,
+  pumpOptions: undefined as any,
+  request: vi.fn(),
+  stop: vi.fn(),
+  write: vi.fn(),
+  clear: vi.fn(),
+  suspend: vi.fn(),
+  pumpStop: vi.fn(),
+  queued: 0,
+  delayHello: false,
+}));
+vi.mock("openclaw/plugin-sdk/gateway-runtime", () => ({
+  resolveGatewayAuth: () => ({ token: "synthetic-token" }),
+  GatewayClient: class {
+    constructor(options: unknown) {
+      h.options = options;
+    }
+    request = h.request;
+    stopAndWait = h.stop;
+  },
+  startGatewayClientWhenEventLoopReady: async () => {
+    if (!h.delayHello) h.options.onHelloOk({ auth: { scopes: h.options.scopes } });
+    return { ready: true };
+  },
+}));
+vi.mock("../src/audio-pump.js", () => ({
+  startFaceTimeAudioPump(options: unknown) {
+    h.pumpOptions = options;
+    return {
+      suppressionReady: async () => {},
+      routeReady: async () => {},
+      processOutputSuppressed: () => true,
+      writeOutputAudio: h.write,
+      clearOutputAudio: h.clear,
+      finishOutputAudio: vi.fn(),
+      queuedAudioFrames: () => h.queued,
+      suspendMedia: h.suspend,
+      stop: h.pumpStop,
+    };
+  },
+}));
+import { resolveFaceTimeConfig } from "../src/config.js";
+import { startNativeFaceTimeTalkDriver } from "../src/talk-native-client.js";
+const log = { info: vi.fn(), warn: vi.fn(), error: vi.fn(), debug: vi.fn() };
+const drivers: Awaited<ReturnType<typeof startNativeFaceTimeTalkDriver>>[] = [];
+const emit = (type: string, extra = {}) =>
+  h.options.onEvent({
+    event: "talk.event",
+    payload: { type, relaySessionId: "relay-1", ...extra },
+  });
+async function start(extra = {}) {
+  const driver = await startNativeFaceTimeTalkDriver({
+    config: resolveFaceTimeConfig({
+      ownerHandles: ["owner@example.test"],
+      realtime: { mode: "talk" },
+    }),
+    fullConfig: { gateway: { port: 18789 } },
+    logger: log,
+    callUUID: "call-one",
+    senderId: "owner@example.test",
+    captureBinary: "/synthetic/capture",
+    ...extra,
+  });
+  drivers.push(driver);
+  return driver;
+}
+beforeEach(() => {
+  vi.resetAllMocks();
+  h.delayHello = false;
+  h.queued = 0;
+  h.request.mockImplementation(async (method: string) => {
+    if (method === "talk.session.create") {
+      emit("ready");
+      return {
+        relaySessionId: "relay-1",
+        audio: {
+          inputEncoding: "pcm16",
+          outputEncoding: "pcm16",
+          inputSampleRateHz: 24000,
+          outputSampleRateHz: 24000,
+        },
+      };
+    }
+    return { ok: true };
+  });
+});
+afterEach(async () => {
+  for (const driver of drivers.splice(0)) await driver.close().catch(() => {});
+});
+describe("FaceTime native Talk attachment", () => {
+  it("attaches main through native Talk and exchanges audio only after activation", async () => {
+    const driver = await start();
+    await driver.readyForAudio();
+    expect(h.request).toHaveBeenCalledWith("talk.session.create", {
+      mode: "realtime",
+      transport: "gateway-relay",
+      brain: "agent-consult",
+      sessionKey: "agent:main:main",
+    });
+    const audio = Buffer.from([1, 0, 2, 0]);
+    emit("audio", { audioBase64: audio.toString("base64") });
+    h.pumpOptions.onInputAudio(audio);
+    expect(h.write).not.toHaveBeenCalled();
+    expect(h.request).not.toHaveBeenCalledWith("talk.session.appendAudio", expect.anything());
+    driver.activate();
+    expect(h.write).toHaveBeenCalledWith(audio, undefined);
+    h.pumpOptions.onInputAudio(audio);
+    expect(h.request).toHaveBeenCalledWith(
+      "talk.session.appendAudio",
+      expect.objectContaining({ sessionId: "relay-1", audioBase64: audio.toString("base64") }),
+    );
+  });
+  it("acknowledges a mark after playback drains and ignores another relay", async () => {
+    const driver = await start();
+    await driver.readyForAudio();
+    driver.activate();
+    h.queued = 100;
+    emit("mark", { markName: "played" });
+    expect(h.request).not.toHaveBeenCalledWith("talk.session.acknowledgeMark", expect.anything());
+    emit("audio", { relaySessionId: "stale", audioBase64: "AAAA" });
+    expect(h.write).not.toHaveBeenCalled();
+    h.queued = 0;
+    h.pumpOptions.onPlaybackDrained();
+    expect(h.request).toHaveBeenCalledWith("talk.session.acknowledgeMark", {
+      sessionId: "relay-1",
+      markName: "played",
+    });
+  });
+  it("detaches work on hangup and rejects later audio", async () => {
+    const driver = await start();
+    await driver.readyForAudio();
+    driver.activate();
+    await driver.close();
+    expect(h.request).toHaveBeenCalledWith("talk.session.close", {
+      sessionId: "relay-1",
+      disposition: "detach",
+    });
+    expect(h.pumpStop).toHaveBeenCalledOnce();
+    emit("audio", { audioBase64: "AAAA" });
+    expect(h.write).not.toHaveBeenCalled();
+  });
+  it("rejects an unapproved caller before connecting or starting media", async () => {
+    await expect(start({ senderId: "stranger@example.test" })).rejects.toThrow("not authorized");
+    expect(h.request).not.toHaveBeenCalled();
+  });
+  it("keeps capture suppression when carrier closure is uncertain", async () => {
+    const onFailure = vi.fn(async () => false);
+    const driver = await start({ onFailure });
+    await driver.readyForAudio();
+    driver.activate();
+    emit("error", { message: "provider failed" });
+    await vi.waitFor(() => expect(onFailure).toHaveBeenCalledOnce());
+    expect(h.suspend).toHaveBeenCalledOnce();
+    expect(h.pumpStop).not.toHaveBeenCalled();
+    expect(driver.realtimeActive()).toBe(false);
+  });
+  it("joins authentication when the call closes during hello", async () => {
+    h.delayHello = true;
+    const driver = await start();
+    await driver.close();
+    expect(h.stop).toHaveBeenCalledOnce();
+    expect(h.request).not.toHaveBeenCalled();
+    expect(driver.realtimeActive()).toBe(false);
+  });
+  it("joins a delayed create response and detaches its relay before close settles", async () => {
+    let complete!: (value: unknown) => void;
+    h.request.mockImplementation((method: string) =>
+      method === "talk.session.create"
+        ? new Promise((resolve) => {
+            complete = resolve;
+          })
+        : Promise.resolve({ ok: true }),
+    );
+    const driver = await start();
+    await vi.waitFor(() => expect(complete).toBeTypeOf("function"));
+    let closed = false;
+    const closing = driver.close().then(() => {
+      closed = true;
+    });
+    await Promise.resolve();
+    expect(closed).toBe(false);
+    complete({
+      relaySessionId: "relay-1",
+      audio: {
+        inputEncoding: "pcm16",
+        outputEncoding: "pcm16",
+        inputSampleRateHz: 24000,
+        outputSampleRateHz: 24000,
+      },
+    });
+    await closing;
+    expect(h.request).toHaveBeenCalledWith("talk.session.close", {
+      sessionId: "relay-1",
+      disposition: "detach",
+    });
+  });
+  it.each([false, true])(
+    "reports suspension failure before releasing capture, closure confirmed=%s",
+    async (confirmed) => {
+      const onFailure = vi.fn(async () => confirmed);
+      const driver = await start({ onFailure });
+      await driver.readyForAudio();
+      driver.activate();
+      h.suspend.mockRejectedValue(new Error("native suspension failed"));
+      emit("error", { message: "provider failed" });
+      await vi.waitFor(() => expect(onFailure).toHaveBeenCalledWith(expect.any(AggregateError)));
+      if (confirmed) await vi.waitFor(() => expect(h.pumpStop).toHaveBeenCalledOnce());
+      else expect(h.pumpStop).not.toHaveBeenCalled();
+      await expect(driver.close()).rejects.toThrow("cleanup failed");
+      expect(h.pumpStop).toHaveBeenCalledOnce();
+    },
+  );
+});
