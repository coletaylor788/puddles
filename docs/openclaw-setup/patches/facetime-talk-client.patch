+++ b/extensions/facetime/scripts/stage-capture.sh
@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+set -euo pipefail
+umask 077
+
+if [[ $# -ne 1 ]]; then
+  echo "Usage: $0 <supported-native-libexec>" >&2
+  exit 2
+fi
+case "$1" in
+  /opt/homebrew/opt/openclaw-facetime/libexec|/usr/local/opt/openclaw-facetime/libexec) ;;
+  *) echo "Unsupported FaceTime native installation" >&2; exit 2 ;;
+esac
+scripts_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+audio_dir="${HOME}/Library/Application Support/OpenClaw/FaceTime/audio"
+source_capture="$1/facetime-audio-capture"
+"${scripts_dir}/verify-native-helper.sh" "${source_capture}" >&2
+/usr/bin/codesign --verify --strict -R='identifier "ai.openclaw.facetime-audio-capture"' "${source_capture}"
+
+digest() { /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'; }
+mkdir -p "${audio_dir}"
+if [[ -L "${audio_dir}" || -L "${audio_dir}/facetime-audio-capture" || -L "${audio_dir}/capture-launcher" ]]; then
+  echo "FaceTime audio installation must use regular files at a stable directory" >&2
+  exit 1
+fi
+# Serialize setup, including the reuse check. Never break another installer's lock.
+lock="${audio_dir}/.install-lock"
+for ((attempt=0; attempt<120; attempt++)); do
+  if mkdir "${lock}" 2>/dev/null; then break; fi
+  sleep 0.25
+done
+if [[ ${attempt} -eq 120 ]]; then
+  echo "FaceTime audio setup is busy or was interrupted; inspect ${lock} before retrying" >&2
+  exit 1
+fi
+stage=""
+committing=0
+cleanup() {
+  result=$?
+  rollback_failed=0
+  trap - EXIT HUP INT TERM
+  if [[ ${committing} -eq 1 ]]; then
+    for name in facetime-audio-capture capture-launcher installed.sha256; do
+      if [[ -f "${stage}/previous/${name}" ]]; then
+        /bin/mv -f "${stage}/previous/${name}" "${audio_dir}/${name}" || rollback_failed=1
+      else
+        /bin/rm -f "${audio_dir}/${name}" || rollback_failed=1
+      fi
+    done
+  fi
+  if [[ ${rollback_failed} -eq 1 ]]; then
+    echo "FaceTime audio rollback failed; recovery files preserved at ${stage}; inspect ${lock} before retrying" >&2
+    exit 1
+  fi
+  [[ -z "${stage}" ]] || /bin/rm -rf "${stage}"
+  /bin/rmdir "${lock}" || result=1
+  exit "${result}"
+}
+trap cleanup EXIT
+trap 'exit 1' HUP INT TERM
+inputs="$(digest "${source_capture}"):$(digest "${scripts_dir}/capture-launcher.c")"
+if [[ -x "${audio_dir}/capture-launcher" && -f "${audio_dir}/installed.sha256" &&
+      "$(cat "${audio_dir}/installed.sha256")" == "${inputs}:$(digest "${audio_dir}/capture-launcher")" ]] &&
+   /usr/bin/cmp -s "${source_capture}" "${audio_dir}/facetime-audio-capture"; then
+  echo "${audio_dir}/capture-launcher"
+  exit 0
+fi
+
+# Stage before replacing either executable. A failed build leaves the prior files intact.
+stage="$(mktemp -d "${audio_dir}/.stage.XXXXXX")"
+/usr/bin/xcrun clang -arch arm64 -mmacosx-version-min=14.0 -O2 -Wall -Wextra -Werror \
+  "${scripts_dir}/capture-launcher.c" -o "${stage}/capture-launcher"
+/usr/bin/ditto "${source_capture}" "${stage}/facetime-audio-capture"
+"${scripts_dir}/verify-native-helper.sh" "${stage}/facetime-audio-capture" >&2
+/usr/bin/codesign --verify --strict -R='identifier "ai.openclaw.facetime-audio-capture"' "${stage}/facetime-audio-capture"
+/usr/bin/cmp -s "${source_capture}" "${stage}/facetime-audio-capture"
+[[ "${inputs}" == "$(digest "${stage}/facetime-audio-capture"):$(digest "${scripts_dir}/capture-launcher.c")" ]]
+chmod 700 "${stage}/capture-launcher" "${stage}/facetime-audio-capture"
+printf '%s\n' "${inputs}:$(digest "${stage}/capture-launcher")" > "${stage}/installed.sha256"
+mkdir "${stage}/previous"
+for name in facetime-audio-capture capture-launcher installed.sha256; do
+  if [[ -f "${audio_dir}/${name}" ]]; then
+    /usr/bin/ditto "${audio_dir}/${name}" "${stage}/previous/${name}"
+  fi
+done
+committing=1
+/bin/mv -f "${stage}/facetime-audio-capture" "${audio_dir}/facetime-audio-capture"
+/bin/mv -f "${stage}/capture-launcher" "${audio_dir}/capture-launcher"
+/bin/mv -f "${stage}/installed.sha256" "${audio_dir}/installed.sha256"
+[[ "$(cat "${audio_dir}/installed.sha256")" == "$(digest "${audio_dir}/facetime-audio-capture"):$(digest "${scripts_dir}/capture-launcher.c"):$(digest "${audio_dir}/capture-launcher")" ]]
+committing=0
+echo "${audio_dir}/capture-launcher"
