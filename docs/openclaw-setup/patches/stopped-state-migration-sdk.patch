+    configSnapshot.sourceConfigBeforeMigrations ??
+      (hasAuthoredIncludes ? configSnapshot.sourceConfig : configSnapshot.parsed),
+    configSnapshot.sourceConfig,
+  );
+  let nextConfig =
+    (migrated.next as OpenClawConfig | null) ??
+    (readTimeChanged ? configSnapshot.sourceConfig : null);
+  if (!nextConfig) {
