+  }
+  const rosterMigrationNeeded =
+    [configSnapshot.sourceConfigBeforeMigrations, configSnapshot.parsed]
+      .filter((source) => source !== undefined)
+      .some((source) => migratePersistedImplicitMainRoster(source).changed) ||
+    (nextConfig.agents?.ownership === undefined && listAgentEntries(nextConfig).length > 1);
+  let stampsExplicitOwnership = false;
+  if (rosterMigrationNeeded) {
