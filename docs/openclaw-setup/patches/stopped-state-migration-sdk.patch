+export function previewLegacyConfigRepair(
+  configSnapshot: ConfigSnapshot,
+  options?: { pluginContracts?: boolean },
+): {
+  sourceConfig: OpenClawConfig;
+  expectedConfig: OpenClawConfig;
+  changes: string[];
+} | null {
+  const hasAuthoredIncludes = containsAuthoredInclude(configSnapshot.parsed);
+  const migrated = applyLegacyDoctorMigrations(configSnapshot.sourceConfig, {
+    sourceConfigBeforeMigrations: configSnapshot.sourceConfigBeforeMigrations,
+    context: {
+      authoredRaw: configSnapshot.parsed,
+      resolvedRaw: configSnapshot.sourceConfig,
+    },
+    pluginContracts: options?.pluginContracts === true,
+  });
