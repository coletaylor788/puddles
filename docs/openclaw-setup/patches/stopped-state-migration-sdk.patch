+/** Converts config-backed rows to canonical rows without changing their effective jobs. */
+export async function materializeCronConfigJobsForMigration(
+  sourceStorePath: string,
+  targetStorePath: string,
+  expectedSourceJobsFingerprint: string,
+  expectedTargetJobsFingerprint: string,
+): Promise<{ before: CronStoreFile; after: CronStoreFile; materialized: number }> {
+  const source = await loadCronJobsStoreWithConfigJobsReadOnly(sourceStorePath, process.env, {
+    artifactPreservingReadOnly: true,
+    includeJobsFingerprint: true,
+  });
+  if (source.jobsFingerprint !== expectedSourceJobsFingerprint) {
+    throw new CronJobsStoreChangedError(path.resolve(sourceStorePath));
+  }
+  const samePartition =
+    cronStoreKey(path.resolve(sourceStorePath)) === cronStoreKey(path.resolve(targetStorePath));
+  const target = samePartition
+    ? source
+    : await loadCronJobsStoreWithConfigJobsReadOnly(targetStorePath, process.env, {
+        artifactPreservingReadOnly: true,
+        includeJobsFingerprint: true,
+      });
+  if (target.jobsFingerprint !== expectedTargetJobsFingerprint) {
+    throw new CronJobsStoreChangedError(path.resolve(targetStorePath));
+  }
+  if (source.invalidConfigRows.length > 0 || target.invalidConfigRows.length > 0) {
+    throw new Error("Cron config rows must be valid before materialization");
+  }
+  if (!samePartition) {
+    await saveCronJobsStore(targetStorePath, source.store, {
+      preserveRuntimeState: true,
+      transactionHooks: {
+        beforeWrite(db) {
+          assertCronJobsStoreUnchanged(db, sourceStorePath, expectedSourceJobsFingerprint);
+          if (!samePartition) {
+            assertCronJobsStoreUnchanged(db, targetStorePath, expectedTargetJobsFingerprint);
+          }
+        },
+      },
+    });
+  }
+  const after = await loadCronJobsStoreWithConfigJobsReadOnly(targetStorePath, process.env, {
+    artifactPreservingReadOnly: true,
+    includeJobsFingerprint: true,
+  });
+  return {
+    before: source.store,
+    after: after.store,
+    materialized: samePartition ? 0 : source.store.jobs.length,
+  };
+}
