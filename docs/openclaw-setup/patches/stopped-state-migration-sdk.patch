+    const { list: _legacyList, ...agents } = canonical.agents ?? {};
+    stampsExplicitOwnership = Object.keys(entries ?? {}).length > 1;
+    nextConfig = {
+      ...canonical,
+      agents: {
+        ...agents,
+        ...(stampsExplicitOwnership ? { ownership: "explicit" as const } : {}),
+        entries: entries as NonNullable<OpenClawConfig["agents"]>["entries"],
+      },
+    };
