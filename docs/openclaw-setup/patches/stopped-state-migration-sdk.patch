+++ b/src/commands/doctor/stopped-config-repair.test.ts
@@ -0,0 +1,187 @@
+import fs from "node:fs/promises";
+import { describe, expect, it } from "vitest";
+import { readConfigFileSnapshotForWrite } from "../../plugin-sdk/config-mutation.js";
+import {
+  previewLegacyConfigRepair,
+  repairLegacyConfigForStoppedState,
+} from "../../plugin-sdk/doctor-repair-runtime.js";
+import { withOpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+
+describe("stopped legacy config repair SDK", () => {
+  it("previews and persists read-time and doctor migrations through the maintained writer", async () => {
+    await withOpenClawTestState({ label: "stopped-config-repair" }, async (state) => {
+      await fs.writeFile(
+        state.statePath("openclaw.json"),
+        JSON.stringify({
+          cron: { store: state.statePath("cron", "legacy-jobs.json") },
+          memory: { backend: "qmd" },
+          plugins: {
+            entries: {
+              "active-memory": { config: { qmd: { enabled: true } } },
+              canvas: {
+                config: {
+                  host: {
+                    enabled: true,
+                    root: state.statePath("legacy-canvas"),
+                    liveReload: true,
+                  },
+                },
+              },
+            },
+          },
+          meta: { lastTouchedAt: "2025-01-01T00:00:00.000Z" },
+        }),
+      );
+      const { snapshot } = await readConfigFileSnapshotForWrite({
+        observe: false,
+        pluginValidation: "core-only",
+      });
+      const preview = previewLegacyConfigRepair(snapshot);
+      expect(preview).not.toBeNull();
+      expect(preview?.expectedConfig).not.toHaveProperty("cron.store");
+      expect(preview?.expectedConfig).not.toHaveProperty("memory.backend");
+      expect(preview?.expectedConfig).not.toHaveProperty("meta.lastTouchedAt");
+      expect(preview?.expectedConfig).toHaveProperty("plugins.entries.active-memory.config.qmd");
+      expect(preview?.expectedConfig).toHaveProperty("plugins.entries.canvas.config.host.root");
+
+      const fullPreview = previewLegacyConfigRepair(snapshot, { pluginContracts: true });
+      expect(fullPreview?.expectedConfig).not.toHaveProperty(
+        "plugins.entries.active-memory.config.qmd",
+      );
+      expect(fullPreview?.expectedConfig).not.toHaveProperty(
+        "plugins.entries.canvas.config.host.root",
+      );
+      expect(fullPreview?.expectedConfig).not.toHaveProperty(
+        "plugins.entries.canvas.config.host.liveReload",
+      );
+      expect(fullPreview?.expectedConfig).toHaveProperty(
+        "plugins.entries.canvas.config.host.enabled",
+        true,
+      );
+
+      const result = await repairLegacyConfigForStoppedState({
+        configSnapshot: snapshot,
+        configWriteOptions: { skipRuntimeSnapshotRefresh: true, skipOutputLogs: true },
+      });
+      expect(result.repaired).toBe(true);
+      expect(result.snapshot.valid).toBe(true);
+      expect(result.snapshot.sourceConfig).toEqual(fullPreview?.expectedConfig);
+    });
+  });
+
+  it.each(["markerless", "default-marked", "fixed-store-workspace", "explicit-owner"] as const)(
+    "previews exactly the persisted native ownership for %s",
+    async (scenario) => {
+      await withOpenClawTestState({ label: "stopped-config-roster" }, async (state) => {
+        const owner =
+          scenario === "default-marked" || scenario === "explicit-owner" ? "agent-2" : "agent-1";
+        const agents = {
+          list: [
+            { id: "agent-1" },
+            { id: "agent-2", ...(scenario === "default-marked" ? { default: true } : {}) },
+          ],
+          ...(scenario === "fixed-store-workspace"
+            ? { defaults: { workspace: "${HOME}/custom-workspace" } }
+            : {}),
+          ...(scenario === "explicit-owner"
+            ? {
+                ownership: "explicit",
+                defaults: {
+                  authInheritance: { agentId: owner },
+                  heartbeat: { agentId: owner },
+                  systemAgent: { agentId: owner },
+                },
+              }
+            : {}),
+        };
+        await fs.writeFile(
+          state.statePath("openclaw.json"),
+          JSON.stringify({
+            agents,
+            ...(scenario === "explicit-owner" ? { talk: { agentId: owner } } : {}),
+            ...(scenario === "fixed-store-workspace"
+              ? { session: { store: state.statePath("shared-sessions.json") } }
+              : {}),
+          }),
+        );
+        const originalRaw = await fs.readFile(state.statePath("openclaw.json"), "utf8");
+        const { snapshot } = await readConfigFileSnapshotForWrite({
+          observe: false,
+          pluginValidation: "core-only",
+        });
+        const originalSource = structuredClone(snapshot.sourceConfig);
+        const preview = previewLegacyConfigRepair(snapshot);
+        expect(preview?.sourceConfig.agents?.ownership).toBe("explicit");
+        expect(Object.keys(preview?.sourceConfig.agents?.entries ?? {})).toHaveLength(2);
+        expect(
+          Object.values(preview?.sourceConfig.agents?.entries ?? {}).some((entry) =>
+            Object.hasOwn(entry, "default"),
+          ),
+        ).toBe(false);
+        const fullPreview = previewLegacyConfigRepair(snapshot, { pluginContracts: true });
+        expect(fullPreview?.expectedConfig).toMatchObject({
+          agents: {
+            defaults: {
+              authInheritance: {
+                agentId:
+                  scenario === "markerless" || scenario === "fixed-store-workspace"
+                    ? "main"
+                    : owner,
+              },
+              heartbeat: { agentId: owner },
+              systemAgent: { agentId: owner },
+            },
+          },
+          talk: { agentId: owner },
+        });
+        expect(snapshot.sourceConfig).toEqual(originalSource);
+        expect(await fs.readFile(state.statePath("openclaw.json"), "utf8")).toBe(originalRaw);
+        const result = await repairLegacyConfigForStoppedState({
+          configSnapshot: snapshot,
+          configWriteOptions: { skipRuntimeSnapshotRefresh: true, skipOutputLogs: true },
+        });
+        expect(result.snapshot.valid).toBe(true);
+        expect(result.snapshot.sourceConfig).toEqual(fullPreview?.expectedConfig);
+        if (scenario === "fixed-store-workspace") {
+          expect(result.snapshot.sourceConfig.agents?.defaults?.sessionStore?.agentId).toBe(owner);
+          expect(result.snapshot.sourceConfig.agents?.entries?.[owner]?.workspace).toBe(
+            `${state.home}/custom-workspace`,
+          );
+          expect(await fs.readFile(state.statePath("openclaw.json"), "utf8")).toContain(
+            "${HOME}/custom-workspace",
+          );
+        }
+      });
+    },
+  );
+  it("refuses roster migration across an authored include boundary without writes", async () => {
+    await withOpenClawTestState({ label: "stopped-config-include" }, async (state) => {
+      const configPath = state.statePath("openclaw.json");
+      const includePath = state.statePath("agents.json");
+      await fs.writeFile(configPath, JSON.stringify({ agents: { $include: "./agents.json" } }));
+      await fs.writeFile(
+        includePath,
+        JSON.stringify({ list: [{ id: "agent-1" }, { id: "agent-2" }] }),
+      );
+      const before = await Promise.all(
+        [configPath, includePath].map((file) => fs.readFile(file, "utf8")),
+      );
+      const { snapshot } = await readConfigFileSnapshotForWrite({
+        observe: false,
+        pluginValidation: "core-only",
+      });
+      expect(() => previewLegacyConfigRepair(snapshot, { pluginContracts: true })).toThrow(
+        "crosses authored include ownership",
+      );
+      await expect(
+        repairLegacyConfigForStoppedState({
+          configSnapshot: snapshot,
+          configWriteOptions: { skipRuntimeSnapshotRefresh: true, skipOutputLogs: true },
+        }),
+      ).rejects.toThrow("crosses authored include ownership");
+      expect(
+        await Promise.all([configPath, includePath].map((file) => fs.readFile(file, "utf8"))),
+      ).toEqual(before);
+    });
+  });
+});
