 type ConfigSnapshot = Awaited<ReturnType<typeof readConfigFileSnapshot>>;
 
+export function previewLegacyConfigRepair(
+  configSnapshot: ConfigSnapshot,
+  options?: { pluginContracts?: boolean },
+): {
+  sourceConfig: OpenClawConfig;
+  expectedConfig: OpenClawConfig;
+  changes: string[];
+} | null {
+  const hasAuthoredIncludes = containsAuthoredInclude(configSnapshot.parsed);
+  // The writer resolves this same preimage owner before roster conversion. Preserve
+  // its provenance so native Doctor materializes the same per-surface ownership.
+  const legacyOwner = resolveLegacyAgentRosterOwner(
+    configSnapshot.sourceConfigBeforeMigrations ?? configSnapshot.parsed,
+  );
