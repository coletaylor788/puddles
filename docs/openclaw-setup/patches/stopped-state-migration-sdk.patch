+    ? retainLegacyDefaultAgentId(
+        cloneConfigWithResolutionFacts(configSnapshot.sourceConfig),
+        legacyOwner,
+      )
+    : configSnapshot.sourceConfig;
+  const migrated = applyLegacyDoctorMigrations(migrationInput, {
+    sourceConfigBeforeMigrations: configSnapshot.sourceConfigBeforeMigrations,
+    context: {
+      authoredRaw: configSnapshot.parsed,
+      resolvedRaw: configSnapshot.sourceConfig,
+    },
+    pluginContracts: options?.pluginContracts === true,
+  });
+  const readTimeChanged = !isDeepStrictEqual(
+    configSnapshot.sourceConfigBeforeMigrations ??
+      (hasAuthoredIncludes ? configSnapshot.sourceConfig : configSnapshot.parsed),
+    configSnapshot.sourceConfig,
+  );
+  let nextConfig =
+    (migrated.next as OpenClawConfig | null) ??
+    (readTimeChanged ? configSnapshot.sourceConfig : null);
+  if (!nextConfig) {
+    return null;
+  }
+  if (options?.pluginContracts === true) {
+    // Migration preserves the old surface owner; native writes separately keep
+    // the actual shared authentication owner across a roster transition.
+    nextConfig = prepareAuthInheritanceOwnerForWrite({
+      currentConfig: configSnapshot.config,
+      targetConfig: nextConfig,
+      writesOwnershipTopology: !isDeepStrictEqual(
+        listAgentEntries(configSnapshot.config),
+        listAgentEntries(nextConfig),
+      ),
+    }).config;
+  }
+  if (
+    options?.pluginContracts === true &&
+    (!validateConfigObjectRawWithPlugins(nextConfig).ok ||
+      findDoctorLegacyConfigIssues(nextConfig, nextConfig).length > 0)
+  ) {
