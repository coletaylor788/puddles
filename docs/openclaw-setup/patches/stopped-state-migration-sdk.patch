+export async function repairLegacyConfigForStoppedState(params: {
+  configSnapshot: ConfigSnapshot;
+  configWriteOptions: ConfigWriteOptions;
+}): Promise<{ snapshot: ConfigSnapshot; repaired: boolean; changes: string[] }> {
+  const preview = previewLegacyConfigRepair(params.configSnapshot);
+  if (!preview) {
+    return { snapshot: params.configSnapshot, repaired: false, changes: [] };
+  }
+  await replaceConfigFile({
+    sourceConfig: preview.sourceConfig,
+    baseHash: params.configSnapshot.hash,
+    writeOptions: {
+      ...params.configWriteOptions,
+      auditOrigin: "doctor",
+      allowConfigSizeDrop: true,
+      skipOutputLogs: true,
+    },
+  });
+  const { snapshot } = await readConfigFileSnapshotForWrite({
+    observe: false,
+    pluginValidation: "core-only",
+  });
+  if (!snapshot.valid) {
+    throw new Error("Persisted legacy config migration is invalid");
+  }
+  return { snapshot, repaired: true, changes: preview.changes };
+}
