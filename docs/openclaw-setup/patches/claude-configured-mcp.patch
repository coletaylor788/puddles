+      const successor = mintMcpLoopbackClientGrant(params);
+      transferMcpLoopbackClientGrant({
+        sourceToken: successor.token,
+        targetToken: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+      });
+      activateMcpLoopbackClientGrantCapture({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "successor",
+      });
+      const next = resolveMcpLoopbackClientGrant({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "successor",
+      })!;
+      expect(revokeMcpLoopbackClientGrant(fresh.token)).toBe(false);
+      expect(next.isCurrent()).toBe(true);
+      await executeMcpToolCall({
+        tool: payment,
+        toolName: payment.name,
+        toolArgs: {},
+        authorizeToolCall: transferred.isCurrent,
+      });
+      expect(payment.execute).not.toHaveBeenCalled();
+      hook.mockImplementationOnce(async () => {
+        revokeMcpLoopbackClientGrant(old.token);
+        return { blocked: false, params: {} };
+      });
+      await executeMcpToolCall({
+        tool: payment,
+        toolName: payment.name,
+        toolArgs: {},
+        authorizeToolCall: next.isCurrent,
+      });
+      expect(payment.execute).not.toHaveBeenCalled();
+    } finally {
+      admission.close();
+    }
+  });
+});
