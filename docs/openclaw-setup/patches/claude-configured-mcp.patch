+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import * as bundleMcpTools from "../agent-bundle-mcp-tools.js";
+import type { SessionMcpRuntime } from "../agent-bundle-mcp-types.js";
+import { prepareConversationCapabilityProfile } from "../conversation-capability-profile.js";
+import { prepareCliLoopbackBundleMcp } from "./loopback-bundle-mcp.js";
+
+describe("configured MCP CLI failure ownership", () => {
+  let workspaceDir: string;
+  beforeEach(async () => {
+    workspaceDir = await fs.mkdtemp(path.join(os.tmpdir(), "cli-mcp-failure-"));
+  });
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    await fs.rm(workspaceDir, { recursive: true, force: true });
+  });
+  const config: OpenClawConfig = {
+    agents: { ownership: "explicit", entries: { main: {} } },
+    mcp: { servers: { probe: { command: "/synthetic/no-execution" } } },
+  };
+  const prepare = () =>
+    prepareCliLoopbackBundleMcp({
+      run: {
+        sessionId: "synthetic-session",
+        sessionKey: "agent:main:main",
+        prompt: "synthetic",
+        provider: "claude-cli",
+        model: "synthetic",
+        timeoutMs: 1000,
+        runId: "synthetic-run",
+        workspaceDir,
+      },
+      config,
+      workspaceDir,
+      agentDir: workspaceDir,
+      agentId: "main",
+      resolveCapabilityProfile: () =>
+        prepareConversationCapabilityProfile({ config, workspaceDir, agentId: "main" }),
+    });
+  it.each(["cancelled", "retired owner"])(
+    "does not convert %s acquisition into a tool-free run",
+    async (reason) => {
+      const failure = new Error(reason);
+      vi.spyOn(bundleMcpTools, "acquireSessionMcpRuntime").mockRejectedValue(failure);
+      const materialize = vi.spyOn(bundleMcpTools, "materializeBundleMcpToolsForRun");
+      await expect(prepare()).rejects.toBe(failure);
+      expect(materialize).not.toHaveBeenCalled();
+    },
+  );
+  it.each(["cancelled", "retired owner", "catalog materialization failed"])(
+    "releases the native lease and joins cleanup before reporting %s",
+    async (reason) => {
+      const failure = new Error(reason);
+      const cleanupEntered = createDeferred<void>();
+      const cleanupRelease = createDeferred<void>();
+      const releaseLease = vi.fn();
+      const runtime = {
+        sessionId: "synthetic-session",
+        markUsed: vi.fn(),
+        getCatalog: vi.fn(async () => {
+          throw failure;
+        }),
+        joinCleanup: vi.fn(async () => {
+          cleanupEntered.resolve();
+          await cleanupRelease.promise;
+        }),
+      } as unknown as SessionMcpRuntime;
+      vi.spyOn(bundleMcpTools, "acquireSessionMcpRuntime").mockResolvedValue({
+        runtime,
+        releaseLease,
+      });
+      let settled = false;
+      const result = prepare()
+        .then(
+          (value) => ({ value }),
+          (error) => ({ error }),
+        )
+        .finally(() => {
+          settled = true;
+        });
+      try {
+        await Promise.race([
+          cleanupEntered.promise,
+          result.then((value) => {
+            throw new Error("Preparation settled before cleanup: " + JSON.stringify(value));
+          }),
+        ]);
+        expect(releaseLease).toHaveBeenCalledTimes(1);
+        expect(settled).toBe(false);
+      } finally {
+        cleanupRelease.resolve();
+      }
+      expect(await result).toEqual({ error: failure });
+      expect(runtime.joinCleanup).toHaveBeenCalledTimes(1);
+    },
+  );
+});
