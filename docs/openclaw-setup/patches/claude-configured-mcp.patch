+      cfg,
+      facts: {
+        runId: "configured-mcp",
+        agentId: "browser",
+        ingress: { kind: "system", boundary: "test", state: "present" },
+      },
+      operationalRunInstance: createOperationalRunInstanceRef("configured-mcp"),
+    });
+    try {
+      const admittedRunContext = await admission.admit("gateway", "configured-mcp");
+      const params = {
+        context,
+        runtimeOwnerToken: "configured-mcp-test",
+        admittedRunContext,
+        bundledTools: [payment],
+      };
+      const old = mintMcpLoopbackClientGrant(params),
+        fresh = mintMcpLoopbackClientGrant(params);
+      expect(old.context).not.toHaveProperty("bundledTools");
+      activateMcpLoopbackClientGrantCapture({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "old",
+      });
+      const bound = resolveMcpLoopbackClientGrant({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "old",
+      })!;
+      const cache = new McpLoopbackToolCache();
+      const cached = await cache.resolve({
+        cfg,
+        context: bound.context,
+        grantToken: old.token,
+        bundledTools: bound.bundledTools,
+        isGrantCurrent: bound.isCurrent,
+      });
+      expect(
+        transferMcpLoopbackClientGrant({
+          sourceToken: fresh.token,
+          targetToken: old.token,
+          runtimeOwnerToken: params.runtimeOwnerToken,
+        }),
+      ).toBe(true);
+      expect(bound.isCurrent()).toBe(false);
+      await executeMcpToolCall({
+        tool: cached.tools[0]!,
+        toolName: payment.name,
+        toolArgs: {},
+        authorizeToolCall: bound.isCurrent,
+      });
+      expect(payment.execute).not.toHaveBeenCalled();
+      activateMcpLoopbackClientGrantCapture({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "fresh",
+      });
+      const transferred = resolveMcpLoopbackClientGrant({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "fresh",
+      })!;
+      expect(transferred.bundledTools?.[0]).toBe(payment);
+      // A warm turn retires capture before releasing its source lease. Its
+      // source token was consumed by transfer and cannot revoke a later turn.
+      deactivateMcpLoopbackClientGrantCapture({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "fresh",
+      });
+      expect(transferred.isCurrent()).toBe(false);
+      const successor = mintMcpLoopbackClientGrant(params);
+      transferMcpLoopbackClientGrant({
+        sourceToken: successor.token,
+        targetToken: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+      });
+      activateMcpLoopbackClientGrantCapture({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "successor",
+      });
+      const next = resolveMcpLoopbackClientGrant({
+        token: old.token,
+        runtimeOwnerToken: params.runtimeOwnerToken,
+        captureKey: "successor",
+      })!;
+      expect(revokeMcpLoopbackClientGrant(fresh.token)).toBe(false);
+      expect(next.isCurrent()).toBe(true);
+      await executeMcpToolCall({
+        tool: payment,
+        toolName: payment.name,
+        toolArgs: {},
+        authorizeToolCall: transferred.isCurrent,
+      });
+      expect(payment.execute).not.toHaveBeenCalled();
+      hook.mockImplementationOnce(async () => {
+        revokeMcpLoopbackClientGrant(old.token);
+        return { blocked: false, params: {} };
+      });
+      await executeMcpToolCall({
+        tool: payment,
+        toolName: payment.name,
+        toolArgs: {},
+        authorizeToolCall: next.isCurrent,
+      });
+      expect(payment.execute).not.toHaveBeenCalled();
+    } finally {
+      admission.close();
+    }
+  });
+});
