+/** Static MCP tools for host-bound harnesses, with the embedded runner's policy.
+ * Harness-specific approval prompts remain in their existing adapter paths.
+ */
+export async function materializeConfiguredMcpToolsForHarnessRunCore(
+  params: Omit<
+    MaterializeRequesterScopedMcpToolsForHarnessRunParams,
+    | "requesterSenderId"
+    | "agentAccountId"
+    | "messageChannel"
+    | "autoApproveCodexAppServerApprovals"
+    | "requestInteractiveCodexApproval"
+  >,
+): Promise<StaticHarnessMcpTools> {
+  const conversationCapabilityProfile = await resolveHarnessCapabilityProfile(params);
+  if (!conversationCapabilityProfile) {
+    throw new Error("Configured MCP requires a prepared harness tool policy");
+  }
+  const acquisition = await acquireSessionMcpRuntime({
+    sessionId: params.sessionId,
+    sessionKey: params.sessionKey,
+    agentId: params.agentId ?? conversationCapabilityProfile.agentId,
+    workspaceDir: params.workspaceDir,
+    agentDir: params.agentDir,
+    cfg: params.cfg,
+    manifestRegistry: params.manifestRegistry,
+    toolOverrides: params.toolOverrides,
+    toolDenylist: conversationCapabilityProfile.policy.explicitToolDenylist,
+  });
+  const runtime = await materializeBundleMcpToolsForRun({
+    ...acquisition,
+    agentId: params.agentId,
+    reservedToolNames: params.reservedToolNames,
+  });
+  try {
+    const policy = { ...params, conversationCapabilityProfile };
+    const tools = applyHarnessToolPolicy(runtime.tools, policy);
+    runtime.restrictAppTools?.(applyHarnessToolPolicy(runtime.appTools ?? runtime.tools, policy));
+    return { tools, dispose: createHarnessDisposer(runtime) };
+  } catch (error) {
+    await runtime.dispose();
+    throw error;
+  }
+}
