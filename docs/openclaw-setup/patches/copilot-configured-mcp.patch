+        cfg: config,
+        toolsAllow: mode === "runtime-denied" ? ["read"] : undefined,
+        policyContext: {
+          config,
+          agentId: "main",
+          sessionKey: "agent:main:main",
+          workspaceDir: "/workspace",
+          ...(mode === "sandbox-denied"
+            ? { sandboxToolPolicy: { allow: [], deny: ["user-mail__*"] } }
