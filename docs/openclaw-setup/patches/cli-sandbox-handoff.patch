+import { prepareCliSandboxExecution } from "./prepare-sandbox.js";
+import type { RunCliAgentParams } from "./types.js";
+
+const mocks = vi.hoisted(() => ({ prepare: vi.fn(), status: vi.fn() }));
+vi.mock("../workspace-sandbox.js", () => ({ resolveAttemptWorkspaceSandbox: mocks.prepare }));
+vi.mock("../sandbox/runtime-status.js", () => ({ resolveSandboxRuntimeStatusAsync: mocks.status }));
+
+const run: RunCliAgentParams = {
+  sessionId: "sandbox-cli",
+  sessionKey: "agent:main:dashboard:sandbox-cli",
+  sessionFile: "fixture.jsonl",
+  workspaceDir: "/workspace",
+  prompt: "work",
+  provider: "claude-cli",
+  model: "fixture",
+  runId: "sandbox-cli",
+  timeoutMs: 1000,
+};
+const options = {
+  run,
+  config: {},
+  agentId: "main",
+  policyAgentId: "main",
+  policySessionKey: run.sessionKey,
+  modelProvider: "fixture",
+  modelId: "fixture",
+  workspaceDir: "/workspace",
+  cwd: "/workspace",
+  hostOwnedTools: ["exec", "process"],
+};
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.status.mockResolvedValue({ sandboxed: true, mode: "all", toolPolicy: {} });
+  mocks.prepare.mockImplementation(async () => ({
+    sandbox: createSandboxTestContext(),
+    effectiveWorkspace: "/projected",
+    effectiveCwd: "/projected",
+    effectiveFsWorkspaceOnly: true,
+    sessionPermissionRoot: "/projected",
+    [Symbol.dispose]: vi.fn(),
+  }));
+});
+
+describe("managed CLI sandbox preparation", () => {
+  it.each([
+    { runtimeToolsAllowPolicy: [] },
+    { runtimeToolsAllowPolicy: ["message"] },
+    { run: { ...run, cliToolAvailability: { native: [], openClaw: [] } } },
+    { run: { ...run, disableTools: true } },
+    { runtimeToolsAllowPolicy: ["write"], promptBuildToolsAllow: ["message"] },
+    { config: { tools: { deny: ["exec", "process"] } } },
+  ])("does not provision unavailable Docker for non-coding authority: %j", async (overrides) => {
+    mocks.prepare.mockRejectedValue(new Error("Docker unavailable"));
+    expect(await prepareCliSandboxExecution({ ...options, ...overrides })).toBeUndefined();
+    expect(mocks.prepare).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    {},
+    { runtimeToolsAllowPolicy: ["write"] },
+    { runtimeToolsAllowPolicy: ["group:fs"] },
+    { runtimeToolsAllowPolicy: ["*"] },
+    { run: { ...run, cliToolAvailability: { native: [], openClaw: ["read"] } } },
+  ])("prepares coding selections and retains the complete native owner: %j", async (overrides) => {
+    const prepared = await prepareCliSandboxExecution({ ...options, ...overrides });
+    expect(prepared?.effectiveCwd).toBe("/projected");
+    expect(prepared?.sessionPermissionRoot).toBe("/projected");
+    expect(prepared?.[Symbol.dispose]).not.toHaveBeenCalled();
+    using owner = prepared;
+    expect(mocks.prepare).toHaveBeenCalledTimes(1);
+  });
+
+  it("fails before tools launch when provisioning fails", async () => {
+    mocks.prepare.mockRejectedValue(new Error("Sandbox image not found"));
+    await expect(prepareCliSandboxExecution(options)).rejects.toThrow("Sandbox image not found");
+  });
+
+  it("releases the native lease if authority expires during preparation", async () => {
+    const abort = new AbortController();
+    const dispose = vi.fn();
+    mocks.prepare.mockImplementation(async () => {
+      abort.abort(new Error("run replaced"));
+      return { sandbox: createSandboxTestContext(), [Symbol.dispose]: dispose };
+    });
+    await expect(
+      prepareCliSandboxExecution({ ...options, run: { ...run, abortSignal: abort.signal } }),
+    ).rejects.toThrow("run replaced");
+    expect(dispose).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not turn a changed sandbox classification into host fallback", async () => {
+    const dispose = vi.fn();
+    mocks.prepare.mockResolvedValue({ sandbox: null, [Symbol.dispose]: dispose });
+    await expect(prepareCliSandboxExecution(options)).rejects.toThrow("require a prepared sandbox");
+    expect(dispose).toHaveBeenCalledTimes(1);
+  });
+
+  it("leaves deliberately unsandboxed runs with their existing owner", async () => {
+    mocks.status.mockResolvedValue({ sandboxed: false });
+    expect(await prepareCliSandboxExecution(options)).toBeUndefined();
+    expect(mocks.prepare).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/agents/cli-runner/prepare-sandbox.ts b/src/agents/cli-runner/prepare-sandbox.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0add308c037b65b627848b43cb95c9a7b3ad92cf
--- /dev/null
+++ b/src/agents/cli-runner/prepare-sandbox.ts
@@ -0,0 +1,95 @@
+import type { McpLoopbackRequestContext } from "../../gateway/mcp-grant-store.js";
+import { selectMediatedCodingTools } from "../../gateway/mcp-http.runtime.js";
+import { projectConversationToolNames } from "../conversation-tool-policy-pipeline.js";
+import { applyEmbeddedAttemptToolsAllow } from "../embedded-agent-runner/run/attempt-tool-construction-plan.js";
+import { resolveSandboxRuntimeStatusAsync } from "../sandbox/runtime-status.js";
+import { resolveAttemptWorkspaceSandbox } from "../workspace-sandbox.js";
+import { resolveCliNativeMcpPolicy } from "./prepare-mcp.js";
+import type { RunCliAgentParams } from "./types.js";
+
+/** Host-owned native workspace lease. Never serialize this onto a CLI request. */
+export type PreparedCliSandboxExecution = Awaited<
+  ReturnType<typeof resolveAttemptWorkspaceSandbox>
+>;
+
+/** Prepare the ordinary session sandbox only for admitted mediated coding tools. */
+export async function prepareCliSandboxExecution(options: {
+  run: RunCliAgentParams;
+  config: NonNullable<RunCliAgentParams["config"]>;
+  agentId: string;
+  policyAgentId: string;
+  policySessionKey: string | undefined;
+  modelProvider: string;
+  modelId: string;
+  workspaceDir: string;
+  cwd: string;
+  runtimeToolsAllowPolicy?: string[];
+  hostOwnedTools?: readonly string[];
+  promptBuildToolsAllow?: string[];
+  sessionPermissionPolicy?: McpLoopbackRequestContext["sessionPermissionPolicy"];
+}): Promise<PreparedCliSandboxExecution | undefined> {
+  const { run } = options;
+  if (run.disableTools === true) {
+    return undefined;
+  }
+  // An explicit empty/non-coding cap must not provision a sandbox merely because
+  // the backend normally owns exec/process. Match the projection's precedence.
+  const selected = selectMediatedCodingTools(
+    options.runtimeToolsAllowPolicy ??
+      run.cliToolAvailability?.openClaw ??
+      (options.hostOwnedTools ? [...options.hostOwnedTools] : undefined),
+  );
+  const candidates = applyEmbeddedAttemptToolsAllow(
+    selected.map((name) => ({ name })),
+    options.promptBuildToolsAllow,
+  ).map((tool) => tool.name);
+  if (candidates.length === 0) {
+    return undefined;
+  }
+  const sandboxStatus = await resolveSandboxRuntimeStatusAsync({
+    cfg: options.config,
+    sessionKey: options.policySessionKey,
+    agentId: options.policyAgentId,
+  });
+  if (!sandboxStatus.sandboxed) {
+    return undefined;
+  }
+  const capabilityProfile = await resolveCliNativeMcpPolicy(run, options);
+  if (
+    projectConversationToolNames({
+      capabilityProfile,
+      toolNames: candidates,
+      warn: () => undefined,
+    }).length === 0
+  ) {
+    return undefined;
+  }
+  run.assertCurrent?.();
+  const prepared = await resolveAttemptWorkspaceSandbox({
+    config: options.config,
+    agentId: options.agentId,
+    workspaceDir: options.workspaceDir,
+    cwd: options.cwd,
+    sessionId: run.sessionId,
+    sessionKey: run.sessionKey,
+    sandboxSessionKey: options.policySessionKey,
+    sandboxAgentId: options.policyAgentId,
+    sessionRoot: options.sessionPermissionPolicy?.root,
+    permissionMode: options.sessionPermissionPolicy?.mode,
+    execOverrides: run.execOverrides,
+    skillsSnapshot: run.skillsSnapshot,
+    abortSignal: run.abortSignal,
+    admittedRunContext: run.admittedRunContext,
+  });
+  try {
+    run.assertCurrent?.();
+    run.abortSignal?.throwIfAborted();
+    if (!prepared.sandbox?.enabled) {
+      throw new Error("Mediated CLI coding tools require a prepared sandbox for this session");
+    }
+    return prepared;
+  } catch (error) {
+    prepared[Symbol.dispose]();
+    throw error;
+  }
+}
