@@ -0,0 +1,95 @@
+import type { McpLoopbackRequestContext } from "../../gateway/mcp-grant-store.js";
+import { selectMediatedCodingTools } from "../../gateway/mcp-http.runtime.js";
+import { projectConversationToolNames } from "../conversation-tool-policy-pipeline.js";
+import { applyEmbeddedAttemptToolsAllow } from "../embedded-agent-runner/run/attempt-tool-construction-plan.js";
+import { resolveSandboxRuntimeStatusAsync } from "../sandbox/runtime-status.js";
+import { resolveAttemptWorkspaceSandbox } from "../workspace-sandbox.js";
+import { resolveCliNativeMcpPolicy } from "./prepare-mcp.js";
+import type { RunCliAgentParams } from "./types.js";
+
+/** Host-owned native workspace lease. Never serialize this onto a CLI request. */
+export type PreparedCliSandboxExecution = Awaited<
+  ReturnType<typeof resolveAttemptWorkspaceSandbox>
+>;
+
+/** Prepare the ordinary session sandbox only for admitted mediated coding tools. */
+export async function prepareCliSandboxExecution(options: {
+  run: RunCliAgentParams;
+  config: NonNullable<RunCliAgentParams["config"]>;
+  agentId: string;
+  policyAgentId: string;
+  policySessionKey: string | undefined;
+  modelProvider: string;
+  modelId: string;
+  workspaceDir: string;
+  cwd: string;
+  runtimeToolsAllowPolicy?: string[];
+  hostOwnedTools?: readonly string[];
+  promptBuildToolsAllow?: string[];
+  sessionPermissionPolicy?: McpLoopbackRequestContext["sessionPermissionPolicy"];
+}): Promise<PreparedCliSandboxExecution | undefined> {
+  const { run } = options;
+  if (run.disableTools === true) {
+    return undefined;
+  }
+  // An explicit empty/non-coding cap must not provision a sandbox merely because
+  // the backend normally owns exec/process. Match the projection's precedence.
+  const selected = selectMediatedCodingTools(
+    options.runtimeToolsAllowPolicy ??
+      run.cliToolAvailability?.openClaw ??
+      (options.hostOwnedTools ? [...options.hostOwnedTools] : undefined),
+  );
+  const candidates = applyEmbeddedAttemptToolsAllow(
+    selected.map((name) => ({ name })),
+    options.promptBuildToolsAllow,
+  ).map((tool) => tool.name);
+  if (candidates.length === 0) {
+    return undefined;
+  }
+  const sandboxStatus = await resolveSandboxRuntimeStatusAsync({
+    cfg: options.config,
+    sessionKey: options.policySessionKey,
+    agentId: options.policyAgentId,
+  });
+  if (!sandboxStatus.sandboxed) {
+    return undefined;
+  }
+  const capabilityProfile = await resolveCliNativeMcpPolicy(run, options);
+  if (
+    projectConversationToolNames({
+      capabilityProfile,
+      toolNames: candidates,
+      warn: () => undefined,
+    }).length === 0
+  ) {
+    return undefined;
+  }
+  run.assertCurrent?.();
+  const prepared = await resolveAttemptWorkspaceSandbox({
+    config: options.config,
+    agentId: options.agentId,
+    workspaceDir: options.workspaceDir,
+    cwd: options.cwd,
+    sessionId: run.sessionId,
+    sessionKey: run.sessionKey,
+    sandboxSessionKey: options.policySessionKey,
+    sandboxAgentId: options.policyAgentId,
+    sessionRoot: options.sessionPermissionPolicy?.root,
+    permissionMode: options.sessionPermissionPolicy?.mode,
+    execOverrides: run.execOverrides,
+    skillsSnapshot: run.skillsSnapshot,
+    abortSignal: run.abortSignal,
+    admittedRunContext: run.admittedRunContext,
+  });
+  try {
+    run.assertCurrent?.();
+    run.abortSignal?.throwIfAborted();
+    if (!prepared.sandbox?.enabled) {
+      throw new Error("Mediated CLI coding tools require a prepared sandbox for this session");
+    }
+    return prepared;
+  } catch (error) {
+    prepared[Symbol.dispose]();
+    throw error;
+  }
+}
