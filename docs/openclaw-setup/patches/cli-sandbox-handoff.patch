new file mode 100644
index 000000000..bf08dfeb3
--- /dev/null
+++ b/src/agents/sandbox/fs-bridge.mutation-fence.test.ts
@@ -0,0 +1,118 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import {
+  createSandbox,
+  createSandboxFsBridge,
+  getScriptsFromCalls,
+  installFsBridgeTestHarness,
+  mockedExecDockerRaw,
+  withTempDir,
+} from "./fs-bridge.test-helpers.js";
+
+describe("sandbox fs bridge mutation fence", () => {
+  installFsBridgeTestHarness();
+
+  it.each(["copyFile", "writeFile", "createFileExclusive", "mkdirp", "remove", "rename"] as const)(
+    "rechecks authority at backend launch before %s takes effect",
+    async (method) => {
+      await withTempDir("openclaw-fs-bridge-fence-", async (stateDir) => {
+        const workspaceDir = path.join(stateDir, "workspace");
+        await fs.mkdir(workspaceDir, { recursive: true });
+        const sandbox = createSandbox({ workspaceDir, agentWorkspaceDir: workspaceDir });
+        const bridge = createSandboxFsBridge({
+          sandbox: {
+            ...sandbox,
+            backend: {
+              enforcesMutationFence: true,
+              runShellCommand: async (params) => {
+                params.assertBeforeMutation?.();
+                return await mockedExecDockerRaw(
+                  [
+                    "exec",
+                    "-i",
+                    sandbox.containerName,
+                    "sh",
+                    "-c",
+                    params.script,
+                    "openclaw-sandbox-fs",
+                    ...(params.args ?? []),
+                  ],
+                  {
+                    input: params.stdin,
+                    allowFailure: params.allowFailure,
+                    signal: params.signal,
+                  },
+                );
+              },
+            },
+          },
+        });
+        expect(bridge.enforcesMutationFence).toBe(true);
+        let checks = 0;
+        const assertBeforeMutation = () => {
+          checks += 1;
+          if (checks === 2) {
+            throw new Error("tool invocation authority is no longer active");
+          }
+        };
+        const mutation = (() => {
+          switch (method) {
+            case "copyFile":
+              return bridge.copyFile!({
+                sourcePath: "source.txt",
+                destinationPath: "copied.txt",
+                assertBeforeMutation,
+              });
+            case "writeFile":
+              return bridge.writeFile({
+                filePath: "victim.txt",
+                data: "changed",
+                assertBeforeMutation,
+              });
+            case "createFileExclusive":
+              return bridge.createFileExclusive!({
+                filePath: "created.txt",
+                data: "created",
+                assertBeforeMutation,
+              });
+            case "mkdirp":
+              return bridge.mkdirp({ filePath: "created-dir", assertBeforeMutation });
+            case "remove":
+              return bridge.remove({ filePath: "victim.txt", assertBeforeMutation });
+            case "rename":
+              return bridge.rename({
+                from: "victim.txt",
+                to: "renamed.txt",
+                assertBeforeMutation,
+              });
+          }
+        })();
+        await expect(mutation).rejects.toThrow("authority is no longer active");
+        expect(checks).toBe(2);
+        expect(getScriptsFromCalls().some((script) => script.includes("python3"))).toBe(false);
+      });
+    },
+  );
+
+  it("advertises the fence only for a backend that declares it", () => {
+    const sandbox = createSandbox();
+    expect(createSandboxFsBridge({ sandbox }).enforcesMutationFence).toBeUndefined();
+    expect(
+      createSandboxFsBridge({
+        sandbox: {
+          ...sandbox,
+          backend: {
+            enforcesMutationFence: true,
+            runShellCommand: async () => ({
+              stdout: Buffer.alloc(0),
+              stderr: Buffer.alloc(0),
+              code: 0,
+            }),
+          },
+        },
+      }).enforcesMutationFence,
+    ).toBe(true);
+    expect(mockedExecDockerRaw).not.toHaveBeenCalled();
+  });
+});
