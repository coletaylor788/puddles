@@ -0,0 +1,117 @@
+import path from "node:path";
+import { expect, it } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import {
+  activateMcpLoopbackClientGrantCapture,
+  mintMcpLoopbackClientGrant,
+  resolveMcpLoopbackClientGrant,
+  revokeMcpLoopbackClientGrant,
+} from "../../gateway/mcp-grant-store.js";
+import {
+  createOperationalRunInstanceRef,
+  prepareAgentRunAdmission,
+} from "../admitted-run-context.js";
+import { createSandboxedWriteTool } from "../agent-tools.read.js";
+import { withGatewayToolCallerIdentity } from "../tools/gateway-caller-context.js";
+import {
+  createSandbox,
+  createSandboxFsBridge,
+  getScriptsFromCalls,
+  installFsBridgeTestHarness,
+  mockedExecDockerRaw,
+  withTempDir,
+} from "./fs-bridge.test-helpers.js";
+
+installFsBridgeTestHarness();
+
+it("fences a delayed sandbox write when its MCP grant is revoked", async () => {
+  await withTempDir("openclaw-mcp-sandbox-fence-", async (stateDir) => {
+    const workspaceDir = path.join(stateDir, "workspace");
+    const admission = prepareAgentRunAdmission({
+      cfg: {},
+      facts: {
+        runId: "sandbox-mutation-fence",
+        agentId: "main",
+        ingress: { kind: "system", boundary: "sandbox-mutation-fence", state: "present" },
+      },
+      operationalRunInstance: createOperationalRunInstanceRef("sandbox-mutation-fence"),
+    });
+    const admittedRunContext = await admission.admit("gateway", "gateway-sandbox-fence");
+    const grant = mintMcpLoopbackClientGrant({
+      toolPolicyConfig: {},
+      context: {
+        sessionKey: "agent:main:sandbox-mutation-fence",
+        senderIsOwner: true,
+      },
+      runtimeOwnerToken: "sandbox-mutation-owner",
+      admittedRunContext,
+    });
+    const capture = {
+      token: grant.token,
+      runtimeOwnerToken: "sandbox-mutation-owner",
+      captureKey: "sandbox-mutation-capture",
+    };
+    expect(activateMcpLoopbackClientGrantCapture(capture)).toBeTruthy();
+    const resolvedGrant = resolveMcpLoopbackClientGrant(capture);
+    if (!resolvedGrant) {
+      throw new Error("expected a live MCP grant");
+    }
+    const mutationEntered = createDeferred<void>();
+    const releaseMutation = createDeferred<void>();
+    const sandbox = createSandbox({ workspaceDir, agentWorkspaceDir: workspaceDir });
+    const bridge = createSandboxFsBridge({
+      sandbox: {
+        ...sandbox,
+        backend: {
+          enforcesMutationFence: true,
+          runShellCommand: async (params) => {
+            if (params.script.includes("python_script=")) {
+              mutationEntered.resolve();
+              await releaseMutation.promise;
+              params.assertBeforeMutation?.();
+            }
+            return await mockedExecDockerRaw(
+              [
+                "exec",
+                "-i",
+                sandbox.containerName,
+                "sh",
+                "-c",
+                params.script,
+                "openclaw-sandbox-fs",
+                ...(params.args ?? []),
+              ],
+              {
+                input: params.stdin,
+                allowFailure: params.allowFailure,
+                signal: params.signal,
+              },
+            );
+          },
+        },
+      },
+    });
+    const tool = createSandboxedWriteTool({ root: workspaceDir, bridge });
+    try {
+      const pending = withGatewayToolCallerIdentity(
+        {
+          agentId: "main",
+          sessionKey: "agent:main:sandbox-mutation-fence",
+          receiptAuthority: resolvedGrant.isCurrent,
+        },
+        () => tool.execute("sandbox-write", { path: "note.txt", content: "blocked" }),
+      );
+      await mutationEntered.promise;
+      expect(revokeMcpLoopbackClientGrant(grant.token)).toBe(true);
+      releaseMutation.resolve();
+      await expect(pending).rejects.toThrow("authority is no longer active");
+      expect(
+        getScriptsFromCalls().filter((script) => script.includes("python_script=")),
+      ).toHaveLength(0);
+    } finally {
+      releaseMutation.resolve();
+      revokeMcpLoopbackClientGrant(grant.token);
+      admission.close();
+    }
+  });
+});
