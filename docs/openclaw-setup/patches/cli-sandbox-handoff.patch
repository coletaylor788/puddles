index 000000000..d5bd48515
--- /dev/null
+++ b/src/agents/sandbox/host-bridge-mutation-fence.test.ts
@@ -0,0 +1,71 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { expect, it } from "vitest";
+import { createHostSandboxFsBridge } from "../test-helpers/host-sandbox-fs-bridge.js";
+
+it.each(["write", "create", "copy", "rename", "mkdir", "remove"] as const)(
+  "keeps the host fixture from mutating after revocation: %s",
+  async (operation) => {
+    const root = await fs.mkdtemp(path.join(os.tmpdir(), "host-fence-"));
+    try {
+      await fs.writeFile(path.join(root, "source"), "original");
+      const bridge = createHostSandboxFsBridge(root);
+      const assertBeforeMutation = () => {
+        throw new Error("revoked");
+      };
+      const promise =
+        operation === "write"
+          ? bridge.writeFile({
+              filePath: "target",
+              data: "late",
+              mkdir: false,
+              assertBeforeMutation,
+            })
+          : operation === "create"
+            ? bridge.createFileExclusive!({
+                filePath: "target",
+                data: "late",
+                mkdir: false,
+                assertBeforeMutation,
+              })
+            : operation === "copy"
+              ? bridge.copyFile!({
+                  sourcePath: "source",
+                  destinationPath: "target",
+                  mkdir: false,
+                  assertBeforeMutation,
+                })
+              : operation === "rename"
+                ? bridge.rename({ from: "source", to: "target", assertBeforeMutation })
+                : operation === "mkdir"
+                  ? bridge.mkdirp({ filePath: "target", assertBeforeMutation })
+                  : bridge.remove({ filePath: "source", assertBeforeMutation });
+      await expect(promise).rejects.toThrow("revoked");
+      expect(await fs.readFile(path.join(root, "source"), "utf8")).toBe("original");
+      await expect(fs.stat(path.join(root, "target"))).rejects.toMatchObject({ code: "ENOENT" });
+    } finally {
+      await fs.rm(root, { recursive: true, force: true });
+    }
+  },
+);
+
+it("rechecks the host fixture after awaited directory preparation", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "host-fence-"));
+  try {
+    let assertions = 0;
+    await expect(
+      createHostSandboxFsBridge(root).writeFile({
+        filePath: "target",
+        data: "late",
+        assertBeforeMutation: () => {
+          if (++assertions === 2) throw new Error("revoked");
+        },
+      }),
+    ).rejects.toThrow("revoked");
+    expect(assertions).toBe(2);
+    await expect(fs.stat(path.join(root, "target"))).rejects.toMatchObject({ code: "ENOENT" });
+  } finally {
+    await fs.rm(root, { recursive: true, force: true });
+  }
+});
