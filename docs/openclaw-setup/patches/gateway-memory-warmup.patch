+import { listAgentIds, resolveAgentConfig, resolveAgentDir } from "../agents/agent-scope.js";
+import { resolveMemorySearchConfig } from "../agents/memory-search.js";
+import type {
+  AcquireConfiguredProviderLocalService,
+  ProviderLocalServiceLease,
+} from "../agents/provider-local-service-target.js";
+import { createConfiguredProviderLocalServiceAcquirer } from "../agents/provider-local-service.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { EmbeddingProvider } from "../plugins/embedding-provider-types.js";
+import { getMemoryEmbeddingProvider } from "../plugins/memory-embedding-provider-runtime.js";
+
+export const GATEWAY_MEMORY_WARMUP_TIMEOUT_MS = 90_000;
+const PROBES = ["A small red boat floats on a lake.", "A quiet library contains history books."];
+
+export function createGatewayMemoryWarmup(config: OpenClawConfig): {
+  ready: Promise<void>;
+  stop: () => Promise<void>;
+} | null {
+  const selected = listAgentIds(config).flatMap((agentId) => {
+    const enabled =
+      resolveAgentConfig(config, agentId)?.memory?.search?.local?.warmupOnGatewayStart ??
+      config.memory?.search?.local?.warmupOnGatewayStart;
+    if (!enabled) return [];
+    const memory = resolveMemorySearchConfig(config, agentId);
+    return memory?.local.warmupOnGatewayStart ? [{ agentId, memory }] : [];
+  });
+  if (selected.length === 0) return null;
+  const controller = new AbortController();
+  const timer = setTimeout(
+    () => controller.abort(new Error("Gateway local memory warmup exceeded 90 seconds")),
+    GATEWAY_MEMORY_WARMUP_TIMEOUT_MS,
+  );
+  const leases = new Set<ProviderLocalServiceLease>();
+  const providers = new Set<EmbeddingProvider>();
+  const acquire = createConfiguredProviderLocalServiceAcquirer(() => config);
+  const acquireLocalService: AcquireConfiguredProviderLocalService = async (target, signal) => {
+    const combined = signal ? AbortSignal.any([controller.signal, signal]) : controller.signal;
+    const lease = await acquire(target, combined);
+    if (!lease?.owned || combined.aborted) {
+      lease?.release();
+      combined.throwIfAborted();
+      throw new Error("Gateway memory warmup requires a gateway-owned local service");
+    }
+    leases.add(lease);
+    // The gateway, rather than one probe request, releases this lease at shutdown.
+    return { owned: true, release() {} };
+  };
+  const close = async () => {
+    try {
+      const results = await Promise.allSettled(
+        [...providers].map((provider) => provider.close?.()),
+      );
+      providers.clear();
+      const failures = results.flatMap((result) =>
+        result.status === "rejected" ? [result.reason] : [],
+      );
+      if (failures.length)
+        throw new AggregateError(failures, "Local embedding provider cleanup failed");
+    } finally {
+      for (const lease of leases) lease.release();
+      leases.clear();
+    }
+  };
+  const ready = (async () => {
+    try {
+      for (const { agentId, memory } of selected) {
+        controller.signal.throwIfAborted();
+        const leaseCount = leases.size;
+        const adapter = getMemoryEmbeddingProvider(memory.provider, config);
+        if (adapter?.transport !== "local")
+          throw new Error("Gateway memory warmup requires an explicit local embedding provider");
+        const result = await adapter.create({
+          config,
+          agentDir: resolveAgentDir(config, agentId),
+          provider: memory.provider,
+          model: memory.model,
+          local: memory.local,
+          dimensions: memory.outputDimensionality,
+          inputType: memory.inputType,
+          queryInputType: memory.queryInputType,
+          documentInputType: memory.documentInputType,
+          signal: controller.signal,
+          ...{ acquireLocalService },
+        });
+        if (!result.provider) throw new Error("Local embedding provider is unavailable");
+        providers.add(result.provider);
+        controller.signal.throwIfAborted();
+        const vectors = await result.provider.embedBatch(PROBES, {
+          signal: controller.signal,
+          inputType: "query",
+        });
+        const [first, second] = vectors;
+        controller.signal.throwIfAborted();
+        if (leases.size === leaseCount) {
+          throw new Error("Gateway memory warmup requires each provider to own its local service");
+        }
+        if (
+          vectors.length !== 2 ||
+          !first ||
+          !second ||
+          !vectors.every(
+            (vector) =>
+              vector.length > 0 &&
+              vector.length === first.length &&
+              (result.provider?.dimensions === undefined ||
+                vector.length === result.provider.dimensions) &&
+              vector.every(Number.isFinite) &&
+              vector.some((value) => value !== 0),
+          ) ||
+          !first.some((value, index) => value !== second[index])
+        ) {
+          throw new Error(
+            "Local embedding warmup did not produce two distinct finite nonzero vectors",
+          );
+        }
+      }
+    } catch (error) {
+      controller.abort(error);
+      try {
+        await close();
+      } catch (cleanupError) {
+        throw new AggregateError(
+          [error, cleanupError],
+          "Local embedding warmup and cleanup failed",
+        );
+      }
+      throw error;
+    } finally {
+      clearTimeout(timer);
+    }
+  })();
+  let stopping: Promise<void> | undefined;
+  return {
+    ready,
+    stop() {
+      return (stopping ??= (async () => {
+        controller.abort(new Error("Gateway local memory warmup stopped"));
+        await Promise.allSettled([ready]);
+        await close();
+      })());
+    },
+  };
+}
