@@ -0,0 +1,230 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { AcquireConfiguredProviderLocalService } from "../agents/provider-local-service-target.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { EmbeddingProviderCreateOptions } from "../plugins/embedding-provider-types.js";
+import { createGatewayMemoryWarmup } from "./server-memory-warmup.js";
+
+const mocks = vi.hoisted(() => ({
+  acquire: vi.fn<AcquireConfiguredProviderLocalService>(),
+  create: vi.fn(),
+  release: vi.fn(),
+  close: vi.fn(),
+  vectors: vi.fn(),
+}));
+vi.mock("../agents/provider-local-service.js", () => ({
+  createConfiguredProviderLocalServiceAcquirer: () => mocks.acquire,
+}));
+vi.mock("../plugins/memory-embedding-provider-runtime.js", () => ({
+  getMemoryEmbeddingProvider: () => ({
+    id: "local",
+    transport: "local",
+    defaultModel: "fixture",
+    create: mocks.create,
+  }),
+}));
+
+function config(enabled = true): OpenClawConfig {
+  return {
+    agents: { entries: { fixture: {} } },
+    memory: {
+      search: {
+        provider: "local",
+        model: "fixture",
+        fallback: "none",
+        local: { warmupOnGatewayStart: enabled },
+      },
+    },
+  };
+}
+
+type HostOptions = EmbeddingProviderCreateOptions & {
+  acquireLocalService: AcquireConfiguredProviderLocalService;
+};
+function later<T>(value: T, ms: number, signal?: AbortSignal): Promise<T> {
+  return new Promise((resolve, reject) => {
+    const abort = () => {
+      clearTimeout(timer);
+      reject(signal?.reason);
+    };
+    const timer = setTimeout(() => {
+      signal?.removeEventListener("abort", abort);
+      resolve(value);
+    }, ms);
+    signal?.addEventListener("abort", abort, { once: true });
+    if (signal?.aborted) abort();
+  });
+}
+
+describe("gateway local embedding startup", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.acquire.mockResolvedValue({ release: mocks.release, owned: true });
+    mocks.vectors.mockResolvedValue([
+      [0.1, 0.2],
+      [0.3, 0.4],
+    ]);
+    mocks.create.mockImplementation(async (options: HostOptions) => ({
+      provider: {
+        id: "local",
+        model: "fixture",
+        close: mocks.close,
+        embedBatch: async (input: string[], params: { signal?: AbortSignal }) => {
+          const lease = await options.acquireLocalService(
+            { providerId: "fixture", baseUrl: "http://127.0.0.1:1234" },
+            params.signal,
+          );
+          try {
+            return await mocks.vectors(input, params);
+          } finally {
+            lease?.release();
+          }
+        },
+      },
+    }));
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("does nothing unless explicitly enabled, including disabled agents", () => {
+    expect(createGatewayMemoryWarmup(config(false))).toBeNull();
+    const disabled = config();
+    disabled.memory!.search!.enabled = false;
+    expect(createGatewayMemoryWarmup(disabled)).toBeNull();
+    expect(mocks.create).not.toHaveBeenCalled();
+  });
+
+  it("honors a per-agent opt-out from the global warmup default", async () => {
+    const configured = config();
+    configured.agents = {
+      entries: {
+        fixture: {},
+        skipped: { memory: { search: { local: { warmupOnGatewayStart: false } } } },
+      },
+    };
+    const owner = createGatewayMemoryWarmup(configured)!;
+    await owner.ready;
+    expect(mocks.create).toHaveBeenCalledOnce();
+    await owner.stop();
+  });
+
+  it("requires every selected provider to acquire its own managed lease", async () => {
+    const configured = config();
+    configured.agents = { entries: { first: {}, second: {} } };
+    const create = mocks.create.getMockImplementation()!;
+    mocks.create.mockImplementationOnce(create).mockImplementationOnce(async () => ({
+      provider: {
+        id: "local",
+        model: "fixture",
+        embedBatch: mocks.vectors,
+      },
+    }));
+    const owner = createGatewayMemoryWarmup(configured)!;
+    await expect(owner.ready).rejects.toThrow("own its local service");
+    await owner.stop();
+    expect(mocks.acquire).toHaveBeenCalledOnce();
+    expect(mocks.release).toHaveBeenCalledOnce();
+  });
+
+  it("proves two actual vectors and retains the lease until gateway stop", async () => {
+    const owner = createGatewayMemoryWarmup(config())!;
+    await owner.ready;
+    expect(mocks.vectors.mock.calls[0][0]).toHaveLength(2);
+    expect(mocks.acquire).toHaveBeenCalledOnce();
+    expect(mocks.release).not.toHaveBeenCalled();
+    expect(mocks.close).not.toHaveBeenCalled();
+    await owner.stop();
+    await owner.stop();
+    expect(mocks.release).toHaveBeenCalledOnce();
+    expect(mocks.close).toHaveBeenCalledOnce();
+  });
+
+  it.each([
+    [],
+    [
+      [0, 0],
+      [1, 2],
+    ],
+    [
+      [1, 2],
+      [1, 2],
+    ],
+    [[1, 2], [1]],
+    [
+      [NaN, 2],
+      [3, 4],
+    ],
+  ])("does not mark invalid vectors ready (%j)", async (...vectors) => {
+    mocks.vectors.mockResolvedValue(vectors);
+    const owner = createGatewayMemoryWarmup(config())!;
+    await expect(owner.ready).rejects.toThrow("two distinct");
+    await owner.stop();
+    expect(mocks.release).toHaveBeenCalledOnce();
+  });
+
+  it("does not claim a preexisting unowned endpoint", async () => {
+    mocks.acquire.mockResolvedValue({ release: mocks.release, owned: false });
+    const owner = createGatewayMemoryWarmup(config())!;
+    await expect(owner.ready).rejects.toThrow("gateway-owned");
+    expect(mocks.vectors).not.toHaveBeenCalled();
+    expect(mocks.release).toHaveBeenCalledOnce();
+  });
+
+  it("shares one 90-second deadline across preparation and real vector production", async () => {
+    vi.useFakeTimers();
+    const create = mocks.create.getMockImplementation()!;
+    mocks.create.mockImplementation(async (options: HostOptions) => {
+      await later(undefined, 40_000, options.signal);
+      return await create(options);
+    });
+    mocks.vectors.mockImplementation(async (_input, params) =>
+      later(
+        [
+          [1, 2],
+          [3, 4],
+        ],
+        60_000,
+        params.signal,
+      ),
+    );
+    const owner = createGatewayMemoryWarmup(config())!;
+    await Promise.all([
+      expect(owner.ready).rejects.toThrow("90 seconds"),
+      vi.advanceTimersByTimeAsync(90_000),
+    ]);
+    expect(mocks.release).toHaveBeenCalledOnce();
+    expect(mocks.create.mock.calls[0][0].signal).toBe(mocks.vectors.mock.calls[0][1].signal);
+    await owner.stop();
+  });
+
+  it("cancels startup when its gateway lifetime ends", async () => {
+    vi.useFakeTimers();
+    mocks.vectors.mockImplementation(async (_input, params) =>
+      later(
+        [
+          [1, 2],
+          [3, 4],
+        ],
+        60_000,
+        params.signal,
+      ),
+    );
+    const owner = createGatewayMemoryWarmup(config())!;
+    const failed = expect(owner.ready).rejects.toThrow("stopped");
+    await vi.advanceTimersByTimeAsync(0);
+    await owner.stop();
+    await failed;
+    expect(mocks.release).toHaveBeenCalledOnce();
+  });
+
+  it("reacquires and warms again for the next gateway generation", async () => {
+    const first = createGatewayMemoryWarmup(config())!;
+    await first.ready;
+    await first.stop();
+    const next = createGatewayMemoryWarmup(config())!;
+    await next.ready;
+    expect(mocks.vectors).toHaveBeenCalledTimes(2);
+    expect(mocks.release).toHaveBeenCalledTimes(1);
+    await next.stop();
+  });
+});
