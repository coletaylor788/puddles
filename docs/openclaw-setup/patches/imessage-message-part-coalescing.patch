+// Imessage tests cover coalesce plugin behavior.
+import { describe, expect, it } from "vitest";
+import {
+  buildIMessageDmCoalesceKey,
+  combineIMessagePayloads,
+  iMessageTextHasUrl,
+  IMESSAGE_URL_BALLOON_BUNDLE_ID,
