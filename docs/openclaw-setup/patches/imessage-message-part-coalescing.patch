+const URL_PATTERN = /\b(?:https?:\/\/|www\.)\S+/i;
+const PAYLOAD_REFERENCE_PATTERN = /\b(?:this|that|these|those|one|here)\b/i;
+const PAYLOAD_KIND_PATTERN =
+  /\b(?:websites?|sites?|links?|pages?|images?|photos?|pictures?|articles?|videos?|files?|attachments?)\b/i;
