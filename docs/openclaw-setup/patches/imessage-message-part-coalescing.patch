+import { describe, expect, it } from "vitest";
+import { parseIMessageNotification } from "./parse-notification.js";
+
+describe("split-message metadata at durable ingress", () => {
+  it("retains URL balloon identity and current reply GUID", () => {
+    const parsed = parseIMessageNotification({
+      message: {
+        id: 1,
+        guid: "url-row",
+        chat_id: 1,
+        text: "https://example.com",
+        balloon_bundle_id: "com.apple.messages.URLBalloonProvider",
+        reply_to_guid: "lead-in",
+      },
+    });
+    expect(parsed?.balloon_bundle_id).toBe("com.apple.messages.URLBalloonProvider");
+    expect(parsed?.reply_to_guid).toBe("lead-in");
+  });
+
+  it.each([42, {}, []])("rejects malformed balloon metadata %j", (balloon_bundle_id) => {
+    expect(
+      parseIMessageNotification({
+        message: {
+          id: 1,
+          guid: "url-row",
+          chat_id: 1,
+          balloon_bundle_id,
+        },
+      }),
+    ).toBeNull();
+  });
+});
