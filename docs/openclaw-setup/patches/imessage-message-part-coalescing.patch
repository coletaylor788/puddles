+/**
+ * Match text that narrowly signals an immediately following payload row:
+ * either a short unfinished fragment or a bounded question with an explicit
+ * deictic reference. Other complete messages dispatch normally.
+ */
+export function isIMessageSplitLeadIn(params: {
+  text: string | null | undefined;
+  hasMedia: boolean;
+}): boolean {
+  if (params.hasMedia) {
+    return false;
+  }
+  const text = (params.text ?? "").trim();
+  if (!text || iMessageTextHasUrl(text)) {
+    return false;
+  }
+  const words = text.split(/\s+/).filter(Boolean);
+  if (words.length === 0) {
+    return false;
+  }
+  if (
+    text.endsWith("?") &&
+    words.length <= IMESSAGE_SPLIT_REFERENTIAL_QUESTION_MAX_WORDS &&
+    PAYLOAD_REFERENCE_PATTERN.test(text) &&
+    (PAYLOAD_KIND_PATTERN.test(text) || PAYLOAD_COMPARISON_PATTERN.test(text))
+  ) {
+    return true;
+  }
+  return !/[.?!…]$/.test(text) && words.length <= IMESSAGE_SPLIT_LEAD_IN_MAX_WORDS;
