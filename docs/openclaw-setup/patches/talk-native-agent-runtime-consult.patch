+import path from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { testing as cliBackendsTesting } from "../../agents/cli-backends.test-support.js";
+import { runCliAgent } from "../../agents/cli-runner.js";
+import { resolveCliRuntimeExecutionProvider } from "../../agents/model-runtime-aliases.js";
+import { isCliProvider } from "../../agents/model-selection.js";
+import { withFullRuntimeReplyConfig } from "../../auto-reply/reply/get-reply-fast-path.js";
+import { replaceSessionEntry } from "../../config/sessions/session-accessor.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { createEmptyPluginRegistry } from "../../plugins/registry-empty.js";
+import { setActivePluginRegistry } from "../../plugins/runtime.js";
+import {
+  createOpenClawTestState,
+  type OpenClawTestState,
+} from "../../test-utils/openclaw-test-state.js";
+import { testing as talkConsultTesting } from "./client-agent-consult.js";
+
+const embeddedCandidate = vi.hoisted(() =>
+  vi.fn(async () => {
+    throw new Error("embedded API execution is forbidden in this fixture");
+  }),
+);
+vi.mock("../../agents/embedded-agent.js", () => ({ runEmbeddedAgent: embeddedCandidate }));
+vi.mock("../../agents/runtime-plugins.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../agents/runtime-plugins.js")>()),
+  withAgentPluginRegistry: async (params: { run: () => Promise<unknown> }) => await params.run(),
+}));
+
+vi.mock("../../agents/cli-runner.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../agents/cli-runner.js")>()),
+  runCliAgent: vi.fn(async () => ({
+    payloads: [{ text: "native Talk reply" }],
+    meta: { durationMs: 1 },
+  })),
+}));
+
+let state: OpenClawTestState | undefined;
+
+afterEach(async () => {
+  setActivePluginRegistry(createEmptyPluginRegistry(), "talk-cli-runtime-cleanup");
+  cliBackendsTesting.resetDepsForTest();
+  await state?.cleanup();
+  state = undefined;
+  vi.clearAllMocks();
+});
+
+it.each([
+  { label: "configured model", selection: {} },
+  {
+    label: "explicit selected model",
+    selection: { provider: "anthropic", model: "claude-opus-4-6" },
+  },
+])("routes a Talk consult through the production selector for $label", async ({ selection }) => {
+  state = await createOpenClawTestState({
+    label: "talk-cli-runtime",
+    env: { OPENCLAW_TEST_FAST: "0" },
+  });
+  const model = "claude-opus-4-6";
+  const cfg = withFullRuntimeReplyConfig({
+    agents: {
+      defaults: {
+        workspace: state.workspaceDir,
+        skipBootstrap: true,
+        model: { primary: `anthropic/${model}` },
+        models: { [`anthropic/${model}`]: { agentRuntime: { id: "claude-cli" } } },
+      },
+    },
+    plugins: { enabled: false },
+  }) as OpenClawConfig;
+  await state.writeConfig(cfg);
+  cliBackendsTesting.setDepsForTest({
+    resolveRuntimeCliBackends: () => [
+      {
+        id: "claude-cli",
+        modelProvider: "anthropic",
+        pluginId: "anthropic",
+        config: { command: "synthetic-claude" },
+      },
+    ],
+    resolvePluginSetupCliBackend: () => undefined,
+  });
+  const registry = createEmptyPluginRegistry();
+  registry.cliBackends.push({
+    pluginId: "anthropic",
+    source: "test",
+    backend: {
+      id: "claude-cli",
+      modelProvider: "anthropic",
+      config: { command: "synthetic-claude" },
+    },
+  } as never);
+  setActivePluginRegistry(registry, "talk-cli-runtime");
+  const sessionKey = "agent:main:talk-cli-runtime";
+  const sessionId = "talk-cli-runtime-session";
+  const storePath = path.join(state.sessionsDir("main"), "sessions.json");
+  await replaceSessionEntry(
+    { agentId: "main", sessionKey, storePath },
+    {
+      sessionId,
+      updatedAt: Date.now(),
+      toolOverrides: { mcpServers: { private: false } },
+    },
+  );
+
+  const runtime = talkConsultTesting.createTalkClientAgentRuntime({ config: cfg });
+  expect(resolveCliRuntimeExecutionProvider({ provider: "anthropic", modelId: model, cfg })).toBe(
+    "claude-cli",
+  );
+  expect(isCliProvider("claude-cli", cfg)).toBe(true);
+  const result = await runtime.runEmbeddedAgent({
+    agentId: "main",
+    ...selection,
+    prompt: "Use the configured native runtime.",
+    runId: "talk-cli-runtime-run",
+    workspaceDir: state.workspaceDir,
+    sessionTarget: { agentId: "main", sessionId, sessionKey, storePath },
+  });
+
+  expect(result.payloads).toEqual([expect.objectContaining({ text: "native Talk reply" })]);
+  expect(runCliAgent).toHaveBeenCalledOnce();
+  expect(runCliAgent).toHaveBeenCalledWith(
+    expect.objectContaining({
+      provider: "claude-cli",
+      transcriptPrompt: "Use the configured native runtime.",
+      sessionKey,
+      toolOverrides: { mcpServers: { private: false } },
+    }),
+  );
+  expect(embeddedCandidate).not.toHaveBeenCalled();
+});
