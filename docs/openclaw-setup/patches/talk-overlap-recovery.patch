diff --git a/extensions/openai/realtime-quicksilver-concurrency.test.ts b/extensions/openai/realtime-quicksilver-concurrency.test.ts
new file mode 100644
--- /dev/null
+++ b/extensions/openai/realtime-quicksilver-concurrency.test.ts
@@ -0,0 +1,259 @@
+import { setImmediate as nextEventLoopTurn } from "node:timers/promises";
+import { describe, expect, it, vi } from "vitest";
+import {
+  createDelegationHarness,
+  parseSent,
+  type ConsultRunner,
+} from "./realtime-quicksilver.test-helpers.js";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (reason: Error) => void;
+  const promise = new Promise<T>((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+const unsupported = () =>
+  Object.assign(new Error("private host detail"), {
+    code: "TALK_STEERING_UNSUPPORTED",
+  });
+
+// Real public wire decoding, transcript matching, delegation lifecycle and output.
+// Only backend work and provider transport are recording doubles. These tests do
+// not certify tool authorization, which is covered by the host policy suites.
+function scenario(params: Parameters<typeof createDelegationHarness>[0]) {
+  const h = createDelegationHarness({ ...params, model: "gpt-live-1" });
+  let offset = 0;
+  const frame = (event: unknown) =>
+    h.controller.handleFrame(Buffer.from(JSON.stringify(event)), false);
+  const request = (id: string, text: string, noticeFirst = false) => {
+    const input = () =>
+      frame({
+        type: "session.input_transcript.delta",
+        delta: text,
+        start_ms: offset,
+        end_ms: offset + 100,
+      });
+    const notice = () =>
+      frame({
+        type: "session.delegation.created",
+        offset_ms: offset + 100,
+        delegation: { id, type: "delegation", target: "client" },
+      });
+    if (noticeFirst) {
+      notice();
+      input();
+    } else {
+      input();
+      notice();
+    }
+    offset += 200;
+  };
+  const replies = (id: string) =>
+    parseSent(h.socket).filter(
+      (e) => e.type === "session.commentary.append" && e.delegation_id === id,
+    );
+  return { ...h, request, replies, frame };
+}
+
+describe("GPT-Live concurrent conversation and backend work", () => {
+  const workKinds = [
+    "read",
+    "parallel-reads",
+    "recorded-write",
+    "reader-child",
+    "tool-failure",
+  ] as const;
+  it.each(workKinds.flatMap((kind) => [false, true].map((noticeFirst) => ({ kind, noticeFirst }))))(
+    "keeps $kind work and conversation alive across rejected overlaps; noticeFirst=$noticeFirst",
+    async ({ kind, noticeFirst }) => {
+      const tool = deferred<string>();
+      const secondTool = deferred<string>();
+      const effects: string[] = [];
+      let final: ((text: string) => boolean) | undefined;
+      const run = vi.fn<ConsultRunner>(async ({ requesterFinal }) => {
+        final = requesterFinal?.append;
+        effects.push(kind);
+        if (kind === "reader-child") {
+          return { text: "", yielded: true };
+        }
+        if (kind === "parallel-reads") {
+          const values = await Promise.all([tool.promise, secondTool.promise]);
+          return { text: values.join(" + ") };
+        }
+        return { text: await tool.promise };
+      });
+      const steer = vi.fn(async () => {
+        throw unsupported();
+      });
+      // Hold the parent until after overlaps, then simulate a yielded child.
+      const admission = deferred<void>();
+      const runner = vi.fn<ConsultRunner>(async (request) => {
+        await admission.promise;
+        return run(request);
+      });
+      const h = scenario({ runAgentConsult: runner, steerAgentConsult: steer });
+      try {
+        h.request("first", "check my calendar", noticeFirst);
+        await vi.waitFor(() => expect(runner).toHaveBeenCalledOnce());
+        for (const id of ["weather", "match"]) {
+          h.request(id, `also check ${id}`, noticeFirst);
+          await vi.waitFor(() => expect(h.replies(id)).toHaveLength(1));
+          expect(h.replies(id)[0]?.content).toContain("not accepted");
+        }
+        expect(h.onFatalError).not.toHaveBeenCalled();
+        expect(runner.mock.calls[0]?.[0].signal?.aborted).toBe(false);
+        admission.resolve();
+        await vi.waitFor(() => expect(effects).toEqual([kind]));
+        // Parallel tools finish out of order, but each result retains its slot.
+        secondTool.resolve("second read");
+        if (kind === "tool-failure") {
+          tool.reject(new Error("private tool failure"));
+        } else {
+          tool.resolve("first result");
+        }
+        await nextEventLoopTurn();
+        if (kind === "reader-child") {
+          expect(final?.("child result")).toBe(true);
+          expect(final?.("duplicate child result")).toBe(false);
+        }
+        await vi.waitFor(() =>
+          expect(
+            h
+              .replies("first")
+              .some((e) =>
+                String(e.content).includes(
+                  kind === "tool-failure"
+                    ? "failed"
+                    : kind === "reader-child"
+                      ? "child result"
+                      : "first result",
+                ),
+              ),
+          ).toBe(true),
+        );
+        expect(effects).toEqual([kind]);
+        runner.mockResolvedValueOnce({ text: "next result" });
+        h.request("next", "now check weather", noticeFirst);
+        await vi.waitFor(() => expect(h.replies("next")[0]?.content).toBe("next result"));
+        expect(runner).toHaveBeenCalledTimes(2);
+        expect(h.onFatalError).not.toHaveBeenCalled();
+        expect(JSON.stringify(parseSent(h.socket))).not.toContain("private");
+      } finally {
+        admission.resolve();
+        tool.resolve("");
+        secondTool.resolve("");
+        h.controller.stop(new Error("test cleanup"));
+      }
+    },
+  );
+
+  it.each(["result-first", "rejection-first"])(
+    "resolves completion racing steering: %s",
+    async (order) => {
+      const result = deferred<{ text: string }>();
+      const steering = deferred<{ text: string }>();
+      const run = vi.fn<ConsultRunner>(async () => result.promise);
+      const steer = vi.fn(async () => steering.promise);
+      const h = scenario({ runAgentConsult: run, steerAgentConsult: steer });
+      try {
+        h.request("first", "original question");
+        h.request("second", "additional question");
+        await vi.waitFor(() => expect(steer).toHaveBeenCalledOnce());
+        if (order === "result-first") {
+          result.resolve({ text: "original answer" });
+          await nextEventLoopTurn();
+        }
+        steering.reject(unsupported());
+        await vi.waitFor(() => expect(h.replies("second")).toHaveLength(1));
+        result.resolve({ text: "original answer" });
+        await vi.waitFor(() => expect(h.replies("first")[0]?.content).toBe("original answer"));
+        expect(h.onFatalError).not.toHaveBeenCalled();
+        expect(run).toHaveBeenCalledOnce();
+      } finally {
+        result.resolve({ text: "" });
+        h.controller.stop(new Error("test cleanup"));
+      }
+    },
+  );
+
+  it.each(["cancel", "detach", "provider-failure"])(
+    "fences pending rejection and stale results after %s",
+    async (ending) => {
+      const result = deferred<{ text: string }>();
+      const steering = deferred<{ text: string }>();
+      let final: ((text: string) => boolean) | undefined;
+      const run = vi.fn<ConsultRunner>(async ({ requesterFinal }) => {
+        final = requesterFinal?.append;
+        return result.promise;
+      });
+      const steer = vi.fn(async () => steering.promise);
+      const h = scenario({ runAgentConsult: run, steerAgentConsult: steer });
+      try {
+        h.request("first", "original question");
+        h.request("second", "additional question");
+        await vi.waitFor(() => expect(steer).toHaveBeenCalledOnce());
+        if (ending === "detach") {
+          h.controller.detach();
+        } else {
+          h.controller.stop(new Error(ending));
+        }
+        const count = h.socket.sent.length;
+        steering.reject(unsupported());
+        result.resolve({ text: "late result" });
+        await nextEventLoopTurn();
+        expect(final?.("late child result")).toBe(false);
+        expect(h.socket.sent).toHaveLength(count);
+        expect(run.mock.calls[0]?.[0].signal?.aborted).toBe(ending !== "detach");
+        expect(h.onFatalError).not.toHaveBeenCalled();
+        // Reconnecting creates a distinct owner. Old callbacks cannot publish there.
+        const fresh = scenario({
+          runAgentConsult: vi.fn(async () => ({ text: "new connection" })),
+        });
+        try {
+          fresh.request("fresh", "new request");
+          await vi.waitFor(() => expect(fresh.replies("fresh")[0]?.content).toBe("new connection"));
+          expect(final?.("stale reconnect result")).toBe(false);
+          expect(fresh.replies("first")).toEqual([]);
+        } finally {
+          fresh.controller.stop(new Error("test cleanup"));
+        }
+      } finally {
+        result.resolve({ text: "" });
+        h.controller.stop(new Error("test cleanup"));
+      }
+    },
+  );
+
+  it("cleans up a failed rejection delivery without an unhandled promise or duplicate work", async () => {
+    const run = vi.fn<ConsultRunner>(
+      async ({ signal }) =>
+        new Promise((_resolve, reject) => {
+          signal?.addEventListener("abort", () => reject(signal.reason), { once: true });
+        }),
+    );
+    const h = scenario({
+      runAgentConsult: run,
+      steerAgentConsult: vi.fn(async () => {
+        throw unsupported();
+      }),
+    });
+    try {
+      h.request("first", "original question");
+      await vi.waitFor(() => expect(run).toHaveBeenCalledOnce());
+      vi.spyOn(h.socket, "send").mockImplementation(() => {
+        throw new Error("transport send failed");
+      });
+      h.request("second", "additional question");
+      await vi.waitFor(() => expect(h.onFatalError).toHaveBeenCalledOnce());
+      expect(run.mock.calls[0]?.[0].signal?.aborted).toBe(true);
+      await nextEventLoopTurn();
+      expect(run).toHaveBeenCalledOnce();
+    } finally {
+      h.controller.stop(new Error("test cleanup"));
+    }
+  });
+});
