+  requesterAgentId: string;
+  targetAgentId: string;
+  configuredRequireAgentId?: boolean;
+  allowAgents?: readonly string[];
+  configuredAgentIds?: readonly string[];
+}): string | undefined {
+  const requesterAgentId = normalizeAgentId(params.requesterAgentId);
+  if (
+    params.configuredRequireAgentId === false ||
+    normalizeAgentId(params.targetAgentId) !== requesterAgentId
+  ) {
+    return undefined;
+  }
+  const allowed = resolveSubagentAllowedTargetIds({
+    requesterAgentId,
+    allowAgents: params.allowAgents,
+    configuredAgentIds: params.configuredAgentIds,
+  }).allowedIds.filter((id) => id !== requesterAgentId);
+  const allowedText = allowed.length > 0 ? allowed.join(", ") : "none";
+  return (
+    `sessions_spawn cron requester "${requesterAgentId}" cannot target itself while explicit agentId policy is enabled. ` +
+    `Choose a non-requester agentId (allowed: ${allowedText}); taskName and label do not select an agent profile. ` +
+    "Set subagents.requireAgentId=false only for an intentional cron same-agent child."
+  );
+}
