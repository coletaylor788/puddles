--- /dev/null
+++ b/src/agents/tools/sessions-untrusted-projection.ts
@@ -0,0 +1,101 @@
+import type { OpenClawConfig } from "../../config/types.js";
+import { redactToolPayloadText } from "../../logging/redact.js";
+import { formatUntrustedAgentText, isUntrustedAgentSession } from "../untrusted-agent-results.js";
+
+/** History is a presentation of the selected source session, never an executable tool call. */
+export function projectUntrustedSessionMessage(
+  message: unknown,
+  config: OpenClawConfig,
+  sourceSessionKey: string,
+  maxChars = 4000,
+): { message: unknown; truncated: boolean; redacted: boolean } {
+  if (!isUntrustedAgentSession(config, sourceSessionKey)) {
+    return { message, truncated: false, redacted: false };
+  }
+  let truncated = false;
+  let redacted = false;
+  const enclose = (value: unknown) => {
+    try {
+      const raw = typeof value === "string" ? value : (JSON.stringify(value) ?? "");
+      const text = redactToolPayloadText(raw);
+      redacted ||= text !== raw;
+      const rendered = formatUntrustedAgentText({ config, sourceSessionKey, text, maxChars });
+      truncated ||=
+        rendered.includes("…[truncated]") || rendered.startsWith("[Agent content unavailable");
+      return rendered;
+    } catch {
+      truncated = true;
+      return "[Agent content unavailable]".slice(0, maxChars);
+    }
+  };
+  const result = (message: unknown) => ({ message, truncated, redacted });
+  if (!message || typeof message !== "object" || Array.isArray(message))
+    return result(enclose(message));
+  const entry = { ...(message as Record<string, unknown>) };
+  // Keep runtime message identities and protocol roles. All source content is rendered as
+  // text, including tool argument objects whose keys can themselves contain instructions.
+  for (const key of Object.keys(entry)) {
+    if (
+      [
+        "role",
+        "id",
+        "toolCallId",
+        "tool_call_id",
+        "timestamp",
+        "stopReason",
+        "isError",
+        "usage",
+        "cost",
+        "api",
+        "provider",
+        "model",
+      ].includes(key)
+    )
+      continue;
+    if (key === "__openclaw" && entry[key] && typeof entry[key] === "object") {
+      const metadata = { ...(entry[key] as Record<string, unknown>) };
+      // Sequence/id/provenance and media references are runtime controls. Descriptive
+      // attachment text is source data even though it accompanies a media descriptor.
+      if (Array.isArray(metadata.media)) {
+        metadata.media = metadata.media.map((media) => {
+          if (!media || typeof media !== "object") return media;
+          const copy = { ...media } as Record<string, unknown>;
+          for (const name of [
+            "fileName",
+            "filename",
+            "title",
+            "caption",
+            "alt",
+            "text",
+            "description",
+          ]) {
+            if (typeof copy[name] === "string") copy[name] = enclose(copy[name]);
+          }
+          return copy;
+        });
+      }
+      entry[key] = metadata;
+    } else if (key === "content" && Array.isArray(entry.content)) {
+      entry.content = entry.content.map((block) => {
+        if (!block || typeof block !== "object") return { type: "text", text: enclose(block) };
+        const source = block as Record<string, unknown>;
+        if (source.type === "image" || source.type === "audio") return source;
+        // Preserve block shape for ordinary text and thinking; render tool data as one
+        // enclosed JSON report rather than releasing arbitrary property names.
+        if (
+          source.type === "text" &&
+          Object.keys(source).every((k) => k === "type" || k === "text")
+        ) {
+          return { ...source, text: enclose(source.text) };
+        }
+        if (source.type === "thinking" && typeof source.thinking === "string") {
+          return { type: "thinking", thinking: enclose(source.thinking) };
+        }
+        return { type: "text", text: enclose(source) };
+      });
+    } else if (typeof entry[key] === "string" || typeof entry[key] === "object") {
+      entry[key] = enclose(entry[key]);
+    }
+  }
+  return result(entry);
+}
