index 0000000..c31c6ac
--- /dev/null
+++ b/src/agents/untrusted-agent-results.ts
@@ -0,0 +1,86 @@
+import { normalizeAgentId } from "@openclaw/normalization-core/agent-id";
+import type { OpenClawConfig } from "../config/types.js";
+import { parseAgentSessionKey } from "../routing/session-key.js";
+import { wrapUntrustedPromptDataBlock } from "./sanitize-for-prompt.js";
+
+const LABEL = "Agent result";
+const UNAVAILABLE = "[Agent content unavailable]";
+const MARKER = "…[truncated]";
+const ENCLOSURE_OVERHEAD = wrapUntrustedPromptDataBlock({ label: LABEL, text: "x" }).length - 1;
+
+/** Source keys come from the session owner. Unknown sources require an unavailable presentation. */
+export function isUntrustedAgentSession(
+  config: OpenClawConfig,
+  sourceSessionKey: string | undefined,
+): boolean {
+  const selected = config.tools?.agentToAgent?.untrustedAgents;
+  if (!selected?.length) return false;
+  const source = parseAgentSessionKey(sourceSessionKey ?? "");
+  return (
+    !source || selected.some((id) => normalizeAgentId(id) === normalizeAgentId(source.agentId))
+  );
+}
+
+/** maxChars bounds the complete presentation, including escaping and closing tags. */
+export function formatUntrustedAgentText(params: {
+  config: OpenClawConfig;
+  sourceSessionKey: string | undefined;
+  text: string;
+  maxChars?: number;
+  truncationMarker?: string;
+}): string {
+  if (!params.config.tools?.agentToAgent?.untrustedAgents?.length) return params.text;
+  const limit =
+    params.maxChars === undefined ? undefined : Math.max(0, Math.floor(params.maxChars));
+  const unavailable = () => (limit === undefined ? UNAVAILABLE : UNAVAILABLE.slice(0, limit));
+  // A missing identity with an enabled policy cannot release an unclassified report.
+  if (!parseAgentSessionKey(params.sourceSessionKey ?? "")) return unavailable();
+  if (!isUntrustedAgentSession(params.config, params.sourceSessionKey)) return params.text;
+  if (limit !== undefined && limit <= ENCLOSURE_OVERHEAD) return unavailable();
+  try {
+    return (
+      wrapUntrustedPromptDataBlock({
+        label: LABEL,
+        text: params.text || "(no output)",
+        ...(limit === undefined ? {} : { maxEscapedChars: limit - ENCLOSURE_OVERHEAD }),
+        truncationMarker: params.truncationMarker ?? MARKER,
+      }) ||
+      wrapUntrustedPromptDataBlock({
+        label: LABEL,
+        text: "(no output)",
+        ...(limit === undefined ? {} : { maxEscapedChars: limit - ENCLOSURE_OVERHEAD }),
+      })
+    );
+  } catch {
+    return unavailable();
+  }
+}
+
+/** Dependency labels carry their own child's identity, even under a trusted parent. */
+export function formatUntrustedAgentExecution<
+  T extends {
+    wait?: { dependencies?: Array<{ sessionKey?: string; label?: string }> };
+  },
+>(config: OpenClawConfig, execution: T): T {
+  if (!config.tools?.agentToAgent?.untrustedAgents?.length || !execution.wait?.dependencies) {
+    return execution;
+  }
+  return {
+    ...execution,
+    wait: {
+      ...execution.wait,
+      dependencies: execution.wait.dependencies.map((dependency) => ({
+        ...dependency,
+        ...(dependency.label
+          ? {
+              label: formatUntrustedAgentText({
+                config,
+                sourceSessionKey: dependency.sessionKey,
+                text: dependency.label,
+              }),
+            }
+          : {}),
+      })),
+    },
+  };
+}
