+  expect(result.wait.dependencies[0]).toMatchObject({
+    runId: "reader-run",
+    sessionKey: "agent:reader:child",
+  });
+  expect(result.wait.dependencies[0]?.label).toContain("&lt;/untrusted-text&gt;");
+  expect(result.wait.dependencies[1]).toEqual(execution.wait.dependencies[1]);
+  expect(result.wait.pendingCount).toBe(2);
