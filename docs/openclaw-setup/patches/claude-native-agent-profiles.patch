diff --git a/extensions/anthropic/cli-profile.test.ts b/extensions/anthropic/cli-profile.test.ts
new file mode 100644
index 00000000000..51239071516
--- /dev/null
+++ b/extensions/anthropic/cli-profile.test.ts
@@ -0,0 +1,135 @@
+import type { CliBackendNormalizeConfigContext } from "openclaw/plugin-sdk/cli-backend";
+import { describe, expect, it, vi } from "vitest";
+import { buildAnthropicCliBackend } from "./cli-backend.js";
+import { applyClaudeAgentProfile } from "./cli-profile.js";
+import { resolveClaudeCliExecutionArgs } from "./cli-shared.js";
+
+function context(
+  mode: "workspace" | "diagnostic" | "restricted",
+  allow: string[] = ["read", "write"],
+): CliBackendNormalizeConfigContext {
+  return {
+    backendId: "claude-cli",
+    agentId: "selected",
+    workspaceDir: "/tmp/workspace",
+    config: {
+      agents: { entries: { selected: { tools: { allow } } } },
+      plugins: {
+        entries: {
+          anthropic: {
+            config: {
+              cliConfigDir: "/tmp/native-login",
+              cliProfiles: { selected: { mode, protectedPaths: ["/tmp/workspace/private"] } },
+            },
+          },
+        },
+      },
+    },
+  };
+}
+const base = {
+  command: "claude",
+  args: ["-p", "--setting-sources", "user", "--permission-mode", "bypassPermissions"],
+  resumeArgs: ["-p", "--resume", "{sessionId}"],
+};
+const settings = (args: string[]) => JSON.parse(args[args.indexOf("--settings") + 1]!);
+
+describe("explicit Claude agent profiles", () => {
+  it("leaves non-selected agents unchanged", () => {
+    expect(applyClaudeAgentProfile(base, { ...context("workspace"), agentId: "other" })).toBe(base);
+  });
+  it("uses actual workspace and binds protected paths and native settings into fresh and resumed argv", () => {
+    const selected = applyClaudeAgentProfile(base, context("workspace"));
+    expect(selected.nativePermissionMode).toBe("defer");
+    for (const args of [selected.args!, selected.resumeArgs!]) {
+      expect(args).not.toContain("bypassPermissions");
+      expect(args[args.indexOf("--setting-sources") + 1]).toBe("");
+      expect(settings(args)).toMatchObject({
+        disableAllHooks: true,
+        permissions: {
+          blockReadsOutsideWorkingDirectories: true,
+          allow: ["Edit(//tmp/workspace/**)"],
+        },
+        sandbox: { enabled: true, failIfUnavailable: true, allowUnsandboxedCommands: false },
+      });
+      expect(settings(args).permissions.deny).toContain("Read(//tmp/workspace/private/**)");
+    }
+    const changed = applyClaudeAgentProfile(base, {
+      ...context("workspace"),
+      workspaceDir: "/tmp/other",
+    });
+    expect(changed.args).not.toEqual(selected.args);
+  });
+  it("clears inherited service secrets even when their names look harmless", () => {
+    vi.stubEnv("NEUTRAL_CONFIG_VALUE", "synthetic-not-a-secret");
+    try {
+      const selected = applyClaudeAgentProfile(base, context("workspace"));
+      expect(selected.strictClearEnv).toBe(true);
+      expect(selected.clearEnv).toContain("NEUTRAL_CONFIG_VALUE");
+      expect(selected.env?.CLAUDE_CONFIG_DIR).toBe("/tmp/native-login");
+      expect(settings(selected.args!).sandbox.filesystem.denyRead).toContain(
+        "/private/tmp/openclaw-cli-mcp-*",
+      );
+    } finally {
+      vi.unstubAllEnvs();
+    }
+  });
+  it.each([undefined, "2.1.256", "2.1.300"])(
+    "refuses unqualified Claude versions: %s",
+    async (version) => {
+      const backend = buildAnthropicCliBackend({ resolveVersion: async () => version });
+      await expect(
+        backend.prepareExecution!({
+          ...context("workspace"),
+          workspaceDir: "/tmp/workspace",
+          provider: "claude-cli",
+          modelId: "haiku",
+        }),
+      ).rejects.toThrow("2.1.301");
+    },
+  );
+  it("accepts native login on the qualified CLI and rejects forwarded API credentials", async () => {
+    const backend = buildAnthropicCliBackend({ resolveVersion: async () => "2.1.301" });
+    const execution = {
+      ...context("workspace"),
+      workspaceDir: "/tmp/workspace",
+      provider: "claude-cli",
+      modelId: "haiku",
+    };
+    await expect(backend.prepareExecution!(execution)).resolves.toBeDefined();
+    const forwarded = { ...execution, authCredential: { type: "api_key", key: "synthetic-key" } };
+    await expect(backend.prepareExecution!(forwarded)).rejects.toThrow("forwarded credentials");
+  });
+  it("keeps the diagnostic exception explicit", () => {
+    const selected = applyClaudeAgentProfile(base, context("diagnostic"));
+    expect(settings(selected.args!).sandbox.enabled).toBe(false);
+    expect(selected.nativePermissionMode).toBe("defer");
+  });
+  it.each([{ allow: [] }, { allow: ["read"] }])(
+    "preserves restricted agent caps, including empty caps: %j",
+    ({ allow }) => {
+      const selected = applyClaudeAgentProfile(base, context("restricted", allow));
+      expect(selected.toolsAllow).toEqual(allow);
+      expect(selected.nativePermissionMode).toBeUndefined();
+    },
+  );
+  it("rejects unbounded specialist configuration", () => {
+    expect(() => applyClaudeAgentProfile(base, context("restricted", ["*"]))).toThrow(
+      "explicit agent tools.allow",
+    );
+  });
+  it("keeps per-run restricted execution stronger than a native agent profile", () => {
+    const selected = applyClaudeAgentProfile(base, context("workspace"));
+    const args = resolveClaudeCliExecutionArgs({
+      workspaceDir: "/tmp/workspace",
+      provider: "claude-cli",
+      modelId: "haiku",
+      useResume: false,
+      baseArgs: selected.args!,
+      toolAvailability: { native: [], openClaw: ["memory_search"] },
+    });
+    expect(args[args.indexOf("--tools") + 1]).toBe("");
+    expect(args[args.indexOf("--allowedTools") + 1]).toBe("mcp__openclaw__memory_search");
+    expect(settings(args).permissions).toBeUndefined();
+  });
+});
diff --git a/extensions/anthropic/cli-profile.ts b/extensions/anthropic/cli-profile.ts
new file mode 100644
index 00000000000..9cc6b4ca96b
--- /dev/null
+++ b/extensions/anthropic/cli-profile.ts
@@ -0,0 +1,179 @@
+import { realpathSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { resolveAgentConfig } from "openclaw/plugin-sdk/agent-scope-runtime";
+import type {
+  CliBackendConfig,
+  CliBackendNormalizeConfigContext,
+} from "openclaw/plugin-sdk/cli-backend";
+
+type ClaudeAgentProfile = {
+  mode: "workspace" | "diagnostic" | "restricted";
+  protectedPaths?: string[];
+};
+type ClaudeProfileConfig = {
+  cliConfigDir?: string;
+  cliProfiles?: Record<string, ClaudeAgentProfile>;
+};
+
+export function resolveClaudeAgentProfile(
+  context?: Pick<CliBackendNormalizeConfigContext, "config" | "agentId">,
+) {
+  const config = context?.config?.plugins?.entries?.anthropic?.config as
+    | ClaudeProfileConfig
+    | undefined;
+  const profile = context?.agentId ? config?.cliProfiles?.[context.agentId] : undefined;
+  return { profile, configDir: config?.cliConfigDir };
+}
+
+function absolutePath(value: string): string {
+  const expanded = value.startsWith("~/") ? path.join(os.homedir(), value.slice(2)) : value;
+  // These are literal trusted paths, not permission-rule expressions.
+  if (!path.isAbsolute(expanded) || /[\n\r*?\[\]{}()]/u.test(expanded)) {
+    throw new Error("Claude profile paths must be absolute literal paths (or start with ~/).");
+  }
+  return path.resolve(expanded);
+}
+
+function replaceArgs(args: string[] | undefined, settings: object): string[] {
+  const result: string[] = [];
+  const values = new Set([
+    "--settings",
+    "--setting-sources",
+    "--permission-mode",
+    "--tools",
+    "--allowedTools",
+  ]);
+  for (let i = 0; i < (args?.length ?? 0); i++) {
+    const arg = args![i]!;
+    if (values.has(arg)) {
+      i++;
+      continue;
+    }
+    if ([...values].some((name) => arg.startsWith(`${name}=`))) continue;
+    if (arg === "--dangerously-skip-permissions") continue;
+    result.push(arg);
+  }
+  return [
+    ...result,
+    "--setting-sources",
+    "",
+    "--settings",
+    JSON.stringify(settings),
+    "--permission-mode",
+    "default",
+    "--tools",
+    "Read,Write,Edit,Bash,Glob,Grep,AskUserQuestion",
+    "--allowedTools",
+    "mcp__openclaw__*",
+    "--disable-slash-commands",
+    "--no-chrome",
+    "--strict-mcp-config",
+  ];
+}
+
+/** Select an explicit agent profile without changing the stock backend for other agents. */
+export function applyClaudeAgentProfile(
+  config: CliBackendConfig,
+  context?: CliBackendNormalizeConfigContext,
+): CliBackendConfig {
+  const { profile, configDir } = resolveClaudeAgentProfile(context);
+  if (!profile) return config;
+  if (!configDir)
+    throw new Error("Claude agent profiles require a dedicated cliConfigDir subscription login.");
+  const env = {
+    ...config.env,
+    CLAUDE_CONFIG_DIR: absolutePath(configDir),
+    CLAUDE_CODE_SUBPROCESS_ENV_SCRUB: profile.mode === "workspace" ? "0" : "1",
+  };
+  // The native login only needs OS/session plumbing. Host service credentials belong
+  // to guarded MCP adapters, never to the model's shell environment.
+  const safeEnv =
+    /^(?:PATH|HOME|USER|LOGNAME|SHELL|TMPDIR|TMP|TEMP|LANG|LC_[A-Z_]+|TZ|TERM|COLORTERM|__CF_USER_TEXT_ENCODING)$/u;
+  const clearEnv = [
+    ...new Set([
+      ...(config.clearEnv ?? []),
+      ...Object.keys(process.env).filter((name) => !safeEnv.test(name)),
+    ]),
+  ].sort();
+  if (profile.mode === "restricted") {
+    const allow = context?.agentId
+      ? resolveAgentConfig(context.config ?? {}, context.agentId)?.tools?.allow
+      : undefined;
+    if (!allow || allow.some((name) => name.includes("*"))) {
+      throw new Error(
+        "Restricted Claude profiles require an explicit agent tools.allow without wildcards.",
+      );
+    }
+    return { ...config, env, clearEnv, strictClearEnv: true, toolsAllow: [...allow] };
+  }
+  // Discovery can normalize before a workspace is admitted. Only execution owns the root.
+  if (!context?.workspaceDir) return { ...config, env, clearEnv, strictClearEnv: true };
+  const workspace = absolutePath(context.workspaceDir);
+  const protectedPaths = [
+    ...new Set(
+      [configDir, "~/.ssh", "~/.aws", "~/Library/Keychains", ...(profile.protectedPaths ?? [])].map(
+        absolutePath,
+      ),
+    ),
+  ];
+  // MCP files contain rendered bearer credentials. Cover fresh and retained warm
+  // configs with stable globs instead of random per-turn paths in the fingerprint.
+  const mcpConfigPaths = [
+    ...new Set([os.tmpdir(), realpathSync(os.tmpdir()), "/tmp", "/private/tmp"]),
+  ].map((root) => path.join(root, "openclaw-cli-mcp-*"));
+  const deniedPaths = [...protectedPaths, ...mcpConfigPaths];
+  const settings = {
+    disableAllHooks: true,
+    enabledPlugins: {},
+    autoMemoryEnabled: false,
+    disableClaudeAiConnectors: true,
+    claudeMdExcludes: ["**/CLAUDE.md", "**/CLAUDE.local.md", "**/.claude/rules/**"],
+    permissions: {
+      defaultMode: "default",
+      blockReadsOutsideWorkingDirectories: profile.mode === "workspace",
+      allow: [`Edit(/${workspace}/**)`],
+      deny: deniedPaths.flatMap((entry) => [
+        `Read(/${entry})`,
+        `Read(/${entry}/**)`,
+        `Edit(/${entry})`,
+        `Edit(/${entry}/**)`,
+      ]),
+    },
+    sandbox: {
+      credentials: {
+        envVars: [
+          "OPENCLAW_MCP_TOKEN",
+          "OPENCLAW_MCP_SESSION_KEY",
+          "OPENCLAW_MCP_CLI_CAPTURE_KEY",
+          "GITHUB_TOKEN",
+          "GH_TOKEN",
+          "GH_ENTERPRISE_TOKEN",
+          "GITHUB_ENTERPRISE_TOKEN",
+        ].map((name) => ({ name, mode: "deny" })),
+      },
+      enabled: profile.mode === "workspace",
+      failIfUnavailable: true,
+      autoAllowBashIfSandboxed: true,
+      allowUnsandboxedCommands: false,
+      excludedCommands: [],
+      filesystem: { denyRead: deniedPaths, denyWrite: deniedPaths },
+      network: {
+        allowedDomains: [],
+        strictAllowlist: true,
+        allowLocalBinding: false,
+        allowUnixSockets: [],
+        allowAllUnixSockets: false,
+      },
+    },
+  };
+  return {
+    ...config,
+    env,
+    clearEnv,
+    strictClearEnv: true,
+    nativePermissionMode: "defer",
+    args: replaceArgs(config.args, settings),
+    resumeArgs: replaceArgs(config.resumeArgs, settings),
+  };
+}
