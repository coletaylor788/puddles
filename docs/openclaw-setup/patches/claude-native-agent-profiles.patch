diff --git a/src/gateway/cli-session-history.profile-dir.test.ts b/src/gateway/cli-session-history.profile-dir.test.ts
new file mode 100644
index 00000000000..54d4240eed9
--- /dev/null
+++ b/src/gateway/cli-session-history.profile-dir.test.ts
@@ -0,0 +1,142 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { claudeCliSessionTranscriptHasContent } from "../agents/command/attempt-execution.helpers.js";
+import {
+  resolveClaudeCliProjectDirForWorkspace,
+  resolveConfiguredClaudeCliConfigDir,
+} from "../agents/command/claude-cli-project-dir.js";
+import { readClaudeCliSessionMessagesAsync } from "./cli-session-history.claude-snapshot.js";
+import {
+  readClaudeCliSessionMessages,
+  readClaudeCliFallbackSeed,
+} from "./cli-session-history.claude.js";
+
+describe("dedicated Claude profile transcript directory", () => {
+  let homeDir: string, configDir: string, workspaceDir: string;
+  const cliSessionId = "synthetic-profile-session";
+  beforeEach(async () => {
+    homeDir = await fs.mkdtemp(path.join(os.tmpdir(), "claude-profile-history-"));
+    configDir = path.join(homeDir, "dedicated");
+    workspaceDir = path.join(homeDir, "workspace");
+    await fs.mkdir(workspaceDir);
+  });
+  afterEach(async () => {
+    await fs.rm(homeDir, { recursive: true, force: true });
+  });
+  async function write(marker: string, directory?: string) {
+    const root = resolveClaudeCliProjectDirForWorkspace({
+      workspaceDir,
+      homeDir,
+      configDir: directory,
+    });
+    await fs.mkdir(root, { recursive: true });
+    const events = [
+      { type: "user", uuid: "user-1", message: { role: "user", content: marker } },
+      {
+        type: "assistant",
+        uuid: "assistant-1",
+        message: {
+          role: "assistant",
+          model: "synthetic-model",
+          content: [
+            {
+              type: "tool_use",
+              id: "write-1",
+              name: "Write",
+              input: { file_path: "/synthetic/file", content: marker },
+            },
+          ],
+        },
+      },
+      {
+        type: "user",
+        uuid: "result-1",
+        message: {
+          role: "user",
+          content: [
+            { type: "tool_result", tool_use_id: "write-1", content: "Created synthetic file" },
+          ],
+        },
+      },
+      {
+        type: "assistant",
+        uuid: "assistant-2",
+        message: {
+          role: "assistant",
+          model: "synthetic-model",
+          content: [{ type: "text", text: marker }],
+        },
+      },
+    ];
+    await fs.writeFile(
+      path.join(root, cliSessionId + ".jsonl"),
+      events.map((e) => JSON.stringify(e)).join("\n"),
+    );
+  }
+  it("keeps default and dedicated histories separate even when session ids collide", async () => {
+    await write("DEFAULT_HISTORY");
+    await write("DEDICATED_HISTORY", configDir);
+    const params = { cliSessionId, homeDir, configDir };
+    for (const messages of [
+      readClaudeCliSessionMessages(params),
+      await readClaudeCliSessionMessagesAsync(params),
+    ]) {
+      expect(JSON.stringify(messages)).toContain("DEDICATED_HISTORY");
+      expect(JSON.stringify(messages)).not.toContain("DEFAULT_HISTORY");
+      expect(JSON.stringify(messages)).toContain('"name":"Write"');
+      expect(JSON.stringify(messages)).toContain("Created synthetic file");
+    }
+    expect(JSON.stringify(readClaudeCliSessionMessages({ cliSessionId, homeDir }))).toContain(
+      "DEFAULT_HISTORY",
+    );
+    expect(JSON.stringify(readClaudeCliFallbackSeed(params))).toContain("DEDICATED_HISTORY");
+    expect(JSON.stringify(readClaudeCliFallbackSeed(params))).not.toContain("DEFAULT_HISTORY");
+  });
+  it("cold-resume probe finds the dedicated transcript without searching another account directory", async () => {
+    await write("DEDICATED_HISTORY", configDir);
+    expect(
+      await claudeCliSessionTranscriptHasContent({
+        sessionId: cliSessionId,
+        workspaceDir,
+        homeDir,
+        configDir,
+      }),
+    ).toBe(true);
+    expect(
+      await claudeCliSessionTranscriptHasContent({
+        sessionId: cliSessionId,
+        workspaceDir,
+        homeDir,
+      }),
+    ).toBe(false);
+    expect(
+      readClaudeCliSessionMessages({
+        cliSessionId,
+        homeDir,
+        configDir: path.join(homeDir, "other-account"),
+      }),
+    ).toEqual([]);
+    expect(
+      readClaudeCliSessionMessages({ cliSessionId: "other-session", homeDir, configDir }),
+    ).toEqual([]);
+    expect(
+      readClaudeCliSessionMessages({ cliSessionId: "../" + cliSessionId, homeDir, configDir }),
+    ).toEqual([]);
+  });
+  it("only opted-in agents resolve the dedicated profile directory", () => {
+    const config = {
+      plugins: {
+        entries: {
+          anthropic: {
+            config: { cliConfigDir: configDir, cliProfiles: { main: { mode: "workspace" } } },
+          },
+        },
+      },
+    };
+    expect(resolveConfiguredClaudeCliConfigDir(config, "main")).toBe(configDir);
+    expect(resolveConfiguredClaudeCliConfigDir(config, "other")).toBeUndefined();
+    expect(resolveConfiguredClaudeCliConfigDir({}, "main")).toBeUndefined();
+  });
+});
