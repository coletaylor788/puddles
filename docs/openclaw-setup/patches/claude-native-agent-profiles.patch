+/** Match the opt-in profile's native login directory; other backends keep defaults. */
+export function resolveConfiguredClaudeCliConfigDir(
+  cfg: OpenClawConfig,
+  agentId: string,
+): string | undefined {
+  const settings = cfg.plugins?.entries?.anthropic?.config;
+  const profiles = settings?.cliProfiles;
+  if (!profiles || typeof profiles !== "object" || !Object.hasOwn(profiles, agentId))
+    return undefined;
+  const value = settings?.cliConfigDir;
+  if (typeof value !== "string" || !value) return undefined;
+  const expanded = value.startsWith("~/") ? path.join(os.homedir(), value.slice(2)) : value;
+  if (!path.isAbsolute(expanded))
+    throw new Error("Claude profile config directory must be absolute");
+  return path.resolve(expanded);
+}
