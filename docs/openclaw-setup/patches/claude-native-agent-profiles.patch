@@ -0,0 +1,51 @@
+import { afterEach, expect, it, vi } from "vitest";
+import { resolveCliChildEnv } from "./execution-env.js";
+
+const preserveKey = "OPENCLAW_LIVE_CLI_BACKEND_PRESERVE_ENV";
+afterEach(() => vi.unstubAllEnvs());
+
+it.each([false, true])(
+  "applies strict profile credential clearing=%s in the actual child environment",
+  (strict) => {
+    vi.stubEnv("ANTHROPIC_API_KEY", "synthetic-ambient-key");
+    vi.stubEnv("NEUTRAL_CREDENTIAL", "synthetic-ambient-neutral");
+    vi.stubEnv(preserveKey, "ANTHROPIC_API_KEY,NEUTRAL_CREDENTIAL");
+    const { env } = resolveCliChildEnv({
+      backend: {
+        command: "claude",
+        clearEnv: ["ANTHROPIC_API_KEY", "NEUTRAL_CREDENTIAL"],
+        ...(strict ? { strictClearEnv: true as const } : {}),
+      },
+    });
+    expect(env.ANTHROPIC_API_KEY).toBe(strict ? undefined : "synthetic-ambient-key");
+    expect(env.NEUTRAL_CREDENTIAL).toBe(strict ? undefined : "synthetic-ambient-neutral");
+  },
+);
+
+it("retains explicit backend overrides after strict clearing but strips them for native-login-only runs", () => {
+  vi.stubEnv("ANTHROPIC_API_KEY", "synthetic-ambient-key");
+  vi.stubEnv(preserveKey, "ANTHROPIC_API_KEY");
+  const prepared = {
+    backend: {
+      command: "claude",
+      strictClearEnv: true as const,
+      clearEnv: ["ANTHROPIC_API_KEY"],
+      env: { ANTHROPIC_API_KEY: "synthetic-selected-key" },
+    },
+  };
+  expect(resolveCliChildEnv(prepared).env.ANTHROPIC_API_KEY).toBe("synthetic-selected-key");
+  expect(
+    resolveCliChildEnv(prepared, { nativeAuthOnly: true }).env.ANTHROPIC_API_KEY,
+  ).toBeUndefined();
+});
+
+it("keeps selected-auth clearing authoritative without the strict profile option", () => {
+  vi.stubEnv("ANTHROPIC_API_KEY", "synthetic-ambient-key");
+  vi.stubEnv(preserveKey, "ANTHROPIC_API_KEY");
+  const { env } = resolveCliChildEnv({
+    backend: { command: "claude", clearEnv: ["ANTHROPIC_API_KEY"] },
+    env: { CLAUDE_CODE_OAUTH_TOKEN: "synthetic-selected-token" },
+  });
+  expect(env.ANTHROPIC_API_KEY).toBeUndefined();
+  expect(env.CLAUDE_CODE_OAUTH_TOKEN).toBe("synthetic-selected-token");
+});
