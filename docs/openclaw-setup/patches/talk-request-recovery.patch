+        await vi.waitFor(() => expect(mocks.consultRealtimeVoiceAgent).toHaveBeenCalledOnce());
+        consultation = Promise.resolve(mocks.consultRealtimeVoiceAgent.mock.results[0]?.value);
+        await withinTest(
+          awaitGateBeforeSettlement(
+            started.promise,
+            consultation,
+            "consult settled before backend publication",
+          ),
+          context.signal,
+        );
+        request("additional", "read another document");
+        await withinTest(
+          awaitGateBeforeSettlement(
+            enterControl.promise,
+            consultation,
+            "consult settled before steering gate",
+          ),
+          context.signal,
+        );
+        finish.resolve();
+        await vi.waitFor(() =>
+          expect(mocks.consultRealtimeVoiceAgent.mock.settledResults[0]?.type).toBe(
+            outcome === "success" ? "fulfilled" : "rejected",
+          ),
+        );
+        resumeControl.resolve();
+        await vi.waitFor(() =>
+          expect(
+            replies("original"),
+            JSON.stringify({ sent, fatal: fatal.mock.calls.map((call) => String(call[0])) }),
+          ).toHaveLength(1),
+        );
+        expect(replies("original")[0]?.content).toContain(
+          outcome === "success" ? "done" : "failed",
+        );
+        expect(replies("additional")[0]?.content).toContain("not accepted");
+        expect(fatal).not.toHaveBeenCalled();
+        request("retry", "try again using the other document");
+        await vi.waitFor(() => expect(replies("retry")[0]?.content).toBe("done"));
+        expect(attempts).toBe(2);
+        expect(fatal).not.toHaveBeenCalled();
+      } finally {
+        finish.resolve();
+        resumeControl.resolve();
+        controller.stop(new Error("fixture cleanup"));
