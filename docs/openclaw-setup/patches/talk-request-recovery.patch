+  runEmbeddedAgent: mocks.runEmbeddedAgentCore,
+}));
+vi.mock("../../src/talk/agent-consult-runtime.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../src/talk/agent-consult-runtime.js")>()),
+  consultRealtimeVoiceAgent: mocks.consultRealtimeVoiceAgent,
+}));
+vi.mock("../../src/talk/agent-run-control.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../src/talk/agent-run-control.js")>()),
+  controlRealtimeVoiceAgentRun: mocks.controlRealtimeVoiceAgentRun,
+}));
+import {
+  createRunner,
+  resetConsultFixture,
+} from "../../src/gateway/talk/client-gateway-control.agent-consult-fixture.test-support.js";
+
+describe("GPT-Live Gateway completion races", () => {
+  beforeEach(resetConsultFixture);
+  afterEach(() => embeddedRunsTesting.resetActiveEmbeddedRuns());
+
+  it.for(["success", "failure"])(
+    "keeps the real Gateway owner and voice call usable when %s races input",
+    async (outcome, context) => {
+      const started = deferred<void>();
+      const finish = deferred<void>();
+      const enterControl = deferred<void>();
+      const resumeControl = deferred<void>();
+      const actual = await vi.importActual<typeof import("../../src/talk/agent-run-control.js")>(
+        "../../src/talk/agent-run-control.js",
+      );
+      mocks.controlRealtimeVoiceAgentRun.mockImplementationOnce(async (params) => {
+        enterControl.resolve();
+        await resumeControl.promise;
+        return actual.controlRealtimeVoiceAgentRun(params);
+      });
+      const operationalRunInstance = { instanceId: "instance:completion-race", runId: "run-talk" };
+      mocks.createOperationalRunInstanceRef.mockReturnValue(operationalRunInstance);
+      let attempts = 0;
+      mocks.runEmbeddedAgentCore.mockImplementation(async () => {
+        const attempt = ++attempts;
+        const handle = createEmbeddedRunHandle({ runId: "run-talk" });
+        await withGatewayToolCallerIdentity(
+          {
+            agentId: "researcher",
+            sessionKey: "agent:researcher:talk",
+            operationalRunInstance,
+            embeddedRunToolAuthorityBinding: () => ({
+              source: "attempt",
+              project: () => "authority",
+              projectAsync: async () => "authority",
+              assertActive: () => {},
+            }),
+          },
+          () => setActiveEmbeddedRun("session-talk", handle, "agent:researcher:talk"),
+        );
+        started.resolve();
+        await finish.promise;
+        clearActiveEmbeddedRun("session-talk", handle, "agent:researcher:talk");
+        if (attempt === 1 && outcome === "failure") throw new Error("synthetic reader failure");
+        return { payloads: [] };
+      });
+      const runner = createRunner(undefined, undefined, { ownerConnId: "connection-owner" });
+      const sent: Array<{ type: string; delegation_id?: string; content?: string }> = [];
+      const socket = { readyState: 1, send: (text: string) => sent.push(JSON.parse(text)) };
+      const fatal = vi.fn();
+      const controller = new OpenAIQuicksilverDelegationController(
+        {
+          model: "gpt-live-1",
+          signal: new AbortController().signal,
+          getSocket: () => socket as never,
+          logger: { debug: vi.fn(), warn: vi.fn() },
+          runAgentConsult: runner.runPrompt,
+          onFatalError: fatal,
+        },
+        String,
+      );
+      let offset = 0;
+      const request = (id: string, text: string) => {
+        controller.handleFrame(
+          Buffer.from(
+            JSON.stringify({
+              type: "session.input_transcript.delta",
+              delta: text,
+              start_ms: offset,
+              end_ms: offset + 100,
+            }),
+          ),
+          false,
+        );
+        controller.handleFrame(
+          Buffer.from(
+            JSON.stringify({
+              type: "session.delegation.created",
