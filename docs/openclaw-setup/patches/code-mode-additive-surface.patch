diff --git a/src/agents/code-mode-skill-runtime.ts b/src/agents/code-mode-skill-runtime.ts
new file mode 100644
index 00000000000..2795760a221
--- /dev/null
+++ b/src/agents/code-mode-skill-runtime.ts
@@ -0,0 +1,66 @@
+import type { Skill } from "../skills/loading/skill-contract.js";
+import type { SkillSnapshot, SkillUsagePath } from "../skills/types.js";
+import { resolveCodeModeSkills, type CodeModeSkillReader } from "./code-mode-skills.js";
+import type { SandboxContext } from "./sandbox/types.js";
+import { getAgentWorkspaceAccess, WorkspaceAccessUnavailableError } from "./workspace-access.js";
+
+/** Bind the exact prompt catalog to the same source readers as ordinary skill reads. */
+export function resolveRuntimeCodeModeSkills(params: {
+  skillsPrompt: string;
+  candidates: readonly Skill[];
+  skillsSnapshot?: SkillSnapshot;
+  skillsWorkspaceDir: string;
+  sandbox?: SandboxContext | null;
+  /** Delivered locations when a native harness retains the original prompt paths. */
+  skillReadLocations?: readonly SkillUsagePath[];
+}) {
+  const sandbox = params.sandbox;
+  const sandboxSkillReader: CodeModeSkillReader | undefined = sandbox?.enabled
+    ? async ({ location, signal }) => {
+        const bridge = sandbox.fsBridge;
+        if (!bridge) {
+          throw new Error("Sandbox filesystem bridge is unavailable for skill reads.");
+        }
+        return (
+          await bridge.readFile({ filePath: location, cwd: sandbox.containerWorkdir, signal })
+        ).toString("utf8");
+      }
+    : undefined;
+  const workspaceAccess = !sandbox?.enabled
+    ? getAgentWorkspaceAccess(params.skillsWorkspaceDir, "loadSkills")
+    : undefined;
+  const workspaceSkillReader: CodeModeSkillReader | undefined = workspaceAccess?.loadSkills
+    ? async ({ location, signal }) => {
+        if (!workspaceAccess.skillResources) {
+          throw new WorkspaceAccessUnavailableError("Remote workspace skill reads are unavailable");
+        }
+        return await workspaceAccess.skillResources.readInstructions(location, { signal });
+      }
+    : undefined;
+  const skills = resolveCodeModeSkills({
+    skillsPrompt: params.skillsPrompt,
+    candidates: params.candidates,
+    reader: sandboxSkillReader,
+  });
+  for (const skill of skills) {
+    const delivered = params.skillReadLocations?.find((entry) => entry.skillName === skill.name);
+    if (sandboxSkillReader && delivered) {
+      skill.reader = ({ signal }) => sandboxSkillReader({ location: delivered.readPath, signal });
+    }
+    if (workspaceSkillReader) {
+      const candidate = params.candidates.find((entry) => entry.filePath === skill.source.filePath);
+      // Resolved ownership wins over a same-name Library pin that was filtered out.
+      if (
+        candidate?.fileHost === "workspace" ||
+        (candidate?.fileHost !== "gateway" &&
+          !params.skillsSnapshot?.librarySelections?.some(
+            (selection) => selection.name === skill.name,
+          ))
+      ) {
+        skill.reader = ({ signal }) =>
+          workspaceSkillReader({ location: skill.source.filePath, signal });
+      }
+    }
+  }
+  return skills;
+}
diff --git a/src/agents/embedded-agent-runner/run/attempt-tool-catalog.test.ts b/src/agents/embedded-agent-runner/run/attempt-tool-catalog.test.ts
new file mode 100644
index 00000000000..83159b7766b
--- /dev/null
+++ b/src/agents/embedded-agent-runner/run/attempt-tool-catalog.test.ts
@@ -0,0 +1,85 @@
+import { describe, expect, it, vi } from "vitest";
+import { createAgentHarnessToolSurfaceRuntimeCore } from "../../harness/tool-surface-bridge.js";
+import { createFakeStream } from "./attempt-stream.test-helpers.js";
+import { wrapStreamFnTrimToolCallNames } from "./attempt-tool-call-stream-normalization.js";
+import { prepareEmbeddedAttemptToolCatalog } from "./attempt-tool-catalog.js";
+
+describe("additive client tool visibility", () => {
+  it.each(["additive", "compact"] as const)(
+    "preserves direct client calls only on the %s surface",
+    async (surface) => {
+      const config = {
+        tools: { codeMode: { enabled: true as const, surface }, toolSearch: false as const },
+      };
+      const runtime = createAgentHarnessToolSurfaceRuntimeCore({
+        config,
+        executeTool: async () => ({ content: [], details: {} }),
+        modelToolsEnabled: true,
+        runId: `client-visibility-${surface}`,
+      });
+      try {
+        const catalog = prepareEmbeddedAttemptToolCatalog({
+          attempt: {
+            config,
+            runId: `client-visibility-${surface}`,
+            model: { api: "openai-completions" },
+            runtimePlan: { tools: { logDiagnostics: vi.fn() } },
+          },
+          setup: {
+            sessionAgentId: "main",
+            effectiveWorkspace: "/tmp/client-visibility",
+            getProviderRuntimeHandle: () => undefined,
+          },
+          preparedToolBase: {
+            toolSurfaceRuntime: runtime,
+            codeModeControlsEnabledForRun: true,
+            codeModeSkills: [],
+            runtimeCapabilityProfile: { policy: {} },
+            toolSearchConfig: runtime.plan.toolSearchConfig,
+            toolSearchControlsEnabledForRun: false,
+            toolsEnabled: true,
+          },
+          bundleTools: {
+            uncompactedEffectiveTools: [],
+            clientTools: [
+              {
+                type: "function",
+                function: { name: "client_pick_file", parameters: { type: "object" } },
+              },
+            ],
+          },
+          abortSignal: new AbortController().signal,
+          executeCodeModeTool: async () => ({ content: [], details: {} }),
+        } as never);
+        const plan = catalog.toolSearchRunPlan;
+        expect(plan.visibleAllowedToolNames.has("client_pick_file")).toBe(surface === "additive");
+        expect(plan.replayAllowedToolNames.has("client_pick_file")).toBe(true);
+        const stream = wrapStreamFnTrimToolCallNames(
+          (() =>
+            createFakeStream({
+              events: [],
+              resultMessage: {
+                role: "assistant",
+                content: [{ type: "toolCall", name: "client_pick_file", arguments: {} }],
+              },
+            })) as never,
+          plan.liveAllowedToolNames,
+          { unknownToolThreshold: 1 },
+        );
+        // Repeated calls exercise the unknown-tool loop guard, not just name spelling.
+        for (let index = 0; index < 3; index += 1) {
+          const result = await (await stream({} as never, {} as never, {} as never)).result();
+          if (surface === "additive") {
+            expect(result.content).toEqual([
+              expect.objectContaining({ type: "toolCall", name: "client_pick_file" }),
+            ]);
+          } else if (index > 0) {
+            expect(result.content[0]?.type).toBe("text");
+          }
+        }
+      } finally {
+        runtime.cleanup();
+      }
+    },
+  );
+});
