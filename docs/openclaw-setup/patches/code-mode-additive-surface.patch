index 0000000000000000000000000000000000000000..398ec5fa6c0820fe53b26694adec05574e571add
--- /dev/null
+++ b/src/agents/code-mode.scheduling.test.ts
@@ -0,0 +1,109 @@
+import { expectDefined } from "@openclaw/normalization-core";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createDeferredCore } from "../shared/deferred.js";
+import { applyCodeModeCatalog } from "./code-mode.js";
+import {
+  createCodeModeHarness,
+  resetCodeModeTestState,
+  resultDetails,
+  waitUntilCompleted,
+} from "./code-mode.test-support.js";
+import { jsonResult, type AnyAgentTool } from "./tools/common.js";
+
+afterEach(resetCodeModeTestState);
+
+describe("additive Code Mode tool execution scheduling", () => {
+  it.each([false, true])(
+    "shares direct and nested exclusion when the first tool is direct-only=%s",
+    async (directOnly) => {
+      const events: string[] = [];
+      const gate = (name: string, executionMode: AnyAgentTool["executionMode"]) => {
+        const started = createDeferredCore();
+        const release = createDeferredCore();
+        const tool: AnyAgentTool = {
+          name,
+          label: name,
+          description: name,
+          parameters: Type.Object({}),
+          executionMode,
+          execute: vi.fn(async () => {
+            events.push(`${name}:start`);
+            started.resolve();
+            await release.promise;
+            events.push(`${name}:done`);
+            return jsonResult({ name });
+          }),
+        };
+        return { tool, started: started.promise, release: () => release.resolve() };
+      };
+      const firstGate = gate("first", "parallel");
+      const exclusiveGate = gate("exclusive", "sequential");
+      const lastGate = gate("last", "parallel");
+      if (directOnly) {
+        firstGate.tool.catalogMode = "direct-only";
+      }
+      const harness = createCodeModeHarness({
+        codeMode: { surface: "additive", timeoutMs: 10_000 },
+      });
+      const projection = applyCodeModeCatalog({
+        ...harness.ctx,
+        tools: [...harness.tools, firstGate.tool, exclusiveGate.tool, lastGate.tool],
+      });
+      const first = expectDefined(
+        projection.tools.find((tool) => tool.name === "first"),
+        "direct first",
+      );
+      const last = expectDefined(
+        projection.tools.find((tool) => tool.name === "last"),
+        "direct last",
+      );
+      const exec = expectDefined(
+        projection.tools.find((tool) => tool.name === "code_exec"),
+        "additive exec",
+      );
+      const wait = expectDefined(
+        projection.tools.find((tool) => tool.name === "code_wait"),
+        "additive wait",
+      );
+      const firstResult = first.execute("first-call", {});
+      let lastResult: ReturnType<AnyAgentTool["execute"]> | undefined;
+      try {
+        await firstGate.started;
+        const parked = resultDetails(
+          await exec.execute("script", {
+            code: "const pending = exclusive({}); await yield_control(); return await pending;",
+          }),
+        );
+        expect(parked, JSON.stringify(parked)).toMatchObject({ status: "waiting" });
+        expect(events).toEqual(["first:start"]);
+        lastResult = last.execute("last-call", {});
+        firstGate.release();
+        expect((await firstResult).details).toEqual({ name: "first" });
+        await exclusiveGate.started;
+        expect(events).toEqual(["first:start", "first:done", "exclusive:start"]);
+        exclusiveGate.release();
+        await lastGate.started;
+        lastGate.release();
+        expect((await lastResult).details).toEqual({ name: "last" });
+        expect(await waitUntilCompleted({ details: parked, waitTool: wait })).toMatchObject({
+          status: "completed",
+          value: { name: "exclusive" },
+        });
+        expect(firstGate.tool.execute).toHaveBeenCalledOnce();
+        expect(exclusiveGate.tool.execute).toHaveBeenCalledOnce();
+        expect(lastGate.tool.execute).toHaveBeenCalledOnce();
+        if (directOnly) {
+          expect(harness.catalogRef.current?.entries.some((entry) => entry.name === "first")).toBe(
+            false,
+          );
+        }
+      } finally {
+        firstGate.release();
+        exclusiveGate.release();
+        lastGate.release();
+        await Promise.allSettled([firstResult, lastResult]);
+      }
+    },
+  );
+});
