@@ -4709,6 +4709,62 @@ describe("active-memory plugin", () => {
     expect(runEmbeddedAgent).not.toHaveBeenCalled();
   });
 
+  it.each([
+    { readyAfterMs: 1_850, setupGraceTimeoutMs: 2_000, recalled: true },
+    { readyAfterMs: 2_600, setupGraceTimeoutMs: 1_700, recalled: false },
+  ])(
+    "shares always recall setup with a cold trigger lookup (recalled=$recalled)",
+    async ({ readyAfterMs, setupGraceTimeoutMs, recalled }) => {
+      const timeoutMs = 250;
+      registerPluginConfig({ timeoutMs, setupGraceTimeoutMs, logging: true });
+      const providerReady = createDeferred<void>();
+      let readinessTimer: ReturnType<typeof setTimeout> | undefined;
+      hoisted.getActiveMemorySearchManager.mockImplementationOnce(async () => {
+        readinessTimer = setTimeout(() => providerReady.resolve(), readyAfterMs);
+        await providerReady.promise;
+        return { manager: null };
+      });
+      runEmbeddedAgent.mockImplementationOnce(async (params: { sessionFile: string }) => {
+        await providerReady.promise;
+        await writeUsableMemoryTranscript(params.sessionFile, "cold local recall");
+        return { payloads: [{ text: "cold local recall" }] };
+      });
+      const startedAt = Date.now();
+      try {
+        const result = await runPromptBuild(
+          { prompt: "What did we decide about the project?" },
+          {
+            sessionKey: "agent:main:telegram:direct:cold",
+            messageProvider: "telegram",
+            channelId: "cold",
+          },
+        );
+        expect(runEmbeddedAgent).toHaveBeenCalledTimes(1);
+        // The optional lookup cannot receive a second setup allowance for deep recall.
+        expect(lastEmbeddedRunParams().timeoutMs).toBeLessThan(timeoutMs + setupGraceTimeoutMs);
+        if (recalled) {
+          expectPrependContextContains(result, "cold local recall");
+        } else {
+          expect(result).toBeUndefined();
+          expectLinesToContain(
+            vi.mocked(api.logger.info).mock.calls.map((call: unknown[]) => String(call[0])),
+            "status=timeout",
+          );
+        }
+        expect(Date.now() - startedAt).toBeLessThan(
+          timeoutMs + setupGraceTimeoutMs + 1_500 + 1_000,
+        );
+        expectLinesNotToContain(
+          vi.mocked(api.logger.warn).mock.calls.map((call: unknown[]) => String(call[0])),
+          "preflight timed out",
+        );
+      } finally {
+        clearTimeout(readinessTimer);
+        providerReady.resolve();
+      }
+    },
+  );
+
   it("preserves recall settlement time after near-limit preflight latency", async () => {
