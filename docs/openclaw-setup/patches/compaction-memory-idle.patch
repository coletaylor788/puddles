@@ -0,0 +1,202 @@
+import { createHash } from "node:crypto";
+import type { PluginStateKeyedStore } from "../../plugin-state/plugin-state-store.types.js";
+import type { AgentHarnessHookContext } from "../harness/hook-context.js";
+
+/** Persist data only. Authentication references are resolved again by the admitted saver. */
+export type CompactionMemorySource = {
+  agentId: string;
+  sessionKey: string;
+  sessionId: string;
+  storePath: string;
+  workspaceDir: string;
+  harnessId: string;
+  provider: string;
+  model: string;
+  authProfileId?: string;
+  authProfileIdSource?: "auto" | "user";
+  contextTokens: number;
+  policy?: AgentHarnessHookContext["memorySavePolicy"];
+};
+export type CompactionMemoryJob = {
+  kind: "job";
+  id: string;
+  source: CompactionMemorySource;
+  watermark: string;
+  chunks: number;
+  createdAt: number;
+  turnTainted: boolean;
+  status: "pending" | "saving" | "reconcile" | "succeeded";
+  attempts: number;
+};
+type SnapshotChunk = { kind: "chunk"; data: string };
+export type CompactionMemoryRecord = CompactionMemoryJob | SnapshotChunk;
+type Store = Pick<
+  PluginStateKeyedStore<CompactionMemoryRecord>,
+  "registerIfAbsent" | "lookup" | "register" | "entries" | "delete"
+>;
+const CHUNK_CHARS = 64 * 1024;
+const MAX_SNAPSHOT_BYTES = 32 * 1024 * 1024;
+const hash = (value: string) => createHash("sha256").update(value).digest("hex");
+const chunkKey = (id: string, index: number) => `snapshot:${id}:${index}`;
+
+/** The manifest is the commit point. Failed capture never admits a partially retained snapshot. */
+export async function retainCompactionMemoryJob(params: {
+  store: Store;
+  source: CompactionMemorySource;
+  entries: readonly unknown[];
+  turnTainted: boolean;
+  now?: number;
+}): Promise<CompactionMemoryJob> {
+  const serialized = JSON.stringify(params.entries);
+  if (Buffer.byteLength(serialized) > MAX_SNAPSHOT_BYTES) {
+    throw new Error("Compaction memory snapshot exceeds the retention bound");
+  }
+  const watermark = hash(serialized);
+  const id = hash(
+    JSON.stringify([
+      params.source.agentId,
+      params.source.sessionKey,
+      params.source.sessionId,
+      watermark,
+    ]),
+  );
+  const key = `job:${id}`;
+  const existing = await params.store.lookup(key);
+  if (existing?.kind === "job") {
+    return existing;
+  }
+  const chunks = Math.ceil(serialized.length / CHUNK_CHARS);
+  for (let index = 0; index < chunks; index++) {
+    await params.store.registerIfAbsent(chunkKey(id, index), {
+      kind: "chunk",
+      data: serialized.slice(index * CHUNK_CHARS, (index + 1) * CHUNK_CHARS),
+    });
+  }
+  const job: CompactionMemoryJob = {
+    kind: "job",
+    id,
+    source: params.source,
+    watermark,
+    chunks,
+    createdAt: params.now ?? Date.now(),
+    turnTainted: params.turnTainted,
+    status: "pending",
+    attempts: 0,
+  };
+  await params.store.registerIfAbsent(key, job);
+  const admitted = await params.store.lookup(key);
+  if (admitted?.kind !== "job") {
+    throw new Error("Compaction memory snapshot admission was not durable");
+  }
+  return admitted;
+}
+
+export async function readCompactionMemorySnapshot(
+  store: Store,
+  job: CompactionMemoryJob,
+): Promise<unknown[]> {
+  let serialized = "";
+  for (let index = 0; index < job.chunks; index++) {
+    const chunk = await store.lookup(chunkKey(job.id, index));
+    if (chunk?.kind !== "chunk") {
+      throw new Error("Retained compaction memory snapshot is incomplete");
+    }
+    serialized += chunk.data;
+  }
+  if (hash(serialized) !== job.watermark) {
+    throw new Error("Retained compaction memory snapshot failed integrity verification");
+  }
+  const entries: unknown = JSON.parse(serialized);
+  if (!Array.isArray(entries)) {
+    throw new Error("Retained compaction memory snapshot is not a transcript");
+  }
+  return entries;
+}
+
+/** One host owns the queue. Serial extraction per destination keeps older saves ahead of newer ones. */
+export function createCompactionMemoryJobRunner(params: {
+  store: Store;
+  assertCurrent: () => void;
+  execute: (job: CompactionMemoryJob, entries: unknown[]) => Promise<void>;
+}) {
+  const destinations = new Map<string, Promise<void>>();
+  const active = new Map<string, Promise<void>>();
+  const run = (job: CompactionMemoryJob): Promise<void> => {
+    if (job.status === "succeeded") {
+      return Promise.resolve();
+    }
+    const existing = active.get(job.id);
+    if (existing) {
+      return existing;
+    }
+    const destination = job.source.workspaceDir;
+    const predecessor = destinations.get(destination) ?? Promise.resolve();
+    const attempt = predecessor.then(async () => {
+      params.assertCurrent();
+      const current = await params.store.lookup(`job:${job.id}`);
+      if (current?.kind !== "job") {
+        throw new Error("Compaction memory job disappeared before execution");
+      }
+      if (current.status === "succeeded") {
+        return;
+      }
+      if (current.status !== "pending") {
+        throw new Error(
+          "Compaction memory save requires write reconciliation; automatic replay refused",
+        );
+      }
+      const entries = await readCompactionMemorySnapshot(params.store, current);
+      params.assertCurrent();
+      // Once model/tool execution can have begun, interruption has an uncertain write outcome.
+      // Persist that boundary first. Recovery may retry retained input, never uncertain writes.
+      const running = { ...current, status: "saving" as const, attempts: current.attempts + 1 };
+      await params.store.register(`job:${job.id}`, running);
+      try {
+        await params.execute(running, entries);
+        params.assertCurrent();
+      } catch (error) {
+        await params.store.register(`job:${job.id}`, { ...running, status: "reconcile" });
+        throw error;
+      }
+      // Checkpoint the captured watermark, never the live session's current compaction count.
+      await params.store.register(`job:${job.id}`, { ...running, status: "succeeded" });
+      // A completed manifest suppresses duplicate notifications even after the large input is released.
+      for (let index = 0; index < current.chunks; index++) {
+        await params.store.delete(chunkKey(job.id, index));
+      }
+    });
+    active.set(job.id, attempt);
+    const settled = attempt
+      .catch(() => undefined)
+      .finally(() => {
+        active.delete(job.id);
+        if (destinations.get(destination) === settled) {
+          destinations.delete(destination);
+        }
+      });
+    destinations.set(destination, settled);
+    return attempt;
+  };
+  return {
+    run,
+    async recover(): Promise<void> {
+      params.assertCurrent();
+      const jobs = (await params.store.entries())
+        .map(({ value }) => value)
+        .filter(
+          (value): value is CompactionMemoryJob =>
+            value.kind === "job" && value.status !== "succeeded",
+        )
+        .sort((a, b) => a.createdAt - b.createdAt || a.id.localeCompare(b.id));
+      // Start each queue in captured order. Failures stay retained; another destination can finish.
+      const outcomes = await Promise.allSettled(jobs.map(run));
+      const errors = outcomes.filter((outcome) => outcome.status === "rejected");
+      if (errors.length) {
+        throw new AggregateError(
+          errors.map((outcome) => outcome.reason),
+          "Compaction memory recovery has unfinished jobs",
+        );
+      }
+    },
+  };
+}
