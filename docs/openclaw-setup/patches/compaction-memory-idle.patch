+vi.mock("../sandbox.js", () => ({
+  resolveSandboxRuntimeStatus: () => ({
+    sandboxed: true,
+    workspaceAccess: mocks.writable ? "rw" : "ro",
+  }),
+  resolveSandboxConfigForAgent: () => ({ workspaceAccess: "rw" }),
+}));
+vi.mock("../../plugins/runtime.js", () => ({ getPluginRegistryForContext: () => ({}) }));
+vi.mock("../../plugins/runtime/gateway-request-scope.js", () => ({
+  getPluginRuntimeGatewayRequestScope: () => undefined,
+  withPluginRuntimeGatewayRequestScope: (_scope: unknown, run: () => unknown) => run(),
+}));
+vi.mock("../../infra/agent-events.js", async (original) => ({
+  ...(await original<object>()),
+  getAgentEventLifecycleGeneration: () => mocks.generation,
+  assertAgentRunLifecycleGenerationCurrent: (generation: string) => {
+    if (generation !== mocks.generation) throw new Error("retired");
+  },
+}));
+vi.mock("./run.js", () => ({
+  createSessionMaintenanceFollowup: (params: any) => ({
+    prompt: "",
+    enqueuedAt: 0,
+    run: {
+      ...params.run,
+      ...params.auth,
+      sessionKey: params.sessionKey,
+      runtimePolicySessionKey: params.runtimePolicySessionKey,
+      sessionId: params.sessionEntry.sessionId,
+      model: params.model,
+      provider: params.provider,
+    },
+  }),
+}));
+
+const context = () => ({
+  config: mocks.cfg,
+  agentId: "main",
+  sessionKey: "agent:main:main",
+  sessionId: "source-id",
+  modelProviderId: "synthetic",
+  modelId: "model",
+  contextTokenBudget: 256000,
