+import { describe, expect, it } from "vitest";
+import type { CliSessionBinding, SessionEntry } from "../../config/sessions.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import type { EmbeddedAgentRunResult } from "../embedded-agent-runner/types.js";
+import { matchesNativeIdleBinding, resolveCompletedNativeIdleBinding } from "./native-idle.js";
+
+function fixture() {
+  const binding: CliSessionBinding = {
+    sessionId: "native-session",
+    authEpochVersion: 1,
+    cwdHash: "workspace-hash",
+  };
+  const entry: SessionEntry = {
+    sessionId: "host-session",
+    updatedAt: 1,
+    cliSessionIds: { "claude-cli": binding.sessionId },
+    cliSessionBindings: { "claude-cli": structuredClone(binding) },
+  };
+  const cfg: OpenClawConfig = {
+    agents: {
+      defaults: {
+        compaction: {
+          idle: { afterMinutes: 15, inputThresholdRatio: 0.8, harnesses: ["claude-cli"] },
+        },
+      },
+    },
+  };
+  const meta: EmbeddedAgentRunResult["meta"] = {
+    durationMs: 1,
+    executionTrace: {
+      runner: "cli",
+      winnerProvider: "claude-cli",
+      winnerModel: "native-model",
+      attempts: [],
+      fallbackUsed: false,
+    },
+    agentMeta: {
+      sessionId: "native-session",
+      provider: "anthropic",
+      model: "native-model",
+      cliSessionBinding: structuredClone(binding),
+    },
+  };
+  return { cfg, entry, meta };
+}
+
+describe("completed native idle binding", () => {
+  it("accepts native-login completion without generic harness or profile fields", () => {
+    const input = fixture();
+    const captured = resolveCompletedNativeIdleBinding(input);
+    expect(captured?.backendId).toBe("claude-cli");
+    expect(captured?.binding.authProfileId).toBeUndefined();
+    expect(input.entry.agentHarnessId).toBeUndefined();
+    expect(matchesNativeIdleBinding(input.entry, captured!)).toBe(true);
+    input.entry.cliSessionBindings!["claude-cli"]!.cwdHash = "changed";
+    expect(captured?.binding.cwdHash).toBe("workspace-hash");
+    expect(matchesNativeIdleBinding(input.entry, captured!)).toBe(false);
+  });
+
+  it.each([
+    "aborted",
+    "yielded",
+    "error",
+    "embedded",
+    "missing-completion",
+    "legacy-only",
+    "conflict",
+    "disabled",
+  ])("rejects %s as native completion evidence", (condition) => {
+    const input = fixture();
+    if (condition === "aborted") input.meta.aborted = true;
+    if (condition === "yielded") input.meta.yielded = true;
+    if (condition === "error") input.meta.error = { kind: "incomplete_turn", message: "failed" };
+    if (condition === "embedded") input.meta.executionTrace!.runner = "embedded";
+    if (condition === "missing-completion") delete input.meta.agentMeta!.cliSessionBinding;
+    if (condition === "legacy-only") delete input.entry.cliSessionBindings;
+    if (condition === "conflict") input.entry.agentHarnessId = "other-runtime";
+    if (condition === "disabled") input.cfg.agents!.defaults!.compaction!.idle!.harnesses = [];
+    expect(resolveCompletedNativeIdleBinding(input)).toBeUndefined();
+  });
+
+  it.each(["sessionId", "authProfileId", "authEpoch", "authEpochVersion"] as const)(
+    "rejects mismatched completion %s",
+    (field) => {
+      const input = fixture();
+      const changed = input.entry.cliSessionBindings!["claude-cli"]!;
+      if (field === "authEpochVersion") changed[field] = 2;
+      else changed[field] = "changed";
+      expect(resolveCompletedNativeIdleBinding(input)).toBeUndefined();
+    },
+  );
+
+  it.each([
+    "sessionId",
+    "authProfileId",
+    "authEpoch",
+    "resumeCheckpointId",
+    "mcpResumeHash",
+    "forkNextResume",
+  ] as const)("invalidates the quiet period after %s changes", (field) => {
+    const input = fixture();
+    const captured = resolveCompletedNativeIdleBinding(input)!;
+    const changed = input.entry.cliSessionBindings!["claude-cli"]!;
+    if (field === "forkNextResume") changed[field] = true;
+    else changed[field] = "changed";
+    expect(matchesNativeIdleBinding(input.entry, captured)).toBe(false);
+  });
+});
diff --git a/src/agents/session-maintenance/native-idle.ts b/src/agents/session-maintenance/native-idle.ts
