+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { expect, it } from "vitest";
+import {
+  projectClaudeCompactionSnapshot,
+  readClaudeCompactionSnapshot,
+} from "./cli-compaction-snapshot.js";
+
+const rows = [
+  {
+    uuid: "u1",
+    parentUuid: null,
+    type: "user",
+    message: { role: "user", content: "Look up the preference" },
+  },
+  {
+    uuid: "a1",
+    parentUuid: "u1",
+    type: "assistant",
+    message: {
+      role: "assistant",
+      content: [
+        { type: "tool_use", id: "t1", name: "Read", input: { file_path: "preferences" } },
+        { type: "thinking", thinking: "private reasoning" },
+      ],
+    },
+  },
+  {
+    uuid: "t1",
+    parentUuid: "a1",
+    type: "user",
+    message: {
+      role: "user",
+      content: [
+        {
+          type: "tool_result",
+          tool_use_id: "t1",
+          content: "The preferred pickup code is synthetic-blue-42.",
+        },
+      ],
+    },
+  },
+  {
+    uuid: "a2",
+    parentUuid: "t1",
+    type: "assistant",
+    message: { role: "assistant", content: "Done." },
+  },
+  {
+    uuid: "branch",
+    parentUuid: "u1",
+    isSidechain: true,
+    type: "assistant",
+    message: { content: "foreign branch" },
+  },
+];
+const jsonl = (values = rows) =>
+  values.map((row) => JSON.stringify({ ...row, sessionId: "native-1" })).join("\n") + "\n";
+it("retains tool-only facts in the native parent chain before compaction", () => {
+  const entries = projectClaudeCompactionSnapshot(jsonl(), "native-1");
+  expect(entries).toHaveLength(4);
+  expect(JSON.stringify(entries)).toContain("synthetic-blue-42");
+  expect(JSON.stringify(entries)).not.toContain("private reasoning");
+  expect(JSON.stringify(entries)).not.toContain("foreign branch");
+});
+it("refuses another owner, incomplete records and missing ancestry", () => {
+  expect(() => projectClaudeCompactionSnapshot(jsonl(), "other")).toThrow("another session");
+  expect(() => projectClaudeCompactionSnapshot(jsonl().trimEnd(), "native-1")).toThrow(
+    "incomplete",
+  );
+  expect(() => projectClaudeCompactionSnapshot(jsonl(rows.slice(1)), "native-1")).toThrow(
+    "missing parent",
+  );
+});
+it("reads only the admitted native session inside its profile and checks cancellation", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "claude-snapshot-"));
+  try {
+    const project = path.join(root, "projects", "synthetic");
+    await fs.mkdir(project, { recursive: true });
+    const transcript = path.join(project, "native-1.jsonl");
+    await fs.writeFile(transcript, jsonl());
+    const context = { sessionId: "native-1", env: { CLAUDE_CONFIG_DIR: root } };
+    const input = { session_id: "native-1", transcript_path: transcript };
+    expect(JSON.stringify(await readClaudeCompactionSnapshot(context, input))).toContain(
+      "synthetic-blue-42",
+    );
+    await expect(
+      readClaudeCompactionSnapshot(context, { ...input, session_id: "other" }),
+    ).rejects.toThrow("different session");
+    await expect(
+      readClaudeCompactionSnapshot({ ...context, abortSignal: AbortSignal.abort() }, input),
+    ).rejects.toThrow();
+    const outside = path.join(root, "native-1.jsonl");
+    await fs.writeFile(outside, jsonl());
+    await expect(
+      readClaudeCompactionSnapshot(context, { ...input, transcript_path: outside }),
+    ).rejects.toThrow("escaped");
+  } finally {
+    await fs.rm(root, { recursive: true, force: true });
+  }
+});
+
+it("ignores large obsolete history and selects the active chain after a native compact boundary", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "claude-snapshot-growth-"));
+  try {
+    const project = path.join(root, "projects", "synthetic");
+    await fs.mkdir(project, { recursive: true });
+    const transcript = path.join(project, "native-1.jsonl");
+    const obsolete =
+      JSON.stringify({
+        uuid: "old",
+        parentUuid: null,
+        type: "user",
+        message: { content: "old".repeat(1024) },
+      }) + "\n";
+    await fs.writeFile(transcript, obsolete.repeat(12000));
+    const boundary = {
+      uuid: "boundary",
+      parentUuid: null,
+      type: "system",
+      subtype: "compact_boundary",
+    };
+    const active = [boundary, { ...rows[0], parentUuid: "boundary" }, ...rows.slice(1)];
+    await fs.appendFile(transcript, jsonl(active as typeof rows));
+    expect((await fs.stat(transcript)).size).toBeGreaterThan(32 * 1024 * 1024);
+    const entries = await readClaudeCompactionSnapshot(
+      { sessionId: "native-1", env: { CLAUDE_CONFIG_DIR: root } },
+      { session_id: "native-1", transcript_path: transcript },
+    );
+    expect(entries).toHaveLength(4);
+    expect(JSON.stringify(entries)).toContain("synthetic-blue-42");
+    expect(JSON.stringify(entries)).not.toContain("native:old");
+  } finally {
+    await fs.rm(root, { recursive: true, force: true });
+  }
+});
diff --git a/extensions/anthropic/cli-compaction-snapshot.ts b/extensions/anthropic/cli-compaction-snapshot.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c420db9d2949d7723be471588e753474b6e9b235
--- /dev/null
+++ b/extensions/anthropic/cli-compaction-snapshot.ts
@@ -0,0 +1,215 @@
+import { constants } from "node:fs";
+import fs, { type FileHandle } from "node:fs/promises";
+import path from "node:path";
+import type { CliBackendExecuteContext } from "openclaw/plugin-sdk/cli-backend";
+import { isRecord } from "openclaw/plugin-sdk/string-coerce-runtime";
+
+const MAX_SNAPSHOT_BYTES = 32 * 1024 * 1024;
+
+/** Read only the native session named by the admitted PreCompact callback. */
+export async function readClaudeCompactionSnapshot(
+  context: Pick<CliBackendExecuteContext, "sessionId" | "env" | "assertCurrent" | "abortSignal">,
+  input: Record<string, unknown>,
+): Promise<unknown[]> {
+  const check = () => {
+    context.assertCurrent?.();
+    context.abortSignal?.throwIfAborted();
+  };
+  check();
+  const sessionId = context.sessionId;
+  if (
+    !sessionId ||
+    !/^[a-zA-Z0-9-]+$/.test(sessionId) ||
+    input.session_id !== sessionId ||
+    typeof input.transcript_path !== "string"
+  ) {
+    throw new Error("Native compaction snapshot has a different session owner");
+  }
+  const configDir =
+    context.env.CLAUDE_CONFIG_DIR || (context.env.HOME && path.join(context.env.HOME, ".claude"));
+  if (!configDir || !path.isAbsolute(configDir))
+    throw new Error("Native compaction profile is unavailable");
+  const root = await fs.realpath(path.join(configDir, "projects"));
+  const target = await fs.realpath(input.transcript_path);
+  const relative = path.relative(root, target);
+  if (
+    !relative ||
+    relative === ".." ||
+    relative.startsWith(`..${path.sep}`) ||
+    path.isAbsolute(relative) ||
+    path.basename(target) !== `${sessionId}.jsonl`
+  ) {
+    throw new Error("Native compaction transcript escaped its admitted profile");
+  }
+  const handle = await fs.open(target, constants.O_RDONLY | constants.O_NOFOLLOW);
+  try {
+    const stat = await handle.stat();
+    if (!stat.isFile()) throw new Error("Native compaction transcript is not a file");
+    // Native transcripts retain obsolete compacted branches. Read backwards and stop
+    // at the active chain's root instead of bounding or loading lifetime history.
+    const selected: string[] = [];
+    const seen = new Set<string>();
+    let parent: string | undefined;
+    let selectedBytes = 0;
+    let complete = false;
+    for await (const line of reverseTranscriptLines(handle, stat.size, check)) {
+      if (!line.trim()) continue;
+      const row: unknown = JSON.parse(line);
+      if (!isRecord(row) || row.isSidechain === true || typeof row.uuid !== "string") continue;
+      if (
+        parent
+          ? row.uuid !== parent
+          : !isRecord(row.message) || (row.type !== "user" && row.type !== "assistant")
+      )
+        continue;
+      if (row.sessionId !== undefined && row.sessionId !== sessionId)
+        throw new Error("Native transcript contains another session owner");
+      if (seen.has(row.uuid)) throw new Error("Native compaction history is cyclic");
+      seen.add(row.uuid);
+      selectedBytes += Buffer.byteLength(line) + 1;
+      if (selectedBytes > MAX_SNAPSHOT_BYTES)
+        throw new Error("Native compaction active history exceeds the retained snapshot bound");
+      selected.push(line);
+      parent = typeof row.parentUuid === "string" ? row.parentUuid : undefined;
+      if (parent && seen.has(parent)) throw new Error("Native compaction history is cyclic");
+      if (!parent) {
+        complete = true;
+        break;
+      }
+    }
+    if (selected.length && !complete)
+      throw new Error("Native compaction history has a missing parent");
+    const current = await fs.stat(target);
+    if (current.ino !== stat.ino || current.dev !== stat.dev || current.size < stat.size)
+      throw new Error("Native compaction transcript was replaced during capture");
+    check();
+    return projectClaudeCompactionSnapshot(selected.toReversed().join("\n") + "\n", sessionId);
+  } finally {
+    await handle.close();
+  }
+}
+
+/** Bound memory per record while scanning backwards, with cancellation between reads. */
+async function* reverseTranscriptLines(handle: FileHandle, size: number, check: () => void) {
+  const chunkSize = 256 * 1024;
+  let end = size;
+  let pending = Buffer.alloc(0);
+  let first = true;
+  while (end > 0) {
+    check();
+    const start = Math.max(0, end - chunkSize);
+    const chunk = Buffer.alloc(end - start);
+    let offset = 0;
+    while (offset < chunk.length) {
+      check();
+      const read = await handle.read(chunk, offset, chunk.length - offset, start + offset);
+      if (!read.bytesRead) throw new Error("Native compaction transcript changed during capture");
+      offset += read.bytesRead;
+    }
+    let data = Buffer.concat([chunk, pending]);
+    if (first) {
+      first = false;
+      if (data.at(-1) !== 10)
+        throw new Error("Native compaction transcript has an incomplete record");
+      data = data.subarray(0, -1);
+    }
+    let lineEnd = data.length;
+    for (let i = data.length - 1; i >= 0; i--) {
+      if (data[i] !== 10) continue;
+      check();
+      if (lineEnd - i - 1 > MAX_SNAPSHOT_BYTES)
+        throw new Error("Native compaction transcript record exceeds the snapshot bound");
+      yield data.subarray(i + 1, lineEnd).toString("utf8");
+      lineEnd = i;
+    }
+    pending = Buffer.from(data.subarray(0, lineEnd));
+    if (pending.length > MAX_SNAPSHOT_BYTES)
+      throw new Error("Native compaction transcript record exceeds the snapshot bound");
+    end = start;
+  }
+  if (pending.length) {
+    check();
+    yield pending.toString("utf8");
+  }
+}
+
+/** Select the current parent chain, including tool-only facts; omit reasoning and other branches. */
+export function projectClaudeCompactionSnapshot(jsonl: string, sessionId: string): unknown[] {
+  if (jsonl && !jsonl.endsWith("\n"))
+    throw new Error("Native compaction transcript has an incomplete record");
+  const rows = new Map<string, Record<string, unknown>>();
+  let leaf: string | undefined;
+  for (const line of jsonl.split("\n")) {
+    if (!line.trim()) continue;
+    const row: unknown = JSON.parse(line);
+    if (!isRecord(row) || row.isSidechain === true || typeof row.uuid !== "string") continue;
+    if (row.sessionId !== undefined && row.sessionId !== sessionId)
+      throw new Error("Native transcript contains another session owner");
+    rows.set(row.uuid, row);
+    if ((row.type === "user" || row.type === "assistant") && isRecord(row.message)) leaf = row.uuid;
+  }
+  const chain: Record<string, unknown>[] = [];
+  const seen = new Set<string>();
+  while (leaf) {
+    if (seen.has(leaf)) throw new Error("Native compaction history is cyclic");
+    seen.add(leaf);
+    const row = rows.get(leaf);
+    if (!row) throw new Error("Native compaction history has a missing parent");
+    chain.push(row);
+    leaf = typeof row.parentUuid === "string" ? row.parentUuid : undefined;
+  }
+  const entries: unknown[] = [];
+  let parentId: string | null = null;
+  for (const row of chain.toReversed()) {
+    if (!isRecord(row.message) || row.isMeta === true) continue;
+    const content =
+      typeof row.message.content === "string"
+        ? row.message.content
+        : Array.isArray(row.message.content)
+          ? row.message.content.flatMap((block): unknown[] => {
+              if (!isRecord(block)) return [];
+              if (block.type === "text" && typeof block.text === "string")
+                return [{ type: "text", text: block.text }];
+              if (block.type === "tool_use")
+                return [{ type: "tool_use", id: block.id, name: block.name, input: block.input }];
+              if (block.type === "tool_result")
+                return [
+                  {
+                    type: "tool_result",
+                    tool_use_id: block.tool_use_id,
+                    is_error: block.is_error,
+                    content:
+                      typeof block.content === "string"
+                        ? block.content
+                        : Array.isArray(block.content)
+                          ? block.content.flatMap((part) =>
+                              isRecord(part) &&
+                              part.type === "text" &&
+                              typeof part.text === "string"
+                                ? [{ type: "text", text: part.text }]
+                                : [],
+                            )
+                          : [],
+                  },
+                ];
+              return [];
+            })
+          : [];
+    // Native tool blocks remain quoted history. They cannot become executable saver calls.
+    const id = `native:${String(row.uuid)}`;
+    entries.push({
+      type: "message",
+      id,
+      parentId,
+      timestamp: typeof row.timestamp === "string" ? row.timestamp : new Date(0).toISOString(),
+      message: {
+        role: "user",
+        content: JSON.stringify({ role: row.message.role, content }),
+        timestamp: 0,
+      },
+    });
+    parentId = id;
+  }
+  if (!entries.length) throw new Error("Native compaction history is empty");
+  return entries;
+}
