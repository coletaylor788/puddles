+  it("rejects capture failure before dispatching any saver", async () => {
+    await withOpenClawTestState({ label: "compaction-memory-capture-failed" }, async () => {
+      mocks.capture.mockRejectedValue(new Error("projection failed"));
+      await expect(captureCompactionMemory(context())).rejects.toThrow("projection failed");
+      expect(mocks.save).not.toHaveBeenCalled();
+      expect(await jobs().entries()).toEqual([]);
+    });
+  });
+
+  it("excludes disabled, incognito, read-only, heartbeat and internal saves", async () => {
+    await withOpenClawTestState({ label: "compaction-memory-excluded" }, async () => {
+      for (const trigger of ["heartbeat", "memory"] as const)
+        await captureCompactionMemory({ ...context(), trigger });
+      mocks.entry.incognito = true;
+      await captureCompactionMemory(context());
+      delete mocks.entry.incognito;
+      mocks.writable = false;
+      await captureCompactionMemory(context());
+      mocks.writable = true;
+      mocks.cfg.agents.defaults.compaction.memoryFlush.enabled = false;
+      await captureCompactionMemory(context());
+      expect(mocks.capture).not.toHaveBeenCalled();
+      expect(mocks.save).not.toHaveBeenCalled();
+    });
+  });
+});
