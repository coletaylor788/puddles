+
+const log = createSubsystemLogger("agents/compaction-memory");
+const state = resolveGlobalSingleton(Symbol.for("openclaw.compactionMemoryRunner"), () => ({
+  generation: "",
+  runner: undefined as ReturnType<typeof createCompactionMemoryJobRunner> | undefined,
+}));
+const store = () =>
+  createCorePluginStateKeyedStore<CompactionMemoryRecord>({
+    ownerId: "core:compaction-memory",
+    namespace: "snapshots",
+    retention: "retained",
+  });
+
+async function writable(
+  cfg: OpenClawConfig,
+  agentId: string,
+  sessionKey: string,
+): Promise<boolean> {
+  const runtime = await resolveSandboxRuntimeStatusAsync({ cfg, agentId, sessionKey });
+  const access =
+    runtime.workspaceAccess ??
+    resolveSandboxConfigForAgent(cfg, runtime.classificationAgentId).workspaceAccess;
+  return !runtime.sandboxed || access === "rw";
+}
+
+function resolveRunner(cfg: OpenClawConfig) {
+  const pluginRegistry = getPluginRegistryForContext();
+  if (!pluginRegistry) {
+    return undefined;
+  }
+  const generation = getAgentEventLifecycleGeneration();
+  if (state.generation === generation && state.runner) {
+    return state.runner;
+  }
+  const resolveGatewayContext = fenceScheduledGatewayContextResolver(
+    getPluginRuntimeGatewayRequestScope()?.resolveGatewayContext,
+  );
+  const assertCurrent = () => {
+    assertAgentRunLifecycleGenerationCurrent(generation);
+    if (resolveGatewayContext && !resolveGatewayContext()) {
+      throw new Error("Compaction memory owner retired");
+    }
+  };
+  const execute = async (job: CompactionMemoryJob, entries: unknown[]) => {
+    const currentCfg = getRuntimeConfig() ?? cfg;
+    const configPublication = getRuntimeConfigSnapshotMetadata();
+    const source = job.source;
+    const budget = createCommandBudget(
+      Date.now(),
+      (currentCfg.agents?.defaults?.timeoutSeconds ?? 600) * 1000,
+    );
+    const owner = createSessionMaintenanceOwner({
+      sessionKey: `compaction-memory:${job.id}`,
+      abortSignal: budget.signal,
+    });
+    try {
+      await owner.track(
+        owner.run(() =>
+          withPluginRuntimeGatewayRequestScope(
+            { pluginRegistry, resolveGatewayContext, isWebchatConnect: () => false },
+            () =>
+              runWithGatewayDetachedWorkAdmission(
+                async () => {
+                  assertCurrent();
+                  if (
+                    source.lifecycleRevision === undefined ||
+                    !Number.isInteger(source.compactionCount) ||
+                    !source.settings
+                  ) {
+                    throw new Error(
+                      "Retained snapshot lacks source incarnation facts; reconciliation required",
+                    );
+                  }
+                  const sourceLease = await prepareSessionGenerationFacts({
+                    agentId: source.agentId,
+                    sessionKey: source.sessionKey,
+                    storePath: source.storePath,
+                    sessionId: source.sessionId,
+                    lifecycleRevision: source.lifecycleRevision,
+                  });
+                  try {
+                    const settings = narrowSessionEventSettings(
+                      source.settings,
+                      sourceLease.readSessionSettings(),
+                    );
+                    const assertJobCurrent = () => {
+                      assertCurrent();
+                      sourceLease.assertCurrent();
+                      assertSessionEventSettingsCurrent(
+                        settings,
+                        sourceLease.readSessionSettings(),
+                      );
+                      // Reuse the native delayed-work publication fence at every effect.
+                      // A constructed tool must not finish under superseded configuration.
+                      if (
+                        (getRuntimeConfig() ?? cfg) !== currentCfg ||
+                        getRuntimeConfigSnapshotMetadata() !== configPublication
+                      ) {
+                        throw new Error(
+                          "Compaction memory configuration changed; reconciliation required",
+                        );
+                      }
+                    };
+                    assertJobCurrent();
+                    if (
+                      !currentCfg.agents?.defaults?.compaction?.memoryFlush?.compactionHooks?.includes(
+                        source.harnessId,
+                      ) ||
+                      currentCfg.agents?.defaults?.compaction?.memoryFlush?.enabled === false ||
+                      !(await writable(
+                        currentCfg,
+                        source.agentId,
+                        source.policy?.runtimePolicySessionKey ?? source.sessionKey,
+                      )) ||
+                      path.resolve(resolveAgentWorkspaceDir(currentCfg, source.agentId)) !==
+                        path.resolve(source.workspaceDir)
+                    ) {
+                      throw new Error(
+                        "Compaction memory save is no longer permitted by current configuration",
+                      );
+                    }
+                    const live = await readSessionEntryReadOnlyInWorker({
+                      agentId: source.agentId,
+                      sessionKey: source.sessionKey,
+                      storePath: source.storePath,
+                      readConsistency: "latest",
+                    });
+                    assertJobCurrent();
+                    if (
+                      !live ||
+                      live.incognito ||
+                      live.sessionId !== source.sessionId ||
+                      (live.lifecycleRevision ?? null) !== source.lifecycleRevision
+                    ) {
+                      throw new Error("Compaction memory source no longer permits saving");
+                    }
+                    const entry: SessionEntry = {
+                      ...live,
+                      ...settings,
+                      compactionCount: source.compactionCount,
+                      sessionId: source.sessionId,
+                      updatedAt: job.createdAt,
+                      agentHarnessId: source.harnessId,
+                      modelSelectionLocked: true,
+                      modelProvider: source.provider,
+                      model: source.model,
+                    };
+                    const followupRun = createSessionMaintenanceFollowup({
+                      cfg: currentCfg,
+                      sessionKey: source.sessionKey,
+                      runtimePolicySessionKey:
+                        source.policy?.runtimePolicySessionKey ?? source.sessionKey,
+                      sessionEntry: entry,
+                      provider: source.provider,
+                      model: source.model,
+                      auth: {
+                        authProfileId: source.authProfileId,
+                        authProfileIdSource: source.authProfileIdSource,
+                      },
+                      run: {
+                        ...source.policy,
+                        agentId: source.agentId,
+                        agentDir: resolveAgentDir(currentCfg, source.agentId),
+                        workspaceDir: source.workspaceDir,
+                        timeoutMs: budget.remainingMs(),
+                      },
+                    });
+                    for (const [partIndex, input] of buildCompactionMemoryInputs({
+                      entries,
+                      contextTokens: source.contextTokens,
+                      capturedAt: job.createdAt,
+                      id: job.id,
+                    }).entries()) {
+                      assertJobCurrent();
+                      owner.signal.throwIfAborted();
+                      followupRun.run.timeoutMs = budget.remainingMs();
+                      const result = await runCompactionMemorySnapshot(
+                        {
+                          cfg: currentCfg,
+                          followupRun,
+                          defaultModel: source.model,
+                          resolvedVerboseLevel: "off",
+                          sessionEntry: entry,
+                          sessionKey: source.sessionKey,
+                          runtimePolicySessionKey:
+                            source.policy?.runtimePolicySessionKey ?? source.sessionKey,
+                          storePath: source.storePath,
+                          isHeartbeat: false,
+                          abortSignal: owner.signal,
+                        },
+                        {
+                          entries: input,
+                          sessionSettings: settings,
+                          partId: `${job.id}-${partIndex}`,
+                          turnTainted: job.turnTainted,
+                          contextTokens: source.contextTokens,
+                          capturedAt: job.createdAt,
+                          assertCurrent: assertJobCurrent,
+                        },
+                      );
+                      assertJobCurrent();
+                      if (result.outcome !== "completed") {
+                        throw new Error(`Compaction memory save ${result.outcome}`);
+                      }
+                    }
+                  } finally {
+                    sourceLease.release();
+                  }
+                },
+                "compaction-memory",
+                owner.signal,
+              ),
+          ),
+        ),
+      );
+    } finally {
+      budget.dispose();
+    }
+  };
+  state.generation = generation;
+  state.runner = createCompactionMemoryJobRunner({ store: store(), assertCurrent, execute });
+  return state.runner;
+}
+
+// Durable plugin state rejects undefined values, including optional object fields.
+// Keep every supplied policy constraint while omitting only absent fields.
+function definedFields<T extends object>(value: T): T {
+  return Object.fromEntries(Object.entries(value).filter(([, field]) => field !== undefined)) as T;
+}
+
+/** Await retention only. Its separate root owns inference after the hook returns. */
+export async function captureCompactionMemory(ctx: AgentHarnessHookContext): Promise<void> {
+  const cfg = ctx.config ?? getRuntimeConfig();
+  const sessionKey = ctx.sessionKey;
+  const agentId = ctx.agentId;
+  if (
+    !cfg ||
+    !agentId ||
+    !sessionKey ||
+    ctx.trigger === "heartbeat" ||
+    ctx.trigger === "memory" ||
+    isInternalSessionEffectsKey(sessionKey) ||
+    isIncognitoSessionKey(sessionKey) ||
+    cfg.agents?.defaults?.compaction?.memoryFlush?.enabled === false
+  ) {
+    return;
+  }
+  const enabled = cfg.agents?.defaults?.compaction?.memoryFlush?.compactionHooks;
+  if (!enabled?.length) {
+    return;
+  }
+  const storePath = resolveSessionStorePathForScope({ agentId, sessionKey }, cfg);
+  const entry = await readSessionEntryReadOnlyInWorker({
+    agentId,
+    sessionKey,
+    storePath,
+    readConsistency: "latest",
+  });
+  const harnessId = ctx.memorySaveHarnessId ?? entry?.agentHarnessId;
+  if (!entry || entry.incognito || !harnessId || !enabled.includes(harnessId)) {
+    return;
+  }
+  if (ctx.sessionId && ctx.sessionId !== entry.sessionId) {
+    throw new Error("Compaction snapshot source generation changed before capture");
+  }
+  if (
+    !(await writable(cfg, agentId, ctx.memorySavePolicy?.runtimePolicySessionKey ?? sessionKey))
+  ) {
+    return;
+  }
+  const provider = ctx.modelProviderId ?? entry.modelProvider;
+  const model = ctx.modelId ?? entry.model;
+  const contextTokens = ctx.contextTokenBudget ?? entry.contextTokens;
+  if (!provider || !model || !contextTokens) {
+    throw new Error("Compaction snapshot lacks admitted model context");
+  }
+  // Claude's host transcript omits native tool results. Its admitted PreCompact callback
+  // supplies native history for automatic, manual and idle compaction through this same path.
+  if (harnessId === "claude-cli" && !ctx.memorySaveEntries) return;
+  const captureLease = await prepareSessionGenerationFacts({
+    agentId,
+    sessionKey,
+    storePath,
+    sessionId: entry.sessionId,
+    lifecycleRevision: entry.lifecycleRevision ?? null,
+  });
+  try {
+    captureLease.assertCurrent();
+    const settings = narrowSessionEventSettings(entry, captureLease.readSessionSettings());
+    const workspaceDir = resolveAgentWorkspaceDir(cfg, agentId);
+    const entries =
+      ctx.memorySaveEntries ??
+      (
+        await prepareMemoryFlushSession({
+          source: { agentId, sessionKey, sessionId: entry.sessionId, storePath },
+          runId: crypto.randomUUID(),
+          workspaceDir,
+        })
+      ).sessionManager.getEntries();
+    captureLease.assertCurrent();
+    assertSessionEventSettingsCurrent(settings, captureLease.readSessionSettings());
+    const job = await retainCompactionMemoryJob({
+      store: store(),
+      source: {
+        agentId,
+        sessionKey,
+        sessionId: entry.sessionId,
+        lifecycleRevision: entry.lifecycleRevision ?? null,
+        compactionCount: entry.compactionCount ?? 0,
+        settings: definedFields(settings),
+        storePath,
+        workspaceDir,
+        harnessId,
+        provider,
+        model,
+        contextTokens,
+        ...(ctx.memorySavePolicy
+          ? {
+              policy: {
+                ...definedFields(ctx.memorySavePolicy),
+                ...(ctx.memorySavePolicy.conversationToolPolicy
+                  ? {
+                      conversationToolPolicy: definedFields(
+                        ctx.memorySavePolicy.conversationToolPolicy,
+                      ),
+                    }
+                  : {}),
+              },
+            }
+          : {}),
+        ...((ctx.memorySaveAuth?.authProfileId ?? entry.authProfileOverride)
+          ? { authProfileId: ctx.memorySaveAuth?.authProfileId ?? entry.authProfileOverride }
+          : {}),
+        ...(entry.authProfileOverrideSource === "auto" || entry.authProfileOverrideSource === "user"
+          ? {
+              authProfileIdSource:
+                ctx.memorySaveAuth?.authProfileIdSource ?? entry.authProfileOverrideSource,
+            }
+          : {}),
+      },
+      entries: [...entries],
+      turnTainted: true,
+    });
+    const runner = resolveRunner(cfg);
+    if (runner) {
+      void runner
+        .run(job)
+        .catch((error) =>
+          log.warn(`Retained compaction memory save is unfinished: ${String(error)}`),
+        );
+    }
+  } finally {
+    captureLease.release();
+  }
+}
+
+/** Called after Gateway startup admission; pending snapshots survive process replacement. */
+export function resumeCompactionMemoryJobs(cfg: OpenClawConfig): void {
+  if (!cfg.agents?.defaults?.compaction?.memoryFlush?.compactionHooks?.length) {
+    return;
+  }
+  const runner = resolveRunner(cfg);
+  if (runner) {
+    void runner
+      .recover()
+      .catch((error) => log.warn(`Compaction memory recovery is unfinished: ${String(error)}`));
+  }
+}
