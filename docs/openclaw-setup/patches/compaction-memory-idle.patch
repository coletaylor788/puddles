+import { describe, expect, it, vi } from "vitest";
+import { createPluginStateKeyedStore } from "../../plugin-state/plugin-state-store.js";
+import { withOpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+import {
+  createCompactionMemoryJobRunner,
+  readCompactionMemorySnapshot,
+  retainCompactionMemoryJob,
+  type CompactionMemoryRecord,
+  type CompactionMemorySource,
+} from "./compaction-memory-jobs.js";
+
+const source: CompactionMemorySource = {
+  agentId: "main",
+  sessionKey: "agent:main:main",
+  sessionId: "source-generation",
+  storePath: "/tmp/test-store",
+  workspaceDir: "/tmp/test-workspace",
+  harnessId: "test-harness",
+  provider: "synthetic",
+  model: "test-model",
+  contextTokens: 256000,
+};
+const open = () =>
+  createPluginStateKeyedStore<CompactionMemoryRecord>("active-memory", {
+    namespace: "compaction-snapshot-jobs",
+    retention: "retained",
+  });
+
+describe("compaction memory snapshot jobs", () => {
+  it("retains multi-chunk Unicode input and reuses the exact same history across notifications", async () => {
+    await withOpenClawTestState({ label: "memory-job-retain" }, async () => {
+      const store = open();
+      const entries = [{ text: "🦆".repeat(90000) }];
+      const first = await retainCompactionMemoryJob({ store, source, entries, turnTainted: true });
+      entries.push({ text: "new live history" });
+      const retained = await readCompactionMemorySnapshot(open(), first);
+      expect(retained).toHaveLength(1);
+      expect(first.chunks).toBeGreaterThan(1);
+      const duplicate = await retainCompactionMemoryJob({
+        store,
+        source,
+        entries: retained,
+        turnTainted: true,
+      });
+      expect(duplicate.id).toBe(first.id);
+      const nextGeneration = await retainCompactionMemoryJob({
+        store,
+        source: { ...source, sessionId: "replacement" },
+        entries: retained,
+        turnTainted: true,
+      });
+      expect(nextGeneration.id).not.toBe(first.id);
+    });
+  });
+
+  it("does not admit a job when snapshot persistence fails", async () => {
+    await withOpenClawTestState({ label: "memory-job-capture-failure" }, async () => {
+      const store = open();
+      const broken = {
+        ...store,
+        registerIfAbsent: vi.fn().mockRejectedValue(new Error("disk failure")),
+      };
+      await expect(
+        retainCompactionMemoryJob({
+          store: broken,
+          source,
+          entries: [{ text: "fact" }],
+          turnTainted: false,
+        }),
+      ).rejects.toThrow("disk failure");
+      expect((await store.entries()).filter(({ value }) => value.kind === "job")).toHaveLength(0);
+    });
+  });
+
+  it("joins duplicate execution, orders a destination, and allows another destination to proceed", async () => {
+    await withOpenClawTestState({ label: "memory-job-independent" }, async () => {
+      const store = open();
+      const jobs = await Promise.all(
+        [1, 2, 3].map((n) =>
+          retainCompactionMemoryJob({
+            store,
+            source: n === 3 ? { ...source, workspaceDir: "/tmp/other" } : source,
+            entries: [{ n }],
+            turnTainted: false,
+            now: n,
+          }),
+        ),
+      );
+      let release!: () => void;
+      const blocked = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      const order: number[] = [];
+      const runner = createCompactionMemoryJobRunner({
+        store,
+        assertCurrent() {},
+        execute: async (_job, entries) => {
+          const n = (entries[0] as { n: number }).n;
+          order.push(n);
+          if (n === 1) {
+            await blocked;
+          }
+        },
+      });
+      const first = runner.run(jobs[0]);
+      expect(runner.run(jobs[0])).toBe(first);
+      const second = runner.run(jobs[1]);
+      await runner.run(jobs[2]);
+      expect(order).toEqual([1, 3]);
+      release();
+      await Promise.all([first, second]);
+      expect(order).toEqual([1, 3, 2]);
+      expect((await store.lookup(`job:${jobs[0].id}`))?.kind).toBe("job");
+      const execute = vi.fn();
+      await createCompactionMemoryJobRunner({
+        store: open(),
+        assertCurrent() {},
+        execute,
+      }).recover();
+      expect(execute).not.toHaveBeenCalled();
+    });
+  });
+
+  it("recovers admitted input but never replays an interrupted possible write", async () => {
+    await withOpenClawTestState({ label: "memory-job-restart" }, async () => {
+      const store = open();
+      const job = await retainCompactionMemoryJob({
+        store,
+        source,
+        entries: [{ text: "fact" }],
+        turnTainted: true,
+      });
+      const execute = vi.fn().mockRejectedValue(new Error("lost acknowledgement after write"));
+      await expect(
+        createCompactionMemoryJobRunner({ store: open(), assertCurrent() {}, execute }).recover(),
+      ).rejects.toThrow("unfinished jobs");
+      expect(execute).toHaveBeenCalledTimes(1);
+      expect(await store.lookup(`job:${job.id}`)).toMatchObject({
+        status: "reconcile",
+        attempts: 1,
+      });
+      const restarted = vi.fn();
+      await expect(
+        createCompactionMemoryJobRunner({
+          store: open(),
+          assertCurrent() {},
+          execute: restarted,
+        }).recover(),
+      ).rejects.toThrow("unfinished jobs");
+      expect(restarted).not.toHaveBeenCalled();
+      expect(await readCompactionMemorySnapshot(store, job)).toEqual([{ text: "fact" }]);
+    });
+  });
+
+  it("holds a crash between execution admission and its acknowledgement", async () => {
+    await withOpenClawTestState({ label: "memory-job-uncertain" }, async () => {
+      const store = open();
+      const job = await retainCompactionMemoryJob({
+        store,
+        source,
+        entries: [{ text: "fact" }],
+        turnTainted: true,
+      });
+      await store.register(`job:${job.id}`, { ...job, status: "saving", attempts: 1 });
+      const execute = vi.fn();
+      await expect(
+        createCompactionMemoryJobRunner({ store: open(), assertCurrent() {}, execute }).recover(),
+      ).rejects.toThrow("unfinished jobs");
+      expect(execute).not.toHaveBeenCalled();
+    });
+  });
+
+  it("refuses incomplete or corrupted snapshots without invoking memory inference", async () => {
+    await withOpenClawTestState({ label: "memory-job-integrity" }, async () => {
+      const store = open();
+      const job = await retainCompactionMemoryJob({
+        store,
+        source,
+        entries: [{ text: "fact" }],
+        turnTainted: true,
+      });
+      await store.register(`snapshot:${job.id}:0`, { kind: "chunk", data: "[]" });
+      const execute = vi.fn();
+      const runner = createCompactionMemoryJobRunner({ store, assertCurrent() {}, execute });
+      await expect(runner.run(job)).rejects.toThrow("integrity verification");
+      expect(execute).not.toHaveBeenCalled();
+      await store.delete(`snapshot:${job.id}:0`);
+      await expect(readCompactionMemorySnapshot(store, job)).rejects.toThrow("incomplete");
+    });
+  });
+});
