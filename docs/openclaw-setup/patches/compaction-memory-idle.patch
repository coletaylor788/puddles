+  );
+
+  it("keeps memory inference usable after the triggering async owner closes", async () => {
+    await withOpenClawTestState({ label: "compaction-memory-owner" }, async () => {
+      const foreground = new AsyncWorkScope();
+      const started = createDeferred();
+      const finish = createDeferred();
+      const saved = createDeferred();
