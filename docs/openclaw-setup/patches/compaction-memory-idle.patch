+import { beforeEach, expect, it, vi } from "vitest";
+import type { SessionEntry } from "../../config/sessions/types.js";
+import type { AccountedAgentTurn } from "./agent-runner-result-accounting.js";
+import type { FinalizeReplyAgentRunInput } from "./agent-runner-result.types.js";
+import { scheduleReplySessionMaintenance } from "./agent-runner-maintenance.js";
+
+const scheduled = vi.hoisted(() => vi.fn());
+vi.mock("../../agents/session-maintenance/run.js", () => ({
+  scheduleSessionMaintenance: scheduled,
+  createSessionMaintenanceFollowup: ({ run, auth }: { run: object; auth: object }) => ({
+    prompt: "", run: { ...run, ...auth },
+  }),
+}));
+beforeEach(() => scheduled.mockClear());
+
+function fixture() {
+  const binding = { sessionId: "native-session", authEpochVersion: 1 };
+  const sessionEntry: SessionEntry = {
+    sessionId: "host-session", updatedAt: 1,
+    cliSessionIds: { "claude-cli": binding.sessionId },
+    cliSessionBindings: { "claude-cli": structuredClone(binding) },
+  };
+  const context = {
+    cfg: { agents: { defaults: { compaction: {
+      idle: { afterMinutes: 15, inputThresholdRatio: 0.8, harnesses: ["claude-cli"] },
+    } } } },
+    sessionKey: "agent:main:idle", storePath: "/synthetic/sessions.sqlite",
+    execution: { status: "ok", maintenanceAuthProfile: undefined },
+    followupRun: { prompt: "", run: { agentId: "main", timeoutMs: 120000 } },
+    replyOperation: {
+      ownerSettlement: Promise.resolve(), lifecycleGeneration: "generation",
+      startedAtMs: 1, result: { kind: "completed" }, abortSignal: new AbortController().signal,
+    },
+  } as unknown as FinalizeReplyAgentRunInput;
+  const accounting = {
+    providerUsed: "anthropic", modelUsed: "native-model", autoCompactionCount: 0,
+    runResult: { meta: {
+      durationMs: 1,
+      executionTrace: { runner: "cli", winnerProvider: "claude-cli", winnerModel: "native-model", attempts: [], fallbackUsed: false },
+      agentMeta: { provider: "anthropic", model: "native-model", sessionId: "native-session", cliSessionBinding: structuredClone(binding) },
+    } },
+  } as unknown as AccountedAgentTurn;
+  return { context, accounting, sessionEntry };
+}
+
+it("arms native Claude idle work after a reply without embedded harness/auth fields", async () => {
+  const input = fixture();
+  scheduleReplySessionMaintenance(input);
+  expect(scheduled).toHaveBeenCalledOnce();
+  const [request, settlement] = scheduled.mock.calls[0];
+  expect(request.agentHarnessId).toBe("claude-cli");
+  expect(request.nativeIdleBinding.binding.sessionId).toBe("native-session");
+  expect(request.followupRun.run.authProfileId).toBeUndefined();
+  await expect(settlement).resolves.toBe(true);
+  expect(input.sessionEntry.agentHarnessId).toBeUndefined();
+});
+
+it.each(["aborted", "yielded", "failed", "compacted", "missing-binding", "unknown-embedded-auth"])(
+  "does not schedule %s completion", (condition) => {
+    const input = fixture();
+    if (condition === "aborted") input.accounting.runResult.meta.aborted = true;
+    if (condition === "yielded") input.accounting.runResult.meta.yielded = true;
+    if (condition === "failed") input.accounting.runResult.meta.error = { kind: "incomplete_turn", message: "failed" };
+    if (condition === "compacted") input.accounting.autoCompactionCount = 1;
+    if (condition === "missing-binding") delete input.sessionEntry.cliSessionBindings;
+    if (condition === "unknown-embedded-auth") {
+      input.accounting.runResult.meta.executionTrace!.runner = "embedded";
+      input.accounting.runResult.meta.agentMeta!.agentHarnessId = "openclaw";
