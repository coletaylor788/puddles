@@ -0,0 +1,53 @@
+import { isDeepStrictEqual } from "node:util";
+import type { CliSessionBinding, SessionEntry } from "../../config/sessions.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { getCliSessionBinding } from "../cli-session.js";
+import type { EmbeddedAgentRunResult } from "../embedded-agent-runner/types.js";
+import { isIdleCompactionHarness } from "./idle.js";
+
+export type NativeIdleBinding = {
+  backendId: string;
+  binding: CliSessionBinding;
+};
+
+/** Native completion proves ambient login without an embedded auth observer. */
+export function resolveCompletedNativeIdleBinding(params: {
+  cfg: OpenClawConfig;
+  meta: EmbeddedAgentRunResult["meta"] | undefined;
+  entry: SessionEntry | undefined;
+}): NativeIdleBinding | undefined {
+  const { meta, entry } = params;
+  const backendId = meta?.executionTrace?.winnerProvider;
+  const completed = meta?.agentMeta?.cliSessionBinding;
+  if (
+    meta?.executionTrace?.runner !== "cli" ||
+    meta.aborted || meta.yielded || meta.error ||
+    !backendId ||
+    !isIdleCompactionHarness(backendId, params.cfg.agents?.defaults?.compaction?.idle) ||
+    !completed?.sessionId ||
+    !entry ||
+    !entry.cliSessionBindings?.[backendId]?.sessionId ||
+    (entry.agentHarnessId !== undefined && entry.agentHarnessId !== backendId)
+  ) {
+    return undefined;
+  }
+  const binding = getCliSessionBinding(entry, backendId);
+  if (!binding) {
+    return undefined;
+  }
+  // A legacy session-id fallback alone is not native completion/auth evidence.
+  for (const field of ["sessionId", "authProfileId", "authEpoch", "authEpochVersion"] as const) {
+    if (binding[field] !== completed[field]) {
+      return undefined;
+    }
+  }
+  return { backendId, binding: structuredClone(binding) };
+}
+
+/** Any native reseed, auth change or pending fork invalidates this quiet period. */
+export function matchesNativeIdleBinding(entry: SessionEntry, captured: NativeIdleBinding): boolean {
+  return (
+    (entry.agentHarnessId === undefined || entry.agentHarnessId === captured.backendId) &&
+    isDeepStrictEqual(getCliSessionBinding(entry, captured.backendId), captured.binding)
+  );
+}
