+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  cancelIdleCompaction,
+  isIdleCompactionHarness,
+  reachesIdleCompactionThreshold,
+  scheduleIdleCompaction,
+} from "./idle.js";
+const policy = { afterMinutes: 15, inputThresholdRatio: 0.8, harnesses: ["claude-cli"] };
+afterEach(() => {
+  cancelIdleCompaction("session");
+  vi.useRealTimers();
+});
+describe("idle native compaction", () => {
+  it("fires after fifteen quiet minutes and resets on new activity", async () => {
+    vi.useFakeTimers();
+    const onIdle = vi.fn();
+    scheduleIdleCompaction({ sessionKey: "session", policy, onIdle });
+    await vi.advanceTimersByTimeAsync(14 * 60000);
+    expect(onIdle).not.toHaveBeenCalled();
+    cancelIdleCompaction("session");
+    await vi.advanceTimersByTimeAsync(60000);
+    expect(onIdle).not.toHaveBeenCalled();
+    scheduleIdleCompaction({ sessionKey: "session", policy, onIdle });
+    await vi.advanceTimersByTimeAsync(15 * 60000 - 1);
+    expect(onIdle).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(onIdle).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(60 * 60000);
+    expect(onIdle).toHaveBeenCalledTimes(1);
+  });
+  it("does not enable an idle timer for an unselected harness or change its native policy", () => {
+    expect(isIdleCompactionHarness("claude-cli", policy)).toBe(true);
+    expect(isIdleCompactionHarness("test-harness", policy)).toBe(false);
+    expect(isIdleCompactionHarness("claude-cli")).toBe(false);
+  });
+  it("requires fresh known usage at eighty percent of the effective input budget", () => {
+    expect(reachesIdleCompactionThreshold(204799, 256000, policy)).toBe(false);
+    expect(reachesIdleCompactionThreshold(204800, 256000, policy)).toBe(true);
+    expect(reachesIdleCompactionThreshold(undefined, 256000, policy)).toBe(false);
+    expect(reachesIdleCompactionThreshold(Number.NaN, 256000, policy)).toBe(false);
+    expect(reachesIdleCompactionThreshold(204800, 0, policy)).toBe(false);
+    expect(reachesIdleCompactionThreshold(102400, 128000, policy)).toBe(true);
+  });
+});
+
+it("cannot rearm an old completion after activity while delivery was settling", async () => {
+  vi.useFakeTimers();
+  let settle!: (value: boolean) => void;
+  const afterOwnerSettles = new Promise<boolean>((resolve) => {
+    settle = resolve;
+  });
+  const onIdle = vi.fn();
+  scheduleIdleCompaction({ sessionKey: "session", policy, onIdle, afterOwnerSettles });
+  cancelIdleCompaction("session");
+  settle(true);
+  await vi.advanceTimersByTimeAsync(30 * 60000);
+  expect(onIdle).not.toHaveBeenCalled();
+});
diff --git a/src/agents/session-maintenance/idle.ts b/src/agents/session-maintenance/idle.ts
new file mode 100644
index 0000000000000000000000000000000000000000..331ecbb5cc84820f866f2542ec654fcd9579f3cd
--- /dev/null
+++ b/src/agents/session-maintenance/idle.ts
@@ -0,0 +1,97 @@
+import { registerAgentEventLifecycleRotationHandler } from "../../infra/agent-events.js";
+import { resolveGlobalSingleton } from "../../shared/global-singleton.js";
+
+export type IdleCompactionPolicy = {
+  afterMinutes: number;
+  inputThresholdRatio: number;
+  harnesses: string[];
+};
+type QuietPeriod = { timer?: ReturnType<typeof setTimeout> };
+const timers = resolveGlobalSingleton(
+  Symbol.for("openclaw.idleCompactionTimers"),
+  () => new Map<string, QuietPeriod>(),
+  (current) => {
+    for (const period of current.values()) {
+      if (period.timer) {
+        clearTimeout(period.timer);
+      }
+    }
+  },
+);
+
+/** Activity invalidates the previous quiet period even while delivery is still settling. */
+export function cancelIdleCompaction(sessionKey: string): void {
+  const period = timers.get(sessionKey);
+  if (period?.timer) {
+    clearTimeout(period.timer);
+  }
+  timers.delete(sessionKey);
+}
+registerAgentEventLifecycleRotationHandler("idle-compaction", () => {
+  for (const key of timers.keys()) {
+    cancelIdleCompaction(key);
+  }
+});
+
+export function isIdleCompactionHarness(
+  harnessId: string | undefined,
+  policy?: IdleCompactionPolicy,
+): boolean {
+  return Boolean(harnessId && policy?.harnesses.includes(harnessId));
+}
+
+/** No owner, writer, command budget, or gateway root is held during this timer. */
+export function scheduleIdleCompaction(params: {
+  sessionKey: string;
+  policy: IdleCompactionPolicy;
+  afterOwnerSettles?: Promise<boolean>;
+  onIdle: () => void;
+}): void {
+  cancelIdleCompaction(params.sessionKey);
+  const period: QuietPeriod = {};
+  timers.set(params.sessionKey, period);
+  const arm = () => {
+    if (timers.get(params.sessionKey) !== period) {
+      return;
+    }
+    period.timer = setTimeout(() => {
+      if (timers.get(params.sessionKey) !== period) {
+        return;
+      }
+      timers.delete(params.sessionKey);
+      params.onIdle();
+    }, params.policy.afterMinutes * 60_000);
+    period.timer.unref?.();
+  };
+  if (params.afterOwnerSettles) {
+    void params.afterOwnerSettles
+      .then((ok) => {
+        if (ok) {
+          arm();
+        } else if (timers.get(params.sessionKey) === period) {
+          cancelIdleCompaction(params.sessionKey);
+        }
+      })
+      .catch(() => {
+        if (timers.get(params.sessionKey) === period) {
+          cancelIdleCompaction(params.sessionKey);
+        }
+      });
+  } else {
+    arm();
+  }
+}
+
+export function reachesIdleCompactionThreshold(
+  tokens: number | undefined,
+  inputBudget: number,
+  policy: IdleCompactionPolicy,
+): boolean {
+  return (
+    typeof tokens === "number" &&
+    Number.isFinite(tokens) &&
+    Number.isFinite(inputBudget) &&
+    inputBudget > 0 &&
+    tokens >= Math.ceil(inputBudget * policy.inputThresholdRatio)
+  );
+}
