@@ -0,0 +1,58 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  cancelIdleCompaction,
+  isIdleCompactionHarness,
+  reachesIdleCompactionThreshold,
+  scheduleIdleCompaction,
+} from "./idle.js";
+const policy = { afterMinutes: 15, inputThresholdRatio: 0.8, harnesses: ["claude-cli"] };
+afterEach(() => {
+  cancelIdleCompaction("session");
+  vi.useRealTimers();
+});
+describe("idle native compaction", () => {
+  it("fires after fifteen quiet minutes and resets on new activity", async () => {
+    vi.useFakeTimers();
+    const onIdle = vi.fn();
+    scheduleIdleCompaction({ sessionKey: "session", policy, onIdle });
+    await vi.advanceTimersByTimeAsync(14 * 60000);
+    expect(onIdle).not.toHaveBeenCalled();
+    cancelIdleCompaction("session");
+    await vi.advanceTimersByTimeAsync(60000);
+    expect(onIdle).not.toHaveBeenCalled();
+    scheduleIdleCompaction({ sessionKey: "session", policy, onIdle });
+    await vi.advanceTimersByTimeAsync(15 * 60000 - 1);
+    expect(onIdle).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(onIdle).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(60 * 60000);
+    expect(onIdle).toHaveBeenCalledTimes(1);
+  });
+  it("does not enable an idle timer for an unselected harness or change its native policy", () => {
+    expect(isIdleCompactionHarness("claude-cli", policy)).toBe(true);
+    expect(isIdleCompactionHarness("test-harness", policy)).toBe(false);
+    expect(isIdleCompactionHarness("claude-cli")).toBe(false);
+  });
+  it("requires fresh known usage at eighty percent of the effective input budget", () => {
+    expect(reachesIdleCompactionThreshold(204799, 256000, policy)).toBe(false);
+    expect(reachesIdleCompactionThreshold(204800, 256000, policy)).toBe(true);
+    expect(reachesIdleCompactionThreshold(undefined, 256000, policy)).toBe(false);
+    expect(reachesIdleCompactionThreshold(Number.NaN, 256000, policy)).toBe(false);
+    expect(reachesIdleCompactionThreshold(204800, 0, policy)).toBe(false);
+    expect(reachesIdleCompactionThreshold(102400, 128000, policy)).toBe(true);
+  });
+});
+
+it("cannot rearm an old completion after activity while delivery was settling", async () => {
+  vi.useFakeTimers();
+  let settle!: (value: boolean) => void;
+  const afterOwnerSettles = new Promise<boolean>((resolve) => {
+    settle = resolve;
+  });
+  const onIdle = vi.fn();
+  scheduleIdleCompaction({ sessionKey: "session", policy, onIdle, afterOwnerSettles });
+  cancelIdleCompaction("session");
+  settle(true);
+  await vi.advanceTimersByTimeAsync(30 * 60000);
+  expect(onIdle).not.toHaveBeenCalled();
+});
