+// Exercise real source selection, bounded hydration and durable storage. A missing
+// runtime registry deliberately leaves the retained job pending, without inference.
+vi.mock("../../plugins/runtime.js", async (original) => ({
+  ...(await original<object>()),
+  getPluginRegistryForContext: () => undefined,
+}));
+vi.mock("../../auto-reply/reply/agent-runner-memory.js", () => ({
+  runCompactionMemorySnapshot: () => {
+    throw new Error("This capture test must never invoke inference");
+  },
+}));
+afterEach(async () => {
+  await drainGlobalSingletonLifecycleState("close");
+});
+
+it.each([
+  { kind: "host", sparsePolicy: false },
+  { kind: "native", sparsePolicy: false },
+  { kind: "host", sparsePolicy: true },
+  { kind: "native", sparsePolicy: true },
+])(
+  "retains actual $kind history with sparse policy $sparsePolicy",
+  async ({ kind, sparsePolicy }) => {
+    await withOpenClawTestState({ label: "compaction-capture-real-store" }, async (state) => {
+      const harness = kind === "native" ? "claude-cli" : "synthetic";
+      const config: OpenClawConfig = {
+        agents: {
+          defaults: {
+            workspace: state.workspaceDir,
+            sandbox: { mode: "off" },
+            compaction: { memoryFlush: { enabled: true, compactionHooks: [harness] } },
+          },
+        },
+      };
+      await state.writeConfig(config);
+      const identity = {
+        agentId: "main",
+        sessionKey: "agent:main:capture",
+        sessionId: "capture-source",
+      };
+      const scope = { ...identity, storePath: resolveSessionStorePathForScope(identity, config) };
+      await upsertSessionEntryCore(scope, {
+        sessionId: identity.sessionId,
+        lifecycleRevision: "capture-lifecycle",
+        compactionCount: 9,
+        updatedAt: 1,
+        agentHarnessId: harness,
+        modelProvider: "synthetic",
+        model: "model",
+        contextTokens: 256000,
+      });
+      const source = await SessionManager.openAsync(scope, state.workspaceDir);
+      await source.appendMessageAsync({
+        role: "user",
+        content: "Retain the Cedar preference.",
+        timestamp: 1,
+      });
+      const toolResult = {
+        role: "toolResult" as const,
+        toolCallId: "read-1",
+        toolName: "read",
+        content: [{ type: "text" as const, text: "Cedar preference is maple-17." }],
+        isError: false,
+        timestamp: 2,
+      };
+      if (kind === "host") await source.appendMessageAsync(toolResult);
+      await waitForSessionTranscriptProjection(scope);
+      const context = {
+        config,
+        ...identity,
+        memorySaveHarnessId: harness,
+        modelProviderId: "synthetic",
+        modelId: "model",
+        contextTokenBudget: 256000,
+        ...(sparsePolicy
+          ? {
+              memorySavePolicy: {
+                runtimePolicySessionKey: identity.sessionKey,
+                chatType: undefined,
+                groupId: undefined,
+                agentAccountId: undefined,
+                conversationToolPolicy: { allow: ["read"], alsoAllow: undefined, deny: ["exec"] },
+              },
+            }
+          : {}),
+        ...(kind === "native"
+          ? {
+              memorySaveEntries: [
+                ...source.getEntries(),
+                {
+                  type: "message",
+                  id: "native-tool-only",
+                  parentId: null,
+                  timestamp: new Date(2).toISOString(),
+                  message: toolResult,
+                },
+              ],
+            }
+          : {}),
+      };
+      if (kind === "native") expect(JSON.stringify(source.getEntries())).not.toContain("maple-17");
+      await captureCompactionMemory(context);
+      const store = createCorePluginStateKeyedStore<CompactionMemoryRecord>({
+        ownerId: "core:compaction-memory",
+        namespace: "snapshots",
+        retention: "retained",
+      });
+      const jobs = (await store.entries()).map((r) => r.value).filter((r) => r.kind === "job");
+      expect(jobs).toHaveLength(1);
+      const job = jobs[0]!;
+      expect(job).toMatchObject({
+        status: "pending",
+        attempts: 0,
+        source: {
+          ...identity,
+          lifecycleRevision: "capture-lifecycle",
+          compactionCount: 9,
+          harnessId: harness,
+          contextTokens: 256000,
+        },
+      });
+      if (sparsePolicy) {
+        expect(job.source.policy).toEqual({
+          runtimePolicySessionKey: identity.sessionKey,
+          conversationToolPolicy: { allow: ["read"], deny: ["exec"] },
+        });
+      } else {
+        expect(Object.hasOwn(job.source, "policy")).toBe(false);
+      }
+      const snapshot = await readCompactionMemorySnapshot(store, job);
+      expect(snapshot).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({
+            type: "message",
+            message: expect.objectContaining({
+              role: "toolResult",
+              content: [{ type: "text", text: "Cedar preference is maple-17." }],
+            }),
+          }),
+        ]),
+      );
+      await captureCompactionMemory(context);
+      expect((await store.entries()).filter((r) => r.value.kind === "job")).toHaveLength(1);
+    });
+  },
+);
