diff --git a/src/agents/command/claude-cli-project-dir.test.ts b/src/agents/command/claude-cli-project-dir.test.ts
new file mode 100644
index 0000000..c497bd6
--- /dev/null
+++ b/src/agents/command/claude-cli-project-dir.test.ts
@@ -0,0 +1,99 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import {
+  claudeCliSessionTranscriptHasContent,
+  claudeCliSessionTranscriptHasOrphanedToolUse,
+} from "./attempt-execution.helpers.js";
+import { resolveClaudeCliProjectDirForWorkspace } from "./claude-cli-project-dir.js";
+
+let root: string;
+beforeEach(async () => {
+  root = await fs.mkdtemp(path.join(os.tmpdir(), "claude-transcript-config-"));
+  vi.stubEnv("CLAUDE_CONFIG_DIR", "");
+});
+afterEach(async () => {
+  vi.unstubAllEnvs();
+  await fs.rm(root, { recursive: true, force: true });
+});
+
+it("keeps the default directory when no native override is configured", () => {
+  expect(resolveClaudeCliProjectDirForWorkspace({ workspaceDir: root, homeDir: root })).toContain(
+    path.join(root, ".claude", "projects"),
+  );
+});
+
+it.each(["environment", "backend"])(
+  "finds a cold native transcript in the %s directory without falling back to another account",
+  async (binding) => {
+    const configDir = path.join(root, "selected-account"),
+      workspaceDir = root;
+    if (binding === "environment") vi.stubEnv("CLAUDE_CONFIG_DIR", configDir);
+    else vi.stubEnv("CLAUDE_CONFIG_DIR", path.join(root, "other-account"));
+    const params = { workspaceDir, homeDir: root, ...(binding === "backend" ? { configDir } : {}) };
+    const canonical = await fs.realpath(workspaceDir);
+    const project = path.join(
+      configDir,
+      "projects",
+      canonical.normalize("NFC").replace(/[^a-zA-Z0-9]/g, "-"),
+    );
+    await fs.mkdir(project, { recursive: true });
+    const transcript = path.join(project, "synthetic-session.jsonl");
+    await fs.writeFile(
+      transcript,
+      JSON.stringify({
+        type: "assistant",
+        message: {
+          role: "assistant",
+          content: [{ type: "tool_use", id: "pending", name: "Read", input: {} }],
+        },
+      }) + "\n",
+    );
+    expect(resolveClaudeCliProjectDirForWorkspace(params)).toBe(project);
+    expect(
+      await claudeCliSessionTranscriptHasContent({ ...params, sessionId: "synthetic-session" }),
+    ).toBe(true);
+    expect(
+      await claudeCliSessionTranscriptHasOrphanedToolUse({
+        ...params,
+        sessionId: "synthetic-session",
+      }),
+    ).toBe(true);
+    await fs.appendFile(
+      transcript,
+      JSON.stringify({
+        type: "user",
+        message: {
+          role: "user",
+          content: [{ type: "tool_result", tool_use_id: "pending", content: "done" }],
+        },
+      }) + "\n",
+    );
+    expect(
+      await claudeCliSessionTranscriptHasOrphanedToolUse({
+        ...params,
+        sessionId: "synthetic-session",
+      }),
+    ).toBe(false);
+    expect(
+      await claudeCliSessionTranscriptHasContent({
+        ...params,
+        configDir: path.join(root, "absent-account"),
+        sessionId: "synthetic-session",
+      }),
+    ).toBe(false);
+  },
+);
+
+// Native CLI uses the absolute signed 32-bit hash for truncated project keys.
+it.each([[13, "84rh70"], [14, "mhah3v"]])(
+  "matches native long workspace keys (%s segments)",
+  (segments, suffix) => {
+    const workspaceDir = "/synthetic/" + "long-workspace/".repeat(Number(segments)) + "alpha";
+    const key = workspaceDir.replace(/[^a-zA-Z0-9]/g, "-").slice(0, 200) + "-" + suffix;
+    expect(resolveClaudeCliProjectDirForWorkspace({ workspaceDir, configDir: root })).toBe(
+      path.join(root, "projects", key),
+    );
+  },
+);
