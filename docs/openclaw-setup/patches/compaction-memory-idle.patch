+      },
+    },
+  };
+  mocks.entry = { sessionId: "source-id", updatedAt: 1, agentHarnessId: "test-harness" };
+  mocks.capture.mockReset().mockResolvedValue({
+    sessionManager: {
+      getEntries: () => [{ type: "message", message: { role: "user", content: "retained fact" } }],
+    },
+  });
+  mocks.save.mockReset().mockResolvedValue({ outcome: "completed" });
+});
+afterEach(async () => {
+  await drainGlobalSingletonLifecycleState("close");
+});
+
+describe("compaction snapshot admission and independent execution", () => {
+  it.each(["test-harness", "claude-cli"])(
+    "retains %s input before returning and lets its source proceed during saving",
+    async (harnessId) => {
+      await withOpenClawTestState({ label: "compaction-memory-independent" }, async () => {
+        mocks.entry.agentHarnessId = harnessId;
+        const started = createDeferred();
+        const finish = createDeferred();
+        mocks.save.mockImplementation(async () => {
+          started.resolve();
+          await finish.promise;
+          return { outcome: "completed" };
+        });
+        const ctx = {
+          ...context(),
+          memorySaveHarnessId: harnessId,
+          ...(harnessId === "claude-cli"
+            ? {
+                memorySaveEntries: [
+                  {
+                    type: "message",
+                    id: "native-1",
+                    parentId: null,
+                    message: { role: "user", content: "retained fact from native tool result" },
+                  },
+                ],
+              }
+            : {}),
+        };
+        if (harnessId === "claude-cli") {
+          await captureCompactionMemory({ ...ctx, memorySaveEntries: undefined });
+          expect(mocks.save).not.toHaveBeenCalled();
+          expect(mocks.capture).not.toHaveBeenCalled();
+        }
+        await captureCompactionMemory(ctx);
+        if (harnessId === "claude-cli") expect(mocks.capture).not.toHaveBeenCalled();
+        await vi.waitFor(
+          () => {
+            expect(mocks.warnings).toEqual([]);
+            expect(mocks.save).toHaveBeenCalledTimes(1);
+          },
+          { timeout: 3000 },
+        );
+        const retained = (await jobs().entries())
+          .map((r) => r.value)
+          .filter((r) => r.kind === "job");
+        expect(retained).toHaveLength(1);
+        expect(retained[0]).toMatchObject({
+          source: { harnessId, authProfileId: "source-auth", policy: ctx.memorySavePolicy },
+        });
+        await captureCompactionMemory(ctx);
+        expect(mocks.save).toHaveBeenCalledTimes(1);
+        const release = await beginForegroundSessionMaintenance(ctx.sessionKey);
+        try {
+          const [params, snapshot] = mocks.save.mock.calls[0];
+          expect(params.abortSignal.aborted).toBe(false);
+          expect(params.followupRun.run).toMatchObject({
+            authProfileId: "source-auth",
+            conversationToolPolicy: { deny: ["exec"] },
+          });
+          expect(JSON.stringify(snapshot.entries)).toContain("retained fact");
+          expect(params.sessionEntry.agentHarnessId).toBe(harnessId);
+        } finally {
+          release();
+          finish.resolve();
+        }
+        await vi.waitFor(async () =>
+          expect(
+            (await jobs().entries())
+              .filter((r) => r.value.kind === "job")
