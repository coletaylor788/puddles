+} from "./cli-compaction-snapshot.js";
+
+const rows = [
+  {
+    uuid: "u1",
+    parentUuid: null,
+    type: "user",
+    message: { role: "user", content: "Look up the preference" },
+  },
+  {
+    uuid: "a1",
+    parentUuid: "u1",
+    type: "assistant",
+    message: {
+      role: "assistant",
+      content: [
+        { type: "tool_use", id: "t1", name: "Read", input: { file_path: "preferences" } },
+        { type: "thinking", thinking: "private reasoning" },
+      ],
+    },
+  },
+  {
+    uuid: "t1",
+    parentUuid: "a1",
+    type: "user",
+    message: {
+      role: "user",
+      content: [
+        {
+          type: "tool_result",
+          tool_use_id: "t1",
+          content: "The preferred pickup code is synthetic-blue-42.",
+        },
+      ],
+    },
+  },
+  {
+    uuid: "a2",
+    parentUuid: "t1",
+    type: "assistant",
+    message: { role: "assistant", content: "Done." },
+  },
+  {
+    uuid: "branch",
+    parentUuid: "u1",
+    isSidechain: true,
+    type: "assistant",
+    message: { content: "foreign branch" },
+  },
+];
+const jsonl = (values = rows) =>
+  values.map((row) => JSON.stringify({ ...row, sessionId: "native-1" })).join("\n") + "\n";
+it("retains tool-only facts in the native parent chain before compaction", () => {
+  const entries = projectClaudeCompactionSnapshot(jsonl(), "native-1");
+  expect(entries).toHaveLength(4);
+  expect(JSON.stringify(entries)).toContain("synthetic-blue-42");
+  expect(JSON.stringify(entries)).not.toContain("private reasoning");
+  expect(JSON.stringify(entries)).not.toContain("foreign branch");
+});
+it("refuses another owner, incomplete records and missing ancestry", () => {
+  expect(() => projectClaudeCompactionSnapshot(jsonl(), "other")).toThrow("another session");
+  expect(() => projectClaudeCompactionSnapshot(jsonl().trimEnd(), "native-1")).toThrow(
+    "incomplete",
+  );
+  expect(() => projectClaudeCompactionSnapshot(jsonl(rows.slice(1)), "native-1")).toThrow(
+    "missing parent",
+  );
+});
+it("reads only the admitted native session inside its profile and checks cancellation", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "claude-snapshot-"));
+  try {
+    const project = path.join(root, "projects", "synthetic");
+    await fs.mkdir(project, { recursive: true });
+    const transcript = path.join(project, "native-1.jsonl");
+    await fs.writeFile(transcript, jsonl());
+    const context = { sessionId: "native-1", env: { CLAUDE_CONFIG_DIR: root } };
+    const input = { session_id: "native-1", transcript_path: transcript };
+    expect(JSON.stringify(await readClaudeCompactionSnapshot(context, input))).toContain(
+      "synthetic-blue-42",
+    );
+    await expect(
+      readClaudeCompactionSnapshot(context, { ...input, session_id: "other" }),
+    ).rejects.toThrow("different session");
+    await expect(
+      readClaudeCompactionSnapshot({ ...context, abortSignal: AbortSignal.abort() }, input),
+    ).rejects.toThrow();
+    const outside = path.join(root, "native-1.jsonl");
+    await fs.writeFile(outside, jsonl());
+    await expect(
+      readClaudeCompactionSnapshot(context, { ...input, transcript_path: outside }),
+    ).rejects.toThrow("escaped");
+  } finally {
+    await fs.rm(root, { recursive: true, force: true });
+  }
+});
+
+it("ignores large obsolete history and selects the active chain after a native compact boundary", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "claude-snapshot-growth-"));
+  try {
+    const project = path.join(root, "projects", "synthetic");
+    await fs.mkdir(project, { recursive: true });
+    const transcript = path.join(project, "native-1.jsonl");
+    const obsolete =
+      JSON.stringify({
+        uuid: "old",
+        parentUuid: null,
+        type: "user",
+        message: { content: "old".repeat(1024) },
+      }) + "\n";
+    await fs.writeFile(transcript, obsolete.repeat(12000));
+    const boundary = {
+      uuid: "boundary",
+      parentUuid: null,
+      type: "system",
+      subtype: "compact_boundary",
+    };
+    const active = [boundary, { ...rows[0], parentUuid: "boundary" }, ...rows.slice(1)];
+    await fs.appendFile(transcript, jsonl(active as typeof rows));
+    expect((await fs.stat(transcript)).size).toBeGreaterThan(32 * 1024 * 1024);
+    const entries = await readClaudeCompactionSnapshot(
+      { sessionId: "native-1", env: { CLAUDE_CONFIG_DIR: root } },
+      { session_id: "native-1", transcript_path: transcript },
