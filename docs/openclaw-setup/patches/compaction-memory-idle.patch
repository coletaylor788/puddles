new file mode 100644
index 0000000000000000000000000000000000000000..35536ee39e96aa50385b7ce9f76f3fafb3e31897
--- /dev/null
+++ b/src/gateway/mcp-http.memory-flush.test.ts
@@ -0,0 +1,219 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import "../agents/test-helpers/fast-bash-tools.js";
+import "../agents/test-helpers/fast-coding-tools.js";
+import "../agents/test-helpers/fast-openclaw-tools.js";
+import { MemoryFlushToolsUnavailableError } from "../agents/agent-tools.memory-flush.js";
+import type { AnyAgentTool } from "../agents/agent-tools.types.js";
+import { createOpenClawTools } from "../agents/openclaw-tools.js";
+import { attachToolAllowlistIntersection } from "../agents/tool-policy.js";
+import { setAppliedRuntimeConfigSnapshot } from "../config/runtime-snapshot.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { setPluginToolMeta } from "../plugins/tool-metadata.js";
+import { createOpenClawTestState } from "../test-utils/openclaw-test-state.js";
+import { handleMcpJsonRpc } from "./mcp-http.handlers.js";
+import { resolveMcpLoopbackScopedTools } from "./mcp-http.runtime.js";
+import { buildMcpToolSchema } from "./mcp-http.schema.js";
+
+const pluginFactory = vi.hoisted(() => vi.fn());
+// Only tool construction is synthetic. The loopback resolver, coding-tool memory
+// projection, policy filters, persistence wrapper, and execution remain real.
+vi.mock("../agents/openclaw-plugin-tools.js", () => ({
+  resolveOpenClawPluginToolsForOptions: pluginFactory,
+  resolveOpenClawPluginToolsForOptionsAsync: async (...args: unknown[]) => pluginFactory(...args),
+}));
+
+function writer(pluginId: string, name = "save_fixture_memory"): AnyAgentTool {
+  const tool: AnyAgentTool = {
+    name,
+    label: name,
+    description: "Synthetic memory persistence",
+    parameters: { type: "object", properties: {} },
+    execute: vi.fn(async () => ({
+      content: [{ type: "text" as const, text: "saved" }],
+      details: {},
+    })),
+  };
+  setPluginToolMeta(tool, { pluginId, optional: false });
+  return tool;
+}
+
+let state: Awaited<ReturnType<typeof createOpenClawTestState>>;
+beforeAll(async () => {
+  state = await createOpenClawTestState({ prefix: "provider-memory-mcp-", layout: "state-only" });
+});
+afterAll(async () => state?.cleanup());
+beforeEach(() => {
+  vi.mocked(createOpenClawTools).mockReset();
+  pluginFactory.mockReset();
+});
+
+async function resolve(
+  tools: AnyAgentTool[],
+  options: {
+    codeMode?: boolean;
+    codeModeMediatedTools?: string[];
+    denied?: boolean;
+    gatewayDenied?: boolean;
+    toolsAllow?: string[] | null;
+  } = {},
+) {
+  const cfg: OpenClawConfig = {
+    plugins: { enabled: false },
+    ...(options.gatewayDenied ? { gateway: { tools: { deny: ["save_fixture_memory"] } } } : {}),
+    tools: {
+      allow: ["read", "save_fixture_memory", "delete_fixture_memory"],
+      ...(options.codeMode
+        ? { codeMode: { enabled: true, surface: "additive", executor: "quickjs" } as const }
+        : {}),
+      ...(options.denied ? { deny: ["save_fixture_memory"] } : {}),
+    },
+  };
+  await state.writeConfig(cfg);
+  await setAppliedRuntimeConfigSnapshot(cfg, cfg);
+  vi.mocked(createOpenClawTools).mockImplementation(() => tools);
+  pluginFactory.mockImplementation(() => tools);
+  const recordPersistenceToolSuccess = vi.fn();
+  const pending = resolveMcpLoopbackScopedTools({
+    cfg,
+    context: {
+      sessionKey: "agent:main:internal:memory-fixture",
+      runtimePolicySessionKey: "agent:main:main",
+      senderIsOwner: false,
+      trigger: "memory",
+      ...(options.codeMode
+        ? {
+            codeMode: true,
+            codeModeMediatedTools: options.codeModeMediatedTools ?? ["save_fixture_memory"],
+          }
+        : {}),
+      toolsAllow:
+        options.toolsAllow === null
+          ? undefined
+          : (options.toolsAllow ?? ["read", "save_fixture_memory", "delete_fixture_memory"]),
+    },
+    memoryFlushTools: {
+      flushId: "captured-fixture-part",
+      ownerPluginId: "memory-fixture",
+      persistenceToolNames: ["save_fixture_memory"],
+      recordPersistenceToolSuccess,
+    },
+  });
+  return { pending, recordPersistenceToolSuccess };
+}
+
+describe("provider memory through the loopback coding-tool policy", () => {
+  it("executes only the declared owner's writer and records successful persistence", async () => {
+    const foreign = writer("foreign-provider");
+    const owned = writer("memory-fixture");
+    const undeclared = writer("memory-fixture", "delete_fixture_memory");
+    const { pending, recordPersistenceToolSuccess } = await resolve([foreign, owned, undeclared]);
+    const result = await pending;
+    expect(result.tools.map((tool) => tool.name).toSorted()).toEqual(["read", owned.name]);
+    expect(recordPersistenceToolSuccess).not.toHaveBeenCalled();
+    await result.tools.find((tool) => tool.name === owned.name)!.execute("save-fixture", {});
+    expect(owned.execute).toHaveBeenCalledOnce();
+    expect(recordPersistenceToolSuccess).toHaveBeenCalledOnce();
+    expect(foreign.execute).not.toHaveBeenCalled();
+    expect(undeclared.execute).not.toHaveBeenCalled();
+  });
+
+  it("keeps the persistence writer under an additive Code Mode production grant", async () => {
+    const owned = writer("memory-fixture");
+    const { pending, recordPersistenceToolSuccess } = await resolve([owned], { codeMode: true });
+    const result = await pending;
+    expect(result.tools.map((tool) => tool.name)).toEqual([owned.name]);
+    expect(result.tools.map((tool) => tool.name)).not.toEqual(
+      expect.arrayContaining(["code_exec", "code_wait", "exec", "wait"]),
+    );
+    await result.tools.find((tool) => tool.name === owned.name)!.execute("save-code-mode", {});
+    expect(owned.execute).toHaveBeenCalledOnce();
+    expect(recordPersistenceToolSuccess).toHaveBeenCalledOnce();
+  });
+
+  it("preserves every explicitly mediated memory tool without Code Mode controls", async () => {
+    const owned = writer("memory-fixture");
+    const { pending } = await resolve([owned], {
+      codeMode: true,
+      codeModeMediatedTools: ["read", "save_fixture_memory"],
+    });
+    const result = await pending;
+    expect(result.tools.map((tool) => tool.name).toSorted()).toEqual(["read", owned.name]);
+    expect(result.tools.map((tool) => tool.name)).not.toEqual(
+      expect.arrayContaining(["code_exec", "code_wait", "exec", "wait"]),
+    );
+  });
+
+  it("rejects an explicitly denied persistence writer before execution", async () => {
+    const owned = writer("memory-fixture");
+    const { pending, recordPersistenceToolSuccess } = await resolve([owned], { denied: true });
+    await expect(pending).rejects.toBeInstanceOf(MemoryFlushToolsUnavailableError);
+    expect(owned.execute).not.toHaveBeenCalled();
+    expect(recordPersistenceToolSuccess).not.toHaveBeenCalled();
+  });
+
+  it("does not substitute a same-name foreign writer for the declared owner", async () => {
+    const foreign = writer("foreign-provider");
+    const { pending, recordPersistenceToolSuccess } = await resolve([foreign]);
+    await expect(pending).rejects.toBeInstanceOf(MemoryFlushToolsUnavailableError);
+    expect(foreign.execute).not.toHaveBeenCalled();
+    expect(recordPersistenceToolSuccess).not.toHaveBeenCalled();
+  });
+  it.each([
+    { label: "read-only", toolsAllow: ["read"] },
+    { label: "empty", toolsAllow: [] },
+    {
+      label: "independent intersections",
+      toolsAllow: attachToolAllowlistIntersection(
+        ["save_fixture_memory"],
+        [["*_memory"], ["read"]],
+      ),
+    },
+  ])("rejects a writer excluded by the $label run cap before execution", async ({ toolsAllow }) => {
+    const owned = writer("memory-fixture");
+    const { pending, recordPersistenceToolSuccess } = await resolve([owned], { toolsAllow });
+    await expect(pending).rejects.toBeInstanceOf(MemoryFlushToolsUnavailableError);
+    expect(owned.execute).not.toHaveBeenCalled();
+    expect(recordPersistenceToolSuccess).not.toHaveBeenCalled();
+  });
+
+  it("rejects a writer removed by the final Gateway surface deny", async () => {
+    const owned = writer("memory-fixture");
+    const { pending, recordPersistenceToolSuccess } = await resolve([owned], {
+      gatewayDenied: true,
+    });
+    await expect(pending).rejects.toBeInstanceOf(MemoryFlushToolsUnavailableError);
+    expect(owned.execute).not.toHaveBeenCalled();
+    expect(recordPersistenceToolSuccess).not.toHaveBeenCalled();
+  });
+
+  it("keeps native policy authoritative when the run has no explicit cap", async () => {
+    const owned = writer("memory-fixture");
+    const { pending, recordPersistenceToolSuccess } = await resolve([owned], {
+      toolsAllow: null,
+      denied: true,
+    });
+    await expect(pending).rejects.toBeInstanceOf(MemoryFlushToolsUnavailableError);
+    expect(owned.execute).not.toHaveBeenCalled();
+    expect(recordPersistenceToolSuccess).not.toHaveBeenCalled();
+  });
+
+  it("rechecks the native MCP invocation authority before a persistence write", async () => {
+    const owned = writer("memory-fixture");
+    const { pending, recordPersistenceToolSuccess } = await resolve([owned]);
+    const { tools } = await pending;
+    const response = await handleMcpJsonRpc({
+      message: {
+        jsonrpc: "2.0",
+        id: 1,
+        method: "tools/call",
+        params: { name: owned.name, arguments: {} },
+      },
+      tools,
+      toolSchema: buildMcpToolSchema(tools),
+      authorizeToolCall: () => false,
+    });
+    expect(response).toMatchObject({ result: { isError: true } });
+    expect(owned.execute).not.toHaveBeenCalled();
+    expect(recordPersistenceToolSuccess).not.toHaveBeenCalled();
+  });
+});
