{
  "name": "puddles",
  "private": true,
  "version": "0.0.0",
  "description": "Puddles personal-agent monorepo: MCP servers, OpenClaw plugins, and host setup",
  "scripts": {
    "build": "corepack pnpm -r --filter \"./packages/**\" --filter \"./openclaw-plugins/**\" build",
    "test": "corepack pnpm -r --filter \"./packages/**\" --filter \"./openclaw-plugins/**\" test",
    "test:integration": "node packages/e2e/bin/openclaw-test-env.mjs ci",
    "lint": "corepack pnpm -r --filter \"./packages/**\" --filter \"./openclaw-plugins/**\" lint"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "optionalDependencies": {
    "apple-pim-cli": "3.7.22"
  }
}
