{
  "id": "agent-browser",
  "name": "Vercel browser",
  "version": "0.1.0",
  "description": "Registers stock Vercel MCP browser tools through OpenClaw",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["command", "args", "agentId"],
    "properties": {
      "command": { "type": "string", "minLength": 1 },
      "args": { "type": "array", "items": { "type": "string" } },
      "env": { "type": "object", "additionalProperties": { "type": "string" } },
      "agentId": { "type": "string", "minLength": 1 }
    }
  }
}
