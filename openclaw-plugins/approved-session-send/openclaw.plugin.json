{
  "id": "approved-session-send",
  "name": "Approved Session Send",
  "version": "0.1.0",
  "description": "Native owner approval for a fixed cross-agent question route",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "requesterAgentId",
      "targetSessionKey",
      "requesters"
    ],
    "properties": {
      "requesterAgentId": {
        "type": "string",
        "minLength": 1
      },
      "targetSessionKey": {
        "type": "string",
        "minLength": 1
      },
      "requesters": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionKey",
            "channel",
            "accountId",
            "senderId"
          ],
          "properties": {
            "sessionKey": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "accountId": {
              "type": "string",
              "minLength": 1
            },
            "senderId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "activation": {
    "onStartup": true,
    "onAgentHarnesses": ["copilot"]
  }
}
