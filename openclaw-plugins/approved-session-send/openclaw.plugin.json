{
  "id": "approved-session-send",
  "name": "Approved Session Send",
  "version": "0.1.0",
  "description": "Native owner approval for a fixed cross-agent question route",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "requesterAgentId",
      "targetSessionKey"
    ],
    "properties": {
      "requesterAgentId": {
        "type": "string",
        "minLength": 1
      },
      "targetSessionKey": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "activation": {
    "onStartup": true,
    "onAgentHarnesses": [
      "copilot"
    ]
  }
}
