{
  "name": "cli-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/plugin.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/plugin.js --external:openclaw && node scripts/write-dist-manifest.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.12",
    "openclaw": "2026.9.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
