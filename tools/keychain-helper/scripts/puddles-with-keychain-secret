#!/bin/sh
set -eu
umask 077

usage() {
  echo "usage: puddles-with-keychain-secret ENV_NAME ALIAS -- COMMAND [ARG ...]" >&2
  exit 64
}

[ "$#" -ge 4 ] || usage
env_name=$1
alias_name=$2
[ "$3" = "--" ] || usage
shift 3

case "$env_name" in
  ''|[0-9]*|*[!A-Za-z0-9_]*) usage ;;
esac

helper=${PUDDLES_KEYCHAIN_HELPER_BIN:-"${HOME:?HOME must be set}/.local/libexec/puddles-keychain-helper/puddles-keychain-helper"}
[ -x "$helper" ] || {
  echo "Keychain helper is not installed or executable" >&2
  exit 69
}

# The sentinel preserves trailing newlines that command substitution would
# otherwise remove. Shell environment values cannot contain NUL bytes.
secret_with_sentinel=$(
  PUDDLES_KEYCHAIN_HELPER_REQUIRE_TEXT=1 \
    "$helper" "$alias_name" &&
    printf '\034'
) || exit $?
secret=${secret_with_sentinel%?}
unset secret_with_sentinel

export "$env_name=$secret"
unset secret env_name alias_name helper
exec "$@"
